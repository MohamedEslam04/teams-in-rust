// The live-call strip of a chat or channel header, as in Teams: a red live dot, how long the
// call has run, the faces of who is known to be in it (overlapping, five at most, then "+N"; a
// click lists their names) and Join. The header draws it only while `OngoingCallStore` says a
// call goes on in `chat-id`.
import { Avatar } from "../atoms/avatar.slint";
import { CallStore } from "../stores/call_store.slint";
import { OngoingCallStore } from "../stores/ongoing_call_store.slint";
import { MeetingJoinButton } from "web_parity.slint";
import { Theme } from "../tokens/theme.slint";

export component OngoingCallStrip inherits Rectangle {
    in property <string> chat-id;
    property <int> count: OngoingCallStore.people.length;
    // Each face after the first sits this far right of the one before (they overlap).
    property <length> step: 16px;
    property <length> face: 24px;
    width: row.preferred-width;
    height: 32px;
    horizontal-stretch: 0;
    accessible-role: text;
    accessible-label: OngoingCallStore.elapsed != "" ? @tr("Call in progress, {}", OngoingCallStore.elapsed) : @tr("Call in progress");
    row := HorizontalLayout {
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: Theme.danger;
                accessible-role: none;
            }
        }
        if OngoingCallStore.elapsed != "": Text {
            text: OngoingCallStore.elapsed;
            color: Theme.fg;
            font-size: 13px * Theme.font-scale;
            font-weight: 600;
            vertical-alignment: center;
            accessible-role: none;
        }
        if root.count > 0: faces := Rectangle {
            width: root.face + (root.count - 1) * root.step + (OngoingCallStore.more > 0 ? root.step + 8px : 0px) + 4px;
            border-radius: 4px;
            background: faces-touch.has-hover ? Theme.surface-hover : transparent;
            accessible-role: button;
            accessible-label: @tr("Who is in the call");
            accessible-description: OngoingCallStore.names;
            accessible-action-default => { names-popup.show(); }
            for p[i] in OngoingCallStore.people: Rectangle {
                // A ring of the header's colour keeps overlapping faces apart.
                x: i * root.step;
                y: (parent.height - self.height) / 2;
                width: root.face + 4px;
                height: self.width;
                border-radius: self.width / 2;
                background: Theme.sidebar;
                Avatar {
                    x: 2px;
                    y: 2px;
                    size: root.face;
                    initials: p.initials;
                    tone: p.color;
                    img: p.photo;
                    has-img: p.has-photo;
                    photo-label: p.name;
                }
            }
            if OngoingCallStore.more > 0: Rectangle {
                x: root.count * root.step + 4px;
                y: (parent.height - self.height) / 2;
                width: root.face + 4px;
                height: root.face + 4px;
                border-radius: self.height / 2;
                background: Theme.surface-hover;
                border-width: 2px;
                border-color: Theme.sidebar;
                Text {
                    text: "+" + OngoingCallStore.more;
                    color: Theme.fg;
                    font-size: 11px * Theme.font-scale;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    accessible-role: none;
                }
            }
            faces-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { names-popup.show(); }
            }
            names-popup := PopupWindow {
                x: 0px;
                y: parent.height + 4px;
                width: 260px;
                height: (root.count + 1) * 32px + (OngoingCallStore.more > 0 ? 28px : 0px) + 12px;
                close-policy: close-on-click-outside;
                Rectangle {
                    background: Theme.surface;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: Theme.border;
                    VerticalLayout {
                        padding: 6px;
                        spacing: 0px;
                        Text {
                            height: 32px;
                            text: @tr("In this call");
                            color: Theme.fg-muted;
                            font-size: 12px * Theme.font-scale;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        for p in OngoingCallStore.people: HorizontalLayout {
                            height: 32px;
                            spacing: 8px;
                            Avatar {
                                y: 4px;
                                size: 24px;
                                initials: p.initials;
                                tone: p.color;
                                img: p.photo;
                                has-img: p.has-photo;
                            }
                            Text {
                                text: p.name;
                                color: Theme.fg;
                                font-size: 13px * Theme.font-scale;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                        if OngoingCallStore.more > 0: Text {
                            height: 28px;
                            text: @tr("and {} more", OngoingCallStore.more);
                            color: Theme.fg-muted;
                            font-size: 12px * Theme.font-scale;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
        // A meeting chat joins as its header's Join always did; any other conversation through
        // what its call's live state offers (`backend/ongoing_call.rs`).
        MeetingJoinButton {
            live: true;
            clicked => { CallStore.command(CallStore.is-meeting-chat(root.chat-id) ? "join-chat" : "join-ongoing", root.chat-id); }
        }
    }
}
