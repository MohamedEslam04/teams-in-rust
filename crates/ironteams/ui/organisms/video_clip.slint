// Video clips, as in Teams: "Record video clip" in the composer's "…" menu opens a recorder in
// the composer (a camera preview, Record / Stop with a timer up to one minute, then Retake,
// Cancel and Send); a sent or received clip is a card with its first picture and a play button
// that opens it in the system player.
//
// The state lives in `ClipStore`, filled by `src/ui/clip.rs` from `backend/video_clips.rs`.
import { Theme } from "../tokens/theme.slint";
import { Icon, IconButton } from "../atoms/widgets.slint";
import { VoiceStore } from "../molecules/voice_player.slint";
import { VideoClipItem } from "../tokens/types.slint";

export global ClipStore {
    // "idle" | "opening" | "ready" | "recording" | "stopping" | "recorded"
    in property <string> state: "idle";
    in property <int> elapsed-ms;
    in property <int> limit-ms: 60000;
    // The live camera picture; once recorded, the take's first picture.
    in property <image> picture;
    in property <bool> has-picture;
    in property <bool> can-record;
    // Why the camera did not open or the take was dropped ("" when fine).
    in property <string> problem;
    callback open();
    callback record();
    callback stop();
    callback retake();
    callback cancel();
    callback send();
    callback play-take();
    // Plays a row's clip (its URL) in the system player.
    callback play(string);
}

// A text button of the recorder.
component ClipButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary;
    in property <bool> enabled: true;
    callback clicked();
    height: 32px;
    min-width: label-text.preferred-width + 28px;
    horizontal-stretch: 0;
    border-radius: 4px;
    border-width: root.primary ? 0 : 1px;
    border-color: Theme.border;
    background: !root.enabled ? Theme.surface-hover : root.primary ? (touch.has-hover ? Theme.accent : Theme.accent-strong) : (touch.has-hover ? Theme.surface-hover : transparent);
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled { root.clicked(); }
    }
    label-text := Text {
        text: root.label;
        color: root.primary && root.enabled ? #ffffff : root.enabled ? Theme.fg : Theme.fg-subtle;
        font-size: 13px * Theme.font-scale;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// The round record / stop button.
component RecordButton inherits Rectangle {
    in property <bool> recording;
    in property <bool> enabled: true;
    callback clicked();
    width: 44px;
    height: 44px;
    border-radius: 22px;
    border-width: 3px;
    border-color: root.enabled ? Theme.fg : Theme.fg-subtle;
    background: transparent;
    accessible-role: button;
    accessible-label: root.recording ? @tr("Stop recording") : @tr("Start recording");
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled { root.clicked(); }
    }
    Rectangle {
        width: root.recording ? 16px : 30px;
        height: self.width;
        border-radius: root.recording ? 3px : 15px;
        background: root.enabled ? Theme.danger : Theme.fg-subtle;
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component ClipRecorderPanel inherits Rectangle {
    property <string> state: ClipStore.state;
    property <bool> recorded: root.state == "recorded";
    border-radius: Theme.radius;
    background: Theme.sidebar;
    accessible-role: groupbox;
    accessible-label: @tr("Record video clip");
    forward-focus: keys;
    keys := FocusScope {
        key-pressed(e) => {
            if e.text == Key.Escape {
                ClipStore.cancel();
                return accept;
            }
            reject
        }
    }
    VerticalLayout {
        padding: 10px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 8px;
            Icon { source: @image-url("../icons/video.svg"); width: 18px; height: 18px; y: 5px; tint: Theme.accent; }
            Text {
                text: @tr("Record video clip");
                color: Theme.fg;
                font-size: 14px * Theme.font-scale;
                font-weight: 600;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            IconButton {
                icon: @image-url("../icons/close.svg");
                tooltip: @tr("Cancel");
                size: 28px;
                clicked => { ClipStore.cancel(); }
            }
        }
        // The camera, or the take's first picture, 16:9.
        HorizontalLayout {
            alignment: center;
            preview := Rectangle {
                width: 320px;
                height: 180px;
                border-radius: 6px;
                background: #000000;
                clip: true;
                if ClipStore.has-picture: Image {
                    width: parent.width;
                    height: parent.height;
                    source: ClipStore.picture;
                    image-fit: contain;
                    accessible-role: image;
                    accessible-label: root.recorded ? @tr("The recorded clip") : @tr("Camera preview");
                }
                if !ClipStore.has-picture: Text {
                    x: 12px;
                    width: parent.width - 24px;
                    text: ClipStore.problem != "" ? ClipStore.problem : root.state == "opening" ? @tr("Starting the camera…") : root.state == "stopping" ? @tr("Making the clip…") : @tr("Waiting for the camera…");
                    color: ClipStore.problem != "" ? #ff7e83 : #cccccc;
                    font-size: 13px * Theme.font-scale;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
                // Play the take before sending.
                if root.recorded: Rectangle {
                    width: 48px;
                    height: 48px;
                    border-radius: 24px;
                    background: play-take.has-hover ? #000000cc : #00000099;
                    accessible-role: button;
                    accessible-label: @tr("Play the clip");
                    accessible-action-default => { ClipStore.play-take(); }
                    Icon { source: @image-url("../icons/play.svg"); width: 22px; height: 22px; tint: #ffffff; }
                    play-take := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { ClipStore.play-take(); }
                    }
                }
                // The timer, over the picture.
                if root.state == "recording" || root.recorded: Rectangle {
                    x: 8px;
                    y: 8px;
                    width: timer.preferred-width + 24px;
                    height: 22px;
                    border-radius: 11px;
                    background: #000000aa;
                    if root.state == "recording": Rectangle {
                        x: 8px;
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: Theme.danger;
                    }
                    timer := Text {
                        x: 20px;
                        text: VoiceStore.clock(ClipStore.elapsed-ms) + " / " + VoiceStore.clock(ClipStore.limit-ms);
                        color: #ffffff;
                        font-size: 12px * Theme.font-scale;
                        vertical-alignment: center;
                        accessible-role: text;
                        accessible-label: root.state == "recording" ? @tr("Recording, {}", self.text) : self.text;
                    }
                }
            }
        }
        if ClipStore.problem != "" && ClipStore.has-picture: Text {
            text: ClipStore.problem;
            color: Theme.danger-text;
            font-size: 12px * Theme.font-scale;
            horizontal-alignment: center;
            overflow: elide;
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: center;
            height: 44px;
            if !root.recorded: VerticalLayout {
                alignment: center;
                ClipButton {
                    label: @tr("Cancel");
                    clicked => { ClipStore.cancel(); }
                }
            }
            if !root.recorded: RecordButton {
                recording: root.state == "recording";
                enabled: root.state == "recording" || ClipStore.can-record;
                clicked => {
                    if root.state == "recording" { ClipStore.stop(); } else { ClipStore.record(); }
                }
            }
            if root.recorded: VerticalLayout {
                alignment: center;
                ClipButton {
                    label: @tr("Retake");
                    clicked => { ClipStore.retake(); }
                }
            }
            if root.recorded: VerticalLayout {
                alignment: center;
                ClipButton {
                    label: @tr("Cancel");
                    clicked => { ClipStore.cancel(); }
                }
            }
            if root.recorded: VerticalLayout {
                alignment: center;
                ClipButton {
                    label: @tr("Send");
                    primary: true;
                    clicked => { ClipStore.send(); }
                }
            }
        }
    }
}

// A clip in a chat row: its first picture with a play button and the length.
export component VideoClipCard inherits Rectangle {
    in property <VideoClipItem> item;
    width: 260px;
    height: 146px;
    border-radius: 6px;
    background: #000000;
    clip: true;
    accessible-role: button;
    accessible-label: @tr("Play video clip, {}", VoiceStore.clock(root.item.duration-ms));
    accessible-action-default => { ClipStore.play(root.item.url); }
    if root.item.has-thumb: Image {
        width: parent.width;
        height: parent.height;
        source: root.item.thumb;
        image-fit: cover;
    }
    if !root.item.has-thumb: Icon {
        source: @image-url("../icons/video.svg");
        width: 36px;
        height: 36px;
        tint: #8a8a8a;
    }
    Rectangle {
        width: 44px;
        height: 44px;
        border-radius: 22px;
        background: touch.has-hover ? #000000cc : #00000099;
        Icon { source: @image-url("../icons/play.svg"); width: 20px; height: 20px; tint: #ffffff; }
    }
    if root.item.duration-ms > 0: Rectangle {
        x: parent.width - self.width - 8px;
        y: parent.height - self.height - 8px;
        width: length-text.preferred-width + 12px;
        height: 20px;
        border-radius: 4px;
        background: #000000aa;
        length-text := Text {
            text: VoiceStore.clock(root.item.duration-ms);
            color: #ffffff;
            font-size: 11px * Theme.font-scale;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { ClipStore.play(root.item.url); }
    }
}
