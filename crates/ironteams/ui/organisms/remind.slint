// "Remind me about this" on messages and "Snooze" on chats. Both stay on this computer. Rust
// fills `RemindStore` (backend/remind.rs); the UI sends `command(name, argument)` (two arguments
// are joined with a tab).
import { ScrollView } from "std-widgets.slint";
import { Theme } from "../tokens/theme.slint";
import { Button, ButtonVariant } from "../atoms/button.slint";
import { Fixed } from "../tokens/fixed.slint";

export struct ReminderRow {
    id: string,
    // "Today 14:30", "Tomorrow 09:00", "Mon 24 Nov 09:00".
    time: string,
    chat: string,
    // "Sender: the start of the message".
    text: string,
}
export struct SnoozedRow {
    id: string,
    title: string,
    until: string,
}

// One row of the Later page: a reminder or a saved message.
export struct LaterRow {
    // `reminder:<id>` or `saved:<chat>` U+001F `<message>`; the commands take it back.
    id: string,
    // reminder | saved
    kind: string,
    // "Team › channel", or the chat's title.
    chat: string,
    author: string,
    preview: string,
    // The due time of a reminder, the time a message was saved ("Today 14:30").
    time: string,
    overdue: bool,
}

export global RemindStore {
    in-out property <bool> open: false;
    in property <[ReminderRow]> reminders;
    in property <[SnoozedRow]> snoozed;
    // The Later page (pages/later.slint): reminders and saved messages in one list.
    in-out property <bool> later-open: false;
    in property <[LaterRow]> later;
    // Names: remind (message id, when), cancel, snooze (chat id, when), unsnooze, refresh,
    // later-open (row id), later-done (row id), later-snooze (row id, `1h` or `tomorrow`).
    callback command(string, string);
}

// The Reminders panel: pending reminders with Cancel, and the snoozed chats with Unsnooze.
export component RemindPanel inherits Rectangle {
    callback close();
    width: 440px;
    height: 460px;
    border-radius: 8px;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    drop-shadow-blur: 16px;
    drop-shadow-color: Fixed.black-a0;
    accessible-role: groupbox;
    accessible-label: @tr("Reminders");

    FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if event.text == Key.Escape { root.close(); return accept; }
            reject
        }
    }

    VerticalLayout {
        padding: 16px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 8px;
            Text { text: @tr("Reminders"); color: Theme.fg; font-size: 16px * Theme.font-scale; font-weight: 700; vertical-alignment: center; horizontal-alignment: Theme.start-align; horizontal-stretch: 1; }
            Button { variant: ButtonVariant.subtle; label: @tr("Close"); clicked => { root.close(); } }
        }
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 6px;
                if RemindStore.reminders.length == 0: Text {
                    text: @tr("No reminders. Use \"Remind me\" in a message's menu.");
                    color: Theme.fg-subtle;
                    font-size: 13px * Theme.font-scale;
                    wrap: word-wrap;
                    horizontal-alignment: Theme.start-align;
                }
                for r in RemindStore.reminders: Rectangle {
                    height: 56px;
                    border-radius: 4px;
                    background: Theme.panel;
                    HorizontalLayout {
                        padding: 8px;
                        spacing: 8px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text { text: r.time + (r.chat != "" ? "  ·  " + r.chat : ""); color: Theme.accent; font-size: 12px * Theme.font-scale; overflow: elide; horizontal-alignment: Theme.start-align; }
                            Text { text: r.text; color: Theme.fg; font-size: 13px * Theme.font-scale; overflow: elide; horizontal-alignment: Theme.start-align; }
                        }
                        VerticalLayout { alignment: center; Button { variant: ButtonVariant.subtle; label: @tr("Cancel"); clicked => { RemindStore.command("cancel", r.id); } } }
                    }
                }
                if RemindStore.snoozed.length > 0: Text {
                    text: @tr("Snoozed chats");
                    color: Theme.fg-muted;
                    font-size: 13px * Theme.font-scale;
                    font-weight: 700;
                    horizontal-alignment: Theme.start-align;
                }
                for c in RemindStore.snoozed: Rectangle {
                    height: 50px;
                    border-radius: 4px;
                    background: Theme.panel;
                    HorizontalLayout {
                        padding: 8px;
                        spacing: 8px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text { text: c.title; color: Theme.fg; font-size: 13px * Theme.font-scale; overflow: elide; horizontal-alignment: Theme.start-align; }
                            Text { text: @tr("Returns {}", c.until); color: Theme.fg-subtle; font-size: 12px * Theme.font-scale; overflow: elide; horizontal-alignment: Theme.start-align; }
                        }
                        VerticalLayout { alignment: center; Button { variant: ButtonVariant.subtle; label: @tr("Unsnooze"); clicked => { RemindStore.command("unsnooze", c.id); } } }
                    }
                }
            }
        }
    }
}
