// "Remind me about this" on messages and "Snooze" on chats. Both stay on this computer. Rust
// fills `RemindStore` (backend/remind.rs); the UI sends `command(name, argument)` (two arguments
// are joined with a tab).
import { ScrollView } from "std-widgets.slint";
import { Theme } from "../tokens/theme.slint";

export struct ReminderRow {
    id: string,
    // "Today 14:30", "Tomorrow 09:00", "Mon 24 Nov 09:00".
    time: string,
    chat: string,
    // "Sender: the start of the message".
    text: string,
}
export struct SnoozedRow {
    id: string,
    title: string,
    until: string,
}

export global RemindStore {
    in-out property <bool> open: false;
    in property <[ReminderRow]> reminders;
    in property <[SnoozedRow]> snoozed;
    // Names: remind (message id, when), cancel, snooze (chat id, when), unsnooze, refresh.
    callback command(string, string);
}

// The small buttons of a row of the panel.
component RowButton inherits Rectangle {
    in property <string> label;
    callback clicked();
    width: label-text.preferred-width + 20px;
    height: 28px;
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.border;
    background: touch.has-hover ? Theme.surface-hover : transparent;
    accessible-role: button;
    accessible-label: root.label;
    label-text := Text { text: root.label; color: Theme.fg; font-size: 12px * Theme.font-scale; horizontal-alignment: center; vertical-alignment: center; }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// The Reminders panel: pending reminders with Cancel, and the snoozed chats with Unsnooze.
export component RemindPanel inherits Rectangle {
    callback close();
    width: 440px;
    height: 460px;
    border-radius: 8px;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    drop-shadow-blur: 16px;
    drop-shadow-color: #000000a0;
    accessible-role: groupbox;
    accessible-label: @tr("Reminders");

    FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if event.text == Key.Escape { root.close(); return accept; }
            reject
        }
    }

    VerticalLayout {
        padding: 16px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 8px;
            Text { text: @tr("Reminders"); color: Theme.fg; font-size: 16px * Theme.font-scale; font-weight: 700; vertical-alignment: center; horizontal-alignment: Theme.start-align; horizontal-stretch: 1; }
            RowButton { label: @tr("Close"); clicked => { root.close(); } }
        }
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 6px;
                if RemindStore.reminders.length == 0: Text {
                    text: @tr("No reminders. Use \"Remind me\" in a message's menu.");
                    color: Theme.fg-subtle;
                    font-size: 13px * Theme.font-scale;
                    wrap: word-wrap;
                    horizontal-alignment: Theme.start-align;
                }
                for r in RemindStore.reminders: Rectangle {
                    height: 56px;
                    border-radius: 4px;
                    background: Theme.sidebar;
                    HorizontalLayout {
                        padding: 8px;
                        spacing: 8px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text { text: r.time + (r.chat != "" ? "  ·  " + r.chat : ""); color: Theme.accent; font-size: 12px * Theme.font-scale; overflow: elide; horizontal-alignment: Theme.start-align; }
                            Text { text: r.text; color: Theme.fg; font-size: 13px * Theme.font-scale; overflow: elide; horizontal-alignment: Theme.start-align; }
                        }
                        VerticalLayout { alignment: center; RowButton { label: @tr("Cancel"); clicked => { RemindStore.command("cancel", r.id); } } }
                    }
                }
                if RemindStore.snoozed.length > 0: Text {
                    text: @tr("Snoozed chats");
                    color: Theme.fg-muted;
                    font-size: 13px * Theme.font-scale;
                    font-weight: 700;
                    horizontal-alignment: Theme.start-align;
                }
                for c in RemindStore.snoozed: Rectangle {
                    height: 50px;
                    border-radius: 4px;
                    background: Theme.sidebar;
                    HorizontalLayout {
                        padding: 8px;
                        spacing: 8px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text { text: c.title; color: Theme.fg; font-size: 13px * Theme.font-scale; overflow: elide; horizontal-alignment: Theme.start-align; }
                            Text { text: @tr("Returns {}", c.until); color: Theme.fg-subtle; font-size: 12px * Theme.font-scale; overflow: elide; horizontal-alignment: Theme.start-align; }
                        }
                        VerticalLayout { alignment: center; RowButton { label: @tr("Unsnooze"); clicked => { RemindStore.command("unsnooze", c.id); } } }
                    }
                }
            }
        }
    }
}
