// The "Video effects and settings" panel, as Teams has it, in two tabs. Video effects: the
// backgrounds (none, blur, your own pictures, the bundled ones), "Preview" (our camera shown to us
// only) and "Apply and turn on video". Settings: the camera, brightness, whether our self-view is
// mirrored (the filters and soft focus are here too). Every choice applies at once, to the
// preview and to what the others see (the mirror only to our own view).
import { ScrollView } from "std-widgets.slint";
import { Theme } from "../tokens/theme.slint";
import { Icon, IconButton } from "../atoms/widgets.slint";
import { CallStore } from "../stores/call_store.slint";
import { VideoFxStore } from "../stores/video_fx_store.slint";
import { Switch, SwitchVariant } from "../atoms/check.slint";
import { Button, ButtonVariant } from "../atoms/button.slint";
import { Heading, HeadingVariant } from "../atoms/heading.slint";
import { RadioRow } from "../atoms/radio_row.slint";
import { BackgroundTile } from "../molecules/background_tile.slint";
import { InfoTip } from "../molecules/info_tip.slint";
import { Tokens } from "../tokens/types.slint";

// "Add new": a picture of your own.
component AddTile inherits Rectangle {
    in property <Tokens> c: Theme.call;
    width: 88px;
    height: 54px;
    border-radius: 6px;
    border-width: 1px;
    border-color: touch.has-hover ? root.c.fg-subtle : root.c.border;
    background: touch.has-hover ? root.c.surface-hover : root.c.surface;
    accessible-role: button;
    accessible-label: "Add new background";
    accessible-action-default => { CallStore.command("fx-add-background", ""); }
    VerticalLayout {
        alignment: center;
        spacing: 2px;
        HorizontalLayout {
            alignment: center;
            Icon { c: root.c; source: @image-url("../icons/plus.svg"); tint: root.c.fg; width: 16px; height: 16px; }
        }
        Text {
            text: "Add new";
            color: root.c.fg;
            font-size: 11px * Theme.font-scale;
            horizontal-alignment: center;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { CallStore.command("fx-add-background", ""); }
    }
}

// The tiles in rows of three: None, Standard blur, "Add new", then Teams' pictures (as they
// download), the bundled ones and your own. (The blur's strength is chosen under the grid.)
component BackgroundGrid inherits Rectangle {
    in property <Tokens> c: Theme.call;
    property <int> cols: 3;
    property <int> count: VideoFxStore.backgrounds.length + 1;
    width: root.cols * 88px + (root.cols - 1) * 8px;
    height: ceil(root.count / root.cols) * 62px - 8px;
    for c[i] in VideoFxStore.backgrounds: BackgroundTile {
        c: root.c;
        x: mod(i < 2 ? i : i + 1, root.cols) * 96px;
        y: floor((i < 2 ? i : i + 1) / root.cols) * 62px;
        choice: c;
        selected: VideoFxStore.background == c.id || (c.id == "blur" && VideoFxStore.background == "strong-blur");
        picked => { CallStore.command("fx-background", c.id); }
    }
    AddTile {
        c: root.c;
        x: mod(2, root.cols) * 96px;
        y: floor(2 / root.cols) * 62px;
    }
}

// A filter: a chip, checked when in use.
component FilterChip inherits Rectangle {
    in property <Tokens> c: Theme.call;
    in property <string> key;
    in property <string> label;
    in property <string> description: root.label;
    property <bool> selected: VideoFxStore.filter == root.key;
    width: txt.preferred-width + 20px;
    height: 28px;
    border-radius: 14px;
    border-width: 1px;
    border-color: root.selected ? root.c.accent : root.c.border;
    background: root.selected ? root.c.selected : touch.has-hover ? root.c.surface-hover : root.c.surface;
    accessible-role: button;
    accessible-label: root.description;
    accessible-checkable: true;
    accessible-checked: root.selected;
    accessible-action-default => { CallStore.command("fx-filter", root.key); }
    txt := Text {
        text: root.label;
        color: root.selected ? root.c.accent : root.c.fg;
        font-size: 12px * Theme.font-scale;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { CallStore.command("fx-filter", root.key); }
    }
}

// A tab of the panel.
component PanelTab inherits Rectangle {
    in property <Tokens> c: Theme.call;
    in property <string> label;
    in property <bool> selected;
    callback picked();
    height: 32px;
    horizontal-stretch: 1;
    border-radius: 4px;
    background: touch.has-hover ? root.c.surface-hover : transparent;
    accessible-role: tab;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.selected;
    accessible-action-default => { root.picked(); }
    Text {
        text: root.label;
        color: root.selected ? root.c.fg : root.c.fg-muted;
        font-size: 13px * Theme.font-scale;
        font-weight: root.selected ? 600 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Rectangle {
        y: root.height - self.height;
        height: 2px;
        background: root.selected ? root.c.accent : transparent;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }
}

// The header of a section that folds: a chevron and its name.
component SectionHeader inherits Rectangle {
    in property <Tokens> c: Theme.call;
    in property <string> label;
    in-out property <bool> open: true;
    height: 32px;
    border-radius: 4px;
    background: touch.has-hover ? root.c.surface-hover : transparent;
    accessible-role: button;
    accessible-label: root.label + " section";
    accessible-expandable: true;
    accessible-expanded: root.open;
    accessible-action-default => { root.open = !root.open; }
    HorizontalLayout {
        padding-left: 6px;
        spacing: 6px;
        VerticalLayout {
            alignment: center;
            Icon {
                c: root.c;
                source: root.open ? @image-url("../icons/chevron-down.svg") : @image-url("../icons/chevron-right.svg");
                tint: root.c.fg;
                width: 14px;
                height: 14px;
            }
        }
        Text {
            text: root.label;
            color: root.c.fg;
            font-size: 14px * Theme.font-scale;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.open = !root.open; }
    }
}

export component VideoEffectsPanel inherits Rectangle {
    in property <Tokens> c: Theme.call;
    property <string> tab: "effects";
    // In a call the panel shows how we look; the pre-join screen has its own preview beside it.
    property <bool> shows-preview: CallStore.phase != "prejoin";
    // Our camera is already on (shown or being sent): nothing to preview.
    property <bool> camera-on: CallStore.phase == "prejoin" ? CallStore.prejoin-camera : CallStore.camera;
    background: root.c.panel;
    function close() {
        VideoFxStore.open = false;
        CallStore.command("video-preview", "off");
    }
    VerticalLayout {
        padding: 12px;
        spacing: 10px;
        HorizontalLayout {
            height: 32px;
            Text {
                text: "Video effects and settings";
                color: root.c.fg;
                font-size: 15px * Theme.font-scale;
                font-weight: 600;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            IconButton {
                c: root.c;
                icon: @image-url("../icons/close.svg");
                tooltip: "Close video effects";
                size: 28px;
                clicked => { root.close(); }
            }
        }
        if root.shows-preview: Rectangle {
            height: 120px;
            border-radius: 6px;
            clip: true;
            background: root.c.rail;
            if VideoFxStore.has-preview: Image {
                width: parent.width;
                height: parent.height;
                source: VideoFxStore.preview;
                image-fit: cover;
                accessible-role: image;
                accessible-label: "Your video preview";
            }
            if !VideoFxStore.has-preview && CallStore.has-self-view: Image {
                width: parent.width;
                height: parent.height;
                source: CallStore.self-view;
                image-fit: cover;
                accessible-role: image;
                accessible-label: "Your video preview";
            }
            if !VideoFxStore.has-preview && !CallStore.has-self-view: Text {
                width: parent.width - 24px;
                x: 12px;
                text: VideoFxStore.preview-status != "" ? VideoFxStore.preview-status : "Select Preview to see how you look";
                color: root.c.fg-subtle;
                font-size: 12px * Theme.font-scale;
                horizontal-alignment: center;
                vertical-alignment: center;
                wrap: word-wrap;
            }
        }
        HorizontalLayout {
            spacing: 4px;
            PanelTab {
                c: root.c;
                label: "Video effects";
                selected: root.tab == "effects";
                picked => { root.tab = "effects"; }
            }
            PanelTab {
                c: root.c;
                label: "Settings";
                selected: root.tab == "settings";
                picked => { root.tab = "settings"; }
            }
        }
        if root.tab == "effects": ScrollView {
            content-width: self.width;
            VerticalLayout {
                width: parent.width;
                alignment: start;
                spacing: 10px;
                Heading { c: root.c; variant: HeadingVariant.caption; text: "Background"; }
                // The blur's strength: neither is checked until a blur is chosen.
                VerticalLayout {
                    spacing: 2px;
                    Heading { c: root.c; variant: HeadingVariant.caption; text: "Blur strength"; }
                    HorizontalLayout {
                        spacing: 4px;
                        RadioRow {
                            c: root.c;
                            label: "Standard";
                            selected: VideoFxStore.background == "blur";
                            picked => { CallStore.command("fx-background", "blur"); }
                        }
                        RadioRow {
                            c: root.c;
                            label: "Strong";
                            selected: VideoFxStore.background == "strong-blur";
                            picked => { CallStore.command("fx-background", "strong-blur"); }
                        }
                    }
                }
                BackgroundGrid { c: root.c; }
                if VideoFxStore.teams-note != "": Text {
                    text: VideoFxStore.teams-note;
                    color: root.c.fg-subtle;
                    font-size: 12px * Theme.font-scale;
                    wrap: word-wrap;
                }
                if VideoFxStore.background.starts-with("custom:"): HorizontalLayout {
                    alignment: start;
                    Rectangle {
                        width: rm.preferred-width + 16px;
                        height: 26px;
                        border-radius: 4px;
                        background: rmt.has-hover ? root.c.surface-hover : transparent;
                        accessible-role: button;
                        accessible-label: "Remove this background";
                        accessible-action-default => { CallStore.command("fx-remove-background", VideoFxStore.background); }
                        rm := Text {
                            text: "Remove this background";
                            color: root.c.accent;
                            font-size: 12px * Theme.font-scale;
                        }
                        rmt := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { CallStore.command("fx-remove-background", VideoFxStore.background); }
                        }
                    }
                }
            }
        }
        if root.tab == "settings": ScrollView {
            content-width: self.width;
            VerticalLayout {
                width: parent.width;
                alignment: start;
                spacing: 4px;
                cam-head := SectionHeader { c: root.c; label: "Camera"; }
                if cam-head.open: VerticalLayout {
                    for cam[i] in VideoFxStore.cameras: RadioRow {
                        c: root.c;
                        label: cam;
                        selected: i == VideoFxStore.camera;
                        picked => { CallStore.command("camera-device", "" + i); }
                    }
                }
                look-head := SectionHeader { c: root.c; label: "Appearance"; }
                if look-head.open: VerticalLayout {
                    spacing: 4px;
                    HorizontalLayout {
                        Switch { c: root.c; variant: SwitchVariant.panel;
                            horizontal-stretch: 1;
                            label: "Adjust brightness";
                            checked: VideoFxStore.brighten;
                            toggled => { CallStore.command("fx-brighten", VideoFxStore.brighten ? "off" : "on"); }
                        }
                        VerticalLayout {
                            alignment: center;
                            InfoTip { c: root.c; tip: "Brightens your video in low light."; }
                        }
                    }
                    HorizontalLayout {
                        Switch { c: root.c; variant: SwitchVariant.panel;
                            horizontal-stretch: 1;
                            label: "Mirror my video";
                            checked: VideoFxStore.mirror;
                            toggled => { CallStore.command("fx-mirror", VideoFxStore.mirror ? "off" : "on"); }
                        }
                        VerticalLayout {
                            alignment: center;
                            InfoTip { c: root.c; tip: "Only you see your video mirrored. Others see it as it is."; }
                        }
                    }
                    HorizontalLayout {
                        Switch { c: root.c; variant: SwitchVariant.panel;
                            horizontal-stretch: 1;
                            label: "Soft focus";
                            checked: VideoFxStore.soft-focus;
                            toggled => { CallStore.command("fx-soft-focus", VideoFxStore.soft-focus ? "off" : "on"); }
                        }
                        VerticalLayout {
                            alignment: center;
                            InfoTip { c: root.c; tip: "Smooths your appearance a little."; }
                        }
                    }
                    Heading { c: root.c; variant: HeadingVariant.caption; text: "Filters"; }
                    HorizontalLayout {
                        alignment: start;
                        spacing: 6px;
                        FilterChip { c: root.c; key: "none"; label: "Original"; description: "No filter"; }
                        FilterChip { c: root.c; key: "warm"; label: "Warm"; }
                        FilterChip { c: root.c; key: "cool"; label: "Cool"; }
                    }
                    HorizontalLayout {
                        alignment: start;
                        spacing: 6px;
                        FilterChip { c: root.c; key: "mono"; label: "B&W"; description: "Black and white"; }
                        FilterChip { c: root.c; key: "vivid"; label: "Vivid"; }
                    }
                }
            }
        }
        if root.tab == "effects": VerticalLayout {
            spacing: 8px;
            Text {
                text: "Others won't see your video while you preview.";
                color: root.c.fg-subtle;
                font-size: 12px * Theme.font-scale;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Button { c: root.c; variant: ButtonVariant.action;
                    label: "Preview";
                    enabled: !root.camera-on;
                    clicked => { CallStore.command("video-preview", "on"); }
                }
                Button { c: root.c; variant: ButtonVariant.action;
                    label: "Apply and turn on video";
                    primary: true;
                    clicked => {
                        CallStore.command("video-apply", "");
                        VideoFxStore.open = false;
                    }
                }
            }
        }
    }
}
