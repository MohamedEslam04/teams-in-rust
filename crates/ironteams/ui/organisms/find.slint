// Finding things (plan chat 7.1, 7.2, 7.4, 7.5, 7.6): the Search page, the quick views (Mentions and
// Followed threads), the Find in chat bar, the Shared tab and the chat details pane. Rust fills the
// properties; the UI sends `command(name, argument)`.
import { ListView } from "std-widgets.slint";
import { Theme } from "../tokens/theme.slint";
import { Icon, IconButton, Pill } from "../atoms/widgets.slint";
import { Avatar } from "../atoms/avatar.slint";
import { PeopleStore, PersonHover } from "../molecules/people.slint";
import { ComposerApps } from "composer_apps.slint";
import { KindBadge } from "onedrive.slint";
import { Motion, SkeletonList } from "../tokens/motion.slint";

// One row of the Search page or a quick view.
export struct HitRow {
    id: string,
    kind: string,        // message | file | person | channel | chat | meeting | thread
    section: string,     // non-empty: the first row of a section of the All tab
    title: string,
    subtitle: string,
    snippet: styled-text,
    snippet-plain: string,
    time: string,
    initials: string,
    color: color,
    avatar: image,
    has-avatar: bool,
    // The person the photo shows ("" when none), for the hover card.
    person: string,
    rtl: bool,
}

// A suggestion of the "In" and "Person" filters.
export struct PickRow { id: string, title: string, subtitle: string }

// One row of the Shared tab.
// `editable` rows are SharePoint drive items (Download, Share, Rename and Delete apply);
// `sharepoint` rows can be opened in SharePoint.
// `icon` is `folder`, `link` or a document kind (`word`, `excel`, `pdf`, `image`, `archive`, `other`, ...);
// `busy` says what is being done to the row while the server answers ("Deleting…"); `highlight`
// marks a row just created.
export struct SharedRow { kind: string, name: string, ext: string, shared-by: string, date: string, url: string, editable: bool, sharepoint: bool, icon: string, busy: string, highlight: bool }

// A channel tab beyond Posts and Files (Notes, a website, Planner, …).
export struct ChannelTabItem { name: string, url: string, id: string }

// An installed app that can have a tab in a channel.
export struct ChannelTabApp { id: string, name: string }

export global FindStore {
    // The open channel's other tabs, and the "Add a tab" dialog.
    in property <[ChannelTabItem]> channel-tabs;
    in-out property <bool> tab-add-open: false;
    // The installed apps the "Add a tab" dialog offers, and which kind it adds (website | app).
    in property <[ChannelTabApp]> tab-apps;
    // The dialog was opened from a chat: the tab goes to the chat (chat-tab-add, chat-tab-add-app).
    in-out property <bool> tab-for-chat: false;
    in-out property <string> tab-add-kind: "website";
    // The tab whose menu is open (its id, name and place), and the dialog it leads to
    // ("" | rename | remove).
    in-out property <string> tab-menu-id;
    in-out property <string> tab-menu-name;
    in-out property <length> tab-menu-x;
    in-out property <length> tab-menu-y;
    in-out property <string> tab-dialog;
    // --- Search page (Ctrl+Alt+E) ---
    in-out property <string> query;
    in-out property <string> tab: "all"; // all | messages | files | people | channels | chats | meetings
    in property <[HitRow]> results;
    in property <bool> searching;
    in property <bool> searched;         // a search ran (shows the empty state when it found nothing)
    in property <bool> more;             // more messages can be loaded
    in property <string> filter-in;      // label of the chosen chat or channel
    in property <string> filter-person;
    in property <string> filter-date;    // "", "Past 24 hours", "Past week", "Past month"
    in-out property <string> filter-editor; // "" | in | person | date
    in property <[PickRow]> picks;
    in-out property <int> focus-tick;

    // --- Quick views ---
    in-out property <bool> quick-open: false;
    in property <string> quick-kind;     // mentions | saved | followed | discover
    in property <[HitRow]> quick-rows;
    in property <bool> quick-loading;
    in property <bool> quick-more;

    // --- Find in chat ---
    in-out property <bool> chat-find-open: false;
    in-out property <string> chat-find-query;
    in property <int> chat-find-count;
    in property <int> chat-find-index;   // 1-based, in time order; 0 when there is no match
    in-out property <int> chat-find-tick;

    // --- Shared tab and details pane ---
    in-out property <string> chat-tab: "chat"; // chat | shared | storyline
    in property <[SharedRow]> shared;
    in property <[SharedRow]> recent;
    in property <bool> shared-loading;
    // New folder and New document apply (a channel with a files folder), and the last file
    // action's outcome.
    in property <bool> shared-can-create;
    in property <string> shared-note;
    in property <bool> shared-note-error; // the note says an action failed
    in-out property <string> shared-filter: "recent"; // recent | files | links
    in-out property <bool> details-open: false;

    // The open message menu's thread is followed.
    in property <bool> menu-following;

    // (name, argument). Names: search, search-tab, editor, pick-query, pick, filter-clear, date, open,
    // more, close-search, quick, quick-close, unfollow, find-open, find-close, find-query, find-prev,
    // find-next, tab, shared-filter, shared-keyword, shared-open, shared-upload, shared-download,
    // shared-copy-link, shared-share, shared-rename (url U+001F name), shared-delete,
    // shared-new-folder, shared-new-doc (word | excel | powerpoint), channel-tab-open,
    // channel-tab-add, channel-tab-add-app (app id U+001F name), channel-tab-rename (tab id
    // U+001F name), channel-tab-remove, channel-tab-apps, details, follow, unfollow-msg,
    // menu-follow, people-profile.
    callback command(string, string);
}

component Chip inherits Rectangle {
    in property <string> label;
    in property <string> value;
    callback clicked();
    callback cleared();
    height: 30px;
    width: min(chip-row.preferred-width, 280px);
    border-radius: 15px;
    border-width: 1px;
    border-color: root.value != "" ? Theme.accent : Theme.border;
    background: root.value != "" ? #3b3d6b : (t.has-hover ? Theme.surface-hover : transparent);
    accessible-role: button;
    accessible-label: root.value != "" ? root.label + ": " + root.value : root.label;
    t := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    chip-row := HorizontalLayout {
        padding-left: 12px;
        padding-right: root.value != "" ? 4px : 12px;
        spacing: 6px;
        Text { text: root.value != "" ? root.label + ": " + root.value : root.label; color: Theme.fg; font-size: 12px * Theme.font-scale; vertical-alignment: center; overflow: elide; }
        if root.value != "": IconButton {
            icon: @image-url("../icons/close.svg");
            tooltip: "Clear " + root.label;
            size: 22px;
            y: 4px;
            clicked => { root.cleared(); }
        }
    }
}

component HitItem inherits Rectangle {
    in property <HitRow> data;
    callback clicked();
    callback secondary();
    in property <string> secondary-label;
    // The pointer is on the person's photo, which sits above the row's TouchArea: the row keeps
    // its highlight.
    property <bool> photo-over;
    height: (root.data.section != "" ? 30px : 0px) + 74px;
    VerticalLayout {
        if root.data.section != "": Text {
            height: 30px;
            text: root.data.section;
            color: Theme.fg-muted;
            font-size: 13px * Theme.font-scale;
            font-weight: 700;
            vertical-alignment: bottom;
        }
        row := Rectangle {
            height: 74px;
            border-radius: 4px;
            background: touch.has-hover || (root.photo-over && root.data.person != "") ? Theme.surface-hover : transparent;
            accessible-role: list-item;
            accessible-label: root.data.title;
            accessible-description: root.data.snippet-plain + " · " + root.data.subtitle;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 12px;
                Avatar {
                    y: (parent.height - 36px) / 2;
                    initials: root.data.initials;
                    tone: root.data.color;
                    img: root.data.avatar;
                    has-img: root.data.has-avatar;
                    size: 36px;
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: root.data.title; color: Theme.fg; font-size: 14px * Theme.font-scale; font-weight: 600; overflow: elide; horizontal-stretch: 1; }
                        Text { text: root.data.time; color: Theme.fg-subtle; font-size: 11px * Theme.font-scale; horizontal-stretch: 0; vertical-alignment: center; }
                    }
                    if root.data.snippet-plain != "": Rectangle {
                        height: 18px;
                        clip: true;
                        StyledText {
                            width: parent.width;
                            text: root.data.snippet;
                            default-color: Theme.fg-muted;
                            default-font-size: 12px * Theme.font-scale;
                            horizontal-alignment: root.data.rtl ? right : left;
                        }
                    }
                    Text { text: root.data.subtitle; color: Theme.fg-subtle; font-size: 11px * Theme.font-scale; overflow: elide; }
                }
                if root.secondary-label != "": Rectangle { width: 82px; horizontal-stretch: 0; }
            }
            touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
            // The photo opens its person's card on hover; a click still opens the result.
            if root.data.person != "": photo-hover := PersonHover {
                x: 12px;
                y: (parent.height - 36px) / 2;
                width: 36px;
                height: 36px;
                person: root.data.person;
                click-opens: false;
                over <=> root.photo-over;
                activated => { root.clicked(); }
            }
            // After the row's own TouchArea, so it gets its clicks.
            if root.secondary-label != "": Rectangle {
                x: parent.width - self.width - 12px;
                y: (parent.height - self.height) / 2;
                width: 74px;
                height: 28px;
                border-radius: 4px;
                border-width: 1px;
                border-color: Theme.border;
                background: sec.has-hover ? Theme.surface-hover : transparent;
                accessible-role: button;
                accessible-label: root.secondary-label;
                Text { text: root.secondary-label; color: Theme.fg; font-size: 12px * Theme.font-scale; horizontal-alignment: center; vertical-alignment: center; }
                sec := TouchArea { mouse-cursor: pointer; clicked => { root.secondary(); } }
            }
        }
    }
}

component PickEditor inherits Rectangle {
    in property <string> placeholder;
    in property <[PickRow]> picks;
    callback query(string);
    callback pick(string);
    height: 44px + min(6, root.picks.length) * 44px;
    background: Theme.sidebar;
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.border;
    VerticalLayout {
        Rectangle {
            height: 44px;
            pick-input := TextInput {
                x: 12px;
                width: parent.width - 24px;
                color: Theme.fg;
                font-size: 13px * Theme.font-scale;
                single-line: true;
                vertical-alignment: center;
                accessible-role: text-input;
                accessible-label: root.placeholder;
                edited => { root.query(self.text); }
                init => { self.focus(); }
            }
            if pick-input.text == "": Text { x: 12px; text: root.placeholder; color: Theme.fg-subtle; font-size: 13px * Theme.font-scale; vertical-alignment: center; }
        }
        for p in root.picks: Rectangle {
            height: 44px;
            background: pt.has-hover ? Theme.surface-hover : transparent;
            accessible-role: list-item;
            accessible-label: p.title;
            VerticalLayout {
                padding-left: 12px;
                padding-right: 12px;
                alignment: center;
                Text { text: p.title; color: Theme.fg; font-size: 13px * Theme.font-scale; overflow: elide; }
                if p.subtitle != "": Text { text: p.subtitle; color: Theme.fg-subtle; font-size: 11px * Theme.font-scale; overflow: elide; }
            }
            pt := TouchArea { mouse-cursor: pointer; clicked => { root.pick(p.id); } }
        }
    }
}

// The Search page: query box, result tabs, filters and the results.
export component SearchView inherits Rectangle {
    background: Theme.main;
    callback close();
    VerticalLayout {
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 16px;
        spacing: 12px;
        HorizontalLayout {
            spacing: 10px;
            height: 40px;
            IconButton { icon: @image-url("../icons/back.svg"); tooltip: "Back to chat"; y: 4px; clicked => { root.close(); } }
            Rectangle {
                border-radius: 4px;
                background: Theme.sidebar;
                border-width: 1px;
                border-color: query-input.has-focus ? Theme.accent : Theme.border;
                max-width: 720px;
                FocusScope {
                    capture-key-pressed(event) => {
                        if event.text == Key.Escape {
                            root.close();
                            return accept;
                        }
                        reject
                    }
                    // Ctrl+Alt+E again puts the cursor back in the box.
                    property <int> tick: FindStore.focus-tick;
                    changed tick => { query-input.focus(); query-input.select-all(); }
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 8px;
                    Icon { source: @image-url("../icons/search.svg"); width: 16px; height: 16px; y: 12px; }
                    query-input := TextInput {
                        text <=> FindStore.query;
                        color: Theme.fg;
                        font-size: 14px * Theme.font-scale;
                        single-line: true;
                        vertical-alignment: center;
                        accessible-role: text-input;
                        accessible-label: "Search";
                        accepted => { FindStore.command("search", self.text); }
                        init => { self.focus(); }
                        changed text => {
                            if self.text == "" { FindStore.command("search", ""); }
                        }
                    }
                    if FindStore.query != "": IconButton {
                        icon: @image-url("../icons/close.svg");
                        tooltip: "Clear search";
                        size: 24px;
                        y: 8px;
                        clicked => { FindStore.query = ""; query-input.focus(); }
                    }
                }
                }
                if query-input.text == "": Text { x: 40px; text: "Search messages, files, people and chats"; color: Theme.fg-subtle; font-size: 14px * Theme.font-scale; vertical-alignment: center; }
            }
        }
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            height: 28px;
            for t in [{key: "all", label: "All"}, {key: "messages", label: "Messages"}, {key: "files", label: "Files"}, {key: "people", label: "People"}, {key: "channels", label: "Channels"}, {key: "chats", label: "Group chats"}, {key: "meetings", label: "Meetings"}]: Pill {
                label: t.label;
                active: FindStore.tab == t.key;
                clicked => { FindStore.tab = t.key; FindStore.command("search-tab", t.key); }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            height: 30px;
            Chip { label: "In"; value: FindStore.filter-in; clicked => { FindStore.filter-editor = FindStore.filter-editor == "in" ? "" : "in"; FindStore.command("editor", FindStore.filter-editor); } cleared => { FindStore.command("filter-clear", "in"); } }
            Chip { label: "Person"; value: FindStore.filter-person; clicked => { FindStore.filter-editor = FindStore.filter-editor == "person" ? "" : "person"; FindStore.command("editor", FindStore.filter-editor); } cleared => { FindStore.command("filter-clear", "person"); } }
            Chip { label: "Date"; value: FindStore.filter-date; clicked => { FindStore.filter-editor = FindStore.filter-editor == "date" ? "" : "date"; FindStore.command("editor", FindStore.filter-editor); } cleared => { FindStore.command("filter-clear", "date"); } }
        }
        if FindStore.filter-editor == "in" || FindStore.filter-editor == "person": HorizontalLayout {
            alignment: start;
            PickEditor {
                width: 360px;
                placeholder: FindStore.filter-editor == "in" ? "Search chats and channels" : "Search people";
                picks: FindStore.picks;
                query(q) => { FindStore.command("pick-query", q); }
                pick(id) => { FindStore.command("pick", id); }
            }
        }
        if FindStore.filter-editor == "date": HorizontalLayout {
            alignment: start;
            Rectangle {
                width: 220px;
                height: 4 * 40px;
                background: Theme.sidebar;
                border-radius: 4px;
                border-width: 1px;
                border-color: Theme.border;
                VerticalLayout {
                    for d in [{key: "", label: "Any time"}, {key: "24h", label: "Past 24 hours"}, {key: "7d", label: "Past week"}, {key: "30d", label: "Past month"}]: Rectangle {
                        height: 40px;
                        background: dt.has-hover ? Theme.surface-hover : transparent;
                        accessible-role: button;
                        accessible-label: d.label;
                        Text { x: 12px; text: d.label; color: Theme.fg; font-size: 13px * Theme.font-scale; vertical-alignment: center; }
                        dt := TouchArea { mouse-cursor: pointer; clicked => { FindStore.filter-editor = ""; FindStore.command("date", d.key); } }
                    }
                }
            }
        }
        Rectangle {
            vertical-stretch: 1;
            VerticalLayout {
                ListView {
                    for r in FindStore.results: HitItem {
                        data: r;
                        clicked => { FindStore.command("open", r.id); }
                    }
                }
                if FindStore.more && !FindStore.searching: Rectangle {
                    height: 44px;
                    Pill { label: FindStore.tab == "all" || FindStore.tab == "messages" ? "Show more messages" : "Show more results"; x: 12px; y: 8px; clicked => { FindStore.command("more", ""); } }
                }
            }
            if FindStore.searching && FindStore.results.length == 0: SkeletonList {
                count: 7;
                avatar: 36px;
                row-height: 64px;
                label: "Searching…";
            }
            if !FindStore.searching && FindStore.searched && FindStore.results.length == 0: VerticalLayout {
                alignment: center;
                spacing: 6px;
                Text { text: "We couldn't find any results"; color: Theme.fg; font-size: 16px * Theme.font-scale; font-weight: 600; horizontal-alignment: center; }
                Text { text: "Check your spelling or try different keywords."; color: Theme.fg-muted; font-size: 13px * Theme.font-scale; horizontal-alignment: center; }
            }
            if !FindStore.searched && !FindStore.searching: Text {
                text: "Type a word or phrase and press Enter";
                color: Theme.fg-subtle;
                font-size: 13px * Theme.font-scale;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

// Quick views: Mentions, Saved and Followed threads.
export component QuickView inherits Rectangle {
    background: Theme.main;
    callback close();
    VerticalLayout {
        Rectangle {
            height: 60px;
            background: Theme.sidebar;
            HorizontalLayout {
                padding-left: 20px;
                padding-right: 16px;
                spacing: 12px;
                Text {
                    text: FindStore.quick-kind == "mentions" ? "Mentions" : (FindStore.quick-kind == "saved" ? "Saved" : (FindStore.quick-kind == "discover" ? "Discover" : "Followed threads"));
                    overflow: elide;
                    color: Theme.fg;
                    font-size: 17px * Theme.font-scale;
                    font-weight: 700;
                    vertical-alignment: center;
                    accessible-role: text;
                }
                Rectangle { horizontal-stretch: 1; }
                IconButton { icon: @image-url("../icons/close.svg"); tooltip: "Close"; y: 14px; clicked => { root.close(); } }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
        }
        // Discover is built from the cache (Teams' own feed has no known endpoint): say so.
        if FindStore.quick-kind == "discover": Rectangle {
            background: Theme.sidebar;
            VerticalLayout {
                padding-left: 20px;
                padding-right: 16px;
                padding-top: 8px;
                padding-bottom: 8px;
                Text {
                    text: "Popular posts from your teams in the last 7 days, ranked by reactions and replies. Built from the channel messages IronTeams has stored, not from Teams' Discover feed.";
                    color: Theme.fg-muted;
                    font-size: 12px * Theme.font-scale;
                    wrap: word-wrap;
                    horizontal-alignment: Theme.start-align;
                }
            }
        }
        Rectangle {
            vertical-stretch: 1;
            VerticalLayout {
                ListView {
                    for r in FindStore.quick-rows: HitItem {
                        data: r;
                        secondary-label: FindStore.quick-kind == "followed" ? "Unfollow" : (FindStore.quick-kind == "saved" ? "Unsave" : "");
                        clicked => { FindStore.command("open", r.id); }
                        secondary => { FindStore.command(FindStore.quick-kind == "saved" ? "unsave" : "unfollow", r.id); }
                    }
                }
                if FindStore.quick-more && !FindStore.quick-loading: Rectangle {
                    height: 44px;
                    Pill { label: "Show more"; x: 12px; y: 8px; clicked => { FindStore.command("more", ""); } }
                }
            }
            if FindStore.quick-loading && FindStore.quick-rows.length == 0: SkeletonList { count: 6; avatar: 36px; row-height: 64px; label: "Loading…"; }
            if !FindStore.quick-loading && FindStore.quick-rows.length == 0: VerticalLayout {
                alignment: center;
                spacing: 6px;
                Text { text: FindStore.quick-kind == "mentions" ? "No one has mentioned you yet" : (FindStore.quick-kind == "saved" ? "No saved messages" : (FindStore.quick-kind == "discover" ? "No channel posts from the last 7 days" : "You are not following any threads")); color: Theme.fg; font-size: 16px * Theme.font-scale; font-weight: 600; horizontal-alignment: center; wrap: word-wrap; }
                if FindStore.quick-kind == "saved": Text { text: "Choose Save this message in a message's \"…\" menu."; color: Theme.fg-muted; font-size: 13px * Theme.font-scale; horizontal-alignment: center; }
                if FindStore.quick-kind == "followed": Text { text: "Follow a channel post from its \"…\" menu."; color: Theme.fg-muted; font-size: 13px * Theme.font-scale; horizontal-alignment: center; }
            }
        }
    }
}

// The bar above the conversation: Find in chat, Find in channel.
export component ChatFindBar inherits Rectangle {
    in property <bool> channel;
    height: 44px;
    background: Theme.sidebar;
    VerticalLayout {
        HorizontalLayout {
            padding-left: 20px;
            padding-right: 16px;
            spacing: 8px;
            Rectangle {
                y: 6px;
                height: 32px;
                max-width: 420px;
                border-radius: 4px;
                background: Theme.sidebar;
                border-width: 1px;
                border-color: find-input.has-focus ? Theme.accent : Theme.border;
                FocusScope {
                    capture-key-pressed(event) => {
                        if event.text == Key.Escape {
                            FindStore.command("find-close", "");
                            return accept;
                        }
                        if event.text == Key.Return {
                            FindStore.command(event.modifiers.shift ? "find-next" : "find-prev", "");
                            return accept;
                        }
                        reject
                    }
                    find-input := TextInput {
                        x: 10px;
                        width: parent.width - 20px;
                        text <=> FindStore.chat-find-query;
                        color: Theme.fg;
                        font-size: 13px * Theme.font-scale;
                        single-line: true;
                        vertical-alignment: center;
                        accessible-role: text-input;
                        accessible-label: root.channel ? "Find in channel" : "Find in chat";
                        edited => { FindStore.command("find-query", self.text); }
                        init => { self.focus(); }
                    }
                }
                if find-input.text == "": Text { x: 10px; text: root.channel ? "Find in channel" : "Find in chat"; color: Theme.fg-subtle; font-size: 13px * Theme.font-scale; vertical-alignment: center; }
            }
            Text {
                horizontal-stretch: 0;
                vertical-alignment: center;
                color: Theme.fg-muted;
                font-size: 12px * Theme.font-scale;
                text: FindStore.chat-find-query == "" ? "" : (FindStore.chat-find-count == 0 ? "No results" : FindStore.chat-find-index + " of " + FindStore.chat-find-count);
                accessible-role: text;
                accessible-label: self.text;
            }
            IconButton { icon: @image-url("../icons/chevron-down.svg"); tooltip: "Previous match"; y: 6px; size: 32px; clicked => { FindStore.command("find-prev", ""); } }
            IconButton { icon: @image-url("../icons/chevron-down.svg"); tooltip: "Next match"; y: 6px; size: 32px; clicked => { FindStore.command("find-next", ""); } }
            IconButton { icon: @image-url("../icons/close.svg"); tooltip: "Close find"; y: 6px; size: 32px; clicked => { FindStore.command("find-close", ""); } }
        }
        Rectangle { height: 1px; background: Theme.border; }
    }
    // Refocus the box when the header button is pressed again.
    changed-tick := Rectangle {
        width: 0px;
        height: 0px;
        property <int> tick: FindStore.chat-find-tick;
        changed tick => { find-input.focus(); }
    }
}

component SharedLine inherits Rectangle {
    in property <SharedRow> data;
    in property <bool> compact: false;
    callback open();
    // The "…" button or a right click: where the menu goes, in window coordinates.
    callback more(length, length);
    height: root.compact ? 48px : 44px;
    background: root.data.highlight ? Theme.accent.with-alpha(0.22) : (t.has-hover ? Theme.surface-hover : transparent);
    animate background { duration: Motion.normal; }
    // Dimmed while the server answers (a delete).
    opacity: root.data.busy != "" ? 0.55 : 1.0;
    accessible-role: list-item;
    accessible-label: root.data.name;
    accessible-description: root.data.busy != "" ? root.data.busy : root.data.shared-by + " · " + root.data.date;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: root.compact ? 12px : 48px;
        spacing: 12px;
        // A link icon, a folder icon, a coloured badge per document kind, or the extension.
        Rectangle {
            width: 28px;
            height: 28px;
            y: (parent.height - 28px) / 2;
            border-radius: 3px;
            background: root.data.kind == "link" ? #2d3a5f : (root.data.icon == "other" || root.data.icon == "" ? #5a5a5a : transparent);
            if root.data.kind == "link": Icon { source: @image-url("../icons/link.svg"); tint: #ffffff; width: 16px; height: 16px; }
            if root.data.kind != "link" && root.data.icon != "other" && root.data.icon != "": KindBadge { kind: root.data.icon; size: 28px; accessible-role: image; accessible-label: root.data.icon == "folder" ? @tr("Folder") : root.data.ext; }
            if root.data.kind != "link" && (root.data.icon == "other" || root.data.icon == ""): Text { text: root.data.ext; color: #ffffff; font-size: 8px * Theme.font-scale; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
        }
        VerticalLayout {
            alignment: center;
            Text { text: root.data.name; color: Theme.fg; font-size: 13px * Theme.font-scale; overflow: elide; }
            if root.compact: Text { text: root.data.busy != "" ? root.data.busy : root.data.shared-by + " · " + root.data.date; color: Theme.fg-subtle; font-size: 11px * Theme.font-scale; overflow: elide; }
        }
        if !root.compact: Text { width: 140px; horizontal-stretch: 0; text: root.data.busy != "" ? root.data.busy : root.data.date; color: Theme.fg-muted; font-size: 12px * Theme.font-scale; vertical-alignment: center; overflow: elide; }
        if !root.compact: Text { width: 160px; horizontal-stretch: 0; text: root.data.shared-by; color: Theme.fg-muted; font-size: 12px * Theme.font-scale; vertical-alignment: center; overflow: elide; }
    }
    t := TouchArea {
        mouse-cursor: pointer;
        enabled: root.data.busy == "";
        clicked => { root.open(); }
        pointer-event(e) => {
            if !root.compact && e.button == PointerEventButton.right && e.kind == PointerEventKind.up {
                root.more(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
    if !root.compact && root.data.busy == "": IconButton {
        x: parent.width - self.width - 12px;
        y: (parent.height - self.height) / 2;
        size: 28px;
        icon: @image-url("../icons/more.svg");
        tooltip: @tr("More actions for {}", root.data.name);
        clicked => { root.more(self.absolute-position.x, self.absolute-position.y + self.height); }
    }
}

// One entry of a small menu (the file menu, the tab menu, the call history menu).
export component FileMenuItem inherits Rectangle {
    in property <string> label;
    in property <bool> danger: false;
    callback clicked();
    height: 32px;
    border-radius: 4px;
    background: item-touch.has-hover ? Theme.surface-hover : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    Text {
        x: 10px;
        width: parent.width - 20px;
        text: root.label;
        color: root.danger ? Theme.danger : Theme.fg;
        font-size: 13px * Theme.font-scale;
        vertical-alignment: center;
        overflow: elide;
        accessible-role: none;
    }
    item-touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// A small button of the Files toolbar.
component FileToolButton inherits Rectangle {
    in property <string> label;
    in property <length> button-width: 100px;
    callback clicked();
    width: root.button-width;
    height: 30px;
    horizontal-stretch: 0;
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.border;
    background: tool-touch.has-hover ? Theme.surface-hover : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    Text { text: root.label; color: Theme.fg; font-size: 12px * Theme.font-scale; horizontal-alignment: center; vertical-alignment: center; overflow: elide; accessible-role: none; }
    tool-touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// The "Shared" tab of a chat or channel (the "Files" tab of a channel).
export component SharedView inherits Rectangle {
    // "" | row (the "…" menu of `row`) | new (the New document menu).
    property <string> menu: "";
    property <SharedRow> file;
    property <length> menu-x;
    property <length> menu-y;
    // "" | rename | delete | folder.
    property <string> prompt: "";
    property <string> prompt-text;
    background: Theme.main;

    function submit() {
        if root.prompt == "folder" {
            FindStore.command("shared-new-folder", root.prompt-text);
        } else if root.prompt == "rename" {
            FindStore.command("shared-rename", root.file.url + "\u{1f}" + root.prompt-text);
        } else if root.prompt == "delete" {
            FindStore.command("shared-delete", root.file.url);
        }
        root.prompt = "";
    }

    VerticalLayout {
        padding-left: 20px;
        padding-right: 20px;
        padding-top: 12px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 6px;
            height: 30px;
            for f in [{key: "recent", label: "Recent"}, {key: "files", label: "Files"}, {key: "links", label: "Links"}]: Pill {
                label: f.label;
                active: FindStore.shared-filter == f.key;
                clicked => { FindStore.shared-filter = f.key; FindStore.command("shared-filter", f.key); }
            }
            Rectangle { horizontal-stretch: 1; }
            Rectangle {
                width: 200px;
                height: 30px;
                horizontal-stretch: 0;
                border-radius: 4px;
                background: Theme.sidebar;
                border-width: 1px;
                border-color: kw-input.has-focus ? Theme.accent : Theme.border;
                kw-input := TextInput {
                    x: 10px;
                    width: parent.width - 20px;
                    color: Theme.fg;
                    font-size: 12px * Theme.font-scale;
                    single-line: true;
                    vertical-alignment: center;
                    accessible-role: text-input;
                    accessible-label: "Filter by keyword";
                    edited => { FindStore.command("shared-keyword", self.text); }
                }
                if kw-input.text == "": Text { x: 10px; text: "Filter by keyword"; color: Theme.fg-subtle; font-size: 12px * Theme.font-scale; vertical-alignment: center; }
            }
            if FindStore.shared-can-create: FileToolButton {
                label: @tr("New folder");
                button-width: 92px;
                clicked => { root.prompt-text = ""; root.prompt = "folder"; }
            }
            if FindStore.shared-can-create: FileToolButton {
                label: @tr("New document");
                button-width: 116px;
                clicked => {
                    root.menu-x = self.absolute-position.x - root.absolute-position.x;
                    root.menu-y = self.absolute-position.y - root.absolute-position.y + self.height;
                    root.menu = "new";
                }
            }
            Rectangle {
                width: 84px;
                height: 30px;
                horizontal-stretch: 0;
                border-radius: 4px;
                background: up.has-hover ? Theme.accent : Theme.accent-strong;
                accessible-role: button;
                accessible-label: "Upload";
                Text { text: "Upload"; color: #ffffff; font-size: 12px * Theme.font-scale; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                up := TouchArea { mouse-cursor: pointer; clicked => { FindStore.command("shared-upload", ""); } }
            }
            Rectangle {
                width: 112px;
                height: 30px;
                horizontal-stretch: 0;
                border-radius: 4px;
                border-width: 1px;
                border-color: Theme.border;
                background: od.has-hover ? Theme.surface-hover : transparent;
                accessible-role: button;
                accessible-label: "Upload from OneDrive";
                Text { text: "From OneDrive"; color: Theme.fg; font-size: 12px * Theme.font-scale; horizontal-alignment: center; vertical-alignment: center; }
                od := TouchArea { mouse-cursor: pointer; clicked => { FindStore.command("shared-onedrive", ""); } }
            }
        }
        if FindStore.shared-note != "": Text {
            height: 18px;
            text: FindStore.shared-note;
            color: FindStore.shared-note-error ? Theme.danger : Theme.fg-muted;
            font-size: 12px * Theme.font-scale;
            overflow: elide;
            vertical-alignment: center;
            accessible-role: text;
        }
        HorizontalLayout {
            padding-left: 52px;
            padding-right: 48px;
            spacing: 12px;
            height: 24px;
            Text { text: "Name"; color: Theme.fg-subtle; font-size: 11px * Theme.font-scale; font-weight: 600; vertical-alignment: center; }
            Text { width: 140px; horizontal-stretch: 0; text: "Date shared"; color: Theme.fg-subtle; font-size: 11px * Theme.font-scale; font-weight: 600; vertical-alignment: center; }
            Text { width: 160px; horizontal-stretch: 0; text: "Shared by"; color: Theme.fg-subtle; font-size: 11px * Theme.font-scale; font-weight: 600; vertical-alignment: center; }
        }
        Rectangle { height: 1px; background: Theme.border; }
        Rectangle {
            vertical-stretch: 1;
            ListView {
                for s in FindStore.shared: SharedLine {
                    data: s;
                    open => { FindStore.command("shared-open", s.url); }
                    more(ax, ay) => {
                        root.file = s;
                        root.menu-x = ax - root.absolute-position.x;
                        root.menu-y = ay - root.absolute-position.y;
                        root.menu = "row";
                    }
                }
            }
            if FindStore.shared-loading && FindStore.shared.length == 0: SkeletonList { count: 5; avatar: 32px; row-height: 56px; label: "Loading…"; }
            if !FindStore.shared-loading && FindStore.shared.length == 0: Text { text: "Nothing has been shared here yet"; color: Theme.fg-muted; font-size: 13px * Theme.font-scale; horizontal-alignment: center; vertical-alignment: center; }
        }
    }

    // The row menu and the New document menu, closed by a click anywhere else.
    if root.menu != "": Rectangle {
        width: root.width;
        height: root.height;
        TouchArea { clicked => { root.menu = ""; } }
        Rectangle {
            x: max(8px, min(root.menu-x, root.width - self.width - 8px));
            y: max(8px, min(root.menu-y, root.height - self.height - 8px));
            width: 210px;
            height: menu-col.preferred-height;
            border-radius: 6px;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 12px;
            drop-shadow-color: #00000090;
            accessible-role: groupbox;
            accessible-label: root.menu == "new" ? @tr("New document") : @tr("File actions");
            TouchArea { }
            menu-col := VerticalLayout {
                padding: 6px;
                if root.menu == "new": FileMenuItem { label: @tr("Word document"); clicked => { root.menu = ""; FindStore.command("shared-new-doc", "word"); } }
                if root.menu == "new": FileMenuItem { label: @tr("Excel workbook"); clicked => { root.menu = ""; FindStore.command("shared-new-doc", "excel"); } }
                if root.menu == "new": FileMenuItem { label: @tr("PowerPoint presentation"); clicked => { root.menu = ""; FindStore.command("shared-new-doc", "powerpoint"); } }
                if root.menu == "row": FileMenuItem { label: @tr("Open"); clicked => { root.menu = ""; FindStore.command("shared-open", root.file.url); } }
                if root.menu == "row" && root.file.editable: FileMenuItem { label: @tr("Download"); clicked => { root.menu = ""; FindStore.command("shared-download", root.file.url); } }
                if root.menu == "row": FileMenuItem { label: @tr("Copy link"); clicked => { root.menu = ""; FindStore.command("shared-copy-link", root.file.url); } }
                if root.menu == "row" && root.file.editable: FileMenuItem { label: @tr("Share"); clicked => { root.menu = ""; FindStore.command("shared-share", root.file.url); } }
                if root.menu == "row" && root.file.editable: FileMenuItem { label: @tr("Rename"); clicked => { root.menu = ""; root.prompt-text = root.file.name; root.prompt = "rename"; } }
                if root.menu == "row" && root.file.editable: FileMenuItem { label: @tr("Delete"); danger: true; clicked => { root.menu = ""; root.prompt = "delete"; } }
                if root.menu == "row" && root.file.sharepoint: FileMenuItem { label: @tr("Open in SharePoint"); clicked => { root.menu = ""; FindStore.command("shared-open", root.file.url); } }
            }
        }
    }

    // New folder, Rename and Delete ask for a name or a confirmation.
    if root.prompt != "": Rectangle {
        width: root.width;
        height: root.height;
        background: Theme.scrim;
        TouchArea { clicked => { root.prompt = ""; } }
        Rectangle {
            x: (root.width - self.width) / 2;
            y: max(8px, (root.height - self.height) / 3);
            width: 360px;
            height: prompt-col.preferred-height;
            border-radius: 8px;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 16px;
            drop-shadow-color: #000000a0;
            accessible-role: groupbox;
            accessible-label: root.prompt == "folder" ? @tr("New folder") : (root.prompt == "rename" ? @tr("Rename") : @tr("Delete"));
            TouchArea { }
            prompt-col := VerticalLayout {
                padding: 16px;
                spacing: 10px;
                Text {
                    text: root.prompt == "folder" ? @tr("New folder") : (root.prompt == "rename" ? @tr("Rename") : (root.file.ext == "DIR" ? @tr("Delete this folder?") : @tr("Delete this file?")));
                    color: Theme.fg;
                    font-size: 16px * Theme.font-scale;
                    font-weight: 600;
                    overflow: elide;
                }
                if root.prompt == "delete": Text {
                    text: root.file.ext == "DIR" ? @tr("{} and everything in it go to the site's recycle bin.", root.file.name) : @tr("{} goes to the site's recycle bin.", root.file.name);
                    color: Theme.fg-muted;
                    font-size: 12px * Theme.font-scale;
                    wrap: word-wrap;
                }
                if root.prompt != "delete": Rectangle {
                    height: 34px;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: Theme.border;
                    background: Theme.main;
                    name-input := TextInput {
                        x: 10px;
                        width: parent.width - 20px;
                        height: parent.height;
                        text <=> root.prompt-text;
                        color: Theme.fg;
                        font-size: 13px * Theme.font-scale;
                        single-line: true;
                        vertical-alignment: center;
                        accessible-role: text-input;
                        accessible-label: @tr("Name");
                        init => { self.focus(); self.select-all(); }
                        accepted => { root.submit(); }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    FileToolButton { label: @tr("Cancel"); button-width: 80px; clicked => { root.prompt = ""; } }
                    Rectangle {
                        width: 80px;
                        height: 30px;
                        border-radius: 4px;
                        background: root.prompt == "delete" ? Theme.danger : Theme.accent-strong;
                        accessible-role: button;
                        accessible-label: root.prompt == "folder" ? @tr("Create") : (root.prompt == "rename" ? @tr("Save") : @tr("Delete"));
                        accessible-action-default => { root.submit(); }
                        Text { text: root.prompt == "folder" ? @tr("Create") : (root.prompt == "rename" ? @tr("Save") : @tr("Delete")); color: #ffffff; font-size: 12px * Theme.font-scale; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; accessible-role: none; }
                        TouchArea { mouse-cursor: pointer; clicked => { root.submit(); } }
                    }
                }
            }
        }
    }
}

// The right panel "In this chat": the recent shared items and "See all".
export component DetailsPane inherits Rectangle {
    in property <string> title;
    width: 320px;
    background: Theme.sidebar;
    border-width: 1px;
    border-color: Theme.border;
    accessible-role: groupbox;
    accessible-label: "In this chat";
    VerticalLayout {
        Rectangle {
            height: 52px;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 8px;
                Text { text: "In this chat"; color: Theme.fg; font-size: 15px * Theme.font-scale; font-weight: 700; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                IconButton { icon: @image-url("../icons/close.svg"); tooltip: "Close details"; y: 10px; clicked => { FindStore.details-open = false; FindStore.command("details", "close"); } }
            }
        }
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            height: 20px;
            Text { text: root.title; color: Theme.fg-muted; font-size: 12px * Theme.font-scale; overflow: elide; }
        }
        // Teams' "In this chat" entries: find, the pinned messages (or how to pin), and the
        // composer's Loop components and apps.
        VerticalLayout {
            padding-left: 8px;
            padding-right: 8px;
            FileMenuItem {
                label: @tr("Find in chat");
                clicked => {
                    FindStore.chat-find-open = true;
                    FindStore.chat-find-tick += 1;
                    FindStore.command("find-open", "");
                }
            }
            Text { height: 24px; text: @tr("Pinned messages"); color: Theme.fg-muted; font-size: 11px * Theme.font-scale; vertical-alignment: bottom; }
            if PeopleStore.pinned.length == 0: Text {
                text: @tr("Nothing is pinned. To pin a message, open its … menu and choose Pin for everyone.");
                color: Theme.fg-subtle;
                font-size: 12px * Theme.font-scale;
                wrap: word-wrap;
                accessible-role: text;
                accessible-label: self.text;
            }
            for p in PeopleStore.pinned: FileMenuItem { label: p.sender + ": " + p.preview; clicked => { PeopleStore.command("pin-jump", p.id); } }
            FileMenuItem {
                label: @tr("Create and share content");
                clicked => {
                    ComposerApps.open = true;
                    ComposerApps.command("list", "");
                }
            }
        }
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            height: 40px;
            Text { text: "Shared"; color: Theme.fg; font-size: 13px * Theme.font-scale; font-weight: 600; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            Rectangle {
                width: see-text.preferred-width + 8px;
                horizontal-stretch: 0;
                accessible-role: button;
                accessible-label: "See all";
                see-text := Text { text: "See all"; color: Theme.accent; font-size: 12px * Theme.font-scale; vertical-alignment: center; horizontal-alignment: center; }
                TouchArea { mouse-cursor: pointer; clicked => { FindStore.chat-tab = "shared"; FindStore.command("tab", "shared"); } }
            }
        }
        for s in FindStore.recent: SharedLine {
            data: s;
            compact: true;
            open => { FindStore.command("shared-open", s.url); }
        }
        if FindStore.recent.length == 0: HorizontalLayout {
            padding-left: 16px;
            height: 32px;
            Text { text: FindStore.shared-loading ? "Loading…" : "Nothing has been shared here yet"; color: Theme.fg-subtle; font-size: 12px * Theme.font-scale; vertical-alignment: center; }
        }
        Rectangle { vertical-stretch: 1; }
    }
}

// "Add a tab": a website with a name, added to the open channel for everyone in it.
export component AddTabDialog inherits Rectangle {
    in-out property <string> tab-name;
    in-out property <string> tab-url;
    // The app picked in the list, when adding an app's tab.
    in-out property <string> app-id;
    property <bool> ready: FindStore.tab-add-kind == "app" ? root.app-id != "" && root.tab-name != "" : root.tab-name != "" && root.tab-url != "";
    init => { FindStore.tab-add-kind = "website"; }
    width: 360px;
    height: col.preferred-height;
    border-radius: 8px;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    drop-shadow-blur: 16px;
    drop-shadow-color: #000000a0;
    accessible-role: groupbox;
    accessible-label: @tr("Add a tab");
    TouchArea { }
    col := VerticalLayout {
        padding: 16px;
        spacing: 10px;
        Text { text: FindStore.tab-add-kind == "app" ? @tr("Add an app tab") : @tr("Add a website tab"); color: Theme.fg; font-size: 16px * Theme.font-scale; font-weight: 600; }
        Text { text: FindStore.tab-for-chat ? @tr("Everyone in the chat sees the tab. Adding tabs to chats is not tried yet in IronTeams, so Teams may refuse it.") : @tr("Everyone in the channel sees the tab, and Teams posts that you added it."); color: Theme.fg-muted; font-size: 12px * Theme.font-scale; wrap: word-wrap; }
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            height: 28px;
            Pill { label: @tr("Website"); active: FindStore.tab-add-kind == "website"; clicked => { FindStore.tab-add-kind = "website"; } }
            Pill { label: @tr("App"); active: FindStore.tab-add-kind == "app"; clicked => { FindStore.tab-add-kind = "app"; FindStore.command("channel-tab-apps", ""); } }
        }
        if FindStore.tab-add-kind == "app": Rectangle {
            height: 150px;
            border-radius: 4px;
            border-width: 1px;
            border-color: Theme.border;
            background: Theme.main;
            clip: true;
            ListView {
                for a in FindStore.tab-apps: Rectangle {
                    height: 30px;
                    background: root.app-id == a.id ? #3b3d6b : (app-touch.has-hover ? Theme.surface-hover : transparent);
                    accessible-role: button;
                    accessible-label: a.name;
                    accessible-checkable: true;
                    accessible-checked: root.app-id == a.id;
                    accessible-action-default => { root.app-id = a.id; if root.tab-name == "" { root.tab-name = a.name; } }
                    Text { x: 10px; width: parent.width - 20px; text: a.name; color: Theme.fg; font-size: 13px * Theme.font-scale; vertical-alignment: center; overflow: elide; accessible-role: none; }
                    app-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.app-id = a.id; if root.tab-name == "" { root.tab-name = a.name; } }
                    }
                }
            }
            if FindStore.tab-apps.length == 0: Text { text: @tr("No installed app has a channel tab."); color: Theme.fg-muted; font-size: 12px * Theme.font-scale; horizontal-alignment: center; vertical-alignment: center; }
        }
        Rectangle {
            height: 34px;
            border-radius: 4px;
            border-width: 1px;
            border-color: Theme.border;
            background: Theme.main;
            name-input := TextInput {
                x: 10px;
                width: parent.width - 20px;
                height: parent.height;
                text <=> root.tab-name;
                color: Theme.fg;
                font-size: 13px * Theme.font-scale;
                single-line: true;
                vertical-alignment: center;
                accessible-role: text-input;
                accessible-label: @tr("Tab name");
            }
            if root.tab-name == "": Text { x: 10px; text: @tr("Docs"); color: Theme.fg-subtle; font-size: 13px * Theme.font-scale; vertical-alignment: center; height: parent.height; }
        }
        if FindStore.tab-add-kind == "website": Rectangle {
            height: 34px;
            border-radius: 4px;
            border-width: 1px;
            border-color: Theme.border;
            background: Theme.main;
            url-input := TextInput {
                x: 10px;
                width: parent.width - 20px;
                height: parent.height;
                text <=> root.tab-url;
                color: Theme.fg;
                font-size: 13px * Theme.font-scale;
                single-line: true;
                vertical-alignment: center;
                accessible-role: text-input;
                accessible-label: @tr("Address");
            }
            if root.tab-url == "": Text { x: 10px; text: "https://"; color: Theme.fg-subtle; font-size: 13px * Theme.font-scale; vertical-alignment: center; height: parent.height; }
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: end;
            Rectangle {
                width: 80px;
                height: 32px;
                border-radius: 4px;
                background: cancel-touch.has-hover ? Theme.surface-hover : transparent;
                border-width: 1px;
                border-color: Theme.border;
                accessible-role: button;
                accessible-label: @tr("Cancel");
                Text { text: @tr("Cancel"); color: Theme.fg; font-size: 13px * Theme.font-scale; horizontal-alignment: center; vertical-alignment: center; }
                cancel-touch := TouchArea { mouse-cursor: pointer; clicked => { FindStore.tab-add-open = false; } }
            }
            Rectangle {
                width: 80px;
                height: 32px;
                border-radius: 4px;
                background: root.ready ? Theme.accent-strong : Theme.surface-hover;
                accessible-role: button;
                accessible-label: @tr("Add");
                accessible-enabled: root.ready;
                Text { text: @tr("Add"); color: #ffffff; font-size: 13px * Theme.font-scale; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                add-touch := TouchArea {
                    mouse-cursor: pointer;
                    enabled: root.ready;
                    clicked => {
                        if FindStore.tab-add-kind == "app" {
                            FindStore.command(FindStore.tab-for-chat ? "chat-tab-add-app" : "channel-tab-add-app", root.app-id + "\u{1f}" + root.tab-name);
                        } else {
                            FindStore.command(FindStore.tab-for-chat ? "chat-tab-add" : "channel-tab-add", root.tab-name + "\u{1f}" + root.tab-url);
                        }
                        FindStore.tab-add-open = false;
                    }
                }
            }
        }
    }
}

// A channel's tab in the header (beyond Posts and Files): a click opens it, the chevron or a
// right click opens its menu (Rename, Remove).
export component ChannelTabButton inherits Rectangle {
    in property <ChannelTabItem> tab;
    width: min(ct-label.preferred-width, 180px) + 22px;
    accessible-role: AccessibleRole.tab;
    accessible-label: root.tab.name;
    function open-menu() {
        FindStore.tab-menu-id = root.tab.id;
        FindStore.tab-menu-name = root.tab.name;
        FindStore.tab-menu-x = root.absolute-position.x;
        FindStore.tab-menu-y = root.absolute-position.y + root.height;
        FindStore.tab-dialog = "";
    }
    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            spacing: 4px;
            ct-label := Text {
                text: root.tab.name;
                color: ct-open.has-hover ? Theme.fg : Theme.fg-muted;
                font-size: 14px * Theme.font-scale;
                overflow: elide;
                vertical-alignment: center;
            }
            Icon { source: @image-url("../icons/chevron-down.svg"); width: 14px; height: 14px; y: 5px; tint: Theme.fg-subtle; }
        }
        Rectangle { height: 3px; }
    }
    ct-open := TouchArea {
        x: 0px;
        width: parent.width - 20px;
        mouse-cursor: pointer;
        clicked => { FindStore.command("channel-tab-open", root.tab.url); }
        pointer-event(e) => {
            if e.button == PointerEventButton.right && e.kind == PointerEventKind.up {
                root.open-menu();
            }
        }
    }
    TouchArea {
        x: parent.width - 20px;
        width: 20px;
        mouse-cursor: pointer;
        accessible-role: button;
        accessible-label: @tr("Tab options for {}", root.tab.name);
        clicked => { root.open-menu(); }
    }
}

// The menu of a channel tab and the Rename and Remove dialogs it leads to. Shown while
// `FindStore.tab-menu-id` is set; fills its parent.
export component ChannelTabOverlays inherits Rectangle {
    in-out property <string> new-name: FindStore.tab-menu-name;
    function close() {
        FindStore.tab-menu-id = "";
        FindStore.tab-dialog = "";
    }
    if FindStore.tab-dialog == "": Rectangle {
        width: root.width;
        height: root.height;
        TouchArea { clicked => { root.close(); } }
        Rectangle {
            x: max(8px, min(FindStore.tab-menu-x, root.width - self.width - 8px));
            y: max(8px, min(FindStore.tab-menu-y, root.height - self.height - 8px));
            width: 190px;
            height: tab-menu-col.preferred-height;
            border-radius: 6px;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 12px;
            drop-shadow-color: #00000090;
            accessible-role: groupbox;
            accessible-label: @tr("Tab actions");
            TouchArea { }
            tab-menu-col := VerticalLayout {
                padding: 6px;
                FileMenuItem { label: @tr("Rename tab"); clicked => { FindStore.tab-dialog = "rename"; } }
                FileMenuItem { label: @tr("Remove tab"); danger: true; clicked => { FindStore.tab-dialog = "remove"; } }
            }
        }
    }
    if FindStore.tab-dialog != "": Rectangle {
        width: root.width;
        height: root.height;
        background: Theme.scrim;
        TouchArea { clicked => { root.close(); } }
        Rectangle {
            x: (root.width - self.width) / 2;
            y: max(8px, (root.height - self.height) / 3);
            width: 360px;
            height: tab-dialog-col.preferred-height;
            border-radius: 8px;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 16px;
            drop-shadow-color: #000000a0;
            accessible-role: groupbox;
            accessible-label: FindStore.tab-dialog == "rename" ? @tr("Rename tab") : @tr("Remove tab");
            TouchArea { }
            tab-dialog-col := VerticalLayout {
                padding: 16px;
                spacing: 10px;
                Text { text: FindStore.tab-dialog == "rename" ? @tr("Rename tab") : @tr("Remove tab?"); color: Theme.fg; font-size: 16px * Theme.font-scale; font-weight: 600; }
                if FindStore.tab-dialog == "remove": Text {
                    text: @tr("{} is removed for everyone in the channel. Its content stays where it is.", FindStore.tab-menu-name);
                    color: Theme.fg-muted;
                    font-size: 12px * Theme.font-scale;
                    wrap: word-wrap;
                }
                if FindStore.tab-dialog == "rename": Rectangle {
                    height: 34px;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: Theme.border;
                    background: Theme.main;
                    tab-name-input := TextInput {
                        x: 10px;
                        width: parent.width - 20px;
                        height: parent.height;
                        text <=> root.new-name;
                        color: Theme.fg;
                        font-size: 13px * Theme.font-scale;
                        single-line: true;
                        vertical-alignment: center;
                        accessible-role: text-input;
                        accessible-label: @tr("Tab name");
                        init => { self.focus(); self.select-all(); }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    FileToolButton { label: @tr("Cancel"); button-width: 80px; clicked => { root.close(); } }
                    Rectangle {
                        width: 80px;
                        height: 30px;
                        border-radius: 4px;
                        background: FindStore.tab-dialog == "remove" ? Theme.danger : Theme.accent-strong;
                        accessible-role: button;
                        accessible-label: FindStore.tab-dialog == "rename" ? @tr("Save") : @tr("Remove");
                        Text { text: FindStore.tab-dialog == "rename" ? @tr("Save") : @tr("Remove"); color: #ffffff; font-size: 12px * Theme.font-scale; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; accessible-role: none; }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                if FindStore.tab-dialog == "rename" {
                                    FindStore.command("channel-tab-rename", FindStore.tab-menu-id + "\u{1f}" + root.new-name);
                                } else {
                                    FindStore.command("channel-tab-remove", FindStore.tab-menu-id);
                                }
                                root.close();
                            }
                        }
                    }
                }
            }
        }
    }
}
