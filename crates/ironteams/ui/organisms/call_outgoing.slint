// 1:1 calls (plans/calls.md K2.1): the Call and Video buttons of a 1:1 chat's header, the Call
// button of the profile card, and the ringing screen ("Calling <name>…" with Cancel). When the
// call connects the in-call window (the call manager's) takes over and this screen closes.
import { Theme } from "../tokens/theme.slint";
import { Icon } from "../atoms/widgets.slint";
import { Avatar } from "../atoms/avatar.slint";
import { DirectCallStore, CallRoundButton } from "call_incoming.slint";
import { CallStore } from "../stores/call_store.slint";
import { Tokens } from "../tokens/types.slint";
import { Fixed } from "../tokens/fixed.slint";

component HeaderCallButton inherits Rectangle {
    in property <Tokens> c: Theme.call;
    in property <image> icon;
    in property <string> label;
    in property <bool> enabled: true;
    in property <string> note;
    in property <length> icon-size: 19px;
    callback clicked();
    width: 32px;
    height: 32px;
    border-radius: 4px;
    background: touch.has-hover && root.enabled ? root.c.surface-hover : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-description: root.note;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    Icon {
        c: root.c;
        source: root.icon;
        width: root.icon-size;
        height: root.icon-size;
        tint: !root.enabled ? root.c.fg-subtle : touch.has-hover ? root.c.accent : root.c.fg-muted;
        opacity: root.enabled ? 1.0 : 0.5;
    }
    touch := TouchArea {
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => { if root.enabled { root.clicked(); } }
    }
    if touch.has-hover: Rectangle {
        y: parent.height + 4px;
        x: (parent.width - self.width) / 2 - 60px;
        width: tip.preferred-width + 16px;
        height: 24px;
        border-radius: 4px;
        background: root.c.surface;
        border-width: 1px;
        border-color: root.c.border;
        tip := Text { text: root.note != "" ? root.note : root.label; color: root.c.fg; font-size: 12px * Theme.font-scale; vertical-alignment: center; }
    }
}

// One row of the call button's dropdown.
component CallChoice inherits Rectangle {
    in property <Tokens> c: Theme.call;
    in property <image> icon;
    in property <string> label;
    in property <bool> enabled: true;
    in property <string> note;
    in property <string> keys;
    callback clicked();
    height: 36px;
    border-radius: 4px;
    background: touch.has-hover && root.enabled ? root.c.surface-hover : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-description: root.note;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        Icon { c: root.c; source: root.icon; width: 16px; height: 16px; y: 10px; tint: root.enabled ? root.c.fg-muted : root.c.fg-subtle; }
        VerticalLayout {
            alignment: center;
            Text { text: root.label; color: root.enabled ? root.c.fg : root.c.fg-subtle; font-size: 13px * Theme.font-scale; accessible-role: none; }
            if root.note != "": Text { text: root.note; color: root.c.fg-subtle; font-size: 11px * Theme.font-scale; accessible-role: none; }
        }
        // The shortcut (Alt+Shift+A / Alt+Shift+V).
        if root.keys != "": Text { text: root.keys; color: root.c.fg-subtle; font-size: 11px * Theme.font-scale; vertical-alignment: center; horizontal-stretch: 0; accessible-role: none; }
    }
    touch := TouchArea {
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => { if root.enabled { root.clicked(); } }
    }
}

// The call button of a 1:1 chat's header, as in Teams: Audio call, and a chevron for the choice
// of Video call (the camera on from the start) or Audio call. Takes no room for any other chat.
export component CallHeaderButtons inherits Rectangle {
    in property <Tokens> c: Theme.content;
    in property <string> chat-id;
    property <bool> direct: DirectCallStore.is-direct(root.chat-id);
    width: root.direct ? 52px : 0px;
    horizontal-stretch: 0;
    if root.direct: HorizontalLayout {
        spacing: 0px;
        HeaderCallButton {
            c: root.c;
            icon: @image-url("../icons/call-direct.svg");
            label: "Audio call";
            clicked => { DirectCallStore.command("dial", root.chat-id); }
        }
        HeaderCallButton {
            c: root.c;
            width: 20px;
            icon: @image-url("../icons/chevron-down.svg");
            icon-size: 12px;
            label: "Call options";
            clicked => { call-popup.show(); }
        }
    }
    call-popup := PopupWindow {
        x: root.width - 250px;
        y: root.height + 4px;
        width: 250px;
        height: 88px;
        close-policy: close-on-click-outside;
        Rectangle {
            background: root.c.surface;
            border-radius: 6px;
            border-width: 1px;
            border-color: root.c.border;
            VerticalLayout {
                padding: 4px;
                CallChoice {
                    c: root.c;
                    icon: @image-url("../icons/video.svg");
                    label: "Video call";
                    // With the camera switched off (IRONTEAMS_CAMERA=0) it calls with audio.
                    note: CallStore.camera-available ? "" : "Video isn't available: calls with audio";
                    keys: "Alt+Shift+V";
                    clicked => {
                        DirectCallStore.command("dial-video", root.chat-id);
                        call-popup.close();
                    }
                }
                CallChoice {
                    c: root.c;
                    icon: @image-url("../icons/call-direct.svg");
                    label: "Audio call";
                    keys: "Alt+Shift+A";
                    clicked => {
                        DirectCallStore.command("dial", root.chat-id);
                        call-popup.close();
                    }
                }
            }
        }
    }
}

// "Call" next to Chat and Email on the profile card.
export component CallPersonButton inherits Rectangle {
    in property <Tokens> c: Theme.call;
    in property <string> mri;
    horizontal-stretch: 1;
    border-radius: 4px;
    background: touch.has-hover ? root.c.surface-hover : root.c.surface-hover;
    accessible-role: button;
    accessible-label: "Call";
    accessible-action-default => { DirectCallStore.command("dial-person", root.mri); }
    Text { text: "Call"; color: root.c.fg; font-size: 13px * Theme.font-scale; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
    touch := TouchArea { mouse-cursor: pointer; clicked => { DirectCallStore.command("dial-person", root.mri); } }
}

// The ringing screen of an outgoing call: covers the window until the call connects or ends.
export component CallOutgoing inherits Rectangle {
    in property <Tokens> c: Theme.call;
    background: Fixed.black-c0;
    accessible-role: groupbox;
    accessible-label: "Outgoing call to " + DirectCallStore.outgoing-name;

    // The window below takes no clicks while the call rings.
    TouchArea { }

    VerticalLayout {
        alignment: center;
        spacing: 18px;
        HorizontalLayout {
            alignment: center;
            Avatar {
                c: root.c;
                initials: DirectCallStore.outgoing-initials;
                tone: DirectCallStore.outgoing-color;
                img: DirectCallStore.outgoing-avatar;
                has-img: DirectCallStore.outgoing-has-avatar;
                size: 96px;
            }
        }
        Text {
            text: DirectCallStore.outgoing-name;
            color: Fixed.white;
            font-size: 22px * Theme.font-scale;
            font-weight: 700;
            horizontal-alignment: center;
            wrap: word-wrap;
            accessible-role: text;
            accessible-label: self.text;
        }
        Text {
            text: DirectCallStore.outgoing-status;
            color: Fixed.call-subtle-fg;
            font-size: 14px * Theme.font-scale;
            horizontal-alignment: center;
            wrap: word-wrap;
            accessible-role: text;
            accessible-label: self.text;
        }
        HorizontalLayout {
            alignment: center;
            padding-top: 12px;
            if !DirectCallStore.outgoing-over: CallRoundButton {
                c: root.c;
                icon: @image-url("../icons/call-direct-end.svg");
                label: "Cancel";
                tone: root.c.danger;
                clicked => { DirectCallStore.command("cancel", ""); }
            }
            if DirectCallStore.outgoing-over: CallRoundButton {
                c: root.c;
                icon: @image-url("../icons/close.svg");
                label: "Close";
                tone: Fixed.call-neutral;
                clicked => { DirectCallStore.command("close", ""); }
            }
        }
    }
}
