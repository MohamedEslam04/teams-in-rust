// The pre-join preview: how we will look (the camera through the effects) while the camera switch
// is on, else our avatar; and the Video effects button over its corner.
import { Theme } from "../tokens/theme.slint";
import { Icon } from "../atoms/widgets.slint";
import { Avatar } from "../atoms/avatar.slint";
import { CallStore } from "../stores/call_store.slint";
import { VideoFxStore } from "../stores/video_fx_store.slint";
import { Tokens } from "../tokens/types.slint";
import { Fixed } from "../tokens/fixed.slint";

// Opens or closes the effects panel.
export component VideoEffectsButton inherits Rectangle {
    in property <Tokens> c: Theme.call;
    width: row.preferred-width + 20px;
    height: 32px;
    border-radius: 16px;
    background: touch.has-hover || VideoFxStore.open ? Fixed.black-cc : Fixed.black-99;
    accessible-role: button;
    accessible-label: "Video effects";
    accessible-checkable: true;
    accessible-checked: VideoFxStore.open;
    accessible-action-default => { VideoFxStore.open = !VideoFxStore.open; }
    row := HorizontalLayout {
        x: 10px;
        spacing: 6px;
        alignment: center;
        Icon {
            c: root.c;
            source: @image-url("../icons/effects.svg");
            tint: Fixed.white;
            width: 16px;
            height: 16px;
            y: 8px;
        }
        Text {
            text: "Video effects";
            color: Fixed.white;
            font-size: 12px * Theme.font-scale;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { VideoFxStore.open = !VideoFxStore.open; }
    }
}

export component VideoPreview inherits Rectangle {
    in property <Tokens> c: Theme.call;
    // Also while only the Video effects panel's Preview runs (the camera is not sent).
    property <bool> live: VideoFxStore.has-preview;
    height: 220px;
    border-radius: Theme.radius;
    clip: true;
    background: root.c.rail;
    if root.live: Image {
        width: root.width;
        height: root.height;
        source: VideoFxStore.preview;
        image-fit: cover;
        accessible-role: image;
        accessible-label: "Your camera preview";
    }
    if !root.live: VerticalLayout {
        alignment: center;
        spacing: 10px;
        padding-left: 16px;
        padding-right: 16px;
        HorizontalLayout {
            alignment: center;
            Avatar { c: root.c; initials: CallStore.my-initials; size: 72px; }
        }
        Text {
            text: !CallStore.prejoin-camera ? "Your camera is off"
                : VideoFxStore.preview-status != "" ? VideoFxStore.preview-status
                : "Your camera turns on when you join";
            color: root.c.fg-subtle;
            font-size: 12px * Theme.font-scale;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
    if CallStore.camera-available: VideoEffectsButton {
        c: root.c;
        x: root.width - self.width - 10px;
        y: root.height - self.height - 10px;
    }
}
