// The post-call quality survey (Teams' "How was the call quality?"), a centred card over the
// call-ended screen. Shown when `CallStore.feedback-open` is set (src/ui/call.rs): after a call or
// meeting that lasted a while, as the Settings choice says. Two big choices, Had issues and Good;
// "Had issues" opens the categories (Audio, Video, Screenshare) with a list of issues to tick.
// Send feedback needs a rating. `sent` carries the answer as `good` or `issues` followed by one
// `category=issue` line per box ticked (backend/call_feedback.rs reads it).
import { Theme } from "../tokens/theme.slint";
import { Icon } from "../atoms/widgets.slint";
import { CallStore } from "../stores/call_store.slint";

// A big rating choice: an emoji over its label.
component RatingChoice inherits Rectangle {
    in property <string> emoji;
    in property <string> label;
    in property <bool> picked;
    callback clicked();
    height: 84px;
    border-radius: 8px;
    border-width: root.picked ? 2px : 1px;
    border-color: root.picked ? Theme.accent : Theme.border;
    background: root.picked ? Theme.selected : touch.has-hover ? Theme.surface-hover : Theme.surface;
    accessible-role: button;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.picked;
    accessible-action-default => { root.clicked(); }
    VerticalLayout {
        alignment: center;
        spacing: 4px;
        Text {
            text: root.emoji;
            font-size: 28px * Theme.font-scale;
            horizontal-alignment: center;
        }
        Text {
            text: root.label;
            color: Theme.fg;
            font-size: 14px * Theme.font-scale;
            font-weight: 600;
            horizontal-alignment: center;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// One of Audio, Video and Screenshare.
component CategoryTab inherits Rectangle {
    in property <string> label;
    in property <bool> picked;
    callback clicked();
    height: 32px;
    width: txt.preferred-width + 24px;
    background: touch.has-hover && !root.picked ? Theme.surface-hover : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.picked;
    accessible-action-default => { root.clicked(); }
    txt := Text {
        text: root.label;
        color: root.picked ? Theme.fg : Theme.fg-muted;
        font-size: 13px * Theme.font-scale;
        font-weight: root.picked ? 600 : 400;
    }
    Rectangle {
        y: parent.height - self.height;
        height: 2px;
        background: root.picked ? Theme.accent : transparent;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// An issue with a tick box.
component IssueRow inherits Rectangle {
    in property <string> text;
    in property <bool> on;
    callback toggled();
    height: 32px;
    border-radius: 4px;
    background: touch.has-hover ? Theme.surface-hover : transparent;
    accessible-role: checkbox;
    accessible-label: root.text;
    accessible-checkable: true;
    accessible-checked: root.on;
    accessible-action-default => { root.toggled(); }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 10px;
        Rectangle {
            width: 18px;
            height: 18px;
            y: (parent.height - self.height) / 2;
            border-radius: 3px;
            border-width: 1px;
            border-color: root.on ? Theme.accent-strong : Theme.fg-subtle;
            background: root.on ? Theme.accent-strong : transparent;
            if root.on: Icon {
                source: @image-url("../icons/check.svg");
                tint: #ffffff;
                width: 14px;
                height: 14px;
            }
        }
        Text {
            text: root.text;
            color: Theme.fg;
            font-size: 13px * Theme.font-scale;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
}

// Dismiss and Send feedback. A disabled one is drawn faded and does nothing.
component FeedbackButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary;
    in property <bool> enabled: true;
    callback clicked();
    height: 34px;
    width: max(88px, txt.preferred-width + 28px);
    border-radius: 4px;
    border-width: root.primary ? 0px : 1px;
    border-color: Theme.border;
    background: root.primary ? (touch.has-hover && root.enabled ? Theme.accent : Theme.accent-strong)
        : touch.has-hover ? Theme.surface-hover : Theme.surface;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    txt := Text {
        text: root.label;
        color: root.primary ? #ffffff : Theme.fg;
        font-size: 13px * Theme.font-scale;
        font-weight: 600;
        opacity: root.enabled ? 1 : 0.45;
    }
    touch := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { if root.enabled { root.clicked(); } }
    }
}

export component CallFeedback inherits Rectangle {
    // Send feedback, with the answer (see the top of the file).
    callback sent(string);
    callback dismissed();
    // "" until picked | good | issues.
    in-out property <string> rating;
    // The category whose issues are listed: audio | video | screenshare.
    in-out property <string> category: "audio";
    // Every issue, grouped by category, and which boxes are ticked (same order).
    property <[{category: string, text: string}]> all: [
        {category: "audio", text: "I couldn't hear any sound"},
        {category: "audio", text: "Other people couldn't hear me"},
        {category: "audio", text: "I heard echo or noise"},
        {category: "audio", text: "Volume was low"},
        {category: "audio", text: "The sound kept cutting out"},
        {category: "audio", text: "Speech was distorted"},
        {category: "video", text: "I couldn't see any video"},
        {category: "video", text: "Other people couldn't see my video"},
        {category: "video", text: "Video was blurry"},
        {category: "video", text: "Video kept freezing"},
        {category: "video", text: "Video and audio were out of sync"},
        {category: "screenshare", text: "I couldn't see any presented content"},
        {category: "screenshare", text: "The presentation stopped unexpectedly"},
        {category: "screenshare", text: "The image quality of the presented content was poor"},
        {category: "screenshare", text: "There was a long delay in the presented content"},
        {category: "screenshare", text: "The presenter's content kept freezing"}
    ];
    in-out property <[bool]> sel: [false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false];
    // The ticked boxes, one `category=issue` line each, each led by a newline.
    property <string> picked:
        (root.sel[0] ? "\n" + root.all[0].category + "=" + root.all[0].text : "") +
        (root.sel[1] ? "\n" + root.all[1].category + "=" + root.all[1].text : "") +
        (root.sel[2] ? "\n" + root.all[2].category + "=" + root.all[2].text : "") +
        (root.sel[3] ? "\n" + root.all[3].category + "=" + root.all[3].text : "") +
        (root.sel[4] ? "\n" + root.all[4].category + "=" + root.all[4].text : "") +
        (root.sel[5] ? "\n" + root.all[5].category + "=" + root.all[5].text : "") +
        (root.sel[6] ? "\n" + root.all[6].category + "=" + root.all[6].text : "") +
        (root.sel[7] ? "\n" + root.all[7].category + "=" + root.all[7].text : "") +
        (root.sel[8] ? "\n" + root.all[8].category + "=" + root.all[8].text : "") +
        (root.sel[9] ? "\n" + root.all[9].category + "=" + root.all[9].text : "") +
        (root.sel[10] ? "\n" + root.all[10].category + "=" + root.all[10].text : "") +
        (root.sel[11] ? "\n" + root.all[11].category + "=" + root.all[11].text : "") +
        (root.sel[12] ? "\n" + root.all[12].category + "=" + root.all[12].text : "") +
        (root.sel[13] ? "\n" + root.all[13].category + "=" + root.all[13].text : "") +
        (root.sel[14] ? "\n" + root.all[14].category + "=" + root.all[14].text : "") +
        (root.sel[15] ? "\n" + root.all[15].category + "=" + root.all[15].text : "");

    background: #000000a0;
    // Nothing behind the card takes clicks.
    TouchArea { }
    card := Rectangle {
        width: min(460px, parent.width - 32px);
        height: content.preferred-height + 40px;
        x: (parent.width - self.width) / 2;
        y: max(8px, (parent.height - self.height) / 2);
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.border;
        background: Theme.main;
        drop-shadow-blur: 16px;
        drop-shadow-color: #00000080;
        content := VerticalLayout {
            padding: 20px;
            spacing: 14px;
            Text {
                text: "How was the call quality?";
                color: Theme.fg;
                font-size: 18px * Theme.font-scale;
                font-weight: 600;
                horizontal-alignment: center;
            }
            HorizontalLayout {
                spacing: 12px;
                RatingChoice {
                    emoji: "👎";
                    label: "Had issues";
                    picked: root.rating == "issues";
                    clicked => { root.rating = "issues"; }
                }
                RatingChoice {
                    emoji: "👍";
                    label: "Good";
                    picked: root.rating == "good";
                    clicked => { root.rating = "good"; }
                }
            }
            if root.rating == "issues": VerticalLayout {
                spacing: 6px;
                HorizontalLayout {
                    alignment: start;
                    CategoryTab {
                        label: "Audio";
                        picked: root.category == "audio";
                        clicked => { root.category = "audio"; }
                    }
                    CategoryTab {
                        label: "Video";
                        picked: root.category == "video";
                        clicked => { root.category = "video"; }
                    }
                    CategoryTab {
                        label: "Screenshare";
                        picked: root.category == "screenshare";
                        clicked => { root.category = "screenshare"; }
                    }
                }
                // As tall as the longest list (Audio, six issues), so the centred card stays put
                // when the tabs switch.
                VerticalLayout {
                    height: 6 * 32px;
                    alignment: start;
                    for issue[i] in root.all: VerticalLayout {
                        if issue.category == root.category: IssueRow {
                            text: issue.text;
                            on: root.sel[i];
                            toggled => { root.sel[i] = !root.sel[i]; }
                        }
                    }
                }
            }
            Text {
                text: "Your answer is kept on this device only. IronTeams doesn't send it to Microsoft.";
                color: Theme.fg-subtle;
                font-size: 11px * Theme.font-scale;
                wrap: word-wrap;
            }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                FeedbackButton {
                    label: "Dismiss";
                    clicked => { root.dismissed(); }
                }
                FeedbackButton {
                    label: "Send feedback";
                    primary: true;
                    enabled: root.rating != "";
                    clicked => { root.sent(root.rating == "good" ? "good" : "issues" + root.picked); }
                }
            }
        }
    }
}
