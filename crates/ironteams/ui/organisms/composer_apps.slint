// Apps in the composer (plan S3.6): the "+" button and the picker it opens. The picker lists the
// open chat's apps that add commands to the message box. A search command takes a query and
// lists result cards to pick from; an action command opens its form. The data comes from
// `src/backend/composer_apps.rs` through the `ComposerApps` global.
import { Theme } from "../tokens/theme.slint";
import { Icon, IconButton } from "../atoms/widgets.slint";
import { Button, ButtonVariant } from "../atoms/button.slint";
import { SearchBox } from "../atoms/search_box.slint";

// One line of the command list: an app's name (header) or one of its commands.
export struct CaCommand {
    key: string,
    app: string,
    title: string,
    description: string,
    action: bool,
    header: bool,
}

// One result card of a search, as a preview.
export struct CaResult {
    title: string,
    subtitle: string,
    thumb: image,
    has-thumb: bool,
    letter: string,
}

// A card waiting in the message.
export struct CaCard {
    app: string,
    title: string,
    subtitle: string,
}

export global ComposerApps {
    in-out property <bool> open;
    in property <[CaCommand]> commands;
    // The open search command's key; empty while the command list shows.
    in property <string> command-key;
    in property <string> command-title;
    in property <string> app-name;
    in property <string> placeholder: "Search";
    in property <bool> loading;
    in property <bool> searching;
    in property <string> status;
    in property <[CaResult]> results;
    in property <[CaCard]> cards;
    in property <string> note;
    in-out property <string> query;
    callback command(string, string);
}

// The "+" in the composer's button row.
export component ComposerAppsButton inherits IconButton {
    icon: @image-url("../icons/plus.svg");
    tooltip: "Actions and apps";
    clicked => {
        ComposerApps.open = true;
        ComposerApps.command("list", "");
    }
}

component CaRow inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    in property <string> hint;
    in property <image> thumb;
    in property <bool> has-thumb;
    in property <string> letter;
    in property <bool> tile: false;
    callback clicked();
    height: root.tile ? 52px : 46px;
    border-radius: 4px;
    background: touch.has-hover ? Theme.surface-hover : transparent;
    accessible-role: button;
    accessible-label: root.title;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: root.tile ? 6px : 0px;
        padding-bottom: root.tile ? 6px : 0px;
        spacing: 10px;
        if root.tile: Rectangle {
            width: 40px;
            height: 40px;
            border-radius: 4px;
            clip: true;
            background: root.has-thumb ? #ffffff10 : Theme.accent-strong;
            if !root.has-thumb: Text {
                text: root.letter;
                color: #ffffff;
                font-size: 16px * Theme.font-scale;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            if root.has-thumb: Image {
                source: root.thumb;
                width: parent.width;
                height: parent.height;
                image-fit: cover;
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text { text: root.title; color: Theme.fg; font-size: 13px * Theme.font-scale; overflow: elide; }
            Text { text: root.detail; color: Theme.fg-muted; font-size: 11px * Theme.font-scale; overflow: elide; }
        }
        if root.hint != "": Text { text: root.hint; color: Theme.fg-subtle; font-size: 11px * Theme.font-scale; vertical-alignment: center; }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// The picker. It sits over the window; a click outside closes it. In a chat its list starts with
// "Schedule a meeting" and "Meet now", as in Teams.
export component ComposerAppsOverlay inherits Rectangle {
    in property <bool> meetings;
    callback schedule-meeting();
    callback meet-now();
    if ComposerApps.open: Rectangle {
        width: parent.width;
        height: parent.height;
        TouchArea {
            pointer-event(e) => {
                if e.kind == PointerEventKind.down {
                    ComposerApps.open = false;
                    ComposerApps.command("close", "");
                }
            }
        }
        panel := Rectangle {
            width: min(420px, parent.width - 32px);
            height: min(parent.height - 160px, 520px);
            x: parent.width - self.width - 24px;
            y: parent.height - self.height - 120px;
            border-radius: 8px;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 16px;
            drop-shadow-color: #000000a0;
            TouchArea { }
            VerticalLayout {
                padding: 12px;
                spacing: 8px;
                HorizontalLayout {
                    height: 32px;
                    spacing: 8px;
                    if ComposerApps.command-key != "": Button { variant: ButtonVariant.kit;
                        label: "Back";
                        clicked => { ComposerApps.command("back", ""); }
                    }
                    Text {
                        text: ComposerApps.command-key == "" ? "Apps for this chat" : ComposerApps.app-name + " · " + ComposerApps.command-title;
                        color: Theme.fg;
                        font-size: 15px * Theme.font-scale;
                        font-weight: 700;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    IconButton {
                        icon: @image-url("../icons/close.svg");
                        size: 28px;
                        tooltip: "Close apps";
                        clicked => {
                            ComposerApps.open = false;
                            ComposerApps.command("close", "");
                        }
                    }
                }

                // The command list.
                if ComposerApps.command-key == "": VerticalLayout {
                    spacing: 4px;
                    vertical-stretch: 1;
                    if ComposerApps.loading: Text { text: "Looking for the apps in this chat…"; color: Theme.fg-subtle; font-size: 13px * Theme.font-scale; }
                    if !ComposerApps.loading && ComposerApps.status != "": Text { text: ComposerApps.status; color: Theme.fg-subtle; font-size: 13px * Theme.font-scale; wrap: word-wrap; }
                    Flickable {
                        vertical-stretch: 1;
                        content-height: cmds.preferred-height;
                        cmds := VerticalLayout {
                            alignment: start;
                            if root.meetings: Text {
                                text: "Meetings";
                                color: Theme.fg-muted;
                                font-size: 11px * Theme.font-scale;
                                font-weight: 600;
                                height: 28px;
                                vertical-alignment: bottom;
                            }
                            if root.meetings: CaRow {
                                title: "Schedule a meeting";
                                detail: "A Teams meeting with the people in this chat";
                                clicked => {
                                    ComposerApps.open = false;
                                    ComposerApps.command("close", "");
                                    root.schedule-meeting();
                                }
                            }
                            if root.meetings: CaRow {
                                title: "Meet now";
                                detail: "Start a meeting right away and get its link";
                                clicked => {
                                    ComposerApps.open = false;
                                    ComposerApps.command("close", "");
                                    root.meet-now();
                                }
                            }
                            for c in ComposerApps.commands: VerticalLayout {
                                if c.header: Text {
                                    text: c.app;
                                    color: Theme.fg-muted;
                                    font-size: 11px * Theme.font-scale;
                                    font-weight: 600;
                                    height: 28px;
                                    vertical-alignment: bottom;
                                }
                                if !c.header: CaRow {
                                    title: c.title;
                                    detail: c.description;
                                    hint: c.action ? "Opens a form" : "Search";
                                    clicked => {
                                        ComposerApps.query = "";
                                        ComposerApps.command(c.action ? "action" : "search", c.key);
                                    }
                                }
                            }
                        }
                    }
                }

                // A search command: the query box and its results.
                if ComposerApps.command-key != "": VerticalLayout {
                    spacing: 8px;
                    vertical-stretch: 1;
                    SearchBox {
                        placeholder: ComposerApps.placeholder;
                        label: "Search text";
                        text <=> ComposerApps.query;
                        edited(q) => { ComposerApps.command("query", q); }
                        init => { self.focus-input(); }
                    }
                    if ComposerApps.searching: Text { text: "Searching…"; color: Theme.fg-subtle; font-size: 13px * Theme.font-scale; }
                    if !ComposerApps.searching && ComposerApps.status != "": Text { text: ComposerApps.status; color: Theme.fg-subtle; font-size: 13px * Theme.font-scale; wrap: word-wrap; }
                    Flickable {
                        vertical-stretch: 1;
                        content-height: found.preferred-height;
                        found := VerticalLayout {
                            alignment: start;
                            for r[i] in ComposerApps.results: CaRow {
                                tile: true;
                                title: r.title;
                                detail: r.subtitle;
                                thumb: r.thumb;
                                has-thumb: r.has-thumb;
                                letter: r.letter;
                                clicked => { ComposerApps.command("choose", "" + i); }
                            }
                        }
                    }
                }

                if ComposerApps.note != "": Text { text: ComposerApps.note; color: Theme.accent; font-size: 12px * Theme.font-scale; wrap: word-wrap; }

                // The cards already in the message.
                if ComposerApps.cards.length > 0: VerticalLayout {
                    spacing: 2px;
                    vertical-stretch: 0;
                    Rectangle { height: 1px; background: Theme.border; }
                    Text { text: "In your message: " + ComposerApps.cards.length; color: Theme.fg-muted; font-size: 11px * Theme.font-scale; font-weight: 600; }
                    for card[i] in ComposerApps.cards: HorizontalLayout {
                        height: 30px;
                        spacing: 8px;
                        Text { text: card.title; color: Theme.fg; font-size: 12px * Theme.font-scale; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                        IconButton {
                            icon: @image-url("../icons/close.svg");
                            size: 24px;
                            tooltip: "Remove " + card.title;
                            clicked => { ComposerApps.command("remove", "" + i); }
                        }
                    }
                }
            }
        }
    }
}
