// The new / edit event form with its recurrence picker, the Scheduler grid and the room picker.
import { ScrollView } from "std-widgets.slint";
import { Theme } from "../tokens/theme.slint";
import { IconButton } from "../atoms/widgets.slint";
import { CalStore, CalForm, CalFmt } from "../stores/calendar_store.slint";
import { CalCard, CalCheck, CalField, CalMenuItem } from "../molecules/calendar_widgets.slint";
import { FlexButton, ButtonVariant } from "../atoms/button.slint";





// Attendees by time slot: busy, tentative and out-of-office shading, the chosen slot outlined.
component SchedulerGrid inherits Rectangle {
    property <length> label-w: 140px;
    property <length> cell-w: 19px;
    property <length> row-h: 28px;
    property <int> slots: CalForm.sched.length > 0 ? CalForm.sched[0].cells.length : 0;
    property <int> sel-start: CalForm.sel-start;
    property <int> sel-end: CalForm.sel-end;
    height: 26px + CalForm.sched.length * root.row-h + 6px;
    border-radius: 4px;
    background: Theme.sidebar;
    border-width: 1px;
    border-color: Theme.border;
    clip: true;

    // Hour labels
    for i in root.slots: Text {
        x: root.label-w + i * root.cell-w;
        y: 0px;
        width: root.cell-w * 2;
        height: 24px;
        text: Math.mod(i * CalForm.sched-slot-min, 60) == 0 ? CalFmt.hhmm(CalForm.sched-first-min + i * CalForm.sched-slot-min) : "";
        color: Theme.fg-subtle;
        font-size: 10px * Theme.font-scale;
        vertical-alignment: center;
        overflow: clip;
    }
    for r[ri] in CalForm.sched: Rectangle {
        y: 26px + ri * root.row-h;
        height: root.row-h;
        width: parent.width;
        Rectangle { y: 0px; height: 1px; background: Theme.border; }
        VerticalLayout {
            x: 8px;
            width: root.label-w - 12px;
            alignment: center;
            Text { text: r.name; color: Theme.fg; font-size: 12px * Theme.font-scale; overflow: elide; }
            Text { text: r.error != "" ? r.error : (r.tz != "" ? r.tz : (r.kind == "room" ? "Room" : "")); color: r.error != "" ? #ffb900 : Theme.fg-subtle; font-size: 9px * Theme.font-scale; overflow: elide; }
        }
        for c[ci] in r.cells: Rectangle {
            x: root.label-w + ci * root.cell-w;
            y: 3px;
            width: root.cell-w - 1px;
            height: root.row-h - 6px;
            border-radius: 2px;
            background: CalFmt.slot-color(c);
            accessible-role: text;
            accessible-label: r.name + " " + CalFmt.hhmm(CalForm.sched-first-min + ci * CalForm.sched-slot-min) + " " + CalFmt.slot-name(c) + (r.work[ci] ? "" : ", outside their work hours");
            // Outside this person's own work hours
            if !r.work[ci]: Rectangle { background: #00000080; border-radius: 2px; }
        }
    }
    // The slot the form holds
    if root.slots > 0 && root.sel-end > root.sel-start: Rectangle {
        x: root.label-w + (root.sel-start - CalForm.sched-first-min) / CalForm.sched-slot-min * root.cell-w - 1px;
        y: 24px;
        width: (root.sel-end - root.sel-start) / CalForm.sched-slot-min * root.cell-w + 1px;
        height: parent.height - 26px;
        border-width: 2px;
        border-color: Theme.accent;
        border-radius: 3px;
        background: #7f85f522;
    }
    for ci in root.slots: TouchArea {
        x: root.label-w + ci * root.cell-w;
        y: 24px;
        width: root.cell-w;
        height: parent.height - 24px;
        mouse-cursor: pointer;
        accessible-role: button;
        accessible-label: "Start at " + CalFmt.hhmm(CalForm.sched-first-min + ci * CalForm.sched-slot-min);
        clicked => { CalForm.pick-slot(CalForm.sched-first-min + ci * CalForm.sched-slot-min); }
    }
}

component Labeled inherits VerticalLayout {
    in property <string> label;
    spacing: 3px;
    Text { text: root.label; color: Theme.fg-muted; font-size: 12px * Theme.font-scale; }
    @children
}

component RecurrencePicker inherits VerticalLayout {
    spacing: 6px;
    Text { text: "Repeat"; color: Theme.fg-muted; font-size: 12px * Theme.font-scale; }
    HorizontalLayout {
        spacing: 6px;
        alignment: start;
        for k in [{key: "none", label: "Never"}, {key: "daily", label: "Daily"}, {key: "weekdays", label: "Every weekday"}, {key: "weekly", label: "Weekly"}, {key: "monthly", label: "Monthly on the date"}, {key: "monthly-nth", label: "Monthly on the weekday"}, {key: "yearly", label: "Yearly"}]: FlexButton { variant: ButtonVariant.toolbar;
            label: k.label;
            active: CalForm.repeat == k.key;
            clicked => { CalForm.repeat = k.key; }
        }
    }
    if CalForm.repeat == "keep": Text { text: "This event repeats. Pick a choice above to change the series."; color: Theme.fg-subtle; font-size: 12px * Theme.font-scale; }
    if CalForm.repeat != "none" && CalForm.repeat != "keep": VerticalLayout {
        spacing: 6px;
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Text { text: "Every"; color: Theme.fg; font-size: 13px * Theme.font-scale; vertical-alignment: center; }
            CalField { width: 56px; placeholder: "1"; text <=> CalForm.interval; }
            Text {
                text: CalForm.repeat == "daily" ? "day(s)" : (CalForm.repeat == "weekdays" || CalForm.repeat == "weekly" ? "week(s)" : (CalForm.repeat == "yearly" ? "year(s)" : "month(s)"));
                color: Theme.fg;
                font-size: 13px * Theme.font-scale;
                vertical-alignment: center;
            }
        }
        if CalForm.repeat == "weekly": HorizontalLayout {
            spacing: 4px;
            alignment: start;
            Text { text: "On"; color: Theme.fg; font-size: 13px * Theme.font-scale; vertical-alignment: center; }
            for d[i] in ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"]: FlexButton { variant: ButtonVariant.toolbar;
                label: d;
                active: CalForm.repeat-days[i];
                clicked => { CalForm.repeat-days[i] = !CalForm.repeat-days[i]; }
            }
        }
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            Text { text: "Ends"; color: Theme.fg; font-size: 13px * Theme.font-scale; vertical-alignment: center; }
            for k in [{key: "never", label: "Never"}, {key: "on", label: "On date"}, {key: "after", label: "After occurrences"}]: FlexButton { variant: ButtonVariant.toolbar;
                label: k.label;
                active: CalForm.end-kind == k.key;
                clicked => { CalForm.end-kind = k.key; }
            }
            if CalForm.end-kind != "never": CalField {
                width: 130px;
                placeholder: CalForm.end-kind == "on" ? "2026-12-31" : "10";
                text <=> CalForm.end-value;
            }
        }
    }
}

component RoomPicker inherits Rectangle {
    height: 40px + max(1, min(CalForm.rooms.length, 6)) * 34px + 44px;
    border-radius: 4px;
    background: Theme.sidebar;
    border-width: 1px;
    border-color: Theme.border;
    VerticalLayout {
        padding: 8px;
        spacing: 6px;
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            height: 28px;
            for l in CalForm.room-lists: FlexButton { variant: ButtonVariant.toolbar; label: l.name; clicked => { CalStore.command("room-list", l.email); } }
            if CalForm.room-lists.length == 0 && !CalForm.rooms-loading: Text { text: CalForm.rooms-note != "" ? CalForm.rooms-note : "No room lists found."; color: Theme.fg-subtle; font-size: 12px * Theme.font-scale; vertical-alignment: center; }
            if CalForm.rooms-loading: Text { text: "Loading rooms…"; color: Theme.fg-muted; font-size: 12px * Theme.font-scale; vertical-alignment: center; }
        }
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                width: parent.width - 10px;
            for r[i] in CalForm.rooms: Rectangle {
                height: 30px;
                border-radius: 4px;
                background: rt.has-hover ? Theme.surface-hover : transparent;
                accessible-role: button;
                accessible-label: r.name + (r.status == 0 ? ", free" : (r.status == 1 ? ", busy" : ""));
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 10px;
                    Text { text: r.name; color: Theme.fg; font-size: 13px * Theme.font-scale; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                    Text { text: r.capacity != "" ? r.capacity + " seats" : ""; color: Theme.fg-subtle; font-size: 12px * Theme.font-scale; vertical-alignment: center; }
                    Text { text: r.place; color: Theme.fg-subtle; font-size: 12px * Theme.font-scale; vertical-alignment: center; overflow: elide; }
                    Text { text: r.status == 0 ? "Free" : (r.status == 1 ? "Busy" : "?"); color: r.status == 0 ? #6bd69b : (r.status == 1 ? #ff8a8d : Theme.fg-subtle); font-size: 12px * Theme.font-scale; font-weight: 600; vertical-alignment: center; }
                }
                rt := TouchArea { mouse-cursor: pointer; clicked => { CalForm.pick-room(i); } }
            }
            }
        }
    }
}

export component EventForm inherits CalCard {
    accessible-role: groupbox;
    accessible-label: CalForm.heading;
    VerticalLayout {
        padding: 16px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 8px;
            height: 32px;
            Text { text: CalForm.heading; color: Theme.fg; font-size: 18px * Theme.font-scale; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
            FlexButton { variant: ButtonVariant.toolbar; label: "Save"; primary: true; y: 2px; clicked => { CalForm.submit(); } }
            FlexButton { variant: ButtonVariant.toolbar; label: "Discard"; y: 2px; clicked => { CalForm.cancel(); } }
        }
        if CalForm.error != "": Rectangle {
            height: 28px;
            border-radius: 4px;
            background: #3b1f22;
            accessible-role: text;
            accessible-label: CalForm.error;
            Text { x: 10px; width: parent.width - 20px; text: CalForm.error; color: #ff8a8d; font-size: 13px * Theme.font-scale; vertical-alignment: center; overflow: elide; }
        }
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 10px;
                width: parent.width - 14px;
                CalField { placeholder: "Add a title"; text <=> CalForm.subject; field-height: 34px; }
                if CalForm.channel-mode: Labeled {
                    label: "Channel";
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        for c in CalForm.channels: FlexButton { variant: ButtonVariant.toolbar; label: c; active: CalForm.channel == c; clicked => { CalForm.channel = c; } }
                        if CalForm.channels.length == 0: Text { text: "You are not in any team yet."; color: Theme.fg-subtle; font-size: 12px * Theme.font-scale; }
                    }
                }
                Labeled {
                    label: "Required attendees (email addresses, separated by commas)";
                    CalField { placeholder: "name@company.com"; text <=> CalForm.required; }
                }
                if !CalForm.show-optional: FlexButton { variant: ButtonVariant.toolbar; label: "+ Optional attendees"; preferred-width: 170px; max-width: 170px; clicked => { CalForm.show-optional = true; } }
                if CalForm.show-optional: Labeled {
                    label: "Optional attendees";
                    CalField { placeholder: "name@company.com"; text <=> CalForm.optional; }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Labeled { label: "Start date"; CalField { placeholder: "2026-12-18"; text <=> CalForm.start-date; } }
                    if !CalForm.all-day: Labeled { label: "Start time"; width: 90px; CalField { placeholder: "9:30 AM"; text <=> CalForm.start-time; edited(t) => { CalForm.times-edited(); } } }
                    Labeled { label: "End date"; CalField { placeholder: "2026-12-18"; text <=> CalForm.end-date; } }
                    if !CalForm.all-day: Labeled { label: "End time"; width: 90px; CalField { placeholder: "10:30 AM"; text <=> CalForm.end-time; edited(t) => { CalForm.times-edited(); } } }
                }
                HorizontalLayout {
                    spacing: 16px;
                    alignment: start;
                    CalCheck { label: "All day"; checked <=> CalForm.all-day; }
                    CalCheck { label: "Microsoft Teams meeting"; checked <=> CalForm.teams-meeting; }
                    Text { text: "Times are in your local time zone."; color: Theme.fg-subtle; font-size: 12px * Theme.font-scale; vertical-alignment: center; }
                }
                RecurrencePicker { }
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    FlexButton { variant: ButtonVariant.toolbar; label: "Scheduler"; active: CalForm.sched-open; clicked => { CalForm.sched-open = !CalForm.sched-open; if CalForm.sched-open { CalStore.command("sched", ""); } } }
                    FlexButton { variant: ButtonVariant.toolbar; label: "Rooms"; active: CalForm.rooms-open; clicked => { CalForm.rooms-open = !CalForm.rooms-open; if CalForm.rooms-open { CalStore.command("rooms", ""); } } }
                }
                if CalForm.sched-open: VerticalLayout {
                    spacing: 6px;
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Text { text: CalForm.sched-loading ? "Checking calendars…" : (CalForm.sched-note != "" ? CalForm.sched-note : "Click a time to move the event there."); color: Theme.fg-muted; font-size: 12px * Theme.font-scale; vertical-alignment: center; }
                        FlexButton { variant: ButtonVariant.toolbar; label: "Refresh"; clicked => { CalStore.command("sched", ""); } }
                    }
                    SchedulerGrid { }
                    if CalForm.suggestions.length > 0: VerticalLayout {
                        spacing: 4px;
                        Text { text: "Suggested times"; color: Theme.fg-muted; font-size: 12px * Theme.font-scale; }
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            for s[i] in CalForm.suggestions: FlexButton { variant: ButtonVariant.toolbar; label: s.label; clicked => { CalForm.apply-suggestion(i); } }
                        }
                    }
                }
                Labeled {
                    label: CalForm.room-name != "" ? "Location (room: " + CalForm.room-name + ")" : "Location";
                    CalField { placeholder: "Add a room or a place"; text <=> CalForm.location; }
                }
                if CalForm.rooms-open: RoomPicker { }
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    Text { text: "Show as"; color: Theme.fg-muted; font-size: 12px * Theme.font-scale; vertical-alignment: center; }
                    for s in [{key: "busy", label: "Busy"}, {key: "tentative", label: "Tentative"}, {key: "free", label: "Free"}, {key: "oof", label: "Out of office"}, {key: "elsewhere", label: "Working elsewhere"}]: FlexButton { variant: ButtonVariant.toolbar;
                        label: s.label;
                        active: CalForm.show-as == s.key;
                        clicked => { CalForm.show-as = s.key; }
                    }
                }
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    Text { text: "Reminder"; color: Theme.fg-muted; font-size: 12px * Theme.font-scale; vertical-alignment: center; }
                    for r in [{key: "default", label: "Default"}, {key: "off", label: "None"}, {key: "5", label: "5 min"}, {key: "15", label: "15 min"}, {key: "60", label: "1 hour"}, {key: "1440", label: "1 day"}]: FlexButton { variant: ButtonVariant.toolbar;
                        label: r.label;
                        active: CalForm.reminder == r.key;
                        clicked => { CalForm.reminder = r.key; }
                    }
                }
                if CalForm.categories.length > 0: HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    Text { text: "Category"; color: Theme.fg-muted; font-size: 12px * Theme.font-scale; vertical-alignment: center; }
                    FlexButton { variant: ButtonVariant.toolbar; label: "None"; active: CalForm.category == ""; clicked => { CalForm.category = ""; } }
                    for c in CalForm.categories: FlexButton { variant: ButtonVariant.toolbar; label: c; active: CalForm.category == c; clicked => { CalForm.category = c; } }
                }
                HorizontalLayout {
                    spacing: 16px;
                    alignment: start;
                    CalCheck { label: "Private"; checked <=> CalForm.private; }
                    CalCheck { label: "Request responses"; checked <=> CalForm.response-requested; }
                    CalCheck { label: "Allow new time proposals"; checked <=> CalForm.allow-proposals; }
                    CalCheck { label: "Hide attendee list"; checked <=> CalForm.hide-attendees; }
                }
                Labeled {
                    label: "Details (supports **bold**, _italic_ and lists)";
                    CalField { multiline: true; field-height: 140px; placeholder: "Add an agenda or a description"; text <=> CalForm.body; }
                }
            }
        }
    }
}
