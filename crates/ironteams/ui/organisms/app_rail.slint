// The app bar on the left: Activity, Chat, Teams, Calendar, Calls, OneDrive with their unread
// badges, then the pinned apps.
import { AppsStore } from "../stores/apps_store.slint";
import { CallsPageStore } from "../stores/calls_page_store.slint";
import { Icon } from "../atoms/widgets.slint";
import { Motion, PopIn } from "../tokens/motion.slint";
import { RailApps } from "apps_rail.slint";
import { Theme } from "../tokens/theme.slint";
import { Tokens } from "../tokens/types.slint";

export component AppRail inherits Rectangle {
    in property <Tokens> c: Theme.nav;
    in property <int> activity-unread;
    in property <int> chats-unread;
    callback navigate(string);
    in-out property <string> view;
    width: AppsStore.rail-width;
    background: root.c.rail;
    VerticalLayout {
        padding-top: 8px;
        spacing: 4px;
        for item in [{key: "activity", label: @tr("Activity"), icon: @image-url("../icons/activity.svg")}, {key: "chat", label: @tr("Chat"), icon: @image-url("../icons/chat.svg")}, {key: "teams", label: @tr("Teams"), icon: @image-url("../icons/teams.svg")}, {key: "calendar", label: @tr("Calendar"), icon: @image-url("../icons/calendar.svg")}, {key: "calls", label: @tr("Calls"), icon: @image-url("../icons/call-direct.svg")}, {key: "onedrive", label: "OneDrive", icon: @image-url("../icons/cloud.svg")}]: ri := Rectangle {
            property <int> badge-count: item.key == "activity" ? root.activity-unread : (item.key == "chat" ? root.chats-unread : 0);
            // Calls shows only in a build with calls.
            property <bool> shown: item.key != "calls" || CallsPageStore.available;
            height: shown ? 56px : 0px;
            visible: shown;
            Rectangle {
                x: 0;
                width: 3px;
                height: 32px;
                y: 12px;
                border-radius: 2px;
                background: root.view == item.key ? root.c.accent : transparent;
            }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                Icon { c: root.c; source: item.icon; tint: root.view == item.key || rt.has-hover ? root.c.accent : root.c.fg-muted; animate tint { duration: Motion.quick; } width: 22px; height: 22px; x: (parent.width - 22px) / 2; }
                Text { text: item.label; color: root.view == item.key ? root.c.accent : root.c.fg-muted; font-size: 10px * Theme.font-scale; horizontal-alignment: center; overflow: elide; }
            }
            if ri.badge-count > 0: PopIn {
                from-scale: Theme.reduced-motion ? 1.0 : 0.3;
                x: parent.width / 2 + 2px;
                y: 4px;
                height: 16px;
                width: max(16px, badge-text.preferred-width + 8px);
                border-radius: 8px;
                background: root.c.unread-badge;
                accessible-role: text;
                accessible-label: @tr("{} unread", ri.badge-count);
                badge-text := Text { text: ri.badge-count > 99 ? "99+" : ri.badge-count; color: root.c.on-badge; font-size: 10px * Theme.font-scale; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
            }
            rt := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.navigate(item.key); }
            }
        }
        RailApps { c: root.c; view <=> root.view; }
    }
}
