// The app bar on the left: Activity, Chat, Teams, Calendar, Calls, OneDrive with their unread
// badges, then the pinned apps.
import { AppsStore, RailItems } from "../stores/apps_store.slint";
import { CallsPageStore } from "../stores/calls_page_store.slint";
import { Icon } from "../atoms/widgets.slint";
import { Motion, PopIn } from "../tokens/motion.slint";
import { RailApps } from "apps_rail.slint";
import { Theme } from "../tokens/theme.slint";
import { Tokens } from "../tokens/types.slint";

export component AppRail inherits Rectangle {
    in property <Tokens> c: Theme.nav;
    in property <int> activity-unread;
    in property <int> chats-unread;
    callback navigate(string);
    in-out property <string> view;
    width: AppsStore.rail-width;
    background: root.c.rail;
    VerticalLayout {
        padding-top: 8px;
        // The gap below an entry belongs to the entry (60px), so a hidden one leaves none.
        spacing: 0px;
        for item in AppsStore.rail-fixed: ri := Rectangle {
            property <int> badge-count: item.key == "activity" ? root.activity-unread : (item.key == "chat" ? root.chats-unread : 0);
            // Calls shows only in a build with calls; a hidden entry takes no room.
            property <bool> shown: item.shown && (item.key != "calls" || CallsPageStore.available);
            height: shown ? 60px : 0px;
            visible: shown;
            // Named here, so the entry keeps its name when the label under the icon is gone.
            accessible-role: text;
            accessible-label: RailItems.label(item.key);
            Rectangle {
                x: 0;
                width: 3px;
                height: 32px;
                y: 12px;
                border-radius: 2px;
                background: root.view == item.key ? root.c.accent : transparent;
            }
            VerticalLayout {
                y: 0px;
                height: 56px;
                alignment: center;
                spacing: 2px;
                Icon { c: root.c; source: RailItems.icon(item.key); tint: root.view == item.key || rt.has-hover ? root.c.accent : root.c.fg-muted; animate tint { duration: Motion.quick; } width: 22px; height: 22px; x: (parent.width - 22px) / 2; }
                if !AppsStore.icons-only: Text { accessible-role: none; text: RailItems.label(item.key); color: root.view == item.key ? root.c.accent : root.c.fg-muted; font-size: 10px * Theme.font-scale; horizontal-alignment: center; overflow: elide; }
            }
            if ri.badge-count > 0: PopIn {
                from-scale: Theme.reduced-motion ? 1.0 : 0.3;
                x: parent.width / 2 + 2px;
                y: 4px;
                height: 16px;
                width: max(16px, badge-text.preferred-width + 8px);
                border-radius: 8px;
                background: root.c.unread-badge;
                accessible-role: text;
                accessible-label: @tr("{} unread", ri.badge-count);
                badge-text := Text { text: ri.badge-count > 99 ? "99+" : ri.badge-count; color: root.c.on-badge; font-size: 10px * Theme.font-scale; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
            }
            rt := TouchArea {
                y: 0px;
                height: 56px;
                mouse-cursor: pointer;
                // Right click: the menu to move or hide the entry (apps_rail.slint).
                pointer-event(e) => {
                    if e.button == PointerEventButton.right && e.kind == PointerEventKind.up {
                        AppsStore.menu-fixed-y = ri.absolute-position.y;
                        AppsStore.menu-fixed = item.key;
                    }
                }
                clicked => { root.navigate(item.key); }
            }
        }
        RailApps { c: root.c; view <=> root.view; }
    }
}
