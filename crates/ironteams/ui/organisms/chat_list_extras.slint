// Pieces of the chat list added for Teams parity: the "Quick views" section at the top of the
// list (Mentions, Followed threads, Discover, Drafts) and the hover card of a channel row (its
// name and whether it is private or standard).
import { Theme } from "../tokens/theme.slint";
import { Icon, SectionHeader } from "../atoms/widgets.slint";
import { FindStore } from "../stores/find_store.slint";
import { Tokens } from "../tokens/types.slint";
import { Fixed } from "../tokens/fixed.slint";

export global QuickViewsStore {
    // The section is expanded. Remembered across restarts with the window state.
    in-out property <bool> open: true;
    // Chats with an unsent draft (the Drafts row's count).
    in property <int> drafts;
}

// The channel row under the pointer, for the hover card the sidebar draws above everything.
export global ChatTipStore {
    in-out property <string> id;
    in-out property <string> title;
    in-out property <bool> private;
    // Bottom edge of the row, in window coordinates.
    in-out property <length> row-bottom;
}

component QuickRow inherits Rectangle {
    in property <Tokens> c: Theme.nav;
    in property <string> label;
    in property <string> a11y-label: root.label;
    in property <image> icon;
    in property <int> count;
    // The count is of mentions: drawn as an accent badge.
    in property <bool> strong;
    in property <bool> active;
    callback clicked();
    height: 32px;
    border-radius: 4px;
    background: root.active ? root.c.selected : (t.has-hover ? root.c.surface-hover : transparent);
    accessible-role: button;
    accessible-label: root.a11y-label;
    accessible-value: root.count > 0 ? root.count : "";
    accessible-action-default => { root.clicked(); }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 12px;
        spacing: 10px;
        Icon { c: root.c; source: root.icon; width: 16px; height: 16px; y: (parent.height - 16px) / 2; tint: root.active ? root.c.accent : root.c.fg-muted; }
        Text {
            text: root.label;
            color: root.c.fg;
            font-size: 13px * Theme.font-scale;
            font-weight: root.strong && root.count > 0 ? 700 : 400;
            vertical-alignment: center;
            horizontal-alignment: Theme.start-align;
            overflow: elide;
            horizontal-stretch: 1;
            accessible-role: none;
        }
        if root.count > 0: Rectangle {
            y: (parent.height - 18px) / 2;
            height: 18px;
            width: max(18px, badge.preferred-width + 10px);
            horizontal-stretch: 0;
            border-radius: 9px;
            background: root.strong ? root.c.accent : transparent;
            badge := Text {
                text: root.count > 99 ? "99+" : root.count;
                color: root.strong ? root.c.on-accent : root.c.fg-subtle;
                font-size: 11px * Theme.font-scale;
                font-weight: root.strong ? 700 : 400;
                horizontal-alignment: center;
                vertical-alignment: center;
                accessible-role: none;
            }
        }
    }
    t := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// The section itself. `open(kind)` asks for a quick view ("mentions", "followed", "discover") or
// the Drafts filter ("drafts").
export component QuickViewsSection inherits VerticalLayout {
    in property <Tokens> c: Theme.nav;
    // Unread chats that mention me.
    in property <int> mentions;
    in property <bool> drafts-on;
    callback open(string);
    property <string> showing: FindStore.quick-open ? FindStore.quick-kind : "";
    qv-header := SectionHeader { c: root.c; label: @tr("Quick views"); expanded <=> QuickViewsStore.open; }
    if QuickViewsStore.open: VerticalLayout {
        QuickRow {
            c: root.c;
            label: @tr("Mentions");
            icon: @image-url("../icons/at.svg");
            count: root.mentions;
            strong: true;
            active: root.showing == "mentions";
            clicked => { root.open("mentions"); }
        }
        QuickRow {
            c: root.c;
            label: @tr("Followed threads");
            icon: @image-url("../icons/thread.svg");
            active: root.showing == "followed";
            clicked => { root.open("followed"); }
        }
        QuickRow {
            c: root.c;
            label: @tr("Discover");
            a11y-label: @tr("Discover: popular posts from your teams");
            icon: @image-url("../icons/compass.svg");
            active: root.showing == "discover";
            clicked => { root.open("discover"); }
        }
        QuickRow {
            c: root.c;
            label: @tr("Drafts");
            icon: @image-url("../icons/edit.svg");
            count: QuickViewsStore.drafts;
            active: root.drafts-on;
            clicked => { root.open("drafts"); }
        }
    }
}

// The hover card of a channel row: its name and "Private" or "Standard", as in Teams. A layer
// over the whole sidebar (it takes no input); the card shows a moment after the pointer rests on
// the row, below it, or above it near the bottom of the list.
export component ChatTipLayer inherits Rectangle {
    in property <Tokens> c: Theme.content;
    property <string> hovered: ChatTipStore.id;
    property <string> shown-for;
    property <bool> shown: root.hovered != "" && root.hovered == root.shown-for;
    changed hovered => { if root.hovered == "" { root.shown-for = ""; } }
    Timer {
        interval: 500ms;
        running: root.hovered != "" && root.hovered != root.shown-for;
        triggered => { root.shown-for = root.hovered; }
    }
    if root.shown: card := Rectangle {
        property <length> below: ChatTipStore.row-bottom - root.absolute-position.y + 2px;
        x: 56px;
        y: self.below + self.height > root.height ? self.below - 56px - self.height - 4px : self.below;
        width: min(root.width - 64px, max(120px, lay.preferred-width));
        height: lay.preferred-height;
        border-radius: 4px;
        background: root.c.panel;
        border-width: 1px;
        border-color: root.c.border;
        drop-shadow-blur: 8px;
        drop-shadow-color: Fixed.black-60;
        accessible-role: text;
        accessible-label: ChatTipStore.title;
        accessible-description: ChatTipStore.private ? @tr("Private") : @tr("Standard");
        lay := VerticalLayout {
            padding: 8px;
            spacing: 2px;
            Text { text: ChatTipStore.title; color: root.c.fg; font-size: 12px * Theme.font-scale; font-weight: 600; overflow: elide; horizontal-alignment: Theme.start-align; accessible-role: none; }
            HorizontalLayout {
                spacing: 4px;
                alignment: start;
                if ChatTipStore.private: Icon { c: root.c; source: @image-url("../icons/lock.svg"); width: 12px; height: 12px; y: 2px; tint: root.c.fg-subtle; }
                Text { text: ChatTipStore.private ? @tr("Private") : @tr("Standard"); color: root.c.fg-muted; font-size: 11px * Theme.font-scale; overflow: elide; accessible-role: none; }
            }
        }
    }
}
