// "Pop out chat": one chat in a window of its own, with its messages and a plain composer. It
// shares the engine with the main window: the Rust side (src/ui/popout.rs) forwards what is done
// here through the main window's callbacks. The window's content is a `ChatColumn`, as the split
// view's pane in the main window is.
import { Theme } from "../tokens/theme.slint";
import { Msg } from "../tokens/types.slint";
import { ChatColumn } from "chat_column.slint";
import { ReactionCard } from "reaction_card.slint";
import { ReactionHover } from "../atoms/reaction_hover.slint";

export component ChatWindow inherits Window {
    in property <string> conv-id;
    in property <string> chat-title;
    in property <[Msg]> messages;
    in-out property <string> draft;
    callback send(string);
    callback react(string, string);
    callback open-url(string);
    // Rust bumps it when the window opens a chat: the list goes to the newest message.
    in-out property <int> scroll-tick;
    out property <bool> at-newest: column.at-newest;

    title: root.chat-title == "" ? "IronTeams" : root.chat-title + " - IronTeams";
    preferred-width: 560px;
    preferred-height: 680px;
    min-width: 360px;
    min-height: 320px;
    background: Theme.main;
    default-font-size: 14px * Theme.font-scale;

    column := ChatColumn {
        width: root.width;
        height: root.height;
        chat-title: root.chat-title;
        messages: root.messages;
        draft <=> root.draft;
        scroll-tick: root.scroll-tick;
        send(t) => { root.send(t); }
        react(id, k) => { root.react(id, k); }
        open-url(u) => { root.open-url(u); }
    }

    // Who reacted, under the chip being hovered.
    if ReactionHover.open: ReactionCard {
        win-w: root.width;
        win-h: root.height;
    }
}
