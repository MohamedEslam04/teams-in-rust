import { VoiceRecStore, VoiceRecorderBar } from "voice_recorder.slint";
import { ScrollView } from "std-widgets.slint";
import { Theme } from "../tokens/theme.slint";
import { Edited, ComposerEmoji, PendingAttachment } from "../tokens/types.slint";
import { Icon, IconButton } from "../atoms/widgets.slint";
import { PeopleStore } from "../molecules/people.slint";
import { MentionApi, MentionPicker } from "../molecules/mention_picker.slint";
import { SnippetApi, SnippetItem, SnippetPicker, SnippetStore } from "../molecules/snippet_picker.slint";
import { FormatApi, FormatBar, FormatEdit, FormatPreview, FormatToggle } from "composer_format.slint";
import { ComposerAppsButton } from "composer_apps.slint";
import { GifPicker, GifStore } from "../molecules/gif_picker.slint";
import { SendStore, SendButton, SendMenu, SchedulePicker, ScheduleBanner } from "composer_send.slint";
import { SpellApi, SpellOverlay, SpellWord } from "../molecules/spelling.slint";
import { SettingsStore } from "../stores/settings_store.slint";
import { ClipStore, ClipRecorderPanel } from "video_clip.slint";
import { LoopStore, LoopEditor } from "../molecules/loop_editor.slint";
import { EmojiGrid } from "../molecules/emoji_grid.slint";
import { ComposerAttachments } from "composer_attachments.slint";
import { ImportanceTag } from "composer_importance.slint";
import { EmojiSuggestions, EmojiPanel, ComposerMoreMenu, AttachMenu } from "composer_popups.slint";
import { EmojiApi } from "../stores/emoji_api.slint";
export { EmojiApi } from "../stores/emoji_api.slint";

export component Composer inherits Rectangle {
    in property <bool> current-is-channel;
    in property <string> thread-root;
    in property <string> reply-author;
    in property <string> reply-preview;
    in property <string> editing-id;
    in-out property <string> draft;
    in-out property <string> post-subject;
    in-out property <int> focus-tick;
    // true: Enter sends and Shift+Enter adds a line. false: Enter adds a line and Ctrl+Enter sends.
    in-out property <bool> enter-sends: true;
    // Request to put the cursor at the end of the text (a draft was restored).
    in property <int> cursor-tick;
    in property <[ComposerEmoji]> recent-emoji;
    in property <[PendingAttachment]> pending-attachments;
    in-out property <int> skin-tone: 0; // 0 default, 1..5 light to dark
    // Formatting (plan chat 5.4): the toolbar and preview strip, and the taller composer (Ctrl+Shift+X).
    in-out property <bool> format-open: false;
    in-out property <bool> expanded: false;
    // "Mark as important" (Ctrl+Shift+I): the next message is sent with the Important delivery
    // option. It shows as a red chip and is used up by the send.
    in-out property <bool> important: false;
    // "Set delivery options" › Urgent: like `important`, for the next message only.
    in-out property <bool> urgent: false;
    // True while the text box has the keyboard focus (the window leaves Ctrl+Shift+7 and 8 to the composer then).
    property <bool> input-focused: composer-input.has-focus;
    callback input-focus(bool);
    changed input-focused => { root.input-focus(root.input-focused); }

    callback send(string);
    callback set-enter-sends(bool);
    callback emoji-used(string);
    callback paste-image();
    callback remove-attachment(int);
    callback skin-tone-changed(int);
    callback typing-tick();
    callback draft-edited(string);
    callback cancel-reply();
    callback attach-image();
    callback attach-file();
    callback attach-cloud();
    // Up in an empty composer: edit my last message.
    callback edit-last();

    property <int> emoji-tab: 0;
    property <string> emoji-query;
    property <[ComposerEmoji]> suggestions: EmojiApi.suggest(root.draft, composer-input.cursor-position-byte-offset, root.skin-tone);
    property <int> sug-index: 0;
    property <string> sug-dismissed; // the draft for which Escape closed the popup
    property <bool> sug-open: root.suggestions.length > 0 && root.sug-dismissed != root.draft;

    // @mentions: the names picked so far (one per line), the `@query` before the cursor and the
    // picker. A picked name is plain `@Name` text; one Backspace after it removes it whole.
    property <string> mention-names;
    property <int> mention-index: 0;
    property <string> mention-dismissed; // the draft for which Escape closed the picker
    property <bool> mention-active: MentionApi.active(root.draft, composer-input.cursor-position-byte-offset);
    property <string> mention-query: MentionApi.query(root.draft, composer-input.cursor-position-byte-offset);
    property <bool> mention-open: root.mention-active && PeopleStore.mention-items.length > 0 && root.mention-dismissed != root.draft;

    // Snippets: the saved quick replies that fit the `/query` before the cursor (src/snippets.rs).
    property <[SnippetItem]> snippet-matches: SnippetApi.matches(root.draft, composer-input.cursor-position-byte-offset, SnippetStore.items);
    property <int> snippet-index: 0;
    property <string> snippet-dismissed; // the draft for which Escape closed the picker
    property <bool> snippet-open: root.snippet-matches.length > 0 && root.snippet-dismissed != root.draft;
    changed snippet-matches => { root.snippet-index = 0; }

    changed cursor-tick => { composer-input.set-selection-offsets(2000000000, 2000000000); }
    changed suggestions => { root.sug-index = 0; }
    changed mention-active => { if root.mention-active { PeopleStore.command("mention-query", root.mention-query); } }
    changed mention-query => { if root.mention-active { PeopleStore.command("mention-query", root.mention-query); } }
    changed draft => {
        if root.draft == "" { root.mention-names = ""; }
        spell-timer.running = true;
        spell-timer.restart();
    }
    property <int> mention-count: PeopleStore.mention-items.length;
    changed mention-count => { root.mention-index = 0; }

    function pick-mention(i: int) {
        if i >= 0 && i < PeopleStore.mention-items.length {
            root.put(MentionApi.complete(root.draft, composer-input.cursor-position-byte-offset, "@" + PeopleStore.mention-items[i].name + " "));
            root.mention-names += PeopleStore.mention-items[i].name + "\n";
            // The text now ends with the name and a space: keep the picker closed until it changes.
            root.mention-dismissed = root.draft;
            PeopleStore.command("mention-pick", PeopleStore.mention-items[i].id);
        }
    }

    // Spell check: the draft is checked once typing pauses (`spell-text` is that snapshot); the
    // underlines of words the draft no longer has in place hide until the next check.
    property <string> spell-text;
    property <int> spell-cursor;
    property <[SpellWord]> spell-words: SettingsStore.check-spelling && root.spell-text != "" ? SpellApi.check(root.spell-text, root.mention-names, root.spell-cursor, SpellApi.generation) : [];
    property <int> spell-stable: SpellApi.stable(root.spell-text, root.draft);
    spell-timer := Timer {
        interval: 500ms;
        running: false;
        triggered => {
            self.running = false;
            root.spell-text = root.draft;
            root.spell-cursor = composer-input.cursor-position-byte-offset;
        }
    }

    function pick-snippet(i: int) {
        if i >= 0 && i < root.snippet-matches.length {
            root.put(SnippetApi.complete(root.draft, composer-input.cursor-position-byte-offset, root.snippet-matches[i].text));
            // A snippet may itself start with `/`: keep the picker closed until the text changes.
            root.snippet-dismissed = root.draft;
        }
    }

    function put(e: Edited) {
        composer-input.text = e.text;
        composer-input.set-selection-offsets(e.cursor, e.cursor);
        root.draft-edited(e.text);
        root.focus-tick += 1;
    }

    // Puts a formatted text back with its selection.
    function put-selection(e: FormatEdit) {
        composer-input.text = e.text;
        composer-input.set-selection-offsets(e.anchor, e.cursor);
        root.draft-edited(e.text);
        root.focus-tick += 1;
    }

    // A toolbar action or shortcut on the selection (`a`, `c`: anchor and cursor byte offsets).
    function format(act: string, a: int, c: int) {
        if act == "important" {
            root.important = !root.important;
            root.urgent = false;
            root.focus-tick += 1;
            return;
        }
        if act == "undo" || act == "redo" {
            let u = act == "undo" ? FormatApi.undo(composer-input.text, a, c) : FormatApi.redo(composer-input.text, a, c);
            if u.ok { root.put-selection(u); }
            return;
        }
        let e = FormatApi.apply(act, composer-input.text, a, c);
        if e.ok { root.put-selection(e); }
    }

    // Formatting shortcuts (Ctrl+B, Ctrl+Alt+1, ...). False: not one, or an undo or redo the toolbar
    // has nothing for, so the input's own undo runs.
    function try-shortcut(event: KeyEvent) -> bool {
        let act = FormatApi.shortcut(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift);
        let a = composer-input.anchor-position-byte-offset;
        let c = composer-input.cursor-position-byte-offset;
        if act == "" { return false; }
        if act == "link" { fmt-bar.open-link(); return true; }
        if act == "undo" || act == "redo" {
            let u = act == "undo" ? FormatApi.undo(composer-input.text, a, c) : FormatApi.redo(composer-input.text, a, c);
            if u.ok { root.put-selection(u); return true; }
            return false;
        }
        root.format(act, a, c);
        return true;
    }

    function pick-emoji(ch: string) {
        root.put(EmojiApi.insert(root.draft, composer-input.cursor-position-byte-offset, ch));
        root.emoji-used(ch);
    }

    function accept-suggestion() {
        root.emoji-used(root.suggestions[root.sug-index].ch);
        root.put(EmojiApi.complete(root.draft, composer-input.cursor-position-byte-offset, root.suggestions[root.sug-index].ch));
    }

    // "Schedule message" is offered for a chat message (not a channel post, a reply or an edit).
    property <bool> can-schedule: !root.current-is-channel && root.thread-root == "" && root.editing-id == "";

    function submit() {
        if LoopStore.open { LoopStore.send(); }
        // A chosen send time: the text is scheduled instead of sent (attachments stay here).
        if SendStore.schedule-at != "" && root.can-schedule {
            if composer-input.text != "" {
                // Cleared first: a refused schedule puts the text (and the time) back.
                let text = composer-input.text;
                let at = SendStore.schedule-at;
                composer-input.text = "";
                SendStore.schedule-at = "";
                SendStore.schedule-label = "";
                root.important = false;
                root.urgent = false;
                SendStore.command("schedule", at + "\u{9}" + text);
            }
            return;
        }
        if composer-input.text != "" || root.pending-attachments.length > 0 {
            root.send(composer-input.text);
            composer-input.text = "";
            root.important = false;
            root.urgent = false;
        }
    }

    // The window's width. A narrow window (760 px) folds GIF and Loop into the "…" menu instead of
    // letting the toolbar crowd (the composer's own width would make a binding loop).
    in property <length> window-width: 1200px;
    property <bool> narrow-bar: root.window-width < 860px;

    function open-gifs() {
        GifStore.tab = "gif";
        GifStore.command("search", "");
        gif-popup.show();
    }

    function open-schedule() {
        if SendStore.schedule-at == "" {
            SendStore.pick-day = 1;
            SendStore.pick-minutes = 480;
        }
        SendStore.open();
        schedule-popup.show();
    }

    // Size like the layout inside, so the parent layout treats this exactly as it did the bare layout.
    min-width: body.min-width;
    preferred-width: body.preferred-width;
    max-width: body.max-width;
    min-height: body.min-height;
    preferred-height: body.preferred-height;
    max-height: body.max-height;

    body := HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        padding-bottom: 16px;
        padding-top: 6px;
        Rectangle {
            border-radius: 6px;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                if root.reply-preview != "": Rectangle {
                    background: Theme.sidebar;
                    border-radius: 4px;
                    HorizontalLayout {
                        padding: 8px;
                        spacing: 8px;
                        Rectangle { width: 3px; background: Theme.accent; }
                        VerticalLayout {
                            Text { text: root.editing-id != "" ? @tr("Editing message") : @tr("Replying to {}", root.reply-author); color: Theme.fg-muted; font-size: 11px * Theme.font-scale; font-weight: 600; overflow: elide; }
                            Text { text: root.reply-preview; color: Theme.fg-muted; font-size: 12px * Theme.font-scale; overflow: elide; }
                        }
                        IconButton { icon: @image-url("../icons/close.svg"); size: 24px; clicked => { root.cancel-reply(); } }
                    }
                }
                if root.pending-attachments.length > 0: ComposerAttachments {
                    pending-attachments: root.pending-attachments;
                    remove-attachment(a0) => { root.remove-attachment(a0); }
                }
                if SendStore.schedule-at != "" && root.can-schedule: ScheduleBanner { }
                if root.important || root.urgent: ImportanceTag {
                    important <=> root.important;
                    urgent <=> root.urgent;
                }
                if root.current-is-channel && root.thread-root == "": HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    height: 34px;
                    TextInput {
                        text <=> root.post-subject;
                        color: Theme.fg;
                        font-size: 15px * Theme.font-scale;
                        font-weight: 700;
                        single-line: true;
                        vertical-alignment: center;
                    }
                }
                // "Record video clip" (the "…" menu) and the Loop paragraph sit above the text.
                if ClipStore.state != "idle": ClipRecorderPanel {
                    init => { self.focus(); }
                }
                if LoopStore.open: HorizontalLayout {
                    padding: 8px;
                    padding-bottom: 0px;
                    LoopEditor { }
                }
                fmt-bar := FormatBar {
                    open: root.format-open;
                    sel-anchor: composer-input.anchor-position-byte-offset;
                    sel-cursor: composer-input.cursor-position-byte-offset;
                    action(a, s, c) => { root.format(a, s, c); }
                }
                if root.format-open && FormatApi.has-format(root.draft): FormatPreview {
                    source: root.draft;
                }
                Rectangle {
                    height: root.expanded ? max(200px, min(420px, composer-input.preferred-height + 20px)) : max(44px, min(220px, composer-input.preferred-height + 20px));
                    composer-scope := FocusScope {
                        capture-key-pressed(event) => {
                            // Not consumed: a text paste still happens. Rust adds an image if the clipboard holds one.
                            if event.text == "v" && (event.modifiers.control || event.modifiers.meta) {
                                root.paste-image();
                            }
                            if root.try-shortcut(event) {
                                return accept;
                            }
                            if root.snippet-open {
                                if event.text == Key.DownArrow {
                                    root.snippet-index = min(root.snippet-index + 1, root.snippet-matches.length - 1);
                                    return accept;
                                }
                                if event.text == Key.UpArrow {
                                    root.snippet-index = max(root.snippet-index - 1, 0);
                                    return accept;
                                }
                                if event.text == Key.Escape {
                                    root.snippet-dismissed = root.draft;
                                    return accept;
                                }
                                if event.text == Key.Tab || (event.text == Key.Return && !event.modifiers.shift) {
                                    root.pick-snippet(root.snippet-index);
                                    return accept;
                                }
                            }
                            if root.mention-open {
                                if event.text == Key.DownArrow {
                                    root.mention-index = min(root.mention-index + 1, PeopleStore.mention-items.length - 1);
                                    return accept;
                                }
                                if event.text == Key.UpArrow {
                                    root.mention-index = max(root.mention-index - 1, 0);
                                    return accept;
                                }
                                if event.text == Key.Escape {
                                    root.mention-dismissed = root.draft;
                                    return accept;
                                }
                                if event.text == Key.Tab || (event.text == Key.Return && !event.modifiers.shift) {
                                    root.pick-mention(root.mention-index);
                                    return accept;
                                }
                            }
                            if event.text == Key.Backspace && root.mention-names != "" && composer-input.anchor-position-byte-offset == composer-input.cursor-position-byte-offset {
                                if MentionApi.backspace(root.draft, composer-input.cursor-position-byte-offset, root.mention-names).cursor >= 0 {
                                    root.put(MentionApi.backspace(root.draft, composer-input.cursor-position-byte-offset, root.mention-names));
                                    return accept;
                                }
                            }
                            if root.sug-open {
                                if event.text == Key.DownArrow {
                                    root.sug-index = min(root.sug-index + 1, root.suggestions.length - 1);
                                    return accept;
                                }
                                if event.text == Key.UpArrow {
                                    root.sug-index = max(root.sug-index - 1, 0);
                                    return accept;
                                }
                                if event.text == Key.Escape {
                                    root.sug-dismissed = root.draft;
                                    return accept;
                                }
                                if event.text == Key.Tab || (event.text == Key.Return && !event.modifiers.shift) {
                                    root.accept-suggestion();
                                    return accept;
                                }
                            }
                            if event.text == Key.UpArrow && composer-input.text == "" && root.editing-id == "" && root.pending-attachments.length == 0 {
                                root.edit-last();
                                return accept;
                            }
                            // Ctrl+Shift+R records a voice message (ui/organisms/voice_recorder.slint).
                            if event.modifiers.control && event.modifiers.shift && (event.text == "R" || event.text == "r") {
                                VoiceRecStore.start();
                                return accept;
                            }
                            if (event.text == Key.Return && (root.enter-sends ? !event.modifiers.shift : event.modifiers.control || event.modifiers.meta)) {
                                root.submit();
                                return accept;
                            }
                            reject
                        }
                        SpellOverlay {
                            x: composer-input.x;
                            y: composer-input.y;
                            width: composer-input.width;
                            height: composer-input.height;
                            text: root.spell-text;
                            words: root.spell-words;
                            stable: root.spell-stable;
                            font-size: composer-input.font-size;
                            align: composer-input.horizontal-alignment;
                            replace(start, end, with) => {
                                let e = SpellApi.replace(composer-input.text, start, end, with);
                                if e.cursor >= 0 { root.put(e); }
                            }
                        }
                        composer-input := TextInput {
                            property <int> tick: root.focus-tick;
                            changed tick => { self.focus(); }
                            x: 14px;
                            y: 10px;
                            width: parent.width - 28px;
                            text <=> root.draft;
                            color: Theme.fg;
                            font-size: 14px * Theme.font-scale;
                            single-line: false;
                            horizontal-alignment: Theme.start-align;
                            wrap: word-wrap;
                            edited => {
                                root.typing-tick();
                                root.draft-edited(self.text);
                            }
                        }
                    }
                    if composer-input.text == "": Text {
                        x: 14px;
                        y: 10px;
                        width: parent.width - 28px;
                        horizontal-alignment: Theme.start-align;
                        text: root.current-is-channel && root.thread-root == "" ? @tr("Start a post") : @tr("Type a message");
                        color: Theme.fg-subtle;
                    }
                }
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    padding-bottom: 6px;
                    spacing: 2px;
                    alignment: end;
                    FormatToggle { on: root.format-open; clicked => { root.format-open = !root.format-open; } }
                    IconButton { icon: @image-url("../icons/emoji.svg"); clicked => { root.emoji-query = ""; emoji-popup.show(); } }
                    IconButton { icon: @image-url("../icons/attach.svg"); tooltip: @tr("Attach file"); clicked => { attach-popup.show(); } }
                    IconButton { icon: @image-url("../icons/more.svg"); clicked => { more-popup.show(); } }
                    if !root.narrow-bar: IconButton {
                        icon: @image-url("../icons/gif.svg");
                        tooltip: @tr("GIF");
                        clicked => { root.open-gifs(); }
                    }
                    if !root.narrow-bar: IconButton {
                        icon: @image-url("../icons/loop.svg");
                        tooltip: @tr("Loop paragraph");
                        active: LoopStore.open;
                        clicked => { LoopStore.open = true; }
                    }
                    ComposerAppsButton { }
                    IconButton {
                        icon: @image-url("../icons/mic.svg");
                        tooltip: @tr("Record a voice message (Ctrl+Shift+R)");
                        clicked => { VoiceRecStore.start(); }
                    }
                    Rectangle { width: 1px; background: Theme.border; }
                    SendButton {
                        ready: composer-input.text != "" || root.pending-attachments.length > 0 || LoopStore.open;
                        send => { root.submit(); }
                        options => { send-popup.show(); }
                    }
                }
            }
            Rectangle {
                y: parent.height - 2px;
                height: 2px;
                background: composer-input.has-focus ? Theme.accent : transparent;
            }
            // While a voice message is recorded or listened back, its bar takes the box.
            if VoiceRecStore.state != "idle": Rectangle {
                background: Theme.surface;
                border-radius: Theme.radius;
                VoiceRecorderBar {
                    x: 8px;
                    width: parent.width - 16px;
                    y: (parent.height - self.height) / 2;
                    init => { self.focus(); }
                }
            }
        }
    }

    if root.snippet-open: SnippetPicker {
        z: 100;
        x: 20px;
        y: -self.height - 4px;
        items: root.snippet-matches;
        index: root.snippet-index;
        picked(i) => { root.pick-snippet(i); }
    }

    if root.mention-open: MentionPicker {
        z: 100;
        x: 20px;
        y: -self.height - 4px;
        items: PeopleStore.mention-items;
        index: root.mention-index;
        picked(i) => { root.pick-mention(i); }
    }

    if root.sug-open: EmojiSuggestions {
        accept-suggestion => { root.accept-suggestion(); }
        sug-index <=> root.sug-index;
        suggestions: root.suggestions;
    }

    send-popup := PopupWindow {
        x: parent.width - 300px;
        y: parent.height - send-menu.menu-height - 60px;
        width: 280px;
        height: send-menu.menu-height;
        close-policy: close-on-click-outside;
        send-menu := SendMenu {
            can-schedule: root.can-schedule;
            important <=> root.important;
            urgent <=> root.urgent;
            schedule => {
                send-popup.close();
                root.open-schedule();
            }
            done => {
                send-popup.close();
                root.focus-tick += 1;
            }
        }
    }

    schedule-popup := PopupWindow {
        x: max(8px, parent.width - 360px);
        y: parent.height - 382px;
        width: 320px;
        height: 322px;
        close-policy: close-on-click-outside;
        SchedulePicker {
            done => {
                schedule-popup.close();
                root.focus-tick += 1;
            }
        }
    }

    gif-popup := PopupWindow {
        x: parent.width - 420px;
        y: parent.height - 530px;
        width: 360px;
        height: 440px;
        close-policy: close-on-click-outside;
        GifPicker {
            width: parent.width;
            height: parent.height;
            picked => { gif-popup.close(); }
        }
    }

    emoji-popup := PopupWindow {
        x: parent.width - 420px;
        y: parent.height - 530px;
        width: 360px;
        height: 440px;
        close-policy: close-on-click-outside;
        EmojiPanel {
            emoji-query <=> root.emoji-query;
            emoji-tab <=> root.emoji-tab;
            pick-emoji(a0) => { root.pick-emoji(a0); }
            recent-emoji: root.recent-emoji;
            skin-tone <=> root.skin-tone;
            skin-tone-changed(a0) => { root.skin-tone-changed(a0); }
            close-popup => { emoji-popup.close(); }
        }
    }

    more-popup := PopupWindow {
        x: parent.width - 330px;
        y: parent.height - 190px - root.more-extra;
        width: 260px;
        height: 150px + root.more-extra;
        ComposerMoreMenu {
            enter-sends <=> root.enter-sends;
            more-action(a0) => { root.more-action(a0); }
            more-actions: root.more-actions;
            set-enter-sends(a0) => { root.set-enter-sends(a0); }
        }
    }

    // The "…" menu's actions: Record video clip, and GIF and Loop when the toolbar has no room.
    property <[{id: string, icon: image, label: string}]> more-actions: root.narrow-bar ? [
        { id: "clip", icon: @image-url("../icons/video.svg"), label: @tr("Record video clip") },
        { id: "gif", icon: @image-url("../icons/gif.svg"), label: @tr("GIF") },
        { id: "loop", icon: @image-url("../icons/loop.svg"), label: @tr("Loop paragraph") },
    ] : [
        { id: "clip", icon: @image-url("../icons/video.svg"), label: @tr("Record video clip") },
    ];
    property <length> more-extra: root.more-actions.length * 34px + 3px;

    function more-action(id: string) {
        more-popup.close();
        if id == "clip" { ClipStore.open(); }
        if id == "gif" { root.open-gifs(); }
        if id == "loop" { LoopStore.open = true; }
    }

    attach-popup := PopupWindow {
        x: parent.width - 330px;
        y: parent.height - 130px;
        width: 260px;
        height: 82px;
        close-policy: close-on-click-outside;
        AttachMenu {
            attach-cloud => { root.attach-cloud(); }
            attach-file => { root.attach-file(); }
            close-popup => { attach-popup.close(); }
        }
    }
}
