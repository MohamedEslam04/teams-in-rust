// Group chat participants: the popover under the header's people button (members, "Add people"
// with an optional share-history switch, and Leave) and the "Leave this chat?" confirmation.
import { Theme } from "../tokens/theme.slint";
import { PersonItem } from "../tokens/types.slint";
import { IconButton } from "../atoms/widgets.slint";
import { Avatar } from "../atoms/avatar.slint";
import { PeopleStore, PersonHover } from "../molecules/people.slint";

export component ParticipantsPanel inherits Rectangle {
    in property <[PersonItem]> members;
    in property <[PersonItem]> add-results;
    // Leave is offered (group chats; a 1:1 chat can't be left).
    in property <bool> can-leave: true;
    callback open-profile(string);
    callback add-query(string);
    callback add-pick(string);
    callback history-changed(bool);
    callback leave();
    callback close();

    property <bool> adding: false;
    property <bool> history: false;

    width: 340px;
    height: min(520px, 150px + (root.adding ? root.add-results.length : root.members.length) * 44px);
    border-radius: 8px;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    drop-shadow-blur: 16px;
    drop-shadow-color: #000000a0;
    accessible-role: groupbox;
    accessible-label: "Participants";

    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        HorizontalLayout {
            height: 28px;
            Text { text: root.adding ? "Add people" : "People (" + root.members.length + ")"; color: Theme.fg; font-size: 15px * Theme.font-scale; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
            IconButton { icon: @image-url("../icons/close.svg"); tooltip: "Close"; size: 28px; clicked => { root.close(); } }
        }

        if root.adding: VerticalLayout {
            spacing: 8px;
            vertical-stretch: 1;
            Rectangle {
                height: 32px;
                border-radius: 4px;
                background: Theme.sidebar;
                border-width: 1px;
                border-color: add-input.has-focus ? Theme.accent : Theme.border;
                add-input := TextInput {
                    x: 10px;
                    width: parent.width - 20px;
                    color: Theme.fg;
                    font-size: 13px * Theme.font-scale;
                    single-line: true;
                    vertical-alignment: center;
                    accessible-role: text-input;
                    accessible-placeholder-text: "Search people";
                    init => { self.focus(); }
                    edited => { root.add-query(self.text); }
                }
                if add-input.text == "": Text { x: 10px; text: "Search people"; color: Theme.fg-subtle; font-size: 13px * Theme.font-scale; vertical-alignment: center; }
            }
            history-toggle := Rectangle {
                height: 28px;
                accessible-role: checkbox;
                accessible-label: "Include chat history";
                accessible-checkable: true;
                accessible-checked: root.history;
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        width: 18px;
                        height: 18px;
                        y: 5px;
                        border-radius: 3px;
                        border-width: 1px;
                        border-color: root.history ? Theme.accent : Theme.fg-subtle;
                        background: root.history ? Theme.accent-strong : transparent;
                        Text { text: root.history ? "✓" : ""; color: #ffffff; font-size: 12px * Theme.font-scale; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Text { text: "Include chat history"; color: Theme.fg; font-size: 13px * Theme.font-scale; vertical-alignment: center; }
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.history = !root.history;
                        root.history-changed(root.history);
                    }
                }
            }
            Flickable {
                vertical-stretch: 1;
                content-height: add-list.preferred-height;
                add-list := VerticalLayout {
                    for r in root.add-results: add-row := Rectangle {
                        height: 44px;
                        border-radius: 4px;
                        background: add-hit.has-hover ? Theme.surface-hover : transparent;
                        accessible-role: button;
                        accessible-label: "Add " + r.name;
                        HorizontalLayout {
                            padding-left: 6px;
                            spacing: 10px;
                            Avatar { initials: r.initials; tone: r.color; img: r.avatar; has-img: r.has-avatar; presence: r.presence; size: 30px; y: 7px; }
                            VerticalLayout {
                                alignment: center;
                                Text { text: r.name; color: Theme.fg; font-size: 13px * Theme.font-scale; overflow: elide; }
                                if r.subtitle != "": Text { text: r.subtitle; color: Theme.fg-subtle; font-size: 11px * Theme.font-scale; overflow: elide; }
                            }
                        }
                        add-hit := PersonHover {
                            person: r.id;
                            click-opens: false;
                            activated => {
                                root.add-pick(r.id);
                                root.adding = false;
                            }
                        }
                    }
                }
            }
        }

        if !root.adding: VerticalLayout {
            spacing: 8px;
            vertical-stretch: 1;
            add-people := Rectangle {
                height: 32px;
                border-radius: 4px;
                background: add-btn.has-hover ? Theme.surface-hover : Theme.surface-hover;
                accessible-role: button;
                accessible-label: "Add people";
                Text { text: "Add people"; color: Theme.fg; font-size: 13px * Theme.font-scale; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                add-btn := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.adding = true; }
                }
            }
            Flickable {
                vertical-stretch: 1;
                content-height: member-list.preferred-height;
                member-list := VerticalLayout {
                    for m in root.members: member-row := Rectangle {
                        height: 44px;
                        border-radius: 4px;
                        background: member-hit.has-hover ? Theme.surface-hover : transparent;
                        accessible-role: button;
                        accessible-label: m.name;
                        HorizontalLayout {
                            padding-left: 6px;
                            spacing: 10px;
                            Avatar { initials: m.initials; tone: m.color; img: m.avatar; has-img: m.has-avatar; presence: m.presence; size: 30px; y: 7px; }
                            VerticalLayout {
                                alignment: center;
                                Text { text: m.name; color: Theme.fg; font-size: 13px * Theme.font-scale; overflow: elide; }
                                if m.subtitle != "": Text { text: m.subtitle; color: Theme.fg-subtle; font-size: 11px * Theme.font-scale; overflow: elide; }
                            }
                        }
                        // Resting on a member opens their hover card next to the row.
                        member-hit := PersonHover { person: m.id; click-opens: false; activated => { root.open-profile(m.id); } }
                    }
                }
            }
            if root.can-leave: leave-btn := Rectangle {
                height: 32px;
                border-radius: 4px;
                background: leave-touch.has-hover ? #3b1f22 : transparent;
                accessible-role: button;
                accessible-label: "Leave";
                Text { text: "Leave"; color: Theme.danger; font-size: 13px * Theme.font-scale; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                leave-touch := TouchArea { mouse-cursor: pointer; clicked => { root.leave(); } }
            }
        }
    }
}

export component LeaveConfirm inherits Rectangle {
    callback confirm();
    callback cancel();
    width: 380px;
    height: 150px;
    border-radius: 8px;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    drop-shadow-blur: 16px;
    drop-shadow-color: #000000a0;
    accessible-role: groupbox;
    accessible-label: "Leave this chat?";
    VerticalLayout {
        padding: 16px;
        spacing: 8px;
        Text { text: "Leave this chat?"; color: Theme.fg; font-size: 17px * Theme.font-scale; font-weight: 700; }
        Text { text: "You will no longer get its messages or see its history."; color: Theme.fg-muted; font-size: 13px * Theme.font-scale; wrap: word-wrap; vertical-stretch: 1; }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            height: 32px;
            leave-cancel := Rectangle {
                width: 80px;
                border-radius: 4px;
                background: cancel-touch.has-hover ? Theme.surface-hover : Theme.surface-hover;
                accessible-role: button;
                accessible-label: "Cancel";
                Text { text: "Cancel"; color: Theme.fg; font-size: 13px * Theme.font-scale; horizontal-alignment: center; vertical-alignment: center; }
                cancel-touch := TouchArea { mouse-cursor: pointer; clicked => { root.cancel(); } }
            }
            leave-confirm := Rectangle {
                width: 80px;
                border-radius: 4px;
                background: confirm-touch.has-hover ? Theme.danger-hover : Theme.danger;
                accessible-role: button;
                accessible-label: "Leave chat";
                Text { text: "Leave"; color: #ffffff; font-size: 13px * Theme.font-scale; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                confirm-touch := TouchArea { mouse-cursor: pointer; clicked => { root.confirm(); } }
            }
        }
    }
}
