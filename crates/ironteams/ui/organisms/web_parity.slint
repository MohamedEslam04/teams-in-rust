// What the Teams web client offers around the chat list, the chat and channel headers and the
// Calls page that IronTeams had no place for: the New chat split button,
// the channel header's Meet now and More menu, and a notice for the actions IronTeams cannot do yet
// (said plainly instead of pretending they worked).
import { Theme } from "../tokens/theme.slint";
import { Icon, IconButton } from "../atoms/widgets.slint";
import { ListStore } from "lists.slint";
import { TeamsStore, TeamsActions } from "../stores/teams_store.slint";
import { FlowsStore } from "../stores/apps_store.slint";
import { ChannelStore } from "channel_posts.slint";
import { MenuItem, MenuItemVariant, MenuFrame, MenuFrameVariant } from "../molecules/menu.slint";

export global WebParityStore {
    // A line for an action IronTeams cannot do yet, shown until dismissed.
    in-out property <string> notice;
}

// The notice of `WebParityStore`, at the bottom of the window.
export component ParityNotice inherits Rectangle {
    height: 40px;
    border-radius: 6px;
    background: #1f2a3b;
    border-width: 1px;
    border-color: Theme.accent;
    accessible-role: text;
    accessible-label: @tr("Notice");
    accessible-value: WebParityStore.notice;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 6px;
        spacing: 8px;
        Text { text: WebParityStore.notice; color: #ffffff; font-size: 12px * Theme.font-scale; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; accessible-role: none; }
        IconButton { icon: @image-url("../icons/close.svg"); size: 26px; y: 7px; tint: #ffffff; tooltip: @tr("Dismiss"); clicked => { WebParityStore.notice = ""; } }
    }
}

// The chat list's New chat button and its chevron: New chat, or Meet now.
export component NewChatSplit inherits Rectangle {
    callback new-chat();
    callback meet-now();
    width: 52px;
    height: 32px;
    HorizontalLayout {
        IconButton { icon: @image-url("../icons/compose.svg"); tooltip: @tr("New chat"); clicked => { root.new-chat(); } }
        IconButton { width: 20px; size: 32px; icon: @image-url("../icons/chevron-down.svg"); tooltip: @tr("New chat options"); clicked => { pop.show(); } }
    }
    pop := PopupWindow {
        x: root.width - 220px;
        y: root.height + 4px;
        width: 220px;
        height: 2 * 32px + 10px;
        close-policy: close-on-click-outside;
        MenuFrame { variant: MenuFrameVariant.parity;
            VerticalLayout {
                padding: 4px;
                MenuItem { variant: MenuItemVariant.parity; label: @tr("New chat"); keys: "Alt+Shift+N"; clicked => { pop.close(); root.new-chat(); } }
                MenuItem { variant: MenuItemVariant.parity; label: @tr("Meet now"); clicked => { pop.close(); root.meet-now(); } }
            }
        }
    }
}

// The channel header's "Meet now" and its chevron: Meet now, or Schedule a meeting.
export component ChannelMeetButton inherits Rectangle {
    callback meet-now();
    callback schedule-meeting();
    width: meet-label.preferred-width + 60px;
    height: 32px;
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.border;
    HorizontalLayout {
        Rectangle {
            accessible-role: button;
            accessible-label: @tr("Meet now");
            accessible-action-default => { root.meet-now(); }
            HorizontalLayout {
                padding-left: 8px;
                spacing: 6px;
                Icon { source: @image-url("../icons/video.svg"); width: 16px; height: 16px; y: 8px; }
                meet-label := Text { text: @tr("Meet now"); color: Theme.fg; font-size: 13px * Theme.font-scale; vertical-alignment: center; accessible-role: none; }
            }
            TouchArea { mouse-cursor: pointer; clicked => { root.meet-now(); } }
        }
        IconButton { width: 22px; size: 30px; icon: @image-url("../icons/chevron-down.svg"); tooltip: @tr("Meeting options"); clicked => { pop.show(); } }
    }
    pop := PopupWindow {
        x: root.width - 220px;
        y: root.height + 4px;
        width: 220px;
        height: 2 * 32px + 10px;
        close-policy: close-on-click-outside;
        MenuFrame { variant: MenuFrameVariant.parity;
            VerticalLayout {
                padding: 4px;
                MenuItem { variant: MenuItemVariant.parity; label: @tr("Meet now"); clicked => { pop.close(); root.meet-now(); } }
                MenuItem { variant: MenuItemVariant.parity; label: @tr("Schedule a meeting"); clicked => { pop.close(); root.schedule-meeting(); } }
            }
        }
    }
}

// The meeting chat header's Join: filled while the meeting is live, outlined otherwise.
export component MeetingJoinButton inherits Rectangle {
    in property <bool> live;
    callback clicked();
    width: join-label.preferred-width + 32px;
    height: 32px;
    border-radius: 4px;
    border-width: root.live ? 0px : 1px;
    border-color: Theme.border;
    background: root.live ? (touch.has-hover ? Theme.accent : Theme.accent-strong) : (touch.has-hover ? Theme.surface-hover : transparent);
    accessible-role: button;
    accessible-label: @tr("Join meeting");
    accessible-action-default => { root.clicked(); }
    join-label := Text {
        text: @tr("Join");
        color: root.live ? #ffffff : Theme.fg;
        font-size: 13px * Theme.font-scale;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// The channel items of the header's More menu. Edit channel, Get email address and Delete
// channel need the channel's team, so they show once "Your teams and channels" knows it.
export component ChannelHeaderItems inherits VerticalLayout {
    in property <string> channel;
    callback done();
    callback sections();
    callback notify();
    MenuItem { variant: MenuItemVariant.parity;
        label: @tr("See new posts at the top");
        checked: ChannelStore.newest-top;
        clicked => { ChannelStore.command("order", ChannelStore.newest-top ? "bottom" : "top"); root.done(); }
    }
    MenuItem { variant: MenuItemVariant.parity; label: @tr("Manage notifications"); chevron: true; clicked => { ListStore.command("channel-menu", root.channel); root.notify(); } }
    MenuItem { variant: MenuItemVariant.parity; label: @tr("Move to section"); chevron: true; clicked => { root.sections(); } }
    for t in TeamsStore.all-teams: VerticalLayout {
        for c in t.channels: VerticalLayout {
            if c.id == root.channel && !c.general: MenuItem { variant: MenuItemVariant.parity; label: @tr("Edit channel"); clicked => { root.done(); TeamsActions.open-dialog("edit-channel", t.id, c.id); } }
        }
    }
    MenuItem { variant: MenuItemVariant.parity; label: @tr("Copy link"); clicked => { ListStore.command("channel-link", root.channel); root.done(); } }
    for t in TeamsStore.all-teams: VerticalLayout {
        for c in t.channels: VerticalLayout {
            if c.id == root.channel: MenuItem { variant: MenuItemVariant.parity; label: @tr("Get email address"); clicked => { root.done(); TeamsActions.open-dialog("email", t.id, c.id); } }
        }
    }
    MenuItem { variant: MenuItemVariant.parity; label: @tr("Workflows"); clicked => { root.done(); FlowsStore.command("flows-enter", ""); } }
    for t in TeamsStore.all-teams: VerticalLayout {
        for c in t.channels: VerticalLayout {
            if c.id == root.channel && !c.general && (t.owner || c.owner): MenuItem { variant: MenuItemVariant.parity;
                label: @tr("Delete channel");
                danger: true;
                clicked => {
                    root.done();
                    TeamsActions.confirm(@tr("Delete {}? You can restore it for 21 days.", c.name), "channel-delete", t.id + "\u{1f}" + c.id);
                }
            }
        }
    }
}
