// Keyboard shortcuts like Teams (plan chat 5.9): the Ctrl+. dialog and the Rust helpers behind the
// window-level chords (src/shortcuts.rs). The chords themselves are routed in app.slint.
import { Theme } from "../tokens/theme.slint";
import { ChatRow, Msg } from "../tokens/types.slint";
import { SectionRow } from "lists.slint";
import { IconButton } from "../atoms/widgets.slint";
import { ScrollView } from "std-widgets.slint";
import { ShortcutStore } from "../stores/shortcut_store.slint";
import { Heading, HeadingVariant } from "../atoms/heading.slint";
import { Fixed } from "../tokens/fixed.slint";

export global ShortcutApi {
    // key text, control, alt, shift -> the action of a window-level chord, or ""
    pure callback action(string, bool, bool, bool) -> string;
    // key text, control, alt, shift, meta -> whether it is a plain E (or its Arabic-layout key)
    pure callback edit-key(string, bool, bool, bool, bool) -> bool;
    // the messages of the open chat -> the id of my newest editable one, or ""
    pure callback last-own([Msg]) -> string;
    // Catch-up (src/catch_up.rs). Both take the chat list as drawn: Favorites, sections, Chats, channels.
    // open chat, 0 = the chip / 1 = next / -1 = previous, the lists -> the unread chat to open, or ""
    pure callback catch-up-target(string, int, [ChatRow], [SectionRow], [ChatRow], [ChatRow]) -> string;
    // the lists -> [unread chats, of which mentions me]
    pure callback catch-up-counts([ChatRow], [SectionRow], [ChatRow], [ChatRow]) -> [int];
    // Shows a transient info notice.
    callback notify(string);
}

component Row inherits Rectangle {
    in property <string> keys;
    in property <string> what;
    // A row that does what it says when clicked (the command palette).
    in property <bool> link: false;
    callback activated();
    height: 28px;
    border-radius: 4px;
    background: root.link && ta.has-hover ? Theme.surface-hover : transparent;
    HorizontalLayout {
        spacing: 12px;
        Text { text: root.keys; color: Theme.mention; font-size: 13px * Theme.font-scale; font-weight: 600; vertical-alignment: center; width: 190px; overflow: elide; }
        Text { text: root.what; color: Theme.fg; font-size: 13px * Theme.font-scale; vertical-alignment: center; overflow: elide; }
    }
    ta := TouchArea { enabled: root.link; mouse-cursor: root.link ? MouseCursor.pointer : MouseCursor.default; clicked => { root.activated(); } }
}

export component ShortcutsDialog inherits Rectangle {
    callback close();
    callback open-palette();
    callback open-settings();
    // The chord of an action the user can rebind (Settings > Keyboard shortcuts).
    pure function k(id: string) -> string {
        return ShortcutStore.keys(id, ShortcutStore.version);
    }
    background: Fixed.black-b0;
    accessible-role: groupbox;
    accessible-label: "Keyboard shortcuts";
    // A click on the dim area closes the dialog.
    TouchArea { clicked => { root.close(); } }
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: max(20px, (parent.height - self.height) / 2);
        width: min(560px, parent.width - 40px);
        height: min(640px, parent.height - 40px);
        border-radius: 8px;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.border;
        // Keeps clicks inside the panel from closing it.
        TouchArea { }
        VerticalLayout {
            Rectangle {
                height: 52px;
                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 12px;
                    Text { text: "Keyboard shortcuts"; color: Theme.fg; font-size: 17px * Theme.font-scale; font-weight: 700; vertical-alignment: center; accessible-role: text; }
                    Rectangle { horizontal-stretch: 1; }
                    IconButton { icon: @image-url("../icons/close.svg"); tooltip: "Close shortcuts"; y: 10px; clicked => { root.close(); } }
                }
            }
            ScrollView {
                VerticalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    padding-bottom: 16px;
                    spacing: 0px;
                    Heading { variant: HeadingVariant.group; text: "General"; height: 28px; vertical-alignment: bottom; }
                    Row { keys: root.k("shortcuts"); what: "Show keyboard shortcuts"; }
                    Row { keys: root.k("palette"); what: "Command palette"; link: true; activated => { root.open-palette(); } }
                    Row { keys: root.k("search"); what: "Search"; }
                    Row { keys: root.k("goto"); what: "Go to a chat or channel"; }
                    Row { keys: root.k("new-chat"); what: "New chat"; }
                    Row { keys: root.k("settings"); what: @tr("Open Settings"); }
                    Row { keys: "Esc"; what: "Close the thread, popup or reply"; }
                    Heading { variant: HeadingVariant.group; text: "Navigation"; height: 28px; vertical-alignment: bottom; }
                    Row { keys: root.k("back") + " / " + root.k("forward"); what: "Back, forward"; }
                    Row { keys: root.k("search-box"); what: "Go to the search box"; }
                    Row { keys: root.k("commands"); what: "Show the list of commands"; }
                    Row { keys: "Ctrl+Shift+1 to 9"; what: "Open the nth app of the app bar"; }
                    Heading { variant: HeadingVariant.group; text: "Chat list"; height: 28px; vertical-alignment: bottom; }
                    Row { keys: root.k("filter-box"); what: "Filter the chat list"; }
                    Row { keys: root.k("filter-unread"); what: "Unread filter"; }
                    Row { keys: root.k("filter-chats"); what: "Chats filter"; }
                    Row { keys: root.k("filter-channels"); what: "Channels filter"; }
                    Row { keys: root.k("filter-clear"); what: "Clear filters"; }
                    Row { keys: "Shift+Esc"; what: "Mark all as read"; }
                    Row { keys: root.k("collapse-all"); what: "Collapse all sections"; }
                    Row { keys: root.k("next-unread"); what: "Next unread chat or channel"; }
                    Row { keys: root.k("previous-unread"); what: "Previous unread chat or channel"; }
                    Row { keys: root.k("next-unread-wrap"); what: @tr("Next unread chat (wraps around)"); }
                    Row { keys: root.k("previous-unread-wrap"); what: @tr("Previous unread chat (wraps around)"); }
                    Row { keys: root.k("unreads"); what: "Unreads: every unread message"; }
                    Heading { variant: HeadingVariant.group; text: "Messages"; height: 28px; vertical-alignment: bottom; }
                    Row { keys: root.k("focus-composer"); what: "Focus the compose box"; }
                    Row { keys: root.k("focus-messages"); what: "Focus the message pane"; }
                    Row { keys: root.k("find"); what: @tr("Find in chat or channel"); }
                    Row { keys: root.k("jump-first"); what: @tr("Jump to the first message of the chat"); }
                    Row { keys: root.k("expand-composer"); what: "Expand the composer"; }
                    Row { keys: root.k("attach-file"); what: "Attach a file"; }
                    Row { keys: "Ctrl+Shift+R"; what: "Record a voice message (Esc deletes it, Enter sends it)"; }
                    Row { keys: "Ctrl+Shift+I"; what: "Mark the next message as important"; }
                    Row { keys: "Up (empty composer)"; what: "Edit your last message"; }
                    Row { keys: "E (pointer over your message)"; what: @tr("Edit that message"); }
                    Row { keys: "R, F, S, P, U"; what: "In a message menu: reply, forward, save, pin, mark unread"; }
                    Heading { variant: HeadingVariant.group; text: "Calls"; height: 28px; vertical-alignment: bottom; }
                    Row { keys: root.k("audio-call"); what: "Audio call (1:1 chat)"; }
                    Row { keys: root.k("video-call"); what: "Video call (1:1 chat)"; }
                    Row { keys: root.k("share-screen"); what: "Share screen (1:1 chat)"; }
                    Heading { variant: HeadingVariant.group; text: "During a call"; height: 28px; vertical-alignment: bottom; }
                    Row { keys: "Ctrl+Shift+M"; what: "Mute or unmute"; }
                    Row { keys: "Ctrl+Shift+O"; what: "Turn the camera on or off"; }
                    Row { keys: "Ctrl+Shift+K"; what: "Raise or lower your hand"; }
                    Row { keys: "Ctrl+Shift+E"; what: "Start or stop sharing your screen"; }
                    Row { keys: "Ctrl+Shift+H / Ctrl+Shift+B"; what: "Leave the call"; }
                    Row { keys: "Esc"; what: "Leave full screen"; }
                    Heading { variant: HeadingVariant.group; text: "Formatting"; height: 28px; vertical-alignment: bottom; }
                    Row { keys: "Ctrl+B / I / U"; what: "Bold, italic, underline"; }
                    Row { keys: "Ctrl+Alt+X"; what: "Strikethrough"; }
                    Row { keys: "Ctrl+K"; what: "Insert link"; }
                    Row { keys: "Ctrl+Alt+Shift+C"; what: "Inline code"; }
                    Row { keys: "Ctrl+Alt+Shift+B"; what: "Code block"; }
                    Row { keys: "Ctrl+Alt+1 / 2 / 3"; what: "Heading 1, 2, 3"; }
                    Row { keys: "Ctrl+Alt+P"; what: "Paragraph"; }
                    Row { keys: "Ctrl+Alt+4"; what: "Quote"; }
                    Row { keys: "Ctrl+Shift+7 / 8"; what: "Numbered list, bullet list"; }
                    Row { keys: "Ctrl+Z / Ctrl+Y"; what: "Undo, redo"; }
                    Heading { variant: HeadingVariant.group; text: @tr("Customize"); height: 28px; vertical-alignment: bottom; }
                    Row { keys: ""; what: @tr("Change these shortcuts in Settings"); link: true; activated => { root.open-settings(); } }
                }
            }
        }
    }
}
