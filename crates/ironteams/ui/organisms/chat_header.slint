// The chat header's "More chat options" (…) menu, as in Teams: Share screen, Mark as unread,
// Move to section, Mute, Copy link and Remove chat history, and the confirmation of the last one.
// Every item reuses what the chat list's item menu and the call buttons already send. When the
// header is narrow, its participants, find and details buttons are items here, with "Create
// and share content" from the details pane ("In this chat").
// A channel's header has Teams' channel items instead (see `ChannelHeaderItems`).
import { Theme } from "../tokens/theme.slint";
import { IconButton } from "../atoms/widgets.slint";
import { ListStore } from "lists.slint";
import { DirectCallStore } from "call_incoming.slint";
import { PeopleStore } from "../molecules/people.slint";
import { FindStore } from "../stores/find_store.slint";
import { ComposerApps } from "composer_apps.slint";
import { ChannelHeaderItems } from "web_parity.slint";
import { MenuItem, MenuItemVariant } from "../atoms/menu.slint";
import { Fixed } from "../tokens/fixed.slint";

export global ChatHeaderStore {
    // The chat whose "Remove chat history" waits for confirmation, or "".
    in-out property <string> remove-history;
}

// The menu itself (inside the button's popup).
export component HeaderMenu inherits Rectangle {
    in property <string> chat-id;
    in property <bool> muted;
    // A channel: Teams' channel items, none of the chat items.
    in property <bool> channel: false;
    // The header's buttons that did not fit.
    in property <bool> extras: false;
    callback mark-unread();
    callback schedule-meeting();
    callback done();
    // Share screen calls the other person, so only a 1:1 chat in a build with calls can use it;
    // other chats show it greyed out, as Teams does outside a call.
    property <bool> can-share: !root.channel && DirectCallStore.available && DirectCallStore.is-direct(root.chat-id);
    property <bool> can-people: !root.channel && (PeopleStore.header-group || PeopleStore.member-count > 0);
    property <string> view: "main";
    out property <length> menu-height: lay.preferred-height + 2px;
    background: Theme.surface;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.border;
    accessible-role: groupbox;
    accessible-label: root.channel ? @tr("More channel options") : @tr("More chat options");
    lay := VerticalLayout {
        padding: 4px;
        if root.view == "main" && root.extras: VerticalLayout {
            if root.can-people: MenuItem { variant: MenuItemVariant.header;
                label: @tr("View and add participants");
                clicked => {
                    PeopleStore.participants-open = true;
                    PeopleStore.command("participants-open", "");
                    root.done();
                }
            }
            MenuItem { variant: MenuItemVariant.header;
                label: root.channel ? @tr("Find in channel") : @tr("Find in chat");
                clicked => {
                    FindStore.chat-find-open = true;
                    FindStore.chat-find-tick += 1;
                    FindStore.command("find-open", "");
                    root.done();
                }
            }
            MenuItem { variant: MenuItemVariant.header;
                label: @tr("Open chat details");
                clicked => {
                    FindStore.details-open = !FindStore.details-open;
                    FindStore.command("details", FindStore.details-open ? "open" : "close");
                    root.done();
                }
            }
            MenuItem { variant: MenuItemVariant.header;
                label: @tr("Create and share content");
                clicked => {
                    ComposerApps.open = true;
                    ComposerApps.command("list", "");
                    root.done();
                }
            }
        }
        if root.view == "main" && root.channel: ChannelHeaderItems {
            channel: root.chat-id;
            done => { root.done(); }
            sections => { root.view = "sections"; }
            notify => { root.view = "notify"; }
        }
        if root.view == "main" && !root.channel: VerticalLayout {
            MenuItem { variant: MenuItemVariant.header; label: @tr("Schedule a meeting"); clicked => { root.schedule-meeting(); root.done(); } }
            MenuItem { variant: MenuItemVariant.header;
                label: @tr("Share screen");
                keys: root.can-share ? "Ctrl+Shift+E" : "";
                enabled: root.can-share;
                clicked => {
                    DirectCallStore.command("share-screen", root.chat-id);
                    root.done();
                }
            }
            MenuItem { variant: MenuItemVariant.header; label: @tr("Mark as unread"); clicked => { root.mark-unread(); root.done(); } }
            MenuItem { variant: MenuItemVariant.header; label: @tr("Move to section"); chevron: true; clicked => { root.view = "sections"; } }
            MenuItem { variant: MenuItemVariant.header;
                label: root.muted ? @tr("Unmute") : @tr("Mute");
                clicked => {
                    ListStore.command(root.muted ? "unmute" : "mute", root.chat-id);
                    root.done();
                }
            }
            MenuItem { variant: MenuItemVariant.header; label: @tr("Copy link"); clicked => { ListStore.command("copy-link", root.chat-id); root.done(); } }
            // The chat's history: back to its very first message, or to a day.
            MenuItem { variant: MenuItemVariant.header;
                label: @tr("Jump to first message");
                keys: "Ctrl+Alt+Home";
                clicked => {
                    PeopleStore.command("jump-first", "");
                    root.done();
                }
            }
            MenuItem { variant: MenuItemVariant.header;
                label: @tr("Jump to a date");
                clicked => {
                    PeopleStore.jump-date-open = true;
                    root.done();
                }
            }
            MenuItem { variant: MenuItemVariant.header;
                label: @tr("Remove chat history");
                danger: true;
                clicked => {
                    ChatHeaderStore.remove-history = root.chat-id;
                    root.done();
                }
            }
        }
        if root.view == "notify": VerticalLayout {
            MenuItem { variant: MenuItemVariant.header; label: @tr("‹ Manage notifications"); clicked => { root.view = "main"; } }
            MenuItem { variant: MenuItemVariant.header; label: @tr("All activity"); checked: ListStore.channel-level == "all"; clicked => { ListStore.command("channel-notify", root.chat-id + "\u{9}all"); root.done(); } }
            MenuItem { variant: MenuItemVariant.header; label: @tr("Only show in the feed"); checked: ListStore.channel-level == "feed"; clicked => { ListStore.command("channel-notify", root.chat-id + "\u{9}feed"); root.done(); } }
            MenuItem { variant: MenuItemVariant.header; label: @tr("Off"); checked: ListStore.channel-level == "off"; clicked => { ListStore.command("channel-notify", root.chat-id + "\u{9}off"); root.done(); } }
        }
        if root.view == "sections": VerticalLayout {
            MenuItem { variant: MenuItemVariant.header; label: @tr("‹ Move to section"); clicked => { root.view = "main"; } }
            for c in ListStore.choices: MenuItem { variant: MenuItemVariant.header;
                label: c.name;
                clicked => {
                    ListStore.command("move", root.chat-id + "\u{9}" + c.id);
                    root.done();
                }
            }
            MenuItem { variant: MenuItemVariant.header;
                label: @tr("New section");
                clicked => {
                    ListStore.dialog-target = root.chat-id;
                    ListStore.dialog-text = "";
                    ListStore.dialog = "new-section";
                    root.done();
                }
            }
        }
    }
}

// The "…" button of the header and its menu.
export component HeaderMoreButton inherits Rectangle {
    in property <string> chat-id;
    in property <bool> muted;
    in property <bool> channel: false;
    in property <bool> extras: false;
    callback mark-unread();
    callback schedule-meeting();
    width: 32px;
    height: 32px;
    more-btn := IconButton {
        icon: @image-url("../icons/more.svg");
        tooltip: root.channel ? @tr("More channel options") : @tr("More chat options");
        clicked => { more-popup.show(); }
    }
    more-popup := PopupWindow {
        x: root.width - 240px;
        y: root.height + 4px;
        width: 240px;
        height: menu.menu-height;
        close-policy: close-on-click-outside;
        menu := HeaderMenu {
            chat-id: root.chat-id;
            muted: root.muted;
            channel: root.channel;
            extras: root.extras;
            mark-unread => { root.mark-unread(); }
            schedule-meeting => { root.schedule-meeting(); }
            done => { more-popup.close(); }
        }
    }
}

// "Remove chat history?" before the history goes.
export component RemoveHistoryConfirm inherits Rectangle {
    callback confirm();
    callback cancel();
    width: 400px;
    height: 160px;
    border-radius: 8px;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    drop-shadow-blur: 16px;
    drop-shadow-color: Fixed.black-a0;
    accessible-role: groupbox;
    accessible-label: @tr("Remove chat history?");
    VerticalLayout {
        padding: 16px;
        spacing: 8px;
        Text { text: @tr("Remove chat history?"); color: Theme.fg; font-size: 17px * Theme.font-scale; font-weight: 700; }
        Text { text: @tr("The messages so far will be removed for you only. The other people in the chat keep them."); color: Theme.fg-muted; font-size: 13px * Theme.font-scale; wrap: word-wrap; vertical-stretch: 1; }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            height: 32px;
            cancel-btn := Rectangle {
                width: 80px;
                border-radius: 4px;
                background: cancel-touch.has-hover ? Theme.surface-hover.brighter(0.2) : Theme.surface-hover;
                accessible-role: button;
                accessible-label: @tr("Cancel");
                accessible-action-default => { root.cancel(); }
                Text { text: @tr("Cancel"); color: Theme.fg; font-size: 13px * Theme.font-scale; horizontal-alignment: center; vertical-alignment: center; accessible-role: none; }
                cancel-touch := TouchArea { mouse-cursor: pointer; clicked => { root.cancel(); } }
            }
            remove-btn := Rectangle {
                width: 90px;
                border-radius: 4px;
                background: remove-touch.has-hover ? Theme.danger-hover : Theme.danger;
                accessible-role: button;
                accessible-label: @tr("Remove");
                accessible-action-default => { root.confirm(); }
                Text { text: @tr("Remove"); color: Theme.on-danger; font-size: 13px * Theme.font-scale; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; accessible-role: none; }
                remove-touch := TouchArea { mouse-cursor: pointer; clicked => { root.confirm(); } }
            }
        }
    }
}
