// The send button's options, as in Teams: right-click Send (or its chevron) for "Schedule message"
// and "Set delivery options" (Standard, Important, Urgent). A chosen send time shows as a banner
// above the box; the open chat's scheduled messages show as "Sending on …" bubbles at the bottom
// of the conversation with Edit and Delete. Rust (src/send_options.rs, backend/scheduled.rs)
// gives the day and time words and keeps the scheduled messages.
import { Theme } from "../tokens/theme.slint";
import { Icon, IconButton } from "../atoms/widgets.slint";

export struct ScheduledItem {
    id: string,     // client message id
    label: string,  // "Sending on Fri, Nov 21 at 8:00 AM"
    text: string,
}

// A one-click choice in the picker ("Tomorrow 9:00 AM"): the day (0 is today) and the minutes
// after midnight it fills in.
export struct QuickChoice {
    label: string,
    day: int,
    minutes: int,
}

// A day of the picker's month calendar. `day` counts from today; `enabled` is today through 60
// days ahead.
export struct PickCell {
    number: int,
    day: int,
    label: string,
    in-month: bool,
    enabled: bool,
    today: bool,
}

export global SendStore {
    // The send time chosen for the next message (ms since 1970 as text); "" sends now.
    in-out property <string> schedule-at;
    in-out property <string> schedule-label;
    // The picker: days from today and minutes after midnight (Teams' default: tomorrow 8:00 AM).
    in-out property <int> pick-day: 1;
    in-out property <int> pick-minutes: 480;
    // The open chat's scheduled messages.
    in property <[ScheduledItem]> scheduled;
    pure callback day-label(int) -> string;
    pure callback time-label(int) -> string;
    // The picked day and time as ms (text), "" when it is not in the future.
    pure callback resolve(int, int) -> string;
    pure callback when-label(string) -> string;
    // Minutes after midnight for a typed time ("8:35 pm", "20:35", "835"), -1 when it is not one.
    pure callback parse-time(string) -> int;
    // The month calendar: its 42 days, title and the month (counted from this one) of a day; and
    // whether a month may be shown.
    pure callback month-cells(int) -> [PickCell];
    pure callback month-title(int) -> string;
    pure callback month-of(int) -> int;
    pure callback month-ok(int) -> bool;
    // The quick choices ("In 1 hour", ...), filled by `refresh` each time the picker opens.
    in property <[QuickChoice]> quick;
    callback refresh();
    in-out property <bool> cal-open: false;
    in-out property <int> cal-month: 0;
    // The typed time was not a time.
    in-out property <bool> time-error: false;
    in-out property <int> open-count: 0;
    // The picker opens: back to the time view, the choices up to date.
    public function open() {
        cal-open = false;
        cal-month = 0;
        time-error = false;
        open-count += 1;
        refresh();
    }
    // schedule <ms>\t<text> | edit <id> | delete <id>
    callback command(string, string);
}

component SendOptionRow inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    in property <bool> checked: false;
    in property <bool> chevron: false;
    in property <bool> checkable: false;
    callback clicked();
    height: root.detail != "" ? 48px : 32px;
    border-radius: 4px;
    background: touch.has-hover ? Theme.surface-hover : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-description: root.detail;
    accessible-checkable: root.checkable;
    accessible-checked: root.checked;
    accessible-action-default => { root.clicked(); }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        if root.checkable: Text { width: 14px; text: root.checked ? "✓" : ""; color: Theme.accent; font-size: 13px * Theme.font-scale; vertical-alignment: center; accessible-role: none; }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text { text: root.label; color: Theme.fg; font-size: 13px * Theme.font-scale; overflow: elide; accessible-role: none; }
            if root.detail != "": Text { text: root.detail; color: Theme.fg-subtle; font-size: 11px * Theme.font-scale; wrap: word-wrap; accessible-role: none; }
        }
        if root.chevron: Icon { source: @image-url("../icons/chevron-right.svg"); width: 14px; height: 14px; y: (parent.height - 14px) / 2; }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// Send, with the chevron that opens its options. A right-click on Send opens them too.
export component SendButton inherits HorizontalLayout {
    in property <bool> ready;
    callback send();
    callback options();
    spacing: 0px;
    send-btn := Rectangle {
        width: 32px;
        height: 32px;
        border-radius: 4px;
        background: touch.has-hover ? Theme.surface-hover : transparent;
        accessible-role: button;
        accessible-label: @tr("Send");
        accessible-action-default => { root.send(); }
        Icon { source: @image-url("../icons/send.svg"); width: 19px; height: 19px; tint: root.ready ? Theme.accent : Theme.fg-subtle; }
        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.send(); }
            pointer-event(e) => {
                if e.button == PointerEventButton.right && e.kind == PointerEventKind.up { root.options(); }
            }
        }
    }
    options-btn := Rectangle {
        width: 18px;
        height: 32px;
        border-radius: 4px;
        background: options-touch.has-hover ? Theme.surface-hover : transparent;
        accessible-role: button;
        accessible-label: @tr("Send options");
        accessible-action-default => { root.options(); }
        Icon { source: @image-url("../icons/chevron-down.svg"); width: 12px; height: 12px; }
        options-touch := TouchArea { mouse-cursor: pointer; clicked => { root.options(); } }
    }
}

// The contents of the send options menu: the two entries, then the delivery choices. The popup
// above Send keeps the height of the taller view, and the menu sits at its bottom, next to Send.
export component SendMenu inherits Rectangle {
    // "Schedule message" is offered (a chat, not a channel post or a reply).
    in property <bool> can-schedule: true;
    in-out property <bool> important;
    in-out property <bool> urgent;
    callback schedule();
    callback done();
    property <string> view: "main";
    out property <length> menu-height: 32px + 3 * 48px + 8px;
    accessible-role: groupbox;
    accessible-label: @tr("Send options");
    panel := Rectangle {
        y: parent.height - self.height;
        height: (root.view == "main" ? (root.can-schedule ? 2 : 1) * 32px : 32px + 3 * 48px) + 8px;
        background: Theme.surface;
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.border;
    }
    VerticalLayout {
        y: panel.y;
        height: panel.height;
        padding: 4px;
        if root.view == "main": VerticalLayout {
            if root.can-schedule: SendOptionRow { label: @tr("Schedule message"); clicked => { root.schedule(); } }
            SendOptionRow { label: @tr("Set delivery options"); chevron: true; clicked => { root.view = "delivery"; } }
        }
        if root.view == "delivery": VerticalLayout {
            SendOptionRow { label: @tr("‹ Set delivery options"); clicked => { root.view = "main"; } }
            SendOptionRow {
                label: @tr("Standard");
                detail: @tr("Delivered as usual");
                checkable: true;
                checked: !root.important && !root.urgent;
                clicked => { root.important = false; root.urgent = false; root.done(); }
            }
            SendOptionRow {
                label: @tr("Important");
                detail: @tr("Marked IMPORTANT! for the recipients");
                checkable: true;
                checked: root.important;
                clicked => { root.important = true; root.urgent = false; root.done(); }
            }
            SendOptionRow {
                label: @tr("Urgent");
                detail: @tr("Recipients are notified every 2 minutes for 20 minutes");
                checkable: true;
                checked: root.urgent;
                clicked => { root.urgent = true; root.important = false; root.done(); }
            }
        }
    }
}

// A quick choice of the picker ("Tomorrow 9:00 AM"): one click fills the day and the time.
component QuickChip inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    callback clicked();
    border-radius: 15px;
    border-width: 1px;
    border-color: root.active ? Theme.accent : Theme.border;
    background: touch.has-hover ? Theme.surface-hover : Theme.sidebar;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    Text {
        x: 10px;
        y: 0px;
        width: parent.width - 20px;
        height: parent.height;
        text: root.label;
        color: Theme.fg;
        font-size: 12px * Theme.font-scale;
        overflow: elide;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// "‹ h ›" or "‹ m ›": the hour or the minute one step earlier or later.
component UnitStep inherits HorizontalLayout {
    in property <string> unit;
    in property <string> what;
    callback back();
    callback next();
    spacing: 0px;
    IconButton { icon: @image-url("../icons/chevron-left.svg"); size: 26px; tooltip: @tr("Earlier {}", root.what); clicked => { root.back(); } }
    Text { width: 14px; text: root.unit; color: Theme.fg-subtle; font-size: 12px * Theme.font-scale; horizontal-alignment: center; vertical-alignment: center; accessible-role: none; }
    IconButton { icon: @image-url("../icons/chevron-right.svg"); size: 26px; tooltip: @tr("Later {}", root.what); clicked => { root.next(); } }
}

// "Send this message on": quick choices, a day (‹ › or a month calendar) and a time (typed, or
// stepped by the hour and the minute; Up and Down move it a minute, Shift 15), then Continue.
export component SchedulePicker inherits Rectangle {
    callback done();
    property <string> picked: SendStore.resolve(SendStore.pick-day, SendStore.pick-minutes);
    property <bool> can-go: root.picked != "" && !SendStore.time-error;
    // The text the time field last showed by itself; the field differs from it while it is typed in.
    property <string> shown;
    property <bool> dirty: time-input.text != root.shown;
    // Written back to the field whenever the time changes (a chip, a stepper) or the picker opens.
    property <int> mins: SendStore.pick-minutes;
    property <int> opens: SendStore.open-count;
    property <length> chip-w: (root.width - 28px - 6px) / 2;
    property <length> cell-w: (root.width - 28px) / 7;
    property <[PickCell]> cells: SendStore.month-cells(SendStore.cal-month);
    property <[string]> heads: [@tr("M"), @tr("T"), @tr("W"), @tr("T"), @tr("F"), @tr("S"), @tr("S")];
    width: 320px;
    height: 322px;
    background: Theme.surface;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.border;
    accessible-role: groupbox;
    accessible-label: @tr("Send this message on");
    init => { root.sync(); }
    changed mins => { root.sync(); }
    changed opens => { root.sync(); }

    // The field shows the picked time again, and the error is gone.
    function sync() {
        time-input.text = SendStore.time-label(SendStore.pick-minutes);
        root.shown = time-input.text;
        SendStore.time-error = false;
    }
    // Takes what was typed: the picked time becomes that time. False (and an error) when it is
    // not a time; the picked time stays as it was.
    function commit() -> bool {
        if time-input.text == root.shown {
            return true;
        }
        let m = SendStore.parse-time(time-input.text);
        if m < 0 {
            SendStore.time-error = true;
            return false;
        }
        SendStore.pick-minutes = m;
        root.sync();
        return true;
    }
    // The field lost focus: take what was typed, or go back to the last good time.
    function leave() {
        if !root.commit() {
            time-input.text = root.shown;
        }
    }
    // `delta` minutes later (earlier when negative) around the clock; the day stays.
    function step(delta: int) {
        root.commit();
        SendStore.pick-minutes = mod(SendStore.pick-minutes + 1440 + delta, 1440);
        root.sync();
    }
    function open-calendar() {
        SendStore.cal-month = SendStore.month-of(SendStore.pick-day);
        SendStore.cal-open = true;
    }
    function choose(day: int) {
        SendStore.pick-day = day;
        SendStore.cal-open = false;
    }
    function confirm() {
        if !root.commit() {
            return;
        }
        if root.picked != "" {
            SendStore.schedule-at = root.picked;
            SendStore.schedule-label = SendStore.when-label(root.picked);
            root.done();
        }
    }

    Rectangle {
        visible: !SendStore.cal-open;
        VerticalLayout {
            padding: 14px;
            spacing: 8px;
            Text { height: 20px; text: @tr("Send this message on"); color: Theme.fg; font-size: 15px * Theme.font-scale; font-weight: 700; overflow: elide; horizontal-alignment: Theme.start-align; }
            Rectangle {
                height: 66px;
                for q[i] in SendStore.quick: QuickChip {
                    x: mod(i, 2) * (root.chip-w + 6px);
                    y: Math.floor(i / 2) * 36px;
                    width: root.chip-w;
                    height: 30px;
                    label: q.label;
                    active: SendStore.pick-day == q.day && SendStore.pick-minutes == q.minutes;
                    clicked => {
                        SendStore.pick-day = q.day;
                        SendStore.pick-minutes = q.minutes;
                    }
                }
            }
            // The day: ‹ › by one day, or the label for a month calendar.
            HorizontalLayout {
                height: 32px;
                spacing: 6px;
                IconButton { icon: @image-url("../icons/chevron-left.svg"); size: 28px; tooltip: @tr("Earlier day"); clicked => { SendStore.pick-day = max(0, SendStore.pick-day - 1); } }
                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 4px;
                    background: date-touch.has-hover ? Theme.surface-hover : Theme.sidebar;
                    border-width: 1px;
                    border-color: Theme.border;
                    accessible-role: button;
                    accessible-label: SendStore.day-label(SendStore.pick-day);
                    accessible-description: @tr("Choose a date");
                    accessible-action-default => { root.open-calendar(); }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 6px;
                        Text { horizontal-stretch: 1; text: SendStore.day-label(SendStore.pick-day); color: Theme.fg; font-size: 13px * Theme.font-scale; overflow: elide; horizontal-alignment: center; vertical-alignment: center; accessible-role: none; }
                        Icon { source: @image-url("../icons/calendar.svg"); width: 14px; height: 14px; y: (parent.height - 14px) / 2; tint: Theme.fg-muted; }
                    }
                    date-touch := TouchArea { mouse-cursor: pointer; clicked => { root.open-calendar(); } }
                }
                IconButton { icon: @image-url("../icons/chevron-right.svg"); size: 28px; tooltip: @tr("Later day"); clicked => { SendStore.pick-day = min(60, SendStore.pick-day + 1); } }
            }
            // The time: type it, or step the hour and the minute.
            HorizontalLayout {
                height: 32px;
                spacing: 6px;
                FocusScope {
                    horizontal-stretch: 1;
                    capture-key-pressed(event) => {
                        if event.text == Key.UpArrow || event.text == Key.DownArrow {
                            root.step((event.modifiers.shift ? 15 : 1) * (event.text == Key.UpArrow ? 1 : -1));
                            return accept;
                        }
                        if event.text == Key.Return {
                            // A second Enter on a time that is already taken goes on.
                            if root.dirty || SendStore.time-error {
                                root.commit();
                            } else {
                                root.confirm();
                            }
                            return accept;
                        }
                        if event.text == Key.Escape { root.done(); return accept; }
                        reject
                    }
                    Rectangle {
                        border-radius: 4px;
                        background: Theme.sidebar;
                        border-width: 1px;
                        border-color: SendStore.time-error ? Theme.danger : (time-input.has-focus ? Theme.accent : Theme.border);
                        time-input := TextInput {
                            x: 10px;
                            width: parent.width - 20px;
                            height: parent.height;
                            color: Theme.fg;
                            font-size: 13px * Theme.font-scale;
                            single-line: true;
                            vertical-alignment: center;
                            horizontal-alignment: Theme.start-align;
                            accessible-role: text-input;
                            accessible-label: @tr("Time");
                            edited => { SendStore.time-error = false; }
                            changed has-focus => { if !self.has-focus { root.leave(); } }
                        }
                        // The first click focuses the field with its time selected, so typing replaces it.
                        if !time-input.has-focus: TouchArea {
                            mouse-cursor: MouseCursor.text;
                            clicked => { time-input.focus(); time-input.select-all(); }
                        }
                    }
                }
                UnitStep { unit: @tr("h"); what: @tr("hour"); back => { root.step(-60); } next => { root.step(60); } }
                UnitStep { unit: @tr("m"); what: @tr("minute"); back => { root.step(-1); } next => { root.step(1); } }
            }
            VerticalLayout {
                vertical-stretch: 1;
                spacing: 2px;
                Text { height: 16px; text: SendStore.time-error ? @tr("Not a time. Try 8:35 PM or 20:35.") : (root.picked == "" ? @tr("Pick a time in the future") : ""); color: Theme.danger; font-size: 11px * Theme.font-scale; overflow: elide; horizontal-alignment: Theme.start-align; }
                Text { height: 16px; text: root.picked != "" ? @tr("Sends {}", SendStore.when-label(root.picked)) : ""; color: Theme.fg-muted; font-size: 12px * Theme.font-scale; overflow: elide; horizontal-alignment: Theme.start-align; }
            }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                cancel-btn := Rectangle {
                    width: 80px;
                    height: 30px;
                    border-radius: 4px;
                    background: cancel-touch.has-hover ? Theme.surface-hover : transparent;
                    border-width: 1px;
                    border-color: Theme.border;
                    accessible-role: button;
                    accessible-label: @tr("Cancel");
                    accessible-action-default => { root.done(); }
                    Text { text: @tr("Cancel"); color: Theme.fg; font-size: 13px * Theme.font-scale; horizontal-alignment: center; vertical-alignment: center; accessible-role: none; }
                    cancel-touch := TouchArea { mouse-cursor: pointer; clicked => { root.done(); } }
                }
                continue-btn := Rectangle {
                    width: 90px;
                    height: 30px;
                    border-radius: 4px;
                    background: !root.can-go ? Theme.surface-hover : (continue-touch.has-hover ? Theme.accent.brighter(0.1) : Theme.accent-strong);
                    accessible-role: button;
                    accessible-label: @tr("Continue");
                    accessible-enabled: root.can-go;
                    accessible-action-default => { root.confirm(); }
                    Text { text: @tr("Continue"); color: !root.can-go ? Theme.fg-subtle : #ffffff; font-size: 13px * Theme.font-scale; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; accessible-role: none; }
                    continue-touch := TouchArea { mouse-cursor: !root.can-go ? MouseCursor.default : MouseCursor.pointer; clicked => { root.confirm(); } }
                }
            }
        }
    }

    // The month calendar, in place of the rest: today through 60 days ahead can be picked.
    if SendStore.cal-open: VerticalLayout {
        padding: 14px;
        spacing: 6px;
        HorizontalLayout {
            height: 32px;
            spacing: 4px;
            if SendStore.month-ok(SendStore.cal-month - 1): IconButton { icon: @image-url("../icons/chevron-left.svg"); size: 28px; tooltip: @tr("Previous month"); clicked => { SendStore.cal-month -= 1; } }
            if !SendStore.month-ok(SendStore.cal-month - 1): Rectangle { width: 28px; }
            Text { horizontal-stretch: 1; text: SendStore.month-title(SendStore.cal-month); color: Theme.fg; font-size: 14px * Theme.font-scale; font-weight: 700; overflow: elide; horizontal-alignment: center; vertical-alignment: center; }
            if SendStore.month-ok(SendStore.cal-month + 1): IconButton { icon: @image-url("../icons/chevron-right.svg"); size: 28px; tooltip: @tr("Next month"); clicked => { SendStore.cal-month += 1; } }
            if !SendStore.month-ok(SendStore.cal-month + 1): Rectangle { width: 28px; }
        }
        Rectangle {
            height: 20px + 6 * 28px;
            for l[i] in root.heads: Text {
                x: i * root.cell-w;
                y: 0px;
                width: root.cell-w;
                height: 20px;
                text: l;
                color: Theme.fg-subtle;
                font-size: 11px * Theme.font-scale;
                horizontal-alignment: center;
                vertical-alignment: center;
                accessible-role: none;
            }
            for c[i] in root.cells: Rectangle {
                x: mod(i, 7) * root.cell-w;
                y: 20px + Math.floor(i / 7) * 28px;
                width: root.cell-w;
                height: 28px;
                accessible-role: button;
                accessible-label: c.label;
                accessible-enabled: c.enabled;
                accessible-checkable: true;
                accessible-checked: c.day == SendStore.pick-day;
                accessible-action-default => { if c.enabled { root.choose(c.day); } }
                Rectangle {
                    width: 24px;
                    height: 24px;
                    x: (parent.width - 24px) / 2;
                    y: (parent.height - 24px) / 2;
                    border-radius: 12px;
                    border-width: c.today ? 1px : 0px;
                    border-color: Theme.accent;
                    background: c.enabled && c.day == SendStore.pick-day ? Theme.accent-strong : (c.enabled && cell-touch.has-hover ? Theme.surface-hover : transparent);
                    Text {
                        text: c.number;
                        color: c.enabled && c.day == SendStore.pick-day ? #ffffff : (c.in-month ? Theme.fg : Theme.fg-muted);
                        opacity: c.enabled ? 1.0 : 0.4;
                        font-size: 12px * Theme.font-scale;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        accessible-role: none;
                    }
                }
                cell-touch := TouchArea {
                    enabled: c.enabled;
                    mouse-cursor: c.enabled ? MouseCursor.pointer : MouseCursor.default;
                    clicked => { root.choose(c.day); }
                }
            }
        }
        Text { height: 16px; text: @tr("Up to 60 days ahead."); color: Theme.fg-subtle; font-size: 11px * Theme.font-scale; overflow: elide; horizontal-alignment: Theme.start-align; }
        Rectangle { vertical-stretch: 1; }
        HorizontalLayout {
            alignment: end;
            Rectangle {
                width: 80px;
                height: 30px;
                border-radius: 4px;
                background: back-touch.has-hover ? Theme.surface-hover : transparent;
                border-width: 1px;
                border-color: Theme.border;
                accessible-role: button;
                accessible-label: @tr("Back");
                accessible-action-default => { SendStore.cal-open = false; }
                Text { text: @tr("Back"); color: Theme.fg; font-size: 13px * Theme.font-scale; horizontal-alignment: center; vertical-alignment: center; accessible-role: none; }
                back-touch := TouchArea { mouse-cursor: pointer; clicked => { SendStore.cal-open = false; } }
            }
        }
    }
}

// Above the box while a send time is chosen: "Select Send to deliver on … at …" with a clear.
export component ScheduleBanner inherits Rectangle {
    height: 30px;
    accessible-role: groupbox;
    accessible-label: @tr("Select Send to deliver on {}", SendStore.schedule-label);
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 6px;
        spacing: 6px;
        Icon { source: @image-url("../icons/history.svg"); width: 14px; height: 14px; y: 5px; tint: Theme.accent; }
        Text {
            text: @tr("Select Send to deliver on {}", SendStore.schedule-label);
            color: Theme.fg-muted;
            font-size: 12px * Theme.font-scale;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
            accessible-role: none;
        }
        IconButton {
            icon: @image-url("../icons/close.svg");
            size: 24px;
            tooltip: @tr("Don't schedule");
            clicked => {
                SendStore.schedule-at = "";
                SendStore.schedule-label = "";
            }
        }
    }
}

// The open chat's scheduled messages, at the bottom of the conversation (right-aligned like my
// own messages), each with Edit and Delete.
export component ScheduledList inherits VerticalLayout {
    in property <length> max-bubble: 520px;
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 4px;
    spacing: 6px;
    for s in SendStore.scheduled: HorizontalLayout {
        alignment: end;
        bubble := Rectangle {
            width: min(root.max-bubble, max(280px, bubble-text.preferred-width + 24px));
            height: bubble-col.preferred-height;
            border-radius: 6px;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            accessible-role: groupbox;
            accessible-label: s.label;
            accessible-description: s.text;
            bubble-col := VerticalLayout {
                padding: 8px;
                padding-left: 12px;
                spacing: 2px;
                HorizontalLayout {
                    spacing: 6px;
                    Icon { source: @image-url("../icons/history.svg"); width: 14px; height: 14px; y: 6px; tint: Theme.fg-subtle; }
                    Text { text: s.label; color: Theme.fg-subtle; font-size: 11px * Theme.font-scale; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; accessible-role: none; }
                    IconButton { icon: @image-url("../icons/edit.svg"); size: 26px; tooltip: @tr("Edit"); clicked => { SendStore.command("edit", s.id); } }
                    IconButton { icon: @image-url("../icons/trash.svg"); size: 26px; tooltip: @tr("Delete"); clicked => { SendStore.command("delete", s.id); } }
                }
                bubble-text := Text { text: s.text; color: Theme.fg; font-size: 14px * Theme.font-scale; wrap: word-wrap; accessible-role: none; }
            }
        }
    }
}
