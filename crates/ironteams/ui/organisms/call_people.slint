// The call window's side panels: People (the roster, with the lobby) and More (record and
// transcribe, live captions, device settings).
import { ScrollView } from "std-widgets.slint";
import { Theme } from "../tokens/theme.slint";
import { Avatar, Icon, IconButton } from "../atoms/widgets.slint";
import { CallStore, CallPerson, CallFound } from "../stores/call_store.slint";
import { DeviceSettings } from "../molecules/call_widgets.slint";
import { PersonHover } from "../molecules/people.slint";
import { VideoFxStore } from "../stores/video_fx_store.slint";
import { VideoEffectsPanel } from "video_effects.slint";
import { Button, ButtonVariant } from "../atoms/button.slint";
import { Switch, SwitchVariant } from "../atoms/check.slint";

component PersonRow inherits Rectangle {
    in property <CallPerson> p;
    height: 44px;
    accessible-role: list-item;
    accessible-label: CallStore.tagged-name(root.p);
    accessible-description: (root.p.lobby ? "In lobby" : root.p.muted ? "Muted" : "Unmuted")
        + (root.p.hand ? ", hand raised" : "")
        + (root.p.role != "" ? ", " + root.p.role : "");
    HorizontalLayout {
        spacing: 10px;
        Avatar {
            initials: root.p.initials;
            img: root.p.photo;
            has-img: root.p.has-photo;
            size: 30px;
            y: 7px;
            if !root.p.me && root.p.id != "": PersonHover { person: root.p.id; }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: CallStore.tagged-name(root.p) + (root.p.me ? " (You)" : "");
                color: Theme.fg;
                font-size: 13px * Theme.font-scale;
                overflow: elide;
            }
            if root.p.role == "organizer" || root.p.role == "presenter": Text {
                text: root.p.role == "organizer" ? "Organizer" : "Presenter";
                color: Theme.fg-subtle;
                font-size: 11px * Theme.font-scale;
                overflow: elide;
            }
        }
        if root.p.reaction != "": Text {
            text: root.p.reaction;
            font-size: 18px;
            vertical-alignment: center;
            accessible-role: text;
            accessible-label: root.p.name + "'s reaction: " + root.p.reaction-name;
        }
        if root.p.hand: Icon {
            source: @image-url("../icons/hand.svg");
            tint: Theme.accent;
            y: 12px;
        }
        if root.p.lobby && CallStore.can-admit: VerticalLayout {
            alignment: center;
            Button { variant: ButtonVariant.solid;
                accessible-label: "Admit " + CallStore.tagged-name(root.p);
                label: "Admit";
                clicked => { CallStore.command("admit", root.p.id); }
            }
        }
        if !root.p.lobby: Icon {
            source: root.p.muted ? @image-url("../icons/mic-off.svg") : @image-url("../icons/mic.svg");
            tint: root.p.muted ? Theme.fg-subtle : Theme.fg;
            y: 12px;
        }
    }
}

component PanelHeader inherits HorizontalLayout {
    in property <string> title;
    height: 32px;
    Text {
        text: root.title;
        color: Theme.fg;
        font-size: 15px * Theme.font-scale;
        font-weight: 600;
        vertical-alignment: center;
        horizontal-stretch: 1;
        overflow: elide;
    }
    IconButton {
        icon: @image-url("../icons/close.svg");
        tooltip: "Close " + root.title;
        size: 28px;
        clicked => { CallStore.panel = ""; }
    }
}

// A people search box with its results under it: `find` on every edit, `picked` with the MRI of
// the row clicked. The invite box and the transfer dialog share it.
export component PeopleSearch inherits VerticalLayout {
    in property <string> placeholder;
    callback picked(CallFound);
    spacing: 4px;
    Rectangle {
        height: 34px;
        border-radius: 4px;
        border-width: 1px;
        border-color: input.has-focus ? Theme.accent : Theme.border;
        background: Theme.surface;
        input := TextInput {
            x: 10px;
            width: parent.width - 20px;
            color: Theme.fg;
            font-size: 13px * Theme.font-scale;
            single-line: true;
            vertical-alignment: center;
            accessible-role: text-input;
            accessible-label: root.placeholder;
            accessible-placeholder-text: root.placeholder;
            edited => { CallStore.command("find", self.text); }
        }
        if input.text == "": Text {
            x: 10px;
            text: root.placeholder;
            color: Theme.fg-subtle;
            font-size: 13px * Theme.font-scale;
            vertical-alignment: center;
        }
    }
    if input.text != "": VerticalLayout {
        for f in CallStore.found: Rectangle {
            height: 40px;
            border-radius: 4px;
            background: row-touch.has-hover ? Theme.surface-hover : transparent;
            accessible-role: list-item;
            accessible-label: f.name;
            accessible-description: f.subtitle;
            accessible-action-default => { input.text = ""; root.picked(f); }
            HorizontalLayout {
                padding-left: 6px;
                spacing: 8px;
                Avatar { initials: f.initials; size: 26px; y: 7px; }
                VerticalLayout {
                    alignment: center;
                    Text { text: f.name; color: Theme.fg; font-size: 13px * Theme.font-scale; overflow: elide; }
                    if f.subtitle != "": Text { text: f.subtitle; color: Theme.fg-subtle; font-size: 11px * Theme.font-scale; overflow: elide; }
                }
            }
            row-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { input.text = ""; root.picked(f); }
            }
        }
    }
}

export component PeoplePanel inherits Rectangle {
    background: Theme.sidebar;
    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        PanelHeader { title: "People"; }
        // Teams' "Invite someone or dial a number" (people only: no phone numbers here).
        if CallStore.kind == "direct": PeopleSearch {
            placeholder: "Invite someone or dial a number";
            picked(f) => { CallStore.command("invite", f.id); }
        }
        if CallStore.kind == "direct" && CallStore.invite-status != "": Text {
            text: CallStore.invite-status;
            color: Theme.fg-subtle;
            font-size: 12px * Theme.font-scale;
            wrap: word-wrap;
            accessible-role: text;
            accessible-label: self.text;
        }
        ScrollView {
            VerticalLayout {
                alignment: start;
                spacing: 2px;
                Text {
                    text: (CallStore.kind == "direct" ? "Currently in this call (" : "In this meeting (") + CallStore.in-call + ")";
                    color: Theme.fg-muted;
                    font-size: 12px * Theme.font-scale;
                    font-weight: 600;
                    overflow: elide;
                }
                for p[i] in CallStore.people: VerticalLayout {
                    if p.lobby && i == CallStore.in-call: HorizontalLayout {
                        height: 32px;
                        spacing: 8px;
                        Text {
                            text: "Waiting in lobby (" + CallStore.in-lobby + ")";
                            color: Theme.fg-muted;
                            font-size: 12px * Theme.font-scale;
                            font-weight: 600;
                            vertical-alignment: bottom;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        if CallStore.can-admit: VerticalLayout {
                            alignment: end;
                            Button { variant: ButtonVariant.solid;
                                label: "Admit all";
                                clicked => { CallStore.command("admit-all", ""); }
                            }
                        }
                    }
                    PersonRow { p: p; }
                }
            }
        }
    }
}

// A section title of the More panel.
component SectionTitle inherits Text {
    color: Theme.fg-muted;
    font-size: 12px * Theme.font-scale;
    font-weight: 600;
}

// More, as Teams' "..." menu: Record and transcribe, Language and speech, Video effects and the
// devices. The
// service decides who may record; a refusal shows as the call's error banner.
export component MorePanel inherits Rectangle {
    // The top bar had no room for these (a narrow window): they are here instead.
    in property <bool> fold: false;
    background: Theme.sidebar;
    VerticalLayout {
        padding: 12px;
        spacing: 12px;
        alignment: start;
        PanelHeader { title: "More"; }
        if root.fold: HorizontalLayout {
            alignment: start;
            spacing: 4px;
            Button { variant: ButtonVariant.call;
                icon: @image-url("../icons/people.svg");
                label: "People";
                checkable: true;
                clicked => { CallStore.panel = "people"; }
            }
            Button { variant: ButtonVariant.call;
                icon: @image-url("../icons/hand.svg");
                label: CallStore.hand ? "Lower" : "Raise";
                checkable: true;
                active: CallStore.hand;
                clicked => { CallStore.command("hand", ""); }
            }
            Button { variant: ButtonVariant.call;
                icon: @image-url("../icons/grid.svg");
                label: "View";
                tip: "Gallery, speaker or focus on content";
                active: CallStore.menu == "view";
                clicked => { CallStore.menu = CallStore.menu == "view" ? "" : "view"; }
            }
            Button { variant: ButtonVariant.call;
                icon: @image-url("../icons/emoji.svg");
                label: "React";
                enabled: CallStore.phase == "connected";
                tip: CallStore.phase == "connected" ? "Send a reaction" : "Reactions work once you're in the meeting";
                active: CallStore.menu == "react";
                clicked => { CallStore.menu = CallStore.menu == "react" ? "" : "react"; }
            }
        }
        if root.fold && CallStore.kind == "direct": HorizontalLayout {
            alignment: start;
            spacing: 4px;
            Button { variant: ButtonVariant.call;
                icon: @image-url("../icons/pause.svg");
                label: CallStore.held ? "Resume" : "Hold";
                checkable: true;
                active: CallStore.held;
                tip: CallStore.held ? "Take the call off hold" : "Put the call on hold";
                clicked => { CallStore.command("hold", ""); }
            }
            Button { variant: ButtonVariant.call;
                icon: @image-url("../icons/forward.svg");
                label: "Transfer";
                active: CallStore.menu == "transfer";
                tip: "Transfer the call to someone else";
                clicked => {
                    if CallStore.menu == "transfer" {
                        CallStore.menu = "";
                    } else {
                        CallStore.menu = "transfer";
                        CallStore.command("transfer-open", "");
                    }
                }
            }
        }
        SectionTitle { text: "Record and transcribe"; }
        HorizontalLayout {
            alignment: start;
            spacing: 8px;
            Button { variant: ButtonVariant.action;
                label: CallStore.recording ? "Stop recording" : "Start recording";
                clicked => { CallStore.command("recording", CallStore.recording ? "stop" : "start"); }
            }
            Button { variant: ButtonVariant.action;
                label: CallStore.transcribing ? "Stop transcription" : "Start transcription";
                clicked => { CallStore.command("transcription", CallStore.transcribing ? "stop" : "start"); }
            }
        }
        SectionTitle { text: "Language and speech"; }
        Switch { variant: SwitchVariant.row;
            label: "Show live captions";
            checked: CallStore.captions;
            toggled => { CallStore.command("captions", CallStore.captions ? "off" : "on"); }
        }
        SectionTitle { text: "Video"; }
        HorizontalLayout {
            alignment: start;
            Button { variant: ButtonVariant.action;
                label: "Video effects";
                clicked => { VideoFxStore.open = true; }
            }
        }
        SectionTitle { text: "Device settings"; }
        DeviceSettings { prefix: "more"; }
        Text {
            text: "Echo cancellation, noise suppression and automatic gain are on.";
            color: Theme.fg-subtle;
            font-size: 12px * Theme.font-scale;
            wrap: word-wrap;
        }
    }
    // Video effects: a page of the panel, over its content.
    if VideoFxStore.open: VideoEffectsPanel {
        width: root.width;
        height: root.height;
    }
}
