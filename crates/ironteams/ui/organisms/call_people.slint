// The call window's side panels: People (the roster, with the lobby) and More (record and
// transcribe, live captions, device settings).
import { ScrollView } from "std-widgets.slint";
import { Theme } from "../tokens/theme.slint";
import { Icon, IconButton, SectionHeader } from "../atoms/widgets.slint";
import { Avatar } from "../atoms/avatar.slint";
import { CallStore, CallPerson, CallAbsent, CallFound } from "../stores/call_store.slint";
import { DeviceSettings } from "../molecules/call_widgets.slint";
import { PersonHover } from "../molecules/people.slint";
import { VideoFxStore } from "../stores/video_fx_store.slint";
import { Button, FlexButton, ButtonVariant } from "../atoms/button.slint";
import { Switch, SwitchVariant } from "../atoms/check.slint";
import { Heading, HeadingVariant } from "../atoms/heading.slint";

// A row of the People panel is a click away from the person's card (`person-card`), when their
// MRI is known.
component PersonRow inherits Rectangle {
    in property <CallPerson> p;
    height: 44px;
    border-radius: 4px;
    background: row-touch.has-hover && root.p.id != "" ? Theme.surface-hover : transparent;
    accessible-role: list-item;
    accessible-action-default => { if root.p.id != "" { CallStore.command("person-card", root.p.id); } }
    accessible-label: CallStore.tagged-name(root.p);
    accessible-description: (root.p.lobby ? "In lobby" : root.p.muted ? "Muted" : "Unmuted")
        + (root.p.hand ? ", hand raised" : "")
        + (root.p.role != "" ? ", " + root.p.role : "");
    // Under the layout, so the Admit button and the photo take their own clicks.
    row-touch := TouchArea {
        enabled: root.p.id != "";
        mouse-cursor: pointer;
        clicked => { CallStore.command("person-card", root.p.id); }
    }
    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        spacing: 10px;
        Avatar {
            initials: root.p.initials;
            img: root.p.photo;
            has-img: root.p.has-photo;
            size: 30px;
            y: 7px;
            if !root.p.me && root.p.id != "": PersonHover {
                person: root.p.id;
                click-opens: false;
                activated => { CallStore.command("person-card", root.p.id); }
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: CallStore.tagged-name(root.p) + (root.p.me ? " (You)" : "");
                color: Theme.fg;
                font-size: 13px * Theme.font-scale;
                overflow: elide;
            }
            if root.p.role == "organizer" || root.p.role == "presenter": Text {
                text: root.p.role == "organizer" ? "Organizer" : "Presenter";
                color: Theme.fg-subtle;
                font-size: 11px * Theme.font-scale;
                overflow: elide;
            }
        }
        if root.p.reaction != "": Text {
            text: root.p.reaction;
            font-size: 18px;
            vertical-alignment: center;
            accessible-role: text;
            accessible-label: root.p.name + "'s reaction: " + root.p.reaction-name;
        }
        if root.p.hand: Icon {
            source: @image-url("../icons/hand.svg");
            tint: Theme.accent;
            y: 12px;
        }
        if root.p.lobby && CallStore.can-admit: VerticalLayout {
            alignment: center;
            Button { variant: ButtonVariant.solid;
                accessible-label: "Admit " + CallStore.tagged-name(root.p);
                label: "Admit";
                clicked => { CallStore.command("admit", root.p.id); }
            }
        }
        if !root.p.lobby: Icon {
            source: root.p.muted ? @image-url("../icons/mic-off.svg") : @image-url("../icons/mic.svg");
            tint: root.p.muted ? Theme.fg-subtle : Theme.fg;
            y: 12px;
        }
    }
}

// Someone who is not in the call: an invitee with their answer, or a member of the meeting chat.
component AbsentRow inherits Rectangle {
    in property <CallAbsent> a;
    height: 44px;
    border-radius: 4px;
    background: row-touch.has-hover && root.a.id != "" ? Theme.surface-hover : transparent;
    accessible-role: list-item;
    accessible-label: root.a.name;
    accessible-description: root.a.status;
    accessible-action-default => { if root.a.id != "" { CallStore.command("person-card", root.a.id); } }
    row-touch := TouchArea {
        enabled: root.a.id != "";
        mouse-cursor: pointer;
        clicked => { CallStore.command("person-card", root.a.id); }
    }
    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        spacing: 10px;
        Avatar {
            initials: root.a.initials;
            img: root.a.photo;
            has-img: root.a.has-photo;
            size: 30px;
            y: 7px;
            if root.a.id != "": PersonHover {
                person: root.a.id;
                click-opens: false;
                activated => { CallStore.command("person-card", root.a.id); }
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.a.name;
                color: Theme.fg;
                font-size: 13px * Theme.font-scale;
                overflow: elide;
            }
            if root.a.status != "": Text {
                text: root.a.status;
                color: Theme.fg-subtle;
                font-size: 11px * Theme.font-scale;
                overflow: elide;
            }
        }
    }
}

component PanelHeader inherits HorizontalLayout {
    in property <string> title;
    height: 32px;
    Text {
        text: root.title;
        color: Theme.fg;
        font-size: 15px * Theme.font-scale;
        font-weight: 600;
        vertical-alignment: center;
        horizontal-stretch: 1;
        overflow: elide;
    }
    IconButton {
        icon: @image-url("../icons/close.svg");
        tooltip: "Close " + root.title;
        size: 28px;
        clicked => { CallStore.panel = ""; }
    }
}

// A people search box with its results under it: `find` on every edit, `picked` with the MRI of
// the row clicked. The invite box and the transfer dialog share it.
export component PeopleSearch inherits VerticalLayout {
    in property <string> placeholder;
    callback picked(CallFound);
    // The text of the box after each edit and when a pick empties it.
    callback edited(string);
    spacing: 4px;
    Rectangle {
        height: 34px;
        border-radius: 4px;
        border-width: 1px;
        border-color: input.has-focus ? Theme.accent : Theme.border;
        background: Theme.surface;
        input := TextInput {
            x: 10px;
            width: parent.width - 20px;
            color: Theme.fg;
            font-size: 13px * Theme.font-scale;
            single-line: true;
            vertical-alignment: center;
            accessible-role: text-input;
            accessible-label: root.placeholder;
            accessible-placeholder-text: root.placeholder;
            edited => { CallStore.command("find", self.text); root.edited(self.text); }
        }
        if input.text == "": Text {
            x: 10px;
            text: root.placeholder;
            color: Theme.fg-subtle;
            font-size: 13px * Theme.font-scale;
            vertical-alignment: center;
        }
    }
    if input.text != "": VerticalLayout {
        for f in CallStore.found: Rectangle {
            height: 40px;
            border-radius: 4px;
            background: row-touch.has-hover ? Theme.surface-hover : transparent;
            accessible-role: list-item;
            accessible-label: f.name;
            accessible-description: f.subtitle;
            accessible-action-default => { input.text = ""; root.edited(""); root.picked(f); }
            HorizontalLayout {
                padding-left: 6px;
                spacing: 8px;
                Avatar { initials: f.initials; size: 26px; y: 7px; }
                VerticalLayout {
                    alignment: center;
                    Text { text: f.name; color: Theme.fg; font-size: 13px * Theme.font-scale; overflow: elide; }
                    if f.subtitle != "": Text { text: f.subtitle; color: Theme.fg-subtle; font-size: 11px * Theme.font-scale; overflow: elide; }
                }
            }
            row-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { input.text = ""; root.edited(""); root.picked(f); }
            }
        }
    }
}

// Teams' Participants panel: one search box (it filters the sections below it and finds people
// to invite), Share invite, and the sections: who is in the meeting (and the lobby), who else was
// invited, and who is only in the meeting chat. Each section folds under its header.
export component PeoplePanel inherits Rectangle {
    background: Theme.sidebar;
    // Which sections are folded: the panel's own, gone when it closes.
    property <bool> meeting-open: true;
    property <bool> invited-open: true;
    property <bool> chat-open: true;
    // Share invite copied the link a moment ago.
    property <bool> copied: false;
    // `people-open` clears the filter and reads who the meeting invited and who its chat holds.
    init => { CallStore.command("people-open", ""); }
    Timer {
        interval: 3s;
        running: root.copied;
        triggered => { root.copied = false; }
    }
    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        PanelHeader { title: "People"; }
        PeopleSearch {
            placeholder: "Type a name";
            picked(f) => { CallStore.command("invite", f.id); }
            edited(text) => { CallStore.command("people-filter", text); }
        }
        if CallStore.invite-status != "": Text {
            text: CallStore.invite-status;
            color: Theme.fg-subtle;
            font-size: 12px * Theme.font-scale;
            wrap: word-wrap;
            accessible-role: text;
            accessible-label: self.text;
        }
        // Not for a 1:1 call: it has no link to share.
        if CallStore.can-share-invite: FlexButton {
            variant: ButtonVariant.toolbar;
            label: root.copied ? "Link copied" : "Share invite";
            clicked => {
                root.copied = true;
                CallStore.command("share-invite", "");
            }
        }
        ScrollView {
            viewport-width: self.width;
            VerticalLayout {
                width: parent.width;
                alignment: start;
                spacing: 0px;
                SectionHeader {
                    label: (CallStore.kind == "direct" ? "Currently in this call (" : "In this meeting (") + CallStore.in-call + ")";
                    expanded <=> root.meeting-open;
                }
                if root.meeting-open: VerticalLayout {
                    for p in CallStore.people: VerticalLayout {
                        if !p.lobby && p.listed: PersonRow { p: p; }
                    }
                }
                if CallStore.in-lobby > 0: HorizontalLayout {
                    height: 32px;
                    padding-left: 10px;
                    spacing: 8px;
                    Text {
                        text: "Waiting in lobby (" + CallStore.in-lobby + ")";
                        color: Theme.fg-muted;
                        font-size: 12px * Theme.font-scale;
                        font-weight: 600;
                        vertical-alignment: bottom;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    if CallStore.can-admit: VerticalLayout {
                        alignment: end;
                        Button { variant: ButtonVariant.solid;
                            label: "Admit all";
                            clicked => { CallStore.command("admit-all", ""); }
                        }
                    }
                }
                for p in CallStore.people: VerticalLayout {
                    if p.lobby && p.listed: PersonRow { p: p; }
                }
                if CallStore.invited.length > 0: SectionHeader {
                    label: "Others invited (" + CallStore.invited.length + ")";
                    expanded <=> root.invited-open;
                }
                if CallStore.invited.length > 0 && root.invited-open: VerticalLayout {
                    for a in CallStore.invited: VerticalLayout {
                        if a.listed: AbsentRow { a: a; }
                    }
                }
                if CallStore.chat-people.length > 0: SectionHeader {
                    label: "People added to the chat (" + CallStore.chat-people.length + ")";
                    expanded <=> root.chat-open;
                }
                if CallStore.chat-people.length > 0 && root.chat-open: VerticalLayout {
                    for a in CallStore.chat-people: VerticalLayout {
                        if a.listed: AbsentRow { a: a; }
                    }
                }
            }
        }
    }
}

// More, as Teams' "..." menu: Record and transcribe, Language and speech, Video effects (its
// panel replaces this one while it is open, see call_window.slint) and the devices. The
// service decides who may record; a refusal shows as the call's error banner.
export component MorePanel inherits Rectangle {
    // The top bar had no room for these (a narrow window): they are here instead.
    in property <bool> fold: false;
    background: Theme.sidebar;
    VerticalLayout {
        padding: 12px;
        spacing: 12px;
        PanelHeader { title: "More"; }
        // Taller than a short window: the panel scrolls, and an open device list with it.
        ScrollView {
            // As wide as the panel, not as wide as the widest row's natural width (that one is
            // centred in a viewport of its own size and pushes the content out of the window).
            viewport-width: self.width;
            VerticalLayout {
                width: parent.width;
                spacing: 12px;
                alignment: start;
                if root.fold: HorizontalLayout {
                    alignment: start;
                    spacing: 4px;
                    Button { variant: ButtonVariant.call;
                        icon: @image-url("../icons/people.svg");
                        label: "People";
                        checkable: true;
                        clicked => { CallStore.panel = "people"; }
                    }
                    Button { variant: ButtonVariant.call;
                        icon: @image-url("../icons/hand.svg");
                        label: CallStore.hand ? "Lower" : "Raise";
                        checkable: true;
                        active: CallStore.hand;
                        clicked => { CallStore.command("hand", ""); }
                    }
                    Button { variant: ButtonVariant.call;
                        icon: @image-url("../icons/grid.svg");
                        label: "View";
                        tip: "Gallery, speaker or focus on content";
                        active: CallStore.menu == "view";
                        clicked => { CallStore.menu = CallStore.menu == "view" ? "" : "view"; }
                    }
                    Button { variant: ButtonVariant.call;
                        icon: @image-url("../icons/emoji.svg");
                        label: "React";
                        enabled: CallStore.phase == "connected";
                        tip: CallStore.phase == "connected" ? "Send a reaction" : "Reactions work once you're in the meeting";
                        active: CallStore.menu == "react";
                        clicked => { CallStore.menu = CallStore.menu == "react" ? "" : "react"; }
                    }
                }
                if root.fold && CallStore.kind == "direct": HorizontalLayout {
                    alignment: start;
                    spacing: 4px;
                    Button { variant: ButtonVariant.call;
                        icon: @image-url("../icons/pause.svg");
                        label: CallStore.held ? "Resume" : "Hold";
                        checkable: true;
                        active: CallStore.held;
                        tip: CallStore.held ? "Take the call off hold" : "Put the call on hold";
                        clicked => { CallStore.command("hold", ""); }
                    }
                    Button { variant: ButtonVariant.call;
                        icon: @image-url("../icons/forward.svg");
                        label: "Transfer";
                        active: CallStore.menu == "transfer";
                        tip: "Transfer the call to someone else";
                        clicked => {
                            if CallStore.menu == "transfer" {
                                CallStore.menu = "";
                            } else {
                                CallStore.menu = "transfer";
                                CallStore.command("transfer-open", "");
                            }
                        }
                    }
                }
                Heading { variant: HeadingVariant.caption; text: "Record and transcribe"; }
                HorizontalLayout {
                    alignment: start;
                    spacing: 8px;
                    Button { variant: ButtonVariant.action;
                        label: CallStore.recording ? "Stop recording" : "Start recording";
                        clicked => { CallStore.command("recording", CallStore.recording ? "stop" : "start"); }
                    }
                    Button { variant: ButtonVariant.action;
                        label: CallStore.transcribing ? "Stop transcription" : "Start transcription";
                        clicked => { CallStore.command("transcription", CallStore.transcribing ? "stop" : "start"); }
                    }
                }
                Heading { variant: HeadingVariant.caption; text: "Language and speech"; }
                Switch { variant: SwitchVariant.row;
                    label: "Show live captions";
                    checked: CallStore.captions;
                    toggled => { CallStore.command("captions", CallStore.captions ? "off" : "on"); }
                }
                Heading { variant: HeadingVariant.caption; text: "Video"; }
                HorizontalLayout {
                    alignment: start;
                    Button { variant: ButtonVariant.action;
                        label: "Video effects";
                        clicked => { VideoFxStore.open = true; }
                    }
                }
                Heading { variant: HeadingVariant.caption; text: "Device settings"; }
                DeviceSettings { prefix: "more"; }
                Text {
                    text: "Echo cancellation, noise suppression and automatic gain are on.";
                    color: Theme.fg-subtle;
                    font-size: 12px * Theme.font-scale;
                    wrap: word-wrap;
                }
            }
        }
    }
}
