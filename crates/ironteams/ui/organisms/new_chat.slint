// New chat (Alt+Shift+N): a "To:" field with people suggestions, "Add group name" once there are
// two or more people, and a message box. The chat is created when the first message is sent.
import { Theme } from "../tokens/theme.slint";
import { PersonItem } from "../tokens/types.slint";
import { IconButton } from "../atoms/widgets.slint";
import { Avatar } from "../atoms/avatar.slint";
import { PersonHover } from "../molecules/people.slint";

export component NewChatPane inherits Rectangle {
    in property <[PersonItem]> to;
    in property <[PersonItem]> results;
    in property <string> hint;
    callback query(string);
    callback add(string);
    callback remove(string);
    callback name(string);
    callback send(string);
    callback close();

    background: Theme.main;
    accessible-role: groupbox;
    accessible-label: @tr("New message");

    // Escape closes the pane wherever the focus is inside it.
    FocusScope {
        capture-key-pressed(event) => {
            if event.text == Key.Escape {
                root.close();
                return accept;
            }
            reject
        }

        VerticalLayout {
            Rectangle {
                height: 60px;
                background: Theme.panel;
                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 16px;
                    Text { text: @tr("New message"); color: Theme.fg; font-size: 17px * Theme.font-scale; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                    IconButton { icon: @image-url("../icons/close.svg"); tooltip: @tr("Close"); y: 14px; clicked => { root.close(); } }
                }
                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
            }

            // To:
            Rectangle {
                min-height: 44px;
                preferred-height: to-row.preferred-height + 16px;
                to-row := HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    spacing: 8px;
                    Text { text: @tr("To:"); color: Theme.fg-muted; font-size: 14px * Theme.font-scale; vertical-alignment: center; horizontal-stretch: 0; }
                    for p in root.to: chip := Rectangle {
                        height: 26px;
                        width: min(chip-text.preferred-width, 200px) + 30px;
                        border-radius: 13px;
                        background: Theme.accent-subtle;
                        accessible-role: button;
                        accessible-label: @tr("Remove {}", p.name);
                        chip-text := Text { x: 10px; width: parent.width - 30px; text: p.name; color: Theme.fg; font-size: 12px * Theme.font-scale; vertical-alignment: center; overflow: elide; }
                        Text { x: parent.width - 18px; text: "×"; color: Theme.fg-muted; font-size: 15px * Theme.font-scale; vertical-alignment: center; }
                        TouchArea { mouse-cursor: pointer; clicked => { root.remove(p.id); } }
                    }
                    FocusScope {
                        horizontal-stretch: 1;
                        min-width: 120px;
                        capture-key-pressed(event) => {
                            if event.text == Key.Backspace && to-input.text == "" && root.to.length > 0 {
                                root.remove(root.to[root.to.length - 1].id);
                                return accept;
                            }
                            if event.text == Key.Return && root.results.length > 0 {
                                root.add(root.results[0].id);
                                to-input.text = "";
                                return accept;
                            }
                            reject
                        }
                        to-input := TextInput {
                            color: Theme.fg;
                            font-size: 14px * Theme.font-scale;
                            single-line: true;
                            vertical-alignment: center;
                            accessible-role: text-input;
                            accessible-placeholder-text: @tr("Enter a name");
                            init => { self.focus(); }
                            edited => { root.query(self.text); }
                        }
                        if to-input.text == "" && root.to.length == 0: Text { text: @tr("Enter a name"); color: Theme.fg-subtle; font-size: 14px * Theme.font-scale; vertical-alignment: center; }
                    }
                }
                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
            }

            if root.to.length >= 2: Rectangle {
                height: 44px;
                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    Rectangle {
                        border-radius: 4px;
                        background: Theme.panel;
                        border-width: 1px;
                        border-color: group-input.has-focus ? Theme.accent : Theme.border;
                        group-input := TextInput {
                            x: 10px;
                            width: parent.width - 20px;
                            color: Theme.fg;
                            font-size: 13px * Theme.font-scale;
                            single-line: true;
                            vertical-alignment: center;
                            accessible-role: text-input;
                            accessible-placeholder-text: @tr("Add group name");
                            edited => { root.name(self.text); }
                        }
                        if group-input.text == "": Text { x: 10px; text: @tr("Add group name"); color: Theme.fg-subtle; font-size: 13px * Theme.font-scale; vertical-alignment: center; }
                    }
                }
            }

            if root.hint != "": Text {
                text: root.hint;
                color: Theme.accent;
                font-size: 12px * Theme.font-scale;
                horizontal-alignment: left;
                accessible-role: text;
            }

            // Suggestions while a name is typed, otherwise empty space above the message box.
            Rectangle {
                vertical-stretch: 1;
                Flickable {
                    content-height: results-list.preferred-height;
                    results-list := VerticalLayout {
                        padding: 8px;
                        for r in root.results: result-row := Rectangle {
                            height: 48px;
                            border-radius: 4px;
                            background: result-hit.has-hover ? Theme.surface-hover : transparent;
                            accessible-role: button;
                            accessible-label: r.name;
                            HorizontalLayout {
                                padding-left: 12px;
                                spacing: 10px;
                                Avatar { initials: r.initials; tone: r.color; img: r.avatar; has-img: r.has-avatar; presence: r.presence; size: 32px; y: 8px; }
                                VerticalLayout {
                                    alignment: center;
                                    Text { text: r.name; color: Theme.fg; font-size: 14px * Theme.font-scale; overflow: elide; }
                                    if r.subtitle != "": Text { text: r.subtitle; color: Theme.fg-subtle; font-size: 12px * Theme.font-scale; overflow: elide; }
                                }
                            }
                            result-hit := PersonHover {
                                person: r.kind == "person" ? r.id : "";
                                click-opens: false;
                                activated => {
                                    root.add(r.id);
                                    to-input.text = "";
                                }
                            }
                        }
                    }
                }
            }

            // The first message.
            Rectangle {
                height: 90px;
                HorizontalLayout {
                    padding: 16px;
                    spacing: 8px;
                    Rectangle {
                        border-radius: 6px;
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: msg-input.has-focus ? Theme.accent : Theme.border;
                        FocusScope {
                            capture-key-pressed(event) => {
                                if event.text == Key.Return && !event.modifiers.shift {
                                    if root.to.length > 0 && msg-input.text != "" {
                                        root.send(msg-input.text);
                                        msg-input.text = "";
                                    }
                                    return accept;
                                }
                                reject
                            }
                            msg-input := TextInput {
                                x: 12px;
                                y: 8px;
                                width: parent.width - 24px;
                                color: Theme.fg;
                                font-size: 14px * Theme.font-scale;
                                wrap: word-wrap;
                                accessible-role: text-input;
                                accessible-placeholder-text: @tr("Type a message");
                            }
                        }
                        if msg-input.text == "": Text { x: 12px; y: 8px; text: @tr("Type a message"); color: Theme.fg-subtle; font-size: 14px * Theme.font-scale; }
                    }
                    send-btn := Rectangle {
                        width: 40px;
                        border-radius: 6px;
                        background: root.to.length > 0 && msg-input.text != "" ? Theme.accent-strong : Theme.surface;
                        accessible-role: button;
                        accessible-label: @tr("Send");
                        accessible-enabled: root.to.length > 0 && msg-input.text != "";
                        Text { text: "➤"; color: root.to.length > 0 && msg-input.text != "" ? Theme.on-accent : Theme.fg-strong; font-size: 16px * Theme.font-scale; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                if root.to.length > 0 && msg-input.text != "" {
                                    root.send(msg-input.text);
                                    msg-input.text = "";
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
