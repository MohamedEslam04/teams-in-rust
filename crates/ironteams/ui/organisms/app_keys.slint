// The window's keyboard shortcuts (Teams' chords; the user can rebind them in Settings, see
// src/shortcut_keys.rs and src/shortcuts.rs) and Esc. It holds the focus when no input has it,
// and wraps the window's content (`@children`).
import { AppsStore } from "../stores/apps_store.slint";
import { ChannelStore } from "channel_posts.slint";
import { DirectCallStore } from "call_incoming.slint";
import { FindStore } from "../stores/find_store.slint";
import { ListStore } from "lists.slint";
import { PaletteStore } from "../stores/palette_store.slint";
import { PeopleStore } from "../molecules/people.slint";
import { SettingsStore } from "../stores/settings_store.slint";
import { SplitStore } from "../stores/split_store.slint";
import { ShortcutApi } from "shortcuts.slint";
import { TopBarStore } from "topbar.slint";

export component AppKeys inherits FocusScope {
    callback attach-file;
    callback cancel-reply;
    callback catch-up(int);
    callback close-thread;
    in-out property <bool> composer-expanded;
    in property <bool> composer-focused;
    in property <string> current-id;
    in-out property <string> filter;
    in-out property <int> focus-tick;
    callback mark-all-read;
    in-out property <bool> menu-open;
    in-out property <int> msg-focus-tick;
    in property <bool> posts-mode;
    in property <string> reply-preview;
    callback set-filter(string);
    in-out property <bool> shortcuts-open;
    // The split view's pane shows: while it is the active one, Esc closes it and Alt+Shift+R
    // goes to its box.
    in property <bool> split-shown;
    callback close-split;
    in property <bool> teams-no-channel;
    in property <string> thread-root;
    in-out property <string> view;
    callback focus-search;
    callback start-command;
    // The command palette closed: take the keys back (a chat hands them to the composer).
    property <int> palette-restore: PaletteStore.restore-tick;
    changed palette-restore => { if root.view != "chat" { self.focus(); } }
    // The page's own input (the composer, the search box) is gone on the pages that have
    // none, which would leave the keyboard shortcuts, Alt+Left among them, without a focus.
    // An open command palette keeps its own input (it hands the keys back when it closes).
    property <string> page: root.view;
    changed page => {
        if !PaletteStore.open && self.page != "chat" && self.page != "teams" && self.page != "search" { self.focus(); }
    }
    // The Teams page with no channel picked drops the conversation (and its composer, which
    // may hold the focus): take the keys so Alt+Down and the other shortcuts still work.
    property <bool> no-channel: root.teams-no-channel;
    changed no-channel => {
        if self.no-channel && !PaletteStore.open { self.focus(); }
    }
    // Shift+Esc marks every chat read, wherever the focus is. The Activity view handles it
    // itself (marks every Activity item read).
    capture-key-pressed(event) => {
        if (event.text == Key.Escape && event.modifiers.shift && root.view != "activity") {
            root.mark-all-read();
            return accept;
        }
        // Ctrl+Shift+1 to 9: the nth entry of the app bar. In the composer Ctrl+Shift+7 and 8
        // are the numbered and bullet list (Teams), so they stay with the composer there.
        if (event.modifiers.control && event.modifiers.shift && AppsStore.shortcut-index(event.text) > 0 && !(root.composer-focused && (AppsStore.shortcut-index(event.text) == 7 || AppsStore.shortcut-index(event.text) == 8))) {
            AppsStore.command("shortcut", "" + AppsStore.shortcut-index(event.text));
            return accept;
        }
        // The other chords: which key means which action is a table the user can change
        // (src/shortcut_keys.rs); `run-shortcut` does the action.
        let a = ShortcutApi.action(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift);
        if a != "" {
            root.run-shortcut(a);
            return accept;
        }
        reject
    }
    // Esc, when nothing else took it: closes the shortcut list, then the active split pane, then
    // the thread, then the reply.
    key-pressed(event) => {
        if event.text == Key.Escape && !event.modifiers.shift {
            if PeopleStore.profile-open { PeopleStore.profile-open = false; return accept; }
            if PeopleStore.jump-date-open { PeopleStore.jump-date-open = false; root.focus-tick += 1; return accept; }
            if root.shortcuts-open { root.shortcuts-open = false; return accept; }
            if root.menu-open { root.menu-open = false; root.focus-tick += 1; return accept; }
            if root.split-shown && SplitStore.active { root.close-split(); return accept; }
            if ChannelStore.thread-id != "" && root.posts-mode { ChannelStore.close-thread(); return accept; }
            if root.thread-root != "" { root.close-thread(); return accept; }
            if root.reply-preview != "" { root.cancel-reply(); return accept; }
        }
        reject
    }
    function run-shortcut(a: string) {
        // Alt+Down and Alt+Up: the next / previous unread chat or channel in the list.
        if a == "next-unread" { root.catch-up(1); }
        if a == "previous-unread" { root.catch-up(-1); }
        // Alt+Shift+Down / Alt+Shift+Up (2 / -2): the same, wrapping around the list.
        if a == "next-unread-wrap" { root.catch-up(2); }
        if a == "previous-unread-wrap" { root.catch-up(-2); }
        // Alt+Q: collapse every section of the chat list.
        if a == "collapse-all" { ListStore.command("collapse-all", ""); }
        // Alt+Left and Alt+Right: Back and Forward.
        if a == "back" { TopBarStore.command("back", ""); }
        if a == "forward" { TopBarStore.command("forward", ""); }
        // Ctrl+Alt+E: Search.
        if a == "search" {
            root.view = "search";
            FindStore.focus-tick += 1;
        }
        // Ctrl+Shift+,: Settings.
        if a == "settings" { SettingsStore.show("general"); }
        // Alt+Shift+N: New chat.
        if a == "new-chat" {
            root.view = "chat";
            PeopleStore.new-chat-open = true;
            PeopleStore.command("new-chat-open", "");
        }
        // Alt+Shift+A and Alt+Shift+V: the call button's Audio call and Video call.
        if a == "audio-call" && root.view == "chat" && DirectCallStore.available && DirectCallStore.is-direct(root.current-id) {
            DirectCallStore.command("dial", root.current-id);
        }
        if a == "video-call" && root.view == "chat" && DirectCallStore.available && DirectCallStore.is-direct(root.current-id) {
            DirectCallStore.command("dial-video", root.current-id);
        }
        if a == "shortcuts" { root.shortcuts-open = !root.shortcuts-open; }
        if a == "palette" { PaletteStore.open = !PaletteStore.open; }
        if a == "goto" {
            root.view = "search";
            FindStore.command("search-tab", "chats");
            FindStore.focus-tick += 1;
        }
        if a == "filter-box" { root.view = "chat"; root.focus-search(); }
        // Ctrl+E: the top search box. Ctrl+/: the box with a "/" in it, which lists the commands.
        if a == "search-box" { root.focus-search(); }
        if a == "commands" { root.start-command(); }
        if a == "filter-unread" { root.filter = root.filter == "unread" ? "all" : "unread"; root.set-filter(root.filter); }
        if a == "filter-chats" { root.filter = root.filter == "chats" ? "all" : "chats"; root.set-filter(root.filter); }
        if a == "filter-channels" { root.filter = root.filter == "channels" ? "all" : "channels"; root.set-filter(root.filter); }
        if a == "filter-clear" { root.filter = "all"; root.set-filter("all"); }
        // Alt+Shift+U: the Unreads view.
        if a == "unreads" {
            root.view = "chat";
            FindStore.command("quick", "unreads");
        }
        if a == "focus-composer" {
            if root.split-shown && SplitStore.active { SplitStore.focus-tick += 1; } else { root.focus-tick += 1; }
        }
        if a == "focus-messages" { root.msg-focus-tick += 1; }
        if a == "expand-composer" { root.composer-expanded = !root.composer-expanded; root.focus-tick += 1; }
        if a == "attach-file" { root.attach-file(); }
        if a == "share-screen" && root.view == "chat" && DirectCallStore.available && DirectCallStore.is-direct(root.current-id) {
            DirectCallStore.command("share-screen", root.current-id);
        }
        // Ctrl+F: Find in chat (or in channel) for the open conversation; again, back to its box.
        if a == "find" && root.conversation-open() {
            if !FindStore.chat-find-open {
                FindStore.chat-find-open = true;
                FindStore.chat-find-tick += 1;
                FindStore.command("find-open", "");
            } else {
                FindStore.chat-find-tick += 1;
            }
        }
        // Ctrl+Alt+Home: the open chat's very first message (a channel's posts have their own list).
        if a == "jump-first" && root.conversation-open() && !root.posts-mode {
            PeopleStore.command("jump-first", "");
        }
    }
    // A chat or channel is open in the window (not one of its threads).
    function conversation-open() -> bool {
        return (root.view == "chat" || root.view == "teams") && root.current-id != "" && !root.teams-no-channel && root.thread-root == "";
    }
    @children
}
