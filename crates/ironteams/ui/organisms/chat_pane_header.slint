// The conversation's header: back, the chat's picture and name (renamed in place), the tabs, and
// the meeting, call, participants, find, details and … buttons. When it is narrow (half a laptop
// screen), participants, find, details and Schedule a meeting move into the … menu so the name
// stays readable.
import { Avatar, GlyphAvatar } from "../atoms/avatar.slint";
import { CallHeaderButtons } from "call_outgoing.slint";
import { CallStore } from "../stores/call_store.slint";
import { ChannelMeetButton, MeetingJoinButton } from "web_parity.slint";
import { ChannelTabButton } from "channel_tabs.slint";
import { OngoingCallStore } from "../stores/ongoing_call_store.slint";
import { OngoingCallStrip } from "ongoing_call_strip.slint";
import { FindStore } from "../stores/find_store.slint";
import { HeaderMoreButton } from "chat_header.slint";
import { Icon, IconButton } from "../atoms/widgets.slint";
import { PeopleStore, PersonHover } from "../molecules/people.slint";
import { RecapsStore } from "../stores/apps_store.slint";
import { Theme } from "../tokens/theme.slint";

// The "Recap" entry of a meeting chat's header tabs (next to Chat and Shared). `tab` is bound to
// the header's `FindStore.chat-tab`, which is `recap` while it shows.
export component RecapTab inherits Rectangle {
    in property <string> chat-id;
    in-out property <string> tab;
    property <bool> active: root.tab == "recap";
    width: min(tab-label.preferred-width, 200px);
    accessible-role: AccessibleRole.tab;
    accessible-label: "Recap";
    accessible-checked: root.active;
    accessible-action-default => { root.open(); }
    function open() {
        root.tab = "recap";
        RecapsStore.command("recaps-chat", root.chat-id);
    }
    VerticalLayout {
        alignment: center;
        tab-label := Text { text: "Recap"; color: root.active ? Theme.fg : Theme.fg-muted; font-size: 14px * Theme.font-scale; font-weight: root.active ? 600 : 400; overflow: elide; accessible-role: none; }
        Rectangle { height: 3px; border-radius: 1px; background: root.active ? Theme.accent : transparent; }
    }
    TouchArea { mouse-cursor: pointer; clicked => { root.open(); } }
}

export component ChatPaneHeader inherits Rectangle {
    callback close-thread;
    in property <image> current-avatar;
    in property <color> current-color;
    in property <bool> current-has-avatar;
    in property <string> current-id;
    in property <string> current-initials;
    in property <bool> current-is-channel;
    in property <bool> current-meeting-live;
    in property <bool> current-muted;
    in property <string> current-person;
    in property <string> current-presence;
    in property <string> current-title;
    in property <string> header-glyph;
    callback mark-chat-unread(string);
    callback meet-now(string);
    in-out property <bool> pane-list;
    in-out property <string> rename-text;
    in-out property <bool> renaming;
    callback schedule-meeting(string);
    in property <bool> single-pane;
    in property <string> thread-root;
    property <bool> compact: self.width < 720px;
    // A call goes on in this conversation: the live-call strip shows.
    property <bool> call-strip: OngoingCallStore.live && OngoingCallStore.chat-id == root.current-id && root.current-id != "";
    height: 60px;
    background: Theme.sidebar;
    HorizontalLayout {
        padding-left: 20px;
        padding-right: 16px;
        spacing: 12px;
        if root.single-pane && root.thread-root == "": IconButton {
            icon: @image-url("../icons/back.svg");
            y: 14px;
            tooltip: @tr("Back to the chat list");
            clicked => { root.pane-list = true; }
        }
        if root.thread-root != "": IconButton { icon: @image-url("../icons/back.svg"); y: 14px; clicked => { root.close-thread(); } }
        if root.header-glyph == "meeting": GlyphAvatar {
            y: 12px;
            size: 36px;
            icon: @image-url("../icons/calendar.svg");
            tone: Theme.accent.transparentize(0.8);
            tint: Theme.accent;
            accessible-label: @tr("Meeting chat");
        }
        if root.header-glyph == "group": GlyphAvatar {
            y: 12px;
            size: 36px;
            icon: @image-url("../icons/people.svg");
            tone: Theme.surface-hover;
            tint: Theme.fg-muted;
            accessible-label: @tr("Group chat");
        }
        if root.header-glyph == "": Avatar {
            y: 12px;
            initials: root.current-initials;
            tone: root.current-color;
            img: root.current-avatar;
            has-img: root.current-has-avatar;
            presence: root.current-person != "" ? root.current-presence : "";
            size: 36px;
            // A 1:1 chat's photo opens the person's card: on a rest, or a click.
            if root.current-person != "": PersonHover {
                person: root.current-person;
                accessible-role: button;
                accessible-label: @tr("Open profile of {}", root.current-title);
                accessible-action-default => { PeopleStore.open-card(root.current-person, self.absolute-position.x, self.absolute-position.y, self.width, self.height, false); }
            }
        }
        if !root.renaming || root.thread-root != "": Text {
            text: root.thread-root != "" ? @tr("Thread") : root.current-title;
            color: Theme.fg;
            font-size: 17px * Theme.font-scale;
            font-weight: 700;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 0;
            // Everything else gives way first.
            min-width: min(self.preferred-width, 120px);
        }
        if root.renaming && root.thread-root == "": Rectangle {
            y: 14px;
            height: 32px;
            width: 260px;
            horizontal-stretch: 0;
            border-radius: 4px;
            background: Theme.sidebar;
            border-width: 1px;
            border-color: Theme.accent;
            FocusScope {
                capture-key-pressed(event) => {
                    if event.text == Key.Escape {
                        root.renaming = false;
                        return accept;
                    }
                    if event.text == Key.Return {
                        root.renaming = false;
                        PeopleStore.command("rename", rename-input.text);
                        return accept;
                    }
                    reject
                }
                rename-input := TextInput {
                    x: 10px;
                    width: parent.width - 20px;
                    text <=> root.rename-text;
                    color: Theme.fg;
                    font-size: 15px * Theme.font-scale;
                    single-line: true;
                    vertical-alignment: center;
                    accessible-role: text-input;
                    accessible-label: @tr("Group name");
                    init => { self.focus(); self.select-all(); }
                }
            }
        }
        if PeopleStore.header-group && root.thread-root == "" && !root.renaming: rename-btn := IconButton {
            icon: @image-url("../icons/edit.svg");
            tooltip: @tr("Rename chat");
            size: 28px;
            y: 16px;
            clicked => {
                root.rename-text = root.current-title;
                root.renaming = true;
            }
        }
        for tab in (root.current-is-channel ? [{k: "posts", l: @tr("Posts")}, {k: "files", l: @tr("Files")}]
            : (root.current-person != "" || root.current-id == "48:notes") && root.thread-root == "" ? [{k: "chat", l: @tr("Chat")}, {k: "shared", l: @tr("Shared")}, {k: "storyline", l: @tr("Storyline")}]
            : [{k: "chat", l: @tr("Chat")}, {k: "shared", l: @tr("Shared")}]): tab-item := Rectangle {
            // The Shared (Files) and Storyline tabs replace the conversation, see `FindStore`.
            property <string> key: tab.k == "files" ? "shared" : (tab.k == "posts" ? "chat" : tab.k);
            property <bool> active: FindStore.chat-tab == self.key || (self.key == "chat" && FindStore.chat-tab != "shared" && FindStore.chat-tab != "storyline");
            width: min(tab-label.preferred-width, 200px);
            accessible-role: AccessibleRole.tab;
            accessible-label: tab.l;
            accessible-checked: self.active;
            VerticalLayout {
                alignment: center;
                tab-label := Text { text: tab.l; color: tab-item.active ? Theme.fg : Theme.fg-muted; font-size: 14px * Theme.font-scale; font-weight: tab-item.active ? 600 : 400; overflow: elide; }
                Rectangle { height: 3px; border-radius: 1px; background: tab-item.active ? Theme.accent : transparent; }
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    FindStore.chat-tab = tab-item.key;
                    FindStore.command("tab", FindStore.chat-tab);
                }
            }
        }
        // The channel's other tabs (empty for chats), then "+" Add a tab (a chat's
        // tab goes to the chat, see `FindStore.tab-for-chat`).
        if root.thread-root == "" && CallStore.is-meeting-chat(root.current-id): RecapTab { chat-id: root.current-id; tab <=> FindStore.chat-tab; }
        for ct in FindStore.channel-tabs: ChannelTabButton { tab: ct; }
        if root.thread-root == "": IconButton {
            icon: @image-url("../icons/plus.svg");
            y: 14px;
            tooltip: @tr("Add a tab");
            clicked => {
                FindStore.tab-for-chat = !root.current-is-channel;
                FindStore.tab-add-open = true;
            }
        }
        if root.thread-root == "" && !root.current-is-channel && !root.compact: IconButton {
            icon: @image-url("../icons/calendar.svg");
            y: 14px;
            tooltip: @tr("Schedule a meeting");
            clicked => { root.schedule-meeting(root.current-id); }
        }
        // While the live-call strip shows, its Join is the meeting's.
        if root.thread-root == "" && CallStore.is-meeting-chat(root.current-id) && !root.call-strip: MeetingJoinButton {
            y: 14px;
            live: root.current-meeting-live;
            clicked => { CallStore.command("join-chat", root.current-id); }
        }
        Rectangle { horizontal-stretch: 1; }
        // A call going on here: live dot, how long, who is in it, Join.
        if root.thread-root == "" && root.call-strip: OngoingCallStrip { chat-id: root.current-id; y: 14px; }
        if root.thread-root == "" && root.current-is-channel && !root.compact: ChannelMeetButton {
            y: 14px;
            meet-now => { root.meet-now(root.current-title); }
            schedule-meeting => { root.schedule-meeting(root.current-id); }
        }
        if root.thread-root == "" && !root.current-is-channel: CallHeaderButtons { chat-id: root.current-id; y: 14px; height: 32px; }
        // "View and add participants": group and 1:1 chats (a 1:1 starts a group).
        if (PeopleStore.header-group || PeopleStore.member-count > 0) && !root.current-is-channel && root.thread-root == "" && !root.compact: people-btn := Rectangle {
            width: people-count.preferred-width + 40px;
            height: 32px;
            y: 14px;
            horizontal-stretch: 0;
            border-radius: 4px;
            background: people-touch.has-hover || PeopleStore.participants-open ? Theme.surface-hover : transparent;
            accessible-role: button;
            accessible-label: @tr("View and add participants");
            accessible-value: PeopleStore.member-count;
            accessible-action-default => {
                PeopleStore.participants-open = true;
                PeopleStore.command("participants-open", "");
            }
            Icon { source: @image-url("../icons/people.svg"); x: 8px; y: 8px; width: 16px; height: 16px; tint: Theme.fg-muted; }
            people-count := Text { x: 30px; text: PeopleStore.member-count; color: Theme.fg-muted; font-size: 13px * Theme.font-scale; vertical-alignment: center; }
            people-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    PeopleStore.participants-open = true;
                    PeopleStore.command("participants-open", "");
                }
            }
        }
        if root.thread-root == "" && !root.compact: IconButton {
            icon: @image-url("../icons/search.svg");
            y: 14px;
            tooltip: root.current-is-channel ? @tr("Find in channel") : @tr("Find in chat");
            active: FindStore.chat-find-open;
            clicked => {
                FindStore.chat-find-open = !FindStore.chat-find-open;
                FindStore.chat-find-tick += 1;
                FindStore.command(FindStore.chat-find-open ? "find-open" : "find-close", "");
            }
        }
        if root.thread-root == "" && !root.compact: IconButton {
            icon: @image-url("../icons/info.svg");
            y: 14px;
            tooltip: @tr("Open chat details");
            active: FindStore.details-open;
            clicked => {
                FindStore.details-open = !FindStore.details-open;
                FindStore.command("details", FindStore.details-open ? "open" : "close");
            }
        }
        if root.thread-root == "": HeaderMoreButton {
            y: 14px;
            chat-id: root.current-id;
            muted: root.current-muted;
            channel: root.current-is-channel;
            extras: root.compact;
            mark-unread => { root.mark-chat-unread(root.current-id); }
            schedule-meeting => { root.schedule-meeting(root.current-id); }
        }
    }
    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
}
