// The card that transfers the call to another device or person.
import { Theme } from "../tokens/theme.slint";
import { CallStore } from "../stores/call_store.slint";
import { PeopleSearch } from "call_people.slint";
import { Button, ButtonVariant } from "../atoms/button.slint";
import { Tokens } from "../tokens/types.slint";
import { Fixed } from "../tokens/fixed.slint";

// "Transfer": pick a person, then "Transfer now" (blind transfer). Opening it holds the call.
export component TransferCard inherits Rectangle {
    in property <Tokens> c: Theme.call;
    property <string> to-id;
    property <string> to-name;
    height: card.preferred-height;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: root.c.border;
    background: root.c.surface;
    drop-shadow-blur: 12px;
    drop-shadow-color: Fixed.black-80;
    accessible-role: groupbox;
    accessible-label: "Transfer";
    card := VerticalLayout {
        padding: 12px;
        spacing: 10px;
        Text {
            text: "Transfer";
            color: root.c.fg;
            font-size: 14px * Theme.font-scale;
            font-weight: 600;
        }
        Text {
            text: "The call is on hold. Pick who takes it.";
            color: root.c.fg-subtle;
            font-size: 12px * Theme.font-scale;
            wrap: word-wrap;
        }
        if root.to-id == "": PeopleSearch {
            c: root.c;
            placeholder: "Transfer to";
            picked(f) => {
                root.to-id = f.id;
                root.to-name = f.name;
            }
        }
        if root.to-id != "": HorizontalLayout {
            spacing: 8px;
            Text {
                text: "To: " + root.to-name;
                color: root.c.fg;
                font-size: 13px * Theme.font-scale;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            Button { c: root.c; variant: ButtonVariant.action;
                label: "Change";
                clicked => { root.to-id = ""; }
            }
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Button { c: root.c; variant: ButtonVariant.action;
                label: "Cancel";
                clicked => { CallStore.menu = ""; }
            }
            if root.to-id != "": Button { c: root.c; variant: ButtonVariant.action;
                label: "Transfer now";
                primary: true;
                clicked => {
                    CallStore.command("transfer", root.to-id);
                    CallStore.menu = "";
                }
            }
        }
    }
}
