// "Your teams and channels": the Teams, Discover, Pending invites, Analytics and Communities tabs,
// the team and channel menus, and the Communities section of the chat list.
import { ScrollView } from "std-widgets.slint";
import { Theme } from "../tokens/theme.slint";
import { Icon, IconButton } from "../atoms/widgets.slint";
import { Pill, Badge, BadgeVariant } from "../atoms/chip.slint";
import { TChannel, TTeam, TeamsStore, TeamsActions } from "../stores/teams_store.slint";
import { SkeletonList } from "../tokens/motion.slint";
import { Button, ButtonVariant } from "../atoms/button.slint";
import { Avatar } from "../atoms/avatar.slint";
import { MenuItem, MenuItemVariant } from "../atoms/menu.slint";
import { SearchBox } from "../atoms/search_box.slint";

component ChannelLine inherits Rectangle {
    in property <TChannel> c;
    callback open();
    callback more(length, length);
    height: 34px;
    border-radius: 4px;
    background: ct.has-hover ? Theme.surface-hover : transparent;
    accessible-role: list-item;
    accessible-label: root.c.name;
    accessible-description: (root.c.shown ? "" : "Hidden ") + (root.c.pinned ? "Pinned " : "") + (root.c.kind != "standard" ? root.c.kind : "");
    ct := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.open(); }
        pointer-event(e) => {
            if e.button == PointerEventButton.right && e.kind == PointerEventKind.up {
                root.more(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
    HorizontalLayout {
        padding-left: 58px;
        padding-right: 8px;
        spacing: 8px;
        Icon { source: root.c.kind == "standard" ? @image-url("../icons/hash.svg") : @image-url("../icons/lock.svg"); width: 14px; height: 14px; y: 10px; tint: root.c.shown ? Theme.fg-muted : Theme.fg-subtle; }
        Text { text: root.c.name; color: root.c.shown ? Theme.fg : Theme.fg-subtle; font-size: 13px * Theme.font-scale; vertical-alignment: center; overflow: elide; horizontal-stretch: 0; }
        if root.c.kind == "shared": Badge { variant: BadgeVariant.tag; text: "Shared"; y: 8px; }
        if !root.c.shown: Badge { variant: BadgeVariant.tag; text: "Hidden"; y: 8px; tone: "warn"; }
        if root.c.pinned: Badge { variant: BadgeVariant.tag; text: "Pinned"; y: 8px; tone: "accent"; }
        if root.c.muted: Badge { variant: BadgeVariant.tag; text: "Muted"; y: 8px; }
        if root.c.archived: Badge { variant: BadgeVariant.tag; text: "Archived"; y: 8px; tone: "warn"; }
        Rectangle { horizontal-stretch: 1; }
        IconButton {
            icon: @image-url("../icons/more.svg");
            tooltip: "More options for " + root.c.name;
            size: 26px;
            y: 4px;
            clicked => { root.more(self.absolute-position.x, self.absolute-position.y + self.height); }
        }
    }
}

component TeamLine inherits Rectangle {
    in property <TTeam> t;
    callback toggle();
    callback open();
    callback more(length, length);
    callback channel-open(TChannel);
    callback channel-more(TChannel, length, length);
    VerticalLayout {
        head := Rectangle {
            height: 58px;
            border-radius: 4px;
            background: hd.has-hover ? Theme.surface-hover : transparent;
            accessible-role: list-item;
            accessible-label: root.t.name;
            accessible-description: root.t.access + ", " + root.t.role + ", " + root.t.people + " people, " + root.t.channel-count + " channels";
            accessible-expanded: root.t.expanded;
            accessible-action-default => { root.toggle(); }
            hd := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.toggle(); }
                pointer-event(e) => {
                    if e.button == PointerEventButton.right && e.kind == PointerEventKind.up {
                        root.more(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                    }
                }
            }
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 8px;
                spacing: 12px;
                Icon { source: root.t.expanded ? @image-url("../icons/chevron-down.svg") : @image-url("../icons/chevron-right.svg"); width: 14px; height: 14px; y: 22px; }
                Avatar {
                    size: 36px;
                    y: 11px;
                    corner: 6px;
                    tone: root.t.color;
                    opacity: root.t.shown ? 1.0 : 0.5;
                    initials: root.t.initials;
                    text-size: 14px * Theme.font-scale;
                    text-weight: 700;
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 3px;
                    horizontal-stretch: 1;
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: root.t.name; color: root.t.shown ? Theme.fg : Theme.fg-muted; font-size: 14px * Theme.font-scale; font-weight: 600; overflow: elide; horizontal-stretch: 0; }
                        Badge { variant: BadgeVariant.tag; text: root.t.access; }
                        if root.t.archived: Badge { variant: BadgeVariant.tag; text: "Archived"; tone: "warn"; }
                        if !root.t.shown: Badge { variant: BadgeVariant.tag; text: "Hidden"; tone: "warn"; }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    Text { text: root.t.people + (root.t.people == 1 ? " person" : " people") + " · " + root.t.channel-count + (root.t.channel-count == 1 ? " channel" : " channels") + " · " + root.t.role; color: Theme.fg-subtle; font-size: 12px * Theme.font-scale; overflow: elide; }
                }
                IconButton {
                    icon: @image-url("../icons/more.svg");
                    tooltip: "More options for " + root.t.name;
                    size: 30px;
                    y: 14px;
                    clicked => { root.more(self.absolute-position.x, self.absolute-position.y + self.height); }
                }
            }
        }
        if root.t.expanded: VerticalLayout {
            for c in root.t.channels: ChannelLine {
                c: c;
                open => { root.channel-open(c); }
                more(x, y) => { root.channel-more(c, x, y); }
            }
        }
    }
}

component TabButton inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    in property <int> badge: 0;
    callback clicked();
    height: 40px;
    width: tab-text.preferred-width + 28px;
    accessible-role: tab;
    accessible-label: root.label;
    accessible-checked: root.active;
    accessible-action-default => { root.clicked(); }
    tab-text := Text { text: root.label; color: root.active ? Theme.fg : Theme.fg-muted; font-size: 14px * Theme.font-scale; font-weight: root.active ? 600 : 400; horizontal-alignment: center; vertical-alignment: center; }
    Rectangle { y: parent.height - 3px; height: 3px; x: 10px; width: parent.width - 20px; border-radius: 1px; background: root.active ? Theme.accent : transparent; }
    TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component DiscoverTab inherits Rectangle {
    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        HorizontalLayout {
            spacing: 8px;
            find := SearchBox { min-width: 220px;
                label: "Search public teams";
                placeholder: "Search public teams";
                horizontal-stretch: 1;
                accepted(q) => { TeamsStore.command("discover", q); }
            }
            Button { variant: ButtonVariant.dialog; label: "Search"; clicked => { TeamsStore.command("discover", find.text); } }
            Button { variant: ButtonVariant.dialog; label: "Join with a code"; clicked => { TeamsActions.open-dialog("join", "", ""); } }
        }
        ScrollView {
            VerticalLayout {
                spacing: 8px;
                alignment: start;
                if TeamsStore.discover.length == 0: Text { text: "No teams to show. Search for a public team by name."; color: Theme.fg-subtle; font-size: 13px * Theme.font-scale; }
                for d in TeamsStore.discover: Rectangle {
                    height: 68px;
                    border-radius: 6px;
                    background: Theme.surface;
                    accessible-role: list-item;
                    accessible-label: d.name;
                    accessible-description: d.access + ", " + d.people + " people";
                    HorizontalLayout {
                        padding: 12px;
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text { text: d.name; color: Theme.fg; font-size: 14px * Theme.font-scale; font-weight: 600; overflow: elide; }
                            Text { text: d.desc == "" ? d.access + " · " + d.people + " people" : d.desc; color: Theme.fg-subtle; font-size: 12px * Theme.font-scale; overflow: elide; }
                        }
                        if !d.requested: Button { variant: ButtonVariant.dialog; label: d.access == "Public" ? "Join team" : "Request to join"; primary: true; y: 10px; clicked => { TeamsStore.command("join", d.group); } }
                        if d.requested: Button { variant: ButtonVariant.dialog; label: "Cancel request"; y: 10px; clicked => { TeamsStore.command("join-cancel", d.group); } }
                    }
                }
            }
        }
    }
}

component PendingTab inherits Rectangle {
    VerticalLayout {
        padding: 16px;
        spacing: 8px;
        alignment: start;
        if TeamsStore.requests.length == 0: Text { text: "You have no pending join requests."; color: Theme.fg-subtle; font-size: 13px * Theme.font-scale; }
        for d in TeamsStore.requests: Rectangle {
            height: 56px;
            border-radius: 6px;
            background: Theme.surface;
            HorizontalLayout {
                padding: 12px;
                spacing: 12px;
                Text { text: d.name; color: Theme.fg; font-size: 14px * Theme.font-scale; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                Text { text: "Waiting for the owners"; color: Theme.fg-subtle; font-size: 12px * Theme.font-scale; vertical-alignment: center; }
                Button { variant: ButtonVariant.dialog; label: "Cancel request"; y: 8px; clicked => { TeamsStore.command("join-cancel", d.group); } }
            }
        }
    }
}

component AnalyticsTab inherits ScrollView {
    VerticalLayout {
        padding: 16px;
        spacing: 8px;
        alignment: start;
        for s in TeamsStore.stats: Rectangle {
            height: 44px;
            border-radius: 6px;
            background: Theme.surface;
            accessible-role: text;
            accessible-label: s.label + ": " + s.value;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                Text { text: s.label; color: Theme.fg-muted; font-size: 13px * Theme.font-scale; vertical-alignment: center; horizontal-stretch: 1; }
                Text { text: s.value; color: Theme.fg; font-size: 18px * Theme.font-scale; font-weight: 700; vertical-alignment: center; }
            }
        }
    }
}

component CommunitiesTab inherits Rectangle {
    VerticalLayout {
        padding: 16px;
        spacing: 10px;
        if TeamsStore.community == "": ScrollView {
            VerticalLayout {
                spacing: 8px;
                alignment: start;
                if TeamsStore.communities.length == 0: Text { text: "You are not in any community."; color: Theme.fg-subtle; font-size: 13px * Theme.font-scale; }
                for c in TeamsStore.communities: Rectangle {
                    height: 64px;
                    border-radius: 6px;
                    background: ct.has-hover ? Theme.surface-hover : Theme.surface;
                    accessible-role: list-item;
                    accessible-label: c.name;
                    accessible-action-default => { TeamsStore.community = c.id; TeamsStore.command("community-open", c.id); }
                    HorizontalLayout {
                        padding: 12px;
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            Text { text: c.name; color: Theme.fg; font-size: 14px * Theme.font-scale; font-weight: 600; overflow: elide; }
                            Text { text: c.people + " members" + (c.company ? " · company-wide" : ""); color: Theme.fg-subtle; font-size: 12px * Theme.font-scale; }
                        }
                    }
                    ct := TouchArea { mouse-cursor: pointer; clicked => { TeamsStore.community = c.id; TeamsStore.command("community-open", c.id); } }
                }
            }
        }
        if TeamsStore.community != "": HorizontalLayout {
            spacing: 10px;
            height: 32px;
            IconButton { icon: @image-url("../icons/back.svg"); tooltip: "Back to communities"; clicked => { TeamsStore.community = ""; } }
            Text { text: TeamsStore.community-name; color: Theme.fg; font-size: 16px * Theme.font-scale; font-weight: 700; vertical-alignment: center; overflow: elide; }
            Rectangle { horizontal-stretch: 1; }
            Text { text: "Read only here. Reply in the browser."; color: Theme.fg-subtle; font-size: 12px * Theme.font-scale; vertical-alignment: center; }
        }
        if TeamsStore.community != "": ScrollView {
            VerticalLayout {
                spacing: 8px;
                alignment: start;
                if TeamsStore.posts.length == 0 && TeamsStore.loading: SkeletonList { count: 4; avatar: 36px; row-height: 88px; label: "Loading posts"; }
                if TeamsStore.posts.length == 0 && !TeamsStore.loading: Text { text: "No posts yet."; color: Theme.fg-subtle; font-size: 13px * Theme.font-scale; }
                for p in TeamsStore.posts: Rectangle {
                    height: post-text.preferred-height + 54px;
                    border-radius: 6px;
                    background: Theme.surface;
                    accessible-role: list-item;
                    accessible-label: p.sender;
                    accessible-description: p.text;
                    Text { x: 14px; y: 10px; width: max(0px, parent.width - 36px - post-time.preferred-width); text: p.sender + (p.reply ? " replied" : ""); color: Theme.fg; font-size: 13px * Theme.font-scale; font-weight: 600; overflow: elide; }
                    post-time := Text { x: parent.width - self.preferred-width - 14px; y: 10px; text: p.time; color: Theme.fg-subtle; font-size: 11px * Theme.font-scale; }
                    post-text := Text { x: 14px; y: 32px; width: parent.width - 28px; text: p.text; color: Theme.fg; font-size: 13px * Theme.font-scale; wrap: word-wrap; }
                    Text { x: 14px; y: parent.height - 22px; text: p.likes > 0 ? "♥ " + p.likes : ""; color: Theme.fg-subtle; font-size: 11px * Theme.font-scale; }
                    if p.url != "": Text {
                        x: parent.width - self.preferred-width - 14px;
                        y: parent.height - 22px;
                        text: "Open in browser";
                        color: Theme.accent;
                        font-size: 11px * Theme.font-scale;
                        TouchArea { mouse-cursor: pointer; clicked => { TeamsStore.command("open-post", p.url); } }
                    }
                }
                if TeamsStore.posts-more: Button { variant: ButtonVariant.dialog; label: "Show older posts"; clicked => { TeamsStore.command("community-more", ""); } }
            }
        }
    }
}

// The whole page, drawn over the area right of the rail. `go(id, title)` opens a channel in Teams.
// The team menu, shared by "Your teams and channels" and the Teams list in the sidebar.
export component TeamMenuItems inherits VerticalLayout {
    in property <TTeam> t;
    callback go(string, string);
    // Closes the menu; called after each action.
    callback done();
    MenuItem { variant: MenuItemVariant.dialog; label: "Go to team"; clicked => { root.go(root.t.id, root.t.name); root.done(); } }
    MenuItem { variant: MenuItemVariant.dialog; label: "New channel"; clicked => { TeamsActions.open-dialog("new-channel", root.t.id, ""); root.done(); } }
    MenuItem { variant: MenuItemVariant.dialog; label: "Add members"; clicked => { TeamsActions.open-dialog("members", root.t.id, ""); root.done(); } }
    MenuItem { variant: MenuItemVariant.dialog; label: "Manage team"; clicked => { TeamsActions.open-dialog("manage-team", root.t.id, ""); root.done(); } }
    MenuItem { variant: MenuItemVariant.dialog; label: "Manage team tags"; clicked => { TeamsActions.open-dialog("tags", root.t.id, ""); root.done(); } }
    MenuItem { variant: MenuItemVariant.dialog; label: "Deleted channels"; clicked => { TeamsActions.open-dialog("deleted", root.t.id, ""); root.done(); } }
    MenuItem { variant: MenuItemVariant.dialog; label: root.t.shown ? "Hide team" : "Show team"; clicked => { TeamsStore.command("team-show", root.t.id + "\u{1f}" + (root.t.shown ? "0" : "1")); root.done(); } }
    MenuItem { variant: MenuItemVariant.dialog; label: "Get link to team"; clicked => { TeamsStore.command("team-link", root.t.id); root.done(); } }
    MenuItem { variant: MenuItemVariant.dialog; label: "Leave the team"; danger: true; clicked => { TeamsActions.confirm("Leave " + root.t.name + "?", "leave-team", root.t.id); root.done(); } }
    if root.t.owner: MenuItem { variant: MenuItemVariant.dialog; label: root.t.archived ? "Restore team from the archive" : "Archive team"; clicked => { TeamsActions.confirm((root.t.archived ? "Restore " : "Archive ") + root.t.name + "?", "team-archive", root.t.id + "\u{1f}" + (root.t.archived ? "0" : "1")); root.done(); } }
    if root.t.owner: MenuItem { variant: MenuItemVariant.dialog; label: "Delete the team"; danger: true; clicked => { TeamsActions.confirm("Delete " + root.t.name + "? Its group stays in the recycle bin for 30 days.", "team-delete", root.t.id); root.done(); } }
}

export component TeamsPage inherits Rectangle {
    callback go(string, string);
    background: Theme.main;
    property <string> menu: ""; // "" | team | channel | new
    property <length> menu-x;
    property <length> menu-y;
    property <TTeam> menu-team;
    property <TChannel> menu-channel;
    function run-and-close(name: string, arg: string) {
        root.menu = "";
        TeamsStore.command(name, arg);
    }
    function open-and-close(kind: string, team: string, channel: string) {
        root.menu = "";
        TeamsActions.open-dialog(kind, team, channel);
    }
    function ask(text: string, command: string, arg: string) {
        root.menu = "";
        TeamsActions.confirm(text, command, arg);
    }
    function set-tab(t: string) {
        TeamsStore.tab = t;
        if t == "discover" { TeamsStore.command("discover", ""); }
        if t == "communities" { TeamsStore.command("communities", ""); }
    }
    VerticalLayout {
        Rectangle {
            height: 64px;
            HorizontalLayout {
                padding-left: 24px;
                padding-right: 24px;
                spacing: 10px;
                Text { text: "Your teams and channels"; color: Theme.fg; font-size: 20px * Theme.font-scale; font-weight: 700; vertical-alignment: center; accessible-role: text; }
                Rectangle { horizontal-stretch: 1; }
                Button { variant: ButtonVariant.dialog; label: "Refresh"; y: 16px; clicked => { TeamsStore.command("refresh", ""); } }
                Button { variant: ButtonVariant.dialog;
                    label: "Create team  ▾";
                    primary: true;
                    y: 16px;
                    clicked => { root.menu-x = self.absolute-position.x - 100px; root.menu-y = self.absolute-position.y + self.height + 4px; root.menu = "new"; }
                }
                IconButton { icon: @image-url("../icons/close.svg"); tooltip: "Close"; y: 16px; clicked => { TeamsStore.open = false; } }
            }
        }
        HorizontalLayout {
            padding-left: 14px;
            spacing: 2px;
            alignment: start;
            height: 40px;
            TabButton { label: "Teams"; active: TeamsStore.tab == "teams"; clicked => { root.set-tab("teams"); } }
            TabButton { label: "Discover"; active: TeamsStore.tab == "discover"; clicked => { root.set-tab("discover"); } }
            TabButton { label: "Pending invites"; active: TeamsStore.tab == "invites"; clicked => { root.set-tab("invites"); } }
            TabButton { label: "Analytics"; active: TeamsStore.tab == "analytics"; clicked => { root.set-tab("analytics"); } }
            TabButton { label: "Communities"; active: TeamsStore.tab == "communities"; clicked => { root.set-tab("communities"); } }
        }
        Rectangle { height: 1px; background: Theme.border; }
        if TeamsStore.error != "": Rectangle {
            height: 34px;
            background: #3b1f22;
            HorizontalLayout {
                padding-left: 24px;
                padding-right: 12px;
                Text { text: TeamsStore.error; color: #ffffff; font-size: 12px * Theme.font-scale; vertical-alignment: center; overflow: elide; accessible-role: text; accessible-label: "Error: " + TeamsStore.error; }
            }
        }
        if TeamsStore.notice != "": Rectangle {
            height: 30px;
            background: #1e2f27;
            Text { x: 24px; width: parent.width - 48px; text: TeamsStore.notice; color: #ffffff; font-size: 12px * Theme.font-scale; vertical-alignment: center; overflow: elide; accessible-role: text; accessible-label: TeamsStore.notice; }
        }
        if TeamsStore.tab == "teams": VerticalLayout {
            vertical-stretch: 1;
            HorizontalLayout {
                height: 52px;
                padding-left: 24px;
                padding-right: 24px;
                spacing: 6px;
                alignment: start;
                for f in [{k: "all", l: "All"}, {k: "owned", l: "Teams you own"}, {k: "member", l: "Member of"}, {k: "guest", l: "Guest in"}, {k: "hidden", l: "Hidden"}, {k: "archived", l: "Archived"}]: Pill {
                    label: f.l;
                    active: TeamsStore.filter == f.k;
                    y: 13px;
                    clicked => { TeamsStore.filter = f.k; TeamsStore.command("filter", f.k); }
                }
                Rectangle { width: 12px; }
                for s in [{k: "az", l: "A to Z"}, {k: "za", l: "Z to A"}, {k: "people", l: "Most people"}, {k: "channels", l: "Most channels"}]: Pill {
                    label: "Sort: " + s.l;
                    active: TeamsStore.sort == s.k;
                    y: 13px;
                    clicked => { TeamsStore.sort = s.k; TeamsStore.command("sort", s.k); }
                }
                Rectangle { horizontal-stretch: 1; }
                SearchBox { min-width: 220px;
                    label: "Search teams";
                    placeholder: "Search teams";
                    text: TeamsStore.query;
                    y: 10px;
                    width: 240px;
                    edited(q) => { TeamsStore.query = q; TeamsStore.command("query", q); }
                }
            }
            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    padding: 12px;
                    spacing: 2px;
                    alignment: start;
                    if TeamsStore.loading && TeamsStore.teams.length == 0: SkeletonList { count: 7; avatar: 32px; row-height: 48px; label: "Loading your teams"; }
                    if !TeamsStore.loading && TeamsStore.teams.length == 0: Text { text: "No teams match."; color: Theme.fg-subtle; font-size: 13px * Theme.font-scale; accessible-role: text; }
                    for t[ti] in TeamsStore.teams: TeamLine {
                        t: t;
                        toggle => { TeamsStore.command("expand", t.id); }
                        open => { root.go(t.id, t.name); }
                        more(x, y) => { root.menu-team = t; root.menu-x = x; root.menu-y = y; root.menu = "team"; }
                        channel-open(c) => { root.go(c.id, t.name + " › " + c.name); }
                        channel-more(c, x, y) => { root.menu-team = t; root.menu-channel = c; root.menu-x = x; root.menu-y = y; root.menu = "channel"; }
                    }
                }
            }
        }
        if TeamsStore.tab == "discover": DiscoverTab { vertical-stretch: 1; }
        if TeamsStore.tab == "invites": PendingTab { vertical-stretch: 1; }
        if TeamsStore.tab == "analytics": AnalyticsTab { vertical-stretch: 1; }
        if TeamsStore.tab == "communities": CommunitiesTab { vertical-stretch: 1; }
    }

    // --- menus ---
    if root.menu != "": Rectangle {
        TouchArea { clicked => { root.menu = ""; } pointer-event(e) => { if e.button == PointerEventButton.right && e.kind == PointerEventKind.down { root.menu = ""; } } }
        Rectangle {
            x: max(8px, min(root.menu-x - root.absolute-position.x, root.width - self.width - 8px));
            y: max(8px, min(root.menu-y - root.absolute-position.y, root.height - self.height - 8px));
            width: 250px;
            height: menu-items.preferred-height + 8px;
            border-radius: 6px;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 10px;
            drop-shadow-color: #00000090;
            menu-items := VerticalLayout {
                padding: 4px;
                if root.menu == "new": VerticalLayout {
                    MenuItem { variant: MenuItemVariant.dialog; label: "New team"; clicked => { root.open-and-close("new-team", "", ""); } }
                    MenuItem { variant: MenuItemVariant.dialog; label: "Join a team with a code"; clicked => { root.open-and-close("join", "", ""); } }
                    MenuItem { variant: MenuItemVariant.dialog; label: "Discover public teams"; clicked => { root.menu = ""; root.set-tab("discover"); } }
                    MenuItem { variant: MenuItemVariant.dialog; label: "Join communities"; clicked => { root.menu = ""; root.set-tab("communities"); } }
                }
                if root.menu == "team": TeamMenuItems {
                    t: root.menu-team;
                    go(id, name) => { root.go(id, name); }
                    done => { root.menu = ""; }
                }
                if root.menu == "channel": VerticalLayout {
                    MenuItem { variant: MenuItemVariant.dialog; label: "Go to channel"; clicked => { root.menu = ""; root.go(root.menu-channel.id, root.menu-team.name + " › " + root.menu-channel.name); } }
                    MenuItem { variant: MenuItemVariant.dialog; label: "Manage notifications"; clicked => { root.open-and-close("notify", root.menu-team.id, root.menu-channel.id); } }
                    MenuItem { variant: MenuItemVariant.dialog; label: root.menu-channel.shown ? "Hide" : "Show"; clicked => { root.run-and-close("chan-show", root.menu-channel.id + "\u{1f}" + (root.menu-channel.shown ? "0" : "1")); } }
                    MenuItem { variant: MenuItemVariant.dialog; label: root.menu-channel.pinned ? "Unpin" : "Pin"; clicked => { root.run-and-close("chan-pin", root.menu-channel.id + "\u{1f}" + (root.menu-channel.pinned ? "0" : "1")); } }
                    if root.menu-channel.kind != "standard": MenuItem { variant: MenuItemVariant.dialog; label: "Add members"; clicked => { root.open-and-close("members", root.menu-team.id, root.menu-channel.id); } }
                    if !root.menu-channel.general: MenuItem { variant: MenuItemVariant.dialog; label: "Edit channel"; clicked => { root.open-and-close("edit-channel", root.menu-team.id, root.menu-channel.id); } }
                    MenuItem { variant: MenuItemVariant.dialog; label: "Manage channel"; clicked => { root.open-and-close("moderation", root.menu-team.id, root.menu-channel.id); } }
                    MenuItem { variant: MenuItemVariant.dialog; label: "Manage channel tags"; clicked => { root.open-and-close("tags", root.menu-team.id, root.menu-channel.id); } }
                    MenuItem { variant: MenuItemVariant.dialog; label: "Copy link"; clicked => { root.run-and-close("chan-link", root.menu-channel.id); } }
                    MenuItem { variant: MenuItemVariant.dialog; label: "Get email address"; clicked => { root.open-and-close("email", root.menu-team.id, root.menu-channel.id); } }
                    if root.menu-channel.kind == "standard": MenuItem { variant: MenuItemVariant.dialog; label: "Show for everyone automatically"; clicked => { root.run-and-close("chan-default", root.menu-channel.id + "\u{1f}1"); } }
                    if root.menu-channel.kind == "standard": MenuItem { variant: MenuItemVariant.dialog; label: "Stop showing for everyone"; clicked => { root.run-and-close("chan-default", root.menu-channel.id + "\u{1f}0"); } }
                    if root.menu-channel.kind != "standard": MenuItem { variant: MenuItemVariant.dialog; label: "Leave channel"; danger: true; clicked => { root.ask("Leave " + root.menu-channel.name + "?", "leave-channel", root.menu-channel.id); } }
                    if !root.menu-channel.general: MenuItem { variant: MenuItemVariant.dialog; label: root.menu-channel.archived ? "Restore from the archive" : "Archive channel"; clicked => { root.ask((root.menu-channel.archived ? "Restore " : "Archive ") + root.menu-channel.name + "?", "channel-archive", root.menu-channel.id + "\u{1f}" + (root.menu-channel.archived ? "0" : "1")); } }
                    if !root.menu-channel.general: MenuItem { variant: MenuItemVariant.dialog; label: "Delete channel"; danger: true; clicked => { root.ask("Delete " + root.menu-channel.name + "? You can restore it for 21 days.", "channel-delete", root.menu-team.id + "\u{1f}" + root.menu-channel.id); } }
                }
            }
        }
    }
}

// The Communities section of the chat list: one row per community; a click opens its feed.
export component CommunitiesSection inherits VerticalLayout {
    callback open(string);
    for c in TeamsStore.communities: Rectangle {
        height: 40px;
        border-radius: 4px;
        background: ct.has-hover ? Theme.surface-hover : transparent;
        accessible-role: list-item;
        accessible-label: c.name;
        accessible-action-default => { root.open(c.id); }
        HorizontalLayout {
            padding-left: 12px;
            spacing: 10px;
            Rectangle { width: 24px; height: 24px; y: 8px; border-radius: 12px; background: #0f7b5f; Text { text: "C"; color: #ffffff; font-size: 11px * Theme.font-scale; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } }
            Text { text: c.name; color: Theme.fg; font-size: 13px * Theme.font-scale; vertical-alignment: center; overflow: elide; }
        }
        ct := TouchArea { mouse-cursor: pointer; clicked => { root.open(c.id); } }
    }
}
