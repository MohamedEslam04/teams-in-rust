import { Theme } from "../tokens/theme.slint";
import { Msg } from "../tokens/types.slint";
import { AddReactionChip, Icon, IconButton, ReactionChip } from "../atoms/widgets.slint";
import { FileCard, LoopCardView, MeetLinkCard } from "../molecules/cards.slint";
import { Avatar } from "../atoms/avatar.slint";
import { CalStore } from "../stores/calendar_store.slint";
import { CardView } from "../molecules/card_view.slint";
import { LinkCardView, MediaStore } from "media.slint";
import { VoicePlayer } from "../molecules/voice_player.slint";
import { CodeBlock } from "../molecules/code_block.slint";
import { VideoClipCard } from "video_clip.slint";
import { MeetingCardView } from "meeting_card.slint";
import { DeliveryMark } from "../molecules/delivery_mark.slint";
import { FadeImage, Motion, PopIn } from "../tokens/motion.slint";
import { ReaderItem } from "../tokens/types.slint";

// Right clicks the window saw (`main.rs` counts them). The words of a message are selectable
// text, which takes the press, as do its links and buttons, so the row's own `pointer-event`
// never sees a right click on them: the hovered row opens its menu from this count instead.
export global MessagePointer {
    in-out property <int> right-clicks;
}

// A reader's photo under my message: their initials in a small circle that slides in from the
// right and fades in (200 ms), each a little after the one before.
component ReaderAvatar inherits Rectangle {
    in property <ReaderItem> r;
    in property <int> index;
    property <bool> shown: Theme.reduced-motion;
    width: 16px;
    height: 16px;
    Avatar {
        x: root.shown ? 0px : 10px;
        size: 16px;
        tone: root.r.color;
        initials: root.r.initials;
        text-size: 7px;
        border-width: 1px;
        border-color: Theme.main;
        opacity: root.shown ? 1.0 : 0.0;
        animate x { duration: Motion.normal; delay: root.index * 60ms; easing: ease-out; }
        animate opacity { duration: Motion.normal; delay: root.index * 60ms; easing: ease-out; }
    }
    init => { if Motion.scrolling { root.shown = true; } }
    Timer {
        interval: 16ms;
        running: !root.shown;
        triggered => { root.shown = true; }
    }
}

export component MessageRow inherits TouchArea {
    in property <Msg> m;
    in property <length> max-bubble: 600px;
    // Top of the list's visible area in window coordinates: a hover bar with no room above the
    // bubble under it sits inside the bubble's top edge.
    in property <length> pane-top: 0px;
    in property <bool> in-channel: false;
    // Inside a channel post card: everyone is drawn on the left with an avatar and a name.
    in property <bool> card-style: false;
    // Multi-select mode: a checkbox per row, clicking toggles it, no hover bar.
    in property <bool> select-mode: false;
    // In the chat's own list: a reply's quote jumps to the quoted message and a day line opens
    // "Jump to a date".
    in property <bool> can-jump: false;
    callback jump-to-message(string);
    callback pick-date();
    callback react(string);
    callback reply();
    callback edit();
    // "More reactions" and the "…" menu, anchored at window coordinates.
    callback more-reactions(length, length);
    callback menu(length, length);
    // The "Seen by" line was pressed: the line's right edge, top and bottom (window coordinates).
    callback show-readers(length, length, length);
    callback toggle-select();
    callback open-url(string);
    callback open-thread();
    callback retry-send();
    callback discard-send();
    // Click on the avatar or the sender's name: open the profile card (sender MRI).
    callback profile(string);
    // The same with the clicked photo or name in window coordinates, for a card next to it.
    callback profile-at(string, length, length, length, length);
    profile-at(id, x, y, w, h) => { root.profile(id); }
    // The pointer came onto (true) or left (false) the photo or name, with its rectangle in
    // window coordinates: resting on it opens the hover card.
    callback photo-hover(string, bool, length, length, length, length);
    height: content.preferred-height;
    // A message that just arrived fades in (150 ms); the rest are placed at once.
    property <bool> arrived: !root.m.fresh || Theme.reduced-motion;
    opacity: root.arrived ? 1.0 : 0.0;
    animate opacity { duration: Motion.fast; easing: ease-out; }
    Timer {
        interval: 16ms;
        running: !root.arrived;
        triggered => { root.arrived = true; }
    }

    // Right click opens the same menu as the "…" button, where the pointer is.
    function open-menu-here() {
        if !root.m.system && !root.m.deleted && !root.m.pending && !root.m.failed && !root.select-mode {
            root.menu(root.absolute-position.x + root.mouse-x, root.absolute-position.y + root.mouse-y);
        }
    }
    pointer-event(e) => {
        if e.kind == PointerEventKind.up && e.button == PointerEventButton.right {
            root.open-menu-here();
        }
    }
    property <int> right-clicks: MessagePointer.right-clicks;
    changed right-clicks => {
        if root.has-hover { root.open-menu-here(); }
    }

    if root.m.selected: Rectangle { background: #7f85f526; }
    // The row a jump from the pinned banner landed on.
    if root.m.flash: Rectangle { background: #7f85f540; }

    content := VerticalLayout {
        width: root.width;
        padding-left: root.select-mode ? 44px : 20px;
        padding-right: 20px;
        padding-top: root.m.show-header || root.m.day != "" ? 10px : 2px;
        spacing: 4px;

        if root.m.day != "": day-line := Rectangle {
            property <bool> hover: false;
            HorizontalLayout {
                padding-top: 6px;
                padding-bottom: 6px;
                spacing: 10px;
                Rectangle { height: 1px; background: Theme.border; y: (parent.height - 1px) / 2; }
                Text { text: root.m.day; color: day-line.hover ? Theme.fg : Theme.fg-muted; font-size: 12px * Theme.font-scale; horizontal-stretch: 0; }
                Rectangle { height: 1px; background: Theme.border; y: (parent.height - 1px) / 2; }
            }
            // A click opens "Jump to a date".
            if root.can-jump: day-touch := TouchArea {
                mouse-cursor: pointer;
                accessible-role: button;
                accessible-label: @tr("Jump to a date");
                accessible-action-default => { root.pick-date(); }
                changed has-hover => { day-line.hover = self.has-hover; }
                clicked => { root.pick-date(); }
            }
        }

        if root.m.new-above: HorizontalLayout {
            padding-top: 4px;
            padding-bottom: 4px;
            spacing: 10px;
            Rectangle { height: 1px; background: Theme.accent; y: (parent.height - 1px) / 2; }
            Text { text: @tr("New messages"); color: Theme.accent; font-size: 12px * Theme.font-scale; font-weight: 600; horizontal-stretch: 0; }
            Rectangle { height: 1px; background: Theme.accent; y: (parent.height - 1px) / 2; }
        }

        // Calls, recordings and transcripts are cards (ui/organisms/meeting_card.slint).
        for c in root.m.meeting: MeetingCardView {
            card: c;
            open-url(u) => { root.open-url(u); }
        }

        if root.m.system && root.m.meeting.length == 0: Text {
            text: root.m.plain;
            color: Theme.fg-subtle;
            font-size: 12px * Theme.font-scale;
            font-italic: true;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        if !root.m.system: HorizontalLayout {
            alignment: root.m.mine && !root.card-style ? end : start;
            spacing: 10px;

            if !root.m.mine || root.card-style: Rectangle {
                width: 32px;
                if root.m.show-header: Avatar {
                    y: 0;
                    initials: root.m.initials;
                    tone: root.m.color;
                    img: root.m.avatar;
                    has-img: root.m.has-avatar;
                    presence: root.m.presence;
                    size: 32px;
                    avatar-touch := TouchArea {
                        mouse-cursor: pointer;
                        accessible-role: button;
                        accessible-label: @tr("Open profile of {}", root.m.sender);
                        accessible-action-default => { root.profile(root.m.sender-id); }
                        clicked => { root.profile-at(root.m.sender-id, self.absolute-position.x, self.absolute-position.y, self.width, self.height); }
                        // Resting on the photo opens the card, as in Teams.
                        // A list row can be reused for another message while the pointer
                        // rests on it: the leave names the person the pointer came to.
                        property <string> hovered: "";
                        changed has-hover => {
                            if self.has-hover { self.hovered = root.m.sender-id; }
                            root.photo-hover(self.hovered, self.has-hover, self.absolute-position.x, self.absolute-position.y, self.width, self.height);
                        }
                    }
                }
            }

            bubble := Rectangle {
                max-width: root.max-bubble;
                border-radius: Theme.radius;
                background: root.m.mentions-me ? #3a3a63 : (root.m.mine ? Theme.bubble-mine : Theme.bubble-other);
                opacity: root.m.pending ? 0.6 : 1.0;
                border-width: root.m.failed || root.m.mentions-me ? 1px : 0px;
                border-color: root.m.failed ? Theme.danger : Theme.accent;

                VerticalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    padding-top: 8px;
                    padding-bottom: 10px;
                    spacing: 6px;

                    if root.m.show-header || root.m.mine: HorizontalLayout {
                        spacing: 8px;
                        alignment: root.m.mine && !root.card-style ? end : start;
                        if !root.m.mine || root.card-style: Rectangle {
                            width: min(sender-text.preferred-width, max(80px, root.max-bubble - 160px));
                            sender-text := Text { width: parent.width; text: root.m.sender; color: Theme.fg; font-size: 12px * Theme.font-scale; font-weight: 600; overflow: elide; }
                            sender-touch := TouchArea {
                                mouse-cursor: pointer;
                                accessible-role: button;
                                accessible-label: @tr("Open profile of {}", root.m.sender);
                                accessible-action-default => { root.profile(root.m.sender-id); }
                                clicked => { root.profile-at(root.m.sender-id, self.absolute-position.x, self.absolute-position.y, self.width, self.height); }
                                property <string> hovered: "";
                                changed has-hover => {
                                    if self.has-hover { self.hovered = root.m.sender-id; }
                                    root.photo-hover(self.hovered, self.has-hover, self.absolute-position.x, self.absolute-position.y, self.width, self.height);
                                }
                            }
                        }
                        Text { text: root.m.time; color: Theme.fg-subtle; font-size: 11px * Theme.font-scale; }
                        if root.m.edited: Text { text: @tr("Edited"); color: Theme.fg-subtle; font-size: 11px * Theme.font-scale; }
                    }

                    if root.m.importance != "": Text {
                        text: root.m.importance == "urgent" ? @tr("URGENT!") : @tr("IMPORTANT!");
                        color: Theme.danger;
                        font-size: 12px;
                        font-weight: 800;
                        accessible-role: text;
                    }

                    if root.m.subject != "": Text {
                        text: root.m.subject;
                        color: Theme.fg;
                        font-size: 15px * Theme.font-scale;
                        font-weight: 700;
                        wrap: word-wrap;
                        min-width: 0px;
                    }

                    for q in root.m.quotes: quote-box := Rectangle {
                        property <bool> hover: false;
                        background: self.hover ? Theme.surface-hover : Theme.sidebar;
                        border-radius: 4px;
                        HorizontalLayout {
                            Rectangle { width: 3px; background: Theme.accent; }
                            VerticalLayout {
                                padding: 8px;
                                spacing: 2px;
                                if q.time != "": Text { text: q.time; color: Theme.accent; font-size: 11px * Theme.font-scale; overflow: elide; }
                                Text { text: q.author; color: Theme.fg-muted; font-size: 11px * Theme.font-scale; font-weight: 600; overflow: elide; }
                                Text { text: q.text; color: Theme.fg-muted; font-size: 12px * Theme.font-scale; wrap: word-wrap; max-height: 120px; overflow: elide; horizontal-alignment: q.rtl ? right : left; }
                            }
                        }
                        // A click goes to the quoted message.
                        if root.can-jump && q.id != "": quote-touch := TouchArea {
                            mouse-cursor: pointer;
                            accessible-role: button;
                            accessible-label: @tr("Go to the original message");
                            accessible-action-default => { root.jump-to-message(q.id); }
                            changed has-hover => { quote-box.hover = self.has-hover; }
                            clicked => { root.jump-to-message(q.id); }
                        }
                    }

                    if root.m.deleted: Text { text: @tr("This message has been deleted."); color: Theme.fg-subtle; font-italic: true; font-size: 13px * Theme.font-scale; }

                    if !root.m.deleted && root.m.card.length > 0: CardView {
                        rows: root.m.card;
                        min-width: min(420px, root.max-bubble - 28px);
                        open-url(u) => { root.open-url(u); }
                    }

                    if !root.m.deleted && root.m.plain != "" && (root.m.card.length == 0 || root.m.headline != "") && root.m.parts.length == 0: StyledText {
                        text: root.m.body;
                        // The layout would keep the bubble as wide as the longest word (a URL, a path);
                        // with no minimum the text wraps inside the bubble, breaking such a word.
                        min-width: 0px;
                        default-color: Theme.fg;
                        default-font-size: 14px * Theme.font-scale;
                        link-color: Theme.accent;
                        selectable: true;
                        horizontal-alignment: root.m.rtl ? right : left;
                        link-clicked(url) => { root.open-url(url); }
                    }

                    // A text with code blocks: its runs of text and its boxes of code, in order.
                    if !root.m.deleted && root.m.plain != "" && (root.m.card.length == 0 || root.m.headline != "") && root.m.parts.length > 0: VerticalLayout {
                        spacing: 6px;
                        for p in root.m.parts: VerticalLayout {
                            if !p.is-code: StyledText {
                                text: p.body;
                                min-width: 0px;
                                default-color: Theme.fg;
                                default-font-size: 14px * Theme.font-scale;
                                link-color: Theme.accent;
                                selectable: true;
                                horizontal-alignment: root.m.rtl ? right : left;
                                link-clicked(url) => { root.open-url(url); }
                            }
                            if p.is-code: CodeBlock {
                                code: p.code;
                                min-width: min(240px, root.max-bubble - 28px);
                                copy(c) => { MediaStore.command("text-copy", c); }
                            }
                        }
                    }

                    // Several pictures form a grid (plan 9.5); clicking one opens the viewer.
                    if root.m.images.length > 0: Rectangle {
                        width: root.m.grid-w;
                        height: root.m.grid-h;
                        for im[i] in root.m.images: Rectangle {
                            x: im.x;
                            y: im.y;
                            width: im.w;
                            height: im.h;
                            border-radius: 4px;
                            background: Theme.sidebar;
                            clip: true;
                            // A soft placeholder, then the picture fades in.
                            FadeImage { source: im.img; loaded: im.loaded; width: parent.width; height: parent.height; accessible-role: image; accessible-label: im.loaded ? "" : @tr("Loading image…"); }
                            if im.overflow > 0: Rectangle {
                                background: #000000a0;
                                Text { text: "+" + im.overflow; color: #ffffff; font-size: 22px * Theme.font-scale; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                accessible-role: button;
                                accessible-label: @tr("Open image {}", i + 1);
                                accessible-action-default => { MediaStore.command("image", root.m.id + "|" + im.url); }
                                clicked => { MediaStore.command("image", root.m.id + "|" + im.url); }
                            }
                        }
                    }

                    // Translate (plan 9.6): a link under a message in another language, "See original" after.
                    if root.m.translate == "offer" || root.m.translate == "busy" || root.m.translate == "shown" || root.m.translate == "failed": HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        height: 18px;
                        if root.m.translate == "busy": Text { text: @tr("Translating…"); color: Theme.fg-subtle; font-size: 12px * Theme.font-scale; vertical-alignment: center; }
                        if root.m.translate == "shown": Text { text: @tr("Translated from {}", root.m.translate-from); color: Theme.fg-subtle; font-size: 12px * Theme.font-scale; vertical-alignment: center; }
                        if root.m.translate == "failed": Text { text: @tr("Could not translate"); color: Theme.danger; font-size: 12px * Theme.font-scale; vertical-alignment: center; }
                        if root.m.translate != "busy" && root.m.translate != "shown": Rectangle {
                            width: tr-link.preferred-width;
                            tr-link := Text { text: root.m.translate == "failed" ? @tr("Retry") : @tr("Translate"); color: Theme.accent; font-size: 12px * Theme.font-scale; font-weight: 600; vertical-alignment: center; }
                            TouchArea {
                                mouse-cursor: pointer;
                                accessible-role: button;
                                accessible-label: root.m.translate == "failed" ? @tr("Retry translation") : @tr("Translate message");
                                accessible-action-default => { MediaStore.command("translate", root.m.id); }
                                clicked => { MediaStore.command("translate", root.m.id); }
                            }
                        }
                        if root.m.translate == "shown": Rectangle {
                            width: orig-link.preferred-width;
                            orig-link := Text { text: @tr("See original"); color: Theme.accent; font-size: 12px * Theme.font-scale; font-weight: 600; vertical-alignment: center; }
                            TouchArea {
                                mouse-cursor: pointer;
                                accessible-role: button;
                                accessible-label: @tr("See original");
                                accessible-action-default => { MediaStore.command("original", root.m.id); }
                                clicked => { MediaStore.command("original", root.m.id); }
                            }
                        }
                    }

                    // Link preview cards (plan 9.7).
                    for c in root.m.links: LinkCardView {
                        c: c;
                        min-width: min(420px, root.max-bubble - 28px);
                        open(u) => { root.open-url(u); }
                    }

                    // Loop components are cards, not bare links.
                    for l in root.m.loops: LoopCardView {
                        title: l.title;
                        url: l.url;
                        min-width: min(320px, root.max-bubble - 28px);
                        open(u) => { root.open-url(u); }
                    }

                    // A Teams meeting link: a card whose Join opens the pre-join screen, as the
                    // calendar's Join does.
                    for u in root.m.joins: MeetLinkCard {
                        url: u;
                        min-width: min(320px, root.max-bubble - 28px);
                        join(link) => { CalStore.command("join", link); }
                    }

                    // Voice messages play in place (ui/molecules/voice_player.slint).
                    for v in root.m.voices: VoicePlayer {
                        item: v;
                    }

                    // Video clips: a card that plays in the system player (ui/organisms/video_clip.slint).
                    for c in root.m.videos: VideoClipCard {
                        item: c;
                    }

                    for f in root.m.files: FileCard {
                        f: f;
                        min-width: 280px;
                        open => { root.open-url("kelma-file:" + f.ext + ":" + f.url); }
                        action(a) => { MediaStore.command("file", a + "\u{1f}" + f.url); }
                    }

                    if root.m.reactions.length > 0: HorizontalLayout {
                        spacing: 4px;
                        alignment: start;
                        for r in root.m.reactions: ReactionChip {
                            r: r;
                            clicked => { root.react(r.key); }
                        }
                        // After the reactions, as in Teams: add another (opens the picker below it).
                        if !root.select-mode && !root.m.system && !root.m.deleted && !root.m.pending && !root.m.failed: AddReactionChip {
                            clicked => { root.more-reactions(self.absolute-position.x, self.absolute-position.y + self.height + 4px); }
                        }
                    }

                    if root.m.failed: HorizontalLayout {
                        spacing: 6px;
                        alignment: root.m.mine ? end : start;
                        Text { text: @tr("Failed to send"); color: Theme.danger; font-size: 12px * Theme.font-scale; vertical-alignment: center; }
                        Text { text: "·"; color: Theme.fg-subtle; font-size: 12px * Theme.font-scale; vertical-alignment: center; }
                        Rectangle {
                            width: retry-text.preferred-width;
                            retry-text := Text { text: @tr("Retry"); color: Theme.accent; font-size: 12px * Theme.font-scale; font-weight: 600; vertical-alignment: center; }
                            TouchArea { mouse-cursor: pointer; clicked => { root.retry-send(); } }
                        }
                        Text { text: "·"; color: Theme.fg-subtle; font-size: 12px * Theme.font-scale; vertical-alignment: center; }
                        Rectangle {
                            width: discard-text.preferred-width;
                            discard-text := Text { text: @tr("Delete"); color: Theme.accent; font-size: 12px * Theme.font-scale; font-weight: 600; vertical-alignment: center; }
                            TouchArea { mouse-cursor: pointer; clicked => { root.discard-send(); } }
                        }
                    }

                    if root.in-channel && root.m.reply-count >= 0: Rectangle {
                        height: 22px;
                        HorizontalLayout {
                            spacing: 6px;
                            Icon { source: @image-url("../icons/thread.svg"); width: 14px; height: 14px; tint: Theme.accent; y: 4px; }
                            Text {
                                text: root.m.reply-count == 0 ? @tr("Reply") : (root.m.reply-count == 1 ? @tr("1 reply") : @tr("{} replies", root.m.reply-count));
                                color: Theme.accent;
                                font-size: 12px * Theme.font-scale;
                                vertical-alignment: center;
                            }
                        }
                        TouchArea { mouse-cursor: pointer; clicked => { root.open-thread(); } }
                    }
                }

                // The hover bar floats over the bubble's top right corner, as in Teams: it overlaps
                // the top edge only by the bubble's top padding, so the sender's name and the time
                // under it stay readable. Its right edge is just inside the bubble's; a bar wider
                // than someone else's (left) bubble starts at the bubble, so it never covers the
                // avatar, and every bar stays inside the pane (the row's width). With no room above
                // (the first message under the top of the pane) it sits inside the top edge.
                // It is not in the bubble's layout, so it never changes the bubble's size.
                // The part above the row is not the row's, so the bar keeps itself shown while the
                // pointer is on it (`bar-touch`); hidden, that area takes no events.
                if !root.select-mode && !root.m.system && !root.m.deleted && !root.m.pending && !root.m.failed: bar-touch := TouchArea {
                    // Four quick reactions, More reactions, Reply with quote, Edit (mine) and More
                    // actions are 30px each, plus the divider and the padding.
                    property <length> left-in-row: parent.absolute-position.x - root.absolute-position.x;
                    property <length> above: -(self.height - 8px);
                    enabled: root.has-hover || self.has-hover;
                    width: (root.m.mine ? 8 : 7) * 30px + 1px + 8px;
                    height: 32px;
                    x: max(8px - self.left-in-row, min(root.width - 8px - self.left-in-row - self.width, root.m.mine && !root.card-style ? parent.width - self.width - 8px : max(0px, parent.width - self.width - 8px)));
                    y: parent.absolute-position.y + self.above < root.pane-top ? 4px : self.above;
                    if root.has-hover || bar-touch.has-hover: bar := Rectangle {
                        width: parent.width;
                        height: parent.height;
                        border-radius: 4px;
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: Theme.border;
                        actions := HorizontalLayout {
                            padding-left: 4px;
                            padding-right: 4px;
                            spacing: 0px;
                            // Teams' quick reactions, then the rest of the buttons.
                            for e in [{k: "like", t: "👍"}, {k: "heart", t: "❤️"}, {k: "laugh", t: "😆"}, {k: "surprised", t: "😮"}]: Rectangle {
                                width: 30px;
                                background: et.has-hover ? Theme.surface-hover : transparent;
                                animate background { duration: Motion.quick; }
                                border-radius: 4px;
                                Text { text: e.t; font-size: 16px * Theme.font-scale; horizontal-alignment: center; vertical-alignment: center; }
                                et := TouchArea { mouse-cursor: pointer; clicked => { root.react(e.k); } }
                            }
                            IconButton {
                                icon: @image-url("../icons/emoji-add.svg"); tooltip: @tr("More reactions");
                                size: 30px;
                                clicked => { root.more-reactions(bar.absolute-position.x + bar.width - 308px, bar.absolute-position.y + bar.height + 4px); }
                            }
                            Rectangle { width: 1px; background: Theme.border; }
                            IconButton { icon: @image-url("../icons/quote.svg"); tooltip: @tr("Reply with quote"); size: 30px; clicked => { root.reply(); } }
                            if root.m.mine: IconButton { icon: @image-url("../icons/edit.svg"); tooltip: @tr("Edit"); size: 30px; clicked => { root.edit(); } }
                            IconButton {
                                icon: @image-url("../icons/more.svg"); tooltip: @tr("More actions");
                                size: 30px;
                                clicked => { root.menu(bar.absolute-position.x + bar.width - 240px, bar.absolute-position.y + bar.height + 4px); }
                            }
                        }
                    }
                }
            }

            // My message in a 1:1 chat: its delivery mark at the right edge, level with the
            // bubble's bottom. The column is there on every one of my messages, so the bubbles
            // line up whether or not they carry a mark.
            if root.m.receipt-side && root.m.mine && !root.card-style: DeliveryMark {
                state: root.m.pending ? "sending" : root.m.receipt;
            }
        }

        // Delivery under my newest message of a group: a clock while it is being sent, a check once
        // sent, an eye (and the readers) when someone saw it. The glyphs cross-fade (200 ms). A
        // 1:1 chat draws the mark beside the bubble instead (`DeliveryMark`).
        if !root.m.receipt-side && (root.m.receipt != "" || (root.m.mine && root.m.pending && !root.m.failed)): receipt-mark := Rectangle {
            property <bool> sending: root.m.pending;
            property <bool> seen: !self.sending && root.m.receipt == "seen";
            property <string> seen-line: root.m.receipt-names != "" ? @tr("Seen by {}", root.m.receipt-names) : @tr("Seen");
            height: 16px;
            accessible-role: text;
            accessible-label: self.sending ? @tr("Sending") : (self.seen ? (root.m.receipt-names != "" ? @tr("Seen by {}", root.m.receipt-names) : @tr("Seen")) : @tr("Sent"));
            HorizontalLayout {
                alignment: end;
                spacing: 4px;
                if receipt-mark.seen: HorizontalLayout {
                    spacing: -4px;
                    for rd[i] in root.m.readers: ReaderAvatar { r: rd; index: i; }
                }
                Rectangle {
                    width: 12px;
                    Icon {
                        source: @image-url("../icons/clock.svg");
                        tint: Theme.fg-subtle;
                        width: 12px;
                        height: 12px;
                        y: 2px;
                        opacity: receipt-mark.sending ? 1.0 : 0.0;
                        animate opacity { duration: Motion.normal; easing: ease-out; }
                    }
                    Icon {
                        source: @image-url("../icons/check.svg");
                        tint: Theme.fg-subtle;
                        width: 12px;
                        height: 12px;
                        y: 2px;
                        opacity: !receipt-mark.sending && !receipt-mark.seen ? 1.0 : 0.0;
                        transform-scale: !receipt-mark.sending && !receipt-mark.seen ? 1.0 : 0.6;
                        animate opacity { duration: Motion.normal; easing: ease-out; }
                        animate transform-scale { duration: Motion.normal; easing: ease-out; }
                    }
                    Icon {
                        source: @image-url("../icons/eye.svg");
                        tint: Theme.accent;
                        width: 12px;
                        height: 12px;
                        y: 2px;
                        opacity: receipt-mark.seen ? 1.0 : 0.0;
                        transform-scale: receipt-mark.seen ? 1.0 : 0.6;
                        animate opacity { duration: Motion.normal; easing: ease-out; }
                        animate transform-scale { duration: Motion.normal; easing: ease-out; }
                    }
                }
                if receipt-mark.sending: Text {
                    text: @tr("Sending…");
                    color: Theme.fg-subtle;
                    font-size: 11px * Theme.font-scale;
                    vertical-alignment: center;
                }
                if receipt-mark.seen: PopIn {
                    from-scale: 1.0;
                    width: seen-text.preferred-width;
                    seen-text := Text {
                        text: receipt-mark.seen-line;
                        color: Theme.fg-subtle;
                        font-size: 11px * Theme.font-scale;
                        vertical-alignment: center;
                    }
                }
            }
            // The whole line (photos, eye and names) opens the list of everyone who saw it. It
            // sits over the right-aligned content: three photos overlap to 12px * n + 4px, then
            // the eye, then the text, 4px apart.
            if receipt-mark.seen && root.m.reader-list.length > 0: readers-link := TouchArea {
                width: min(receipt-mark.width, 12px * min(root.m.readers.length, 3) + 4px + 4px + 12px + 4px + measure.preferred-width);
                x: receipt-mark.width - self.width;
                mouse-cursor: pointer;
                accessible-role: button;
                accessible-label: @tr("Show who saw this");
                clicked => {
                    root.show-readers(self.absolute-position.x + self.width, self.absolute-position.y, self.absolute-position.y + self.height);
                }
            }
            // Measures the line's text for the link above (the line's own text sits in a layout).
            measure := Text {
                visible: false;
                width: 0px;
                height: 0px;
                text: receipt-mark.seen-line;
                font-size: 11px * Theme.font-scale;
            }
        }
    }

    if root.select-mode && !root.m.system && !root.m.deleted: Rectangle {
        x: 12px;
        y: 12px;
        width: 20px;
        height: 20px;
        border-radius: 4px;
        border-width: 1px;
        border-color: root.m.selected ? Theme.accent : Theme.fg-subtle;
        background: root.m.selected ? Theme.accent-strong : transparent;
        accessible-role: checkbox;
        accessible-label: @tr("Select message");
        accessible-checkable: true;
        accessible-checked: root.m.selected;
        Text { text: root.m.selected ? "✓" : ""; color: #ffffff; font-size: 13px * Theme.font-scale; horizontal-alignment: center; vertical-alignment: center; }
    }
    if root.select-mode && !root.m.system && !root.m.deleted: TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggle-select(); }
    }
}
