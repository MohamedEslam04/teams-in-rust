import { ScrollView } from "std-widgets.slint";
import { Theme } from "../tokens/theme.slint";
import { ChatRow, TeamRow } from "../tokens/types.slint";
import { Icon, IconButton, SectionHeader } from "../atoms/widgets.slint";
import { Pill } from "../atoms/chip.slint";
import { Avatar, GlyphAvatar } from "../atoms/avatar.slint";
import { ChannelMenu, ItemMenu, ListStore, OptionRow, SectionHead } from "lists.slint";
import { CommunitiesSection } from "communities_section.slint";
import { TeamMenuItems } from "team_menu.slint";
import { TeamsStore } from "../stores/teams_store.slint";
import { PeopleStore, PersonHover } from "../molecules/people.slint";
import { RemindStore } from "remind.slint";
import { ChatTipLayer, ChatTipStore, QuickViewsSection } from "chat_list_extras.slint";
import { FindStore } from "../stores/find_store.slint";
import { NewChatSplit } from "web_parity.slint";
import { ChatHeaderStore } from "chat_header.slint";
import { Motion, PopIn, Reveal, SkeletonList, TypingDots, TypingStore } from "../tokens/motion.slint";
import { MenuItem, MenuItemVariant } from "../atoms/menu.slint";

// "See all" / "Show less" under the Meetings section.
component MoreRow inherits Rectangle {
    in property <string> label;
    callback clicked();
    height: 28px;
    border-radius: 4px;
    background: touch.has-hover ? Theme.surface-hover : transparent;
    animate background { duration: Motion.quick; }
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    Text {
        x: 54px;
        y: 0px;
        width: parent.width - 64px;
        height: parent.height;
        text: root.label;
        color: Theme.accent;
        font-size: 12px * Theme.font-scale;
        vertical-alignment: center;
        horizontal-alignment: Theme.start-align;
        overflow: elide;
        accessible-role: none;
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component ChatItem inherits Rectangle {
    in property <ChatRow> data;
    in property <bool> selected;
    // Bottom of the list in window coordinates: the menu opens upwards when it would not fit.
    in property <length> limit: 100000px;
    // The open menu's height when it opens upwards (0 when it opens downwards).
    property <length> menu-up: 0px;
    property <bool> in-section: root.data.section != "favorites" && root.data.section != "chats" && root.data.section != "meetings" && root.data.section != "channels";
    // The menu's main view (as `ItemMenu.menu-height` counts it).
    property <length> menu-height: (6 + (root.in-section ? 1 : 0) + (root.data.channel ? 2 + (ListStore.channel-private ? 1 : 0) : 4) + (root.data.group ? 1 : 0)) * 32px + 8px;
    function open-menu() {
        root.menu-up = root.absolute-position.y + root.height - 8px + root.menu-height > root.limit ? root.menu-height : 0px;
        item-menu.show();
    }
    callback clicked();
    callback toggle-favorite();
    callback mark-unread();
    callback leave();
    height: 56px;
    border-radius: 4px;
    background: selected ? Theme.selected : (t.has-hover ? Theme.surface-hover : transparent);
    animate background { duration: Motion.quick; }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 10px;
        alignment: stretch;
        // Each kind of row has its own avatar, as in Teams: a person's photo (or initials) with
        // presence, a people glyph for a group chat, a calendar for a meeting chat and the team's
        // square picture with a "#" badge for a channel.
        if !root.data.channel && root.data.kind != "meeting" && !(root.data.group && !root.data.has-avatar): Avatar {
            initials: root.data.initials;
            tone: root.data.color;
            img: root.data.avatar;
            has-img: root.data.has-avatar;
            presence: root.data.presence;
            size: 32px;
            y: (parent.height - 32px) / 2;
        }
        if root.data.group && !root.data.has-avatar: GlyphAvatar {
            y: (parent.height - 32px) / 2;
            icon: @image-url("../icons/people.svg");
            tone: Theme.surface-hover;
            tint: Theme.fg-muted;
            accessible-label: @tr("Group chat");
        }
        if !root.data.channel && root.data.kind == "meeting": GlyphAvatar {
            y: (parent.height - 32px) / 2;
            icon: @image-url("../icons/calendar.svg");
            tone: Theme.accent.transparentize(0.8);
            tint: Theme.accent;
            accessible-label: @tr("Meeting chat");
        }
        if root.data.channel: Rectangle {
            width: 32px;
            height: 32px;
            y: (parent.height - 32px) / 2;
            accessible-role: image;
            accessible-label: @tr("Channel");
            // The team's picture, square like in Teams.
            Avatar {
                size: 32px;
                corner: 6px;
                tone: root.data.color;
                initials: root.data.initials;
                text-size: 12px;
                img: root.data.avatar;
                has-img: root.data.has-avatar;
                photo-label: @tr("Team picture");
            }
            Rectangle {
                x: 32px - 13px + 2px;
                y: 32px - 13px + 2px;
                width: 13px;
                height: 13px;
                border-radius: 4px;
                background: Theme.sidebar;
                Icon { source: @image-url("../icons/hash.svg"); width: 9px; height: 9px; tint: Theme.fg-muted; }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: root.data.title;
                    color: Theme.fg;
                    font-size: 14px * Theme.font-scale;
                    font-weight: root.data.unread ? 700 : 400;
                    overflow: elide;
                    // A private channel's lock follows the name.
                    horizontal-stretch: root.data.private ? 0 : 1;
                    horizontal-alignment: root.data.rtl-title ? right : left;
                }
                if root.data.private: Icon {
                    source: @image-url("../icons/lock.svg");
                    width: 12px;
                    height: 12px;
                    y: (parent.height - 12px) / 2;
                    tint: Theme.fg-subtle;
                    accessible-role: image;
                    accessible-label: @tr("Private channel");
                }
                if root.data.private: Rectangle { horizontal-stretch: 1; }
                // Someone is typing in this chat: three dots, as in Teams.
                for tc in TypingStore.chats: Rectangle {
                    width: tc == root.data.id ? 18px : 0px;
                    horizontal-stretch: 0;
                    if tc == root.data.id: TypingDots {
                        tint: Theme.accent;
                        dot: 3px;
                        y: (parent.height - self.height) / 2;
                        accessible-role: image;
                        accessible-label: @tr("Typing");
                    }
                }
                if root.data.mention: Text { text: "@"; color: Theme.accent; font-size: 13px * Theme.font-scale; font-weight: 700; horizontal-stretch: 0; vertical-alignment: center; accessible-role: text; accessible-label: @tr("You were mentioned"); }
                if ListStore.show-times: Text { text: root.data.time; color: Theme.fg-subtle; font-size: 11px * Theme.font-scale; horizontal-stretch: 0; vertical-alignment: center; }
                if root.data.muted: Text { text: "🔕"; color: Theme.fg-subtle; font-size: 11px * Theme.font-scale; horizontal-stretch: 0; vertical-alignment: center; accessible-role: text; accessible-label: @tr("Muted"); }
            }
            if ListStore.show-previews: HorizontalLayout {
                spacing: 4px;
                if root.data.draft: Text { text: @tr("Draft:"); color: #e97a5f; font-size: 12px * Theme.font-scale; horizontal-stretch: 0; }
                Text {
                    text: root.data.preview;
                    color: root.data.unread ? Theme.fg : Theme.fg-subtle;
                    font-weight: root.data.unread ? 600 : 400;
                    font-size: 12px * Theme.font-scale;
                    overflow: elide;
                    horizontal-alignment: root.data.rtl-preview ? right : left;
                }
            }
        }
        if root.data.unread: PopIn {
            from-scale: Theme.reduced-motion ? 1.0 : 0.3;
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: Theme.accent;
            y: (parent.height - 8px) / 2;
        }
    }
    t := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        changed has-hover => {
            if self.has-hover && root.data.channel {
                ChatTipStore.title = root.data.title;
                ChatTipStore.private = root.data.private;
                ChatTipStore.row-bottom = root.absolute-position.y + root.height;
                ChatTipStore.id = root.data.id;
            } else if ChatTipStore.id == root.data.id {
                ChatTipStore.id = "";
            }
        }
        // Resting on a 1:1 chat's photo opens the person's hover card; a click opens the chat.
        // (Inside the row's TouchArea, which would otherwise take the pointer from the photo.)
        if root.data.person != "": photo-hover := PersonHover {
            x: 12px;
            y: (parent.height - 32px) / 2;
            width: 32px;
            height: 32px;
            person: root.data.person;
            click-opens: false;
            activated => { root.clicked(); }
        }
        pointer-event(e) => {
            if e.button == PointerEventButton.right && e.kind == PointerEventKind.up {
                if root.data.channel { ListStore.command("channel-menu", root.data.id); }
                root.open-menu();
            }
        }
        if t.has-hover: IconButton {
            x: parent.width - 30px;
            y: 30px;
            size: 22px;
            icon: @image-url("../icons/star.svg");
            tint: root.data.favorite ? #ffd335 : Theme.fg-subtle;
            clicked => { root.toggle-favorite(); }
        }
        // The same menu as a right click.
        if t.has-hover: IconButton {
            x: parent.width - 54px;
            y: 30px;
            size: 22px;
            icon: @image-url("../icons/more.svg");
            tooltip: @tr("More options");
            clicked => {
                if root.data.channel { ListStore.command("channel-menu", root.data.id); }
                root.open-menu();
            }
        }
    }

    item-menu := PopupWindow {
        x: parent.width - 190px;
        // Placed when it opens, so switching to the section list does not move it.
        y: root.menu-up > 0px ? 8px - root.menu-up : root.height - 8px;
        width: 180px;
        height: menu.menu-height;
        close-policy: close-on-click-outside;
        menu := ItemMenu {
            data: root.data;
            in-section: root.in-section;
            mark-unread => { root.mark-unread(); }
            leave => { root.leave(); }
            remove-history => { ChatHeaderStore.remove-history = root.data.id; }
            toggle-favorite => { root.toggle-favorite(); }
            done => { item-menu.close(); }
        }
    }
}

// The row of the chat being started in the New chat pane: "New message", selected.
component NewMessageRow inherits Rectangle {
    height: 56px;
    border-radius: 4px;
    background: Theme.selected;
    accessible-role: list-item;
    accessible-label: @tr("New message");
    accessible-item-selected: true;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 10px;
        Rectangle {
            width: 32px;
            height: 32px;
            y: 12px;
            border-radius: 16px;
            background: Theme.surface-hover;
            Icon { source: @image-url("../icons/compose.svg"); width: 16px; height: 16px; }
        }
        Text { text: @tr("New message"); color: Theme.fg; font-size: 14px * Theme.font-scale; font-italic: true; vertical-alignment: center; overflow: elide; accessible-role: none; }
    }
}

// "While you were away": shown once after start-up when chats are unread (dismissed for the session).
// The message counts are not known cheaply, so it counts chats.
component AwayCard inherits Rectangle {
    in property <string> summary;
    callback begin();
    callback dismiss();
    height: lay.preferred-height;
    border-radius: 6px;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    accessible-role: groupbox;
    accessible-label: @tr("While you were away");
    lay := VerticalLayout {
        padding: 10px;
        spacing: 6px;
        HorizontalLayout {
            spacing: 6px;
            Text { text: @tr("While you were away"); color: Theme.fg; font-size: 12px * Theme.font-scale; font-weight: 700; vertical-alignment: center; horizontal-alignment: Theme.start-align; overflow: elide; horizontal-stretch: 1; }
            IconButton { icon: @image-url("../icons/close.svg"); size: 24px; tooltip: @tr("Dismiss"); clicked => { root.dismiss(); } }
        }
        Text { text: root.summary; color: Theme.fg-muted; font-size: 12px * Theme.font-scale; wrap: word-wrap; horizontal-alignment: Theme.start-align; }
        HorizontalLayout {
            alignment: start;
            Pill { label: @tr("Start catching up"); active: true; clicked => { root.begin(); } }
        }
    }
}

export component Sidebar inherits Rectangle {
    in property <string> view;
    in-out property <string> filter: "all";
    in property <[ChatRow]> chats-favorites;
    in property <[ChatRow]> chats-main;
    in property <[ChatRow]> chats-channels;
    in property <[TeamRow]> teams;
    in property <string> current-id;
    // Unread chats and how many of them mention me (the "Catch up" chip and the away card).
    in property <int> catch-chats;
    in property <int> catch-mentions;
    in property <bool> away-visible;
    // The first sync has not finished and there is nothing to list yet: grey rows stand in.
    in property <bool> loading;

    callback select-chat(string);
    callback select-channel(string, string);
    callback toggle-team(int);
    callback toggle-favorite(string);
    callback set-filter(string);
    callback mark-unread(string);
    callback mark-all-read();
    callback leave-chat(string);
    callback new-chat();
    // The New chat button's dropdown: Meet now.
    callback meet-now();
    // Quick views: "mentions" or "followed".
    callback quick-view(string);
    callback manage-teams();
    callback open-community(string);
    // Opens the first unread chat (the chip and the away card's button).
    callback catch-up();
    callback dismiss-away();

    property <bool> communities-open: true;
    // Where the Meetings section's rows start in `chats-main`.
    property <int> meetings-start: root.chats-main.length - ListStore.meetings-count;
    // The filter row's chevron shows the less used filters (Communities).
    property <bool> more-filters: root.filter == "communities";
    // The list menu's "Customize view" shows its options.
    property <bool> customize-open: false;
    property <string> away-summary: (root.catch-chats == 1 ? @tr("1 chat with new messages") : @tr("{} chats with new messages", root.catch-chats))
        + (root.catch-mentions == 0 ? "" : ", " + (root.catch-mentions == 1 ? @tr("1 mention") : @tr("{} mentions", root.catch-mentions)));

    width: 320px;
    background: Theme.sidebar;
    border-width: 0px;

    // A section the user just opened or closed has had its moment: later rows are placed at once.
    Timer {
        interval: 400ms;
        running: Motion.toggled;
        triggered => { Motion.toggled = false; }
    }

    VerticalLayout {
        HorizontalLayout {
            height: 56px;
            padding-left: 16px;
            padding-right: 12px;
            Text { text: root.view == "chat" ? @tr("Chat") : @tr("Teams"); color: Theme.fg; font-size: 20px * Theme.font-scale; font-weight: 700; vertical-alignment: center; overflow: elide; }
            Rectangle { horizontal-stretch: 1; }
            if root.view == "chat" && root.catch-chats > 0: Pill {
                label: @tr("Catch up · {}", root.catch-chats);
                active: root.catch-mentions > 0;
                y: 15px;
                clicked => { root.catch-up(); }
            }
            if root.view == "teams": Pill {
                label: @tr("Your teams and channels");
                y: 15px;
                clicked => { root.manage-teams(); }
            }
            if root.view == "chat": NewChatSplit {
                y: 12px;
                new-chat => { root.new-chat(); }
                meet-now => { root.meet-now(); }
            }
            if root.view == "chat": IconButton {
                icon: @image-url("../icons/more.svg");
                tooltip: @tr("Chat list options");
                y: 12px;
                clicked => { root.customize-open = false; list-menu.show(); }
            }
        }
        if root.view == "chat": VerticalLayout {
            padding-left: 12px;
            padding-bottom: 8px;
            spacing: 6px;
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                Pill { label: @tr("Unread"); active: root.filter == "unread"; clicked => { root.filter = root.filter == "unread" ? "all" : "unread"; root.set-filter(root.filter); } }
                Pill { label: @tr("Channels"); active: root.filter == "channels"; clicked => { root.filter = root.filter == "channels" ? "all" : "channels"; root.set-filter(root.filter); } }
                Pill { label: @tr("Chats"); active: root.filter == "chats"; clicked => { root.filter = root.filter == "chats" ? "all" : "chats"; root.set-filter(root.filter); } }
            }
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                Pill { label: @tr("Meeting chats"); active: root.filter == "meetings"; clicked => { root.filter = root.filter == "meetings" ? "all" : "meetings"; root.set-filter(root.filter); } }
                Pill { label: @tr("Drafts"); active: root.filter == "drafts"; clicked => { root.filter = root.filter == "drafts" ? "all" : "drafts"; root.set-filter(root.filter); } }
                Pill { label: root.more-filters ? "‹" : "›"; accessible-label: root.more-filters ? @tr("Fewer filters") : @tr("More filters"); clicked => { root.more-filters = !root.more-filters; } }
            }
            if root.more-filters: HorizontalLayout {
                spacing: 6px;
                alignment: start;
                Pill { label: @tr("Communities"); active: root.filter == "communities"; clicked => { root.filter = root.filter == "communities" ? "all" : "communities"; root.set-filter(root.filter); } }
            }
        }
        Rectangle { height: 1px; background: Theme.border; }
        if root.view == "chat" && root.away-visible: HorizontalLayout {
            padding: 8px;
            AwayCard {
                summary: root.away-summary;
                begin => { root.catch-up(); }
                dismiss => { root.dismiss-away(); }
            }
        }

        // Both lists stay built and the other page's one is clipped to nothing: Chat to Teams and
        // back (or a page of the rail, see app.slint) keeps the list's scroll place and does not
        // build every row again.
        lists := Rectangle {
            vertical-stretch: 1;
            Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: root.view == "chat" ? parent.height : 0px;
                clip: true;
                ScrollView {
                    x: 0px;
                    y: 0px;
                    width: lists.width;
                    height: lists.height;
                    VerticalLayout {
                        padding: 6px;
                        spacing: 1px;
                        alignment: start;
                        QuickViewsSection {
                            mentions: root.catch-mentions;
                            drafts-on: root.filter == "drafts";
                            open(kind) => {
                                if kind == "drafts" {
                                    FindStore.quick-open = false;
                                    root.filter = root.filter == "drafts" ? "all" : "drafts";
                                    root.set-filter(root.filter);
                                } else {
                                    root.quick-view(kind);
                                }
                            }
                        }
                        // The chat being started in the New chat pane, as Teams lists it.
                        if PeopleStore.new-chat-open: NewMessageRow { }
                        if root.filter != "communities": SectionHeader { label: @tr("Favorites"); expanded <=> ListStore.favorites-open; }
                        if ListStore.favorites-open: Reveal { for c in root.chats-favorites: ChatItem {
                            data: c;
                            selected: c.id == root.current-id;
                            limit: root.absolute-position.y + root.height;
                            clicked => { root.select-chat(c.id); }
                            toggle-favorite => { root.toggle-favorite(c.id); }
                            mark-unread => { root.mark-unread(c.id); }
                            leave => { root.leave-chat(c.id); }
                        } }
                        for sec in ListStore.sections: VerticalLayout {
                            SectionHead { section: sec; toggle => { Motion.toggled = true; ListStore.command("section-toggle", sec.id); } }
                            if sec.expanded: Reveal { for c in sec.items: ChatItem {
                                data: c;
                                selected: c.id == root.current-id;
                                limit: root.absolute-position.y + root.height;
                                clicked => { root.select-chat(c.id); }
                                toggle-favorite => { root.toggle-favorite(c.id); }
                                mark-unread => { root.mark-unread(c.id); }
                                leave => { root.leave-chat(c.id); }
                            } }
                        }
                        if root.filter != "communities": SectionHeader { label: @tr("Chats"); expanded <=> ListStore.chats-open; }
                        if ListStore.chats-open: Reveal { for c in root.chats-main: VerticalLayout {
                            if c.section != "meetings": ChatItem {
                                data: c;
                                selected: c.id == root.current-id;
                                limit: root.absolute-position.y + root.height;
                                clicked => { root.select-chat(c.id); }
                                toggle-favorite => { root.toggle-favorite(c.id); }
                                mark-unread => { root.mark-unread(c.id); }
                                leave => { root.leave-chat(c.id); }
                            }
                        } }
                        // Meeting chats, collapsed by default: the newest five, then "See all".
                        if ListStore.meetings-count > 0: SectionHead {
                            section: { id: "meetings", name: @tr("Meetings"), expanded: ListStore.meetings-open, unread: ListStore.meetings-unread, local: false };
                            toggle => { Motion.toggled = true; ListStore.meetings-open = !ListStore.meetings-open; }
                        }
                        if ListStore.meetings-count > 0 && ListStore.meetings-open: Reveal { for c[i] in root.chats-main: VerticalLayout {
                            if c.section == "meetings" && (ListStore.meetings-all || i < root.meetings-start + 5): ChatItem {
                                data: c;
                                selected: c.id == root.current-id;
                                limit: root.absolute-position.y + root.height;
                                clicked => { root.select-chat(c.id); }
                                toggle-favorite => { root.toggle-favorite(c.id); }
                                mark-unread => { root.mark-unread(c.id); }
                                leave => { root.leave-chat(c.id); }
                            }
                        } }
                        if ListStore.meetings-open && ListStore.meetings-count > 5: MoreRow {
                            label: ListStore.meetings-all ? @tr("Show less") : @tr("See all ({})", ListStore.meetings-count);
                            clicked => { ListStore.meetings-all = !ListStore.meetings-all; }
                        }
                        if !ListStore.combined && root.filter != "communities": SectionHeader { label: @tr("Teams and channels"); expanded <=> ListStore.channels-open; }
                        if ListStore.channels-open && !ListStore.combined: Reveal { for c in root.chats-channels: ChatItem {
                            data: c;
                            selected: c.id == root.current-id;
                            limit: root.absolute-position.y + root.height;
                            clicked => { root.select-chat(c.id); }
                            toggle-favorite => { root.toggle-favorite(c.id); }
                            mark-unread => { root.mark-unread(c.id); }
                            leave => { root.leave-chat(c.id); }
                        } }
                        if TeamsStore.communities.length > 0: SectionHeader { label: @tr("Communities"); expanded <=> root.communities-open; }
                        if TeamsStore.communities.length > 0 && root.communities-open: CommunitiesSection { open(id) => { root.open-community(id); } }
                        if TeamsStore.communities.length == 0 && root.filter == "communities": Text {
                            text: @tr("You are not in any community.");
                            color: Theme.fg-subtle;
                            font-size: 13px * Theme.font-scale;
                            horizontal-alignment: center;
                            height: 40px;
                            vertical-alignment: center;
                        }
                        // Under everything else, so it never moves a row.
                        if root.loading: SkeletonList { count: 8; label: @tr("Loading chats"); }
                    }
                }
            }
            Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: root.view == "teams" ? parent.height : 0px;
                clip: true;
                ScrollView {
                    x: 0px;
                    y: 0px;
                    width: lists.width;
                    height: lists.height;
                    VerticalLayout {
                        padding: 6px;
                        spacing: 2px;
                        alignment: start;
                        for t[ti] in root.teams: VerticalLayout {
                            Rectangle {
                                height: 44px;
                                border-radius: 4px;
                                background: tt.has-hover ? Theme.surface-hover : transparent;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    spacing: 10px;
                                    Icon { source: t.expanded ? @image-url("../icons/chevron-down.svg") : @image-url("../icons/chevron-right.svg"); width: 14px; height: 14px; y: 15px; }
                                    // The team's picture when it is known, else its initials.
                                    Avatar {
                                        size: 28px;
                                        y: 8px;
                                        corner: 4px;
                                        tone: t.color;
                                        tone-under-img: true;
                                        initials: t.initials;
                                        text-size: 12px * Theme.font-scale;
                                        text-weight: 700;
                                        img: t.avatar;
                                        has-img: t.has-avatar;
                                        photo-label: @tr("Team picture");
                                    }
                                    Text { text: t.name; color: Theme.fg; font-size: 14px * Theme.font-scale; font-weight: 600; vertical-alignment: center; overflow: elide; }
                                    Rectangle { width: 30px; }
                                }
                                tt := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.toggle-team(ti); }
                                    pointer-event(e) => {
                                        if e.button == PointerEventButton.right && e.kind == PointerEventKind.up {
                                            team-menu.show();
                                        }
                                    }
                                    if tt.has-hover: IconButton {
                                        x: parent.width - 30px;
                                        y: 11px;
                                        size: 22px;
                                        icon: @image-url("../icons/more.svg");
                                        tooltip: @tr("More options for {}", t.name);
                                        clicked => { team-menu.show(); }
                                    }
                                }
                                // The team menu of "Your teams and channels".
                                team-menu := PopupWindow {
                                    x: parent.width - 250px;
                                    y: parent.height - 4px;
                                    width: 250px;
                                    height: team-items.preferred-height + 10px;
                                    close-policy: close-on-click-outside;
                                    Rectangle {
                                        background: Theme.surface;
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: Theme.border;
                                        team-items := VerticalLayout {
                                            padding: 4px;
                                            for full in TeamsStore.all-teams: VerticalLayout {
                                                if full.id == t.id: TeamMenuItems {
                                                    t: full;
                                                    go(id, name) => { root.select-channel(id, name); }
                                                    done => { team-menu.close(); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            if t.expanded: VerticalLayout {
                                for ch in t.channels: Rectangle {
                                    height: 34px;
                                    border-radius: 4px;
                                    background: ch.id == root.current-id ? Theme.selected : (ct.has-hover ? Theme.surface-hover : transparent);
                                    HorizontalLayout {
                                        padding-left: 50px;
                                        padding-right: 32px;
                                        spacing: 6px;
                                        Text {
                                            text: ch.hidden ? @tr("{} (hidden)", ch.name) : ch.name;
                                            color: ch.hidden ? Theme.fg-subtle : Theme.fg;
                                            font-size: 13px * Theme.font-scale;
                                            font-weight: ch.unread ? 700 : 400;
                                            font-italic: ch.hidden;
                                            vertical-alignment: center;
                                            overflow: elide;
                                            // A private channel's lock follows the name.
                                            horizontal-stretch: ch.private ? 0 : 1;
                                        }
                                        if ch.private: Icon {
                                            source: @image-url("../icons/lock.svg");
                                            width: 12px;
                                            height: 12px;
                                            y: (parent.height - 12px) / 2;
                                            tint: Theme.fg-subtle;
                                            accessible-role: image;
                                            accessible-label: @tr("Private channel");
                                        }
                                        if ch.private: Rectangle { horizontal-stretch: 1; }
                                    }
                                    ct := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.select-channel(ch.id, t.name + " › " + ch.name); }
                                        pointer-event(e) => {
                                            if e.button == PointerEventButton.right && e.kind == PointerEventKind.up {
                                                ListStore.command("channel-menu", ch.id);
                                                ch-menu.show();
                                            }
                                        }
                                        // The same menu as a right click.
                                        if ct.has-hover: IconButton {
                                            x: parent.width - 28px;
                                            y: 6px;
                                            size: 22px;
                                            icon: @image-url("../icons/more.svg");
                                            tooltip: @tr("More options for {}", ch.name);
                                            clicked => {
                                                ListStore.command("channel-menu", ch.id);
                                                ch-menu.show();
                                            }
                                        }
                                    }
                                    ch-menu := PopupWindow {
                                        x: parent.width - 200px;
                                        y: parent.height - 4px;
                                        width: 190px;
                                        height: cm.menu-height;
                                        close-policy: close-on-click-outside;
                                        cm := ChannelMenu { channel: ch.id; done => { ch-menu.close(); } }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    if root.view == "chat": ChatTipLayer { x: 0px; y: 0px; width: root.width; height: root.height; }

    list-menu := PopupWindow {
        // Customize view unfolds inside the menu, so a click must not close it by itself.
        close-policy: close-on-click-outside;
        x: parent.width - 240px;
        y: 48px;
        width: 228px;
        height: list-items.preferred-height + 2px;
        Rectangle {
            background: Theme.surface;
            border-radius: 6px;
            border-width: 1px;
            border-color: Theme.border;
            list-items := VerticalLayout {
                padding: 4px;
                MenuItem { variant: MenuItemVariant.plain; label: @tr("Mark all as read"); clicked => { list-menu.close(); root.mark-all-read(); } }
                MenuItem { variant: MenuItemVariant.plain; label: @tr("New section"); clicked => { list-menu.close(); ListStore.dialog-target = ""; ListStore.dialog-text = ""; ListStore.dialog = "new-section"; } }
                MenuItem { variant: MenuItemVariant.plain; label: @tr("Collapse all sections"); clicked => { list-menu.close(); ListStore.command("collapse-all", ""); } }
                // Teams' "Customize view": the list's display options, behind a chevron.
                MenuItem { variant: MenuItemVariant.parity; label: @tr("Customize view"); chevron: true; checked: root.customize-open; clicked => { root.customize-open = !root.customize-open; } }
                if root.customize-open: OptionRow { label: @tr("Show message previews"); checked: ListStore.show-previews; clicked => { ListStore.command("option", "previews\u{9}" + (ListStore.show-previews ? "off" : "on")); } }
                if root.customize-open: OptionRow { label: @tr("Show time stamps"); checked: ListStore.show-times; clicked => { ListStore.command("option", "times\u{9}" + (ListStore.show-times ? "off" : "on")); } }
                if root.customize-open: OptionRow { label: @tr("Chats and channels together"); checked: ListStore.combined; clicked => { ListStore.command("option", "combined\u{9}" + (ListStore.combined ? "off" : "on")); } }
                Rectangle { height: 1px; background: Theme.border; }
                MenuItem { variant: MenuItemVariant.parity; label: @tr("Your teams and channels"); clicked => { list-menu.close(); root.manage-teams(); } }
                MenuItem { variant: MenuItemVariant.parity;
                    label: @tr("Your communities");
                    clicked => {
                        list-menu.close();
                        TeamsStore.open = true;
                        TeamsStore.command("open", "");
                        TeamsStore.tab = "communities";
                        TeamsStore.command("communities", "");
                    }
                }
                HorizontalLayout {
                    height: 24px;
                    padding-left: 10px;
                    Text { text: @tr("Quick views"); color: Theme.fg-subtle; font-size: 11px * Theme.font-scale; vertical-alignment: bottom; }
                }
                MenuItem { variant: MenuItemVariant.plain; label: @tr("Mentions"); clicked => { list-menu.close(); root.quick-view("mentions"); } }
                MenuItem { variant: MenuItemVariant.plain; label: @tr("Saved"); clicked => { list-menu.close(); root.quick-view("saved"); } }
                MenuItem { variant: MenuItemVariant.plain; label: @tr("Followed threads"); clicked => { list-menu.close(); root.quick-view("followed"); } }
                MenuItem { variant: MenuItemVariant.plain; label: @tr("Reminders"); clicked => { list-menu.close(); RemindStore.open = true; RemindStore.command("refresh", ""); } }
            }
        }
    }
}
