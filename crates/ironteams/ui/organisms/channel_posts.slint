// A channel's Posts tab like Teams (plan 8.4): every post is a card with a summary of its replies
// ("3 replies from Sara, Omar and others") and a Reply field under it. Both open the thread in a
// panel that slides in from the right, with the post, the replies and a composer. Day dividers
// sit between the posts of different days, scrolling to the oldest post loads older ones,
// "Post in channel" opens the composer (with the Announcement option), and the "…" menu orders
// the posts.
import { ListView, ScrollView } from "std-widgets.slint";
import { Theme } from "../tokens/theme.slint";
import { Msg } from "../tokens/types.slint";
import { IconButton } from "../atoms/widgets.slint";
import { Avatar } from "../atoms/avatar.slint";
import { MessageRow } from "message_row.slint";
import { PeopleStore } from "../molecules/people.slint";
import { Motion, Spinner, WheelGlide } from "../tokens/motion.slint";

// Someone who replied to a post: the summary shows their photo and names the first two.
export struct Replier {
    name: string,
    initials: string,
    color: color,
    avatar: image,
    has-avatar: bool,
}

export struct PostItem {
    post: Msg,
    // Non-empty: a day divider above the card.
    day: string,
    reply-count: int,
    // Who replied, the newest reply's writer first, at most three.
    repliers: [Replier],
    following: bool,
}

export global ChannelStore {
    in property <[PostItem]> posts;
    // The engine pushed post cards for the open channel: the Posts tab replaces the flat list.
    in property <bool> active: false;
    // "Post in channel" is open: the composer shows, with the Announcement strip above it.
    in-out property <bool> compose-open: false;
    in-out property <bool> announcement: false;
    in-out property <string> headline;
    in-out property <string> theme: "blue";
    // "See new posts at top".
    in property <bool> newest-top: false;
    // Older posts were added above: the card at `anchor-index` (the one that was first) stays
    // where it was. Rust bumps the tick.
    in property <int> anchor-index: -1;
    in property <int> anchor-tick;
    // The post whose thread the panel shows ("" when it is closed).
    in-out property <string> thread-id;
    // The thread as Rust read it: it is the open one when `thread-post.id` is `thread-id`.
    in property <Msg> thread-post;
    in property <[Msg]> thread-replies;
    // The panel composer's text, and whether it takes the cursor when the panel opens.
    in-out property <string> thread-text;
    in-out property <bool> thread-focus;
    in-out property <int> thread-focus-tick;
    // Names: thread, close-thread, reply, follow, unfollow, follow-msg, order, announce.
    callback command(string, string);

    // Opens a post's thread in the panel; `focus` puts the cursor in its composer.
    public function open-thread(id: string, focus: bool) {
        if root.thread-id != id {
            root.thread-text = "";
        }
        root.thread-id = id;
        root.thread-focus = focus;
        if focus {
            root.thread-focus-tick += 1;
        }
        root.command("thread", id);
    }

    public function close-thread() {
        if root.thread-id != "" {
            root.thread-id = "";
            root.command("close-thread", "");
        }
    }

    // "1 reply from Sara", "2 replies from Sara and Omar", "5 replies from Sara, Omar and others".
    public pure function replies-summary(count: int, people: [Replier]) -> string {
        if people.length == 0 {
            return count == 1 ? @tr("1 reply") : @tr("{} replies", count);
        }
        if count == 1 {
            return @tr("1 reply from {}", people[0].name);
        }
        if people.length == 1 {
            return @tr("{} replies from {}", count, people[0].name);
        }
        if people.length == 2 {
            return @tr("{} replies from {} and {}", count, people[0].name, people[1].name);
        }
        @tr("{} replies from {}, {} and others", count, people[0].name, people[1].name)
    }
}

component Link inherits Rectangle {
    in property <string> label;
    in property <bool> bold: false;
    callback clicked();
    width: txt.preferred-width + 8px;
    height: 24px;
    border-radius: 4px;
    background: touch.has-hover ? Theme.surface-hover : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    txt := Text { x: 4px; text: root.label; color: Theme.accent; font-size: 12px * Theme.font-scale; font-weight: root.bold ? 700 : 400; vertical-alignment: center; }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// Headline and color of an announcement, above the composer while "Post in channel" is open.
export component AnnouncementBar inherits Rectangle {
    height: 44px;
    background: Theme.sidebar;
    HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        spacing: 10px;
        Rectangle {
            width: ann-label.preferred-width + 30px;
            height: 28px;
            y: 8px;
            border-radius: 14px;
            border-width: 1px;
            border-color: ChannelStore.announcement ? Theme.accent : Theme.border;
            background: ChannelStore.announcement ? #3b3d6b : transparent;
            accessible-role: checkbox;
            accessible-label: "Announcement";
            accessible-checkable: true;
            accessible-checked: ChannelStore.announcement;
            ann-label := Text { x: 14px; text: "Announcement"; color: Theme.fg; font-size: 12px * Theme.font-scale; vertical-alignment: center; }
            TouchArea { mouse-cursor: pointer; clicked => { ChannelStore.announcement = !ChannelStore.announcement; } }
        }
        if ChannelStore.announcement: Rectangle {
            y: 7px;
            height: 30px;
            horizontal-stretch: 1;
            border-radius: 4px;
            background: Theme.sidebar;
            border-width: 1px;
            border-color: headline-input.has-focus ? Theme.accent : Theme.border;
            headline-input := TextInput {
                x: 10px;
                width: parent.width - 20px;
                text <=> ChannelStore.headline;
                color: Theme.fg;
                font-size: 13px * Theme.font-scale;
                single-line: true;
                vertical-alignment: center;
                accessible-role: text-input;
                accessible-label: "Headline";
            }
            if ChannelStore.headline == "": Text { x: 10px; text: "Type a headline"; color: Theme.fg-subtle; font-size: 13px * Theme.font-scale; vertical-alignment: center; }
        }
        if ChannelStore.announcement: HorizontalLayout {
            spacing: 6px;
            for t in ["blue", "green", "red", "yellow", "gray"]: Rectangle {
                width: 22px;
                height: 22px;
                y: 11px;
                border-radius: 11px;
                border-width: ChannelStore.theme == t ? 2px : 0px;
                border-color: #ffffff;
                background: t == "blue" ? #4f6bed : (t == "green" ? #3d9b53 : (t == "yellow" ? #d9a21b : (t == "red" ? Theme.presence-busy : #8a8a8a)));
                accessible-role: checkbox;
                accessible-label: "Banner color " + t;
                accessible-checkable: true;
                accessible-checked: ChannelStore.theme == t;
                TouchArea { mouse-cursor: pointer; clicked => { ChannelStore.theme = t; } }
            }
        }
        if !ChannelStore.announcement: Rectangle { horizontal-stretch: 1; }
    }
}

// A thin line with a label in the middle: the day between posts, the reply count in the panel.
component Divider inherits HorizontalLayout {
    in property <string> label;
    padding-top: 8px;
    padding-bottom: 6px;
    spacing: 10px;
    Rectangle { height: 1px; background: Theme.border; y: (parent.height - 1px) / 2; }
    Text { text: root.label; color: Theme.fg-muted; font-size: 12px * Theme.font-scale; horizontal-stretch: 0; }
    Rectangle { height: 1px; background: Theme.border; y: (parent.height - 1px) / 2; }
}

// A TouchArea so the whole card takes the wheel before the list does (`wheel`, the list's glide).
component PostCard inherits TouchArea {
    in property <PostItem> item;
    in property <length> bubble: 600px;
    callback wheel(PointerScrollEvent) -> EventResult;
    scroll-event(e) => { return root.wheel(e); }
    callback react(string, string);
    callback edit(string);
    callback more-reactions(string, length, length);
    callback menu(Msg, length, length);
    callback open-url(string);
    callback profile(string);
    callback retry-send(string);
    callback discard-send(string);
    height: lay.preferred-height;

    lay := VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 4px;
        if root.item.day != "": Divider { label: root.item.day; }
        Rectangle {
            border-radius: 8px;
            background: Theme.sidebar;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding-top: 6px;
                padding-bottom: root.item.reply-count > 0 ? 6px : 8px;
                MessageRow {
                    m: root.item.post;
                    max-bubble: root.bubble;
                    in-channel: false;
                    card-style: true;
                    react(k) => { root.react(root.item.post.id, k); }
                    reply => { ChannelStore.open-thread(root.item.post.id, true); }
                    edit => { root.edit(root.item.post.id); }
                    more-reactions(x, y) => { root.more-reactions(root.item.post.id, x, y); }
                    menu(x, y) => { root.menu(root.item.post, x, y); }
                    open-url(u) => { root.open-url(u); }
                    profile(id) => { root.profile(id); }
                    profile-at(id, x, y, w, h) => { PeopleStore.open-card(id, x, y, w, h, false); }
                    photo-hover(id, on, x, y, w, h) => { if on { PeopleStore.hover-enter(id, x, y, w, h); } else { PeopleStore.hover-leave(id); } }
                    retry-send => { root.retry-send(root.item.post.id); }
                    discard-send => { root.discard-send(root.item.post.id); }
                }
                // The replies stay folded: who replied and how many, which opens the thread.
                if root.item.reply-count > 0: HorizontalLayout {
                    // Under the post's text, past its 32px photo.
                    padding-left: 60px;
                    padding-right: 12px;
                    spacing: 6px;
                    alignment: start;
                    Rectangle {
                        width: 20px + max(0, root.item.repliers.length - 1) * 14px;
                        height: 24px;
                        for p[i] in root.item.repliers: Avatar {
                            x: i * 14px;
                            y: 2px;
                            size: 20px;
                            initials: p.initials;
                            tone: p.color;
                            img: p.avatar;
                            has-img: p.has-avatar;
                        }
                    }
                    Link {
                        label: ChannelStore.replies-summary(root.item.reply-count, root.item.repliers);
                        bold: true;
                        clicked => { ChannelStore.open-thread(root.item.post.id, false); }
                    }
                }
            }
        }
        // "↩ Reply": opens the thread with the cursor in its composer.
        reply-field := Rectangle {
            height: 32px;
            border-radius: 4px;
            background: reply-touch.has-hover ? Theme.surface-hover : transparent;
            border-width: 1px;
            border-color: Theme.border;
            accessible-role: button;
            accessible-label: @tr("Reply");
            accessible-action-default => { ChannelStore.open-thread(root.item.post.id, true); }
            HorizontalLayout {
                padding-left: 12px;
                spacing: 8px;
                alignment: start;
                Text { text: "↩"; color: Theme.fg-subtle; font-size: 14px * Theme.font-scale; vertical-alignment: center; accessible-role: none; }
                Text { text: @tr("Reply"); color: Theme.fg-subtle; font-size: 13px * Theme.font-scale; vertical-alignment: center; accessible-role: none; }
            }
            reply-touch := TouchArea { mouse-cursor: text; clicked => { ChannelStore.open-thread(root.item.post.id, true); } }
        }
    }
}

// The thread panel: the post, its replies as chat rows and a composer that replies in the thread.
component ThreadPanel inherits Rectangle {
    in property <string> channel;
    callback react(string, string);
    callback edit(string);
    callback more-reactions(string, length, length);
    callback menu(Msg, length, length);
    callback open-url(string);
    callback profile(string);
    callback retry-send(string);
    callback discard-send(string);
    // Rust pushed the thread that is open.
    property <bool> ready: ChannelStore.thread-post.id == ChannelStore.thread-id;
    property <int> count: ChannelStore.thread-replies.length;
    // A reply was sent from here: the list follows it down when it shows.
    property <bool> follow-down: false;
    background: Theme.main;
    drop-shadow-blur: 18px;
    drop-shadow-color: #00000059;

    function send() {
        if ChannelStore.thread-text != "" {
            ChannelStore.command("reply", ChannelStore.thread-id + "\u{9}" + ChannelStore.thread-text);
            ChannelStore.thread-text = "";
            root.follow-down = true;
        }
    }

    // Clicks inside the panel stay in it.
    TouchArea { }

    VerticalLayout {
        Rectangle {
            height: 56px;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 10px;
                spacing: 8px;
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text { text: @tr("Thread"); color: Theme.fg; font-size: 16px * Theme.font-scale; font-weight: 700; }
                    Text { text: root.channel; color: Theme.fg-muted; font-size: 12px * Theme.font-scale; overflow: elide; }
                }
                IconButton {
                    icon: @image-url("../icons/close.svg");
                    tooltip: @tr("Close thread");
                    y: 12px;
                    clicked => { ChannelStore.close-thread(); }
                }
            }
        }
        Rectangle { height: 1px; background: Theme.border; }
        thread-scroll := ScrollView {
            vertical-stretch: 1;
            changed viewport-height => {
                if root.follow-down {
                    self.viewport-y = min(0px, self.visible-height - self.viewport-height);
                }
            }
            VerticalLayout {
                alignment: start;
                padding-bottom: 8px;
                if root.ready: MessageRow {
                    m: ChannelStore.thread-post;
                    max-bubble: thread-scroll.width - 90px;
                    pane-top: thread-scroll.absolute-position.y;
                    card-style: true;
                    react(k) => { root.react(ChannelStore.thread-post.id, k); }
                    reply => { ChannelStore.thread-focus-tick += 1; }
                    edit => { root.edit(ChannelStore.thread-post.id); }
                    more-reactions(x, y) => { root.more-reactions(ChannelStore.thread-post.id, x, y); }
                    menu(x, y) => { root.menu(ChannelStore.thread-post, x, y); }
                    open-url(u) => { root.open-url(u); }
                    profile(id) => { root.profile(id); }
                    profile-at(id, x, y, w, h) => { PeopleStore.open-card(id, x, y, w, h, false); }
                    photo-hover(id, on, x, y, w, h) => { if on { PeopleStore.hover-enter(id, x, y, w, h); } else { PeopleStore.hover-leave(id); } }
                    retry-send => { root.retry-send(ChannelStore.thread-post.id); }
                    discard-send => { root.discard-send(ChannelStore.thread-post.id); }
                }
                if root.ready: Divider {
                    padding-left: 16px;
                    padding-right: 16px;
                    label: root.count == 0 ? @tr("No replies yet") : (root.count == 1 ? @tr("1 reply") : @tr("{} replies", root.count));
                }
                if root.ready: VerticalLayout {
                    for r in ChannelStore.thread-replies: MessageRow {
                        m: r;
                        max-bubble: thread-scroll.width - 90px;
                        pane-top: thread-scroll.absolute-position.y;
                        card-style: true;
                        react(k) => { root.react(r.id, k); }
                        reply => { ChannelStore.thread-focus-tick += 1; }
                        edit => { root.edit(r.id); }
                        more-reactions(x, y) => { root.more-reactions(r.id, x, y); }
                        menu(x, y) => { root.menu(r, x, y); }
                        open-url(u) => { root.open-url(u); }
                        profile(id) => { root.profile(id); }
                        profile-at(id, x, y, w, h) => { PeopleStore.open-card(id, x, y, w, h, false); }
                        photo-hover(id, on, x, y, w, h) => { if on { PeopleStore.hover-enter(id, x, y, w, h); } else { PeopleStore.hover-leave(id); } }
                        retry-send => { root.retry-send(r.id); }
                        discard-send => { root.discard-send(r.id); }
                    }
                }
            }
        }
        // The composer: Enter sends the reply into the thread, Shift+Enter starts a new line.
        VerticalLayout {
            padding: 12px;
            Rectangle {
                height: max(40px, thread-input.preferred-height + 18px);
                border-radius: 4px;
                background: Theme.sidebar;
                border-width: 1px;
                border-color: thread-input.has-focus ? Theme.accent : Theme.border;
                FocusScope {
                    capture-key-pressed(event) => {
                        if event.text == Key.Escape {
                            ChannelStore.close-thread();
                            return accept;
                        }
                        if event.text == Key.Return && !event.modifiers.shift {
                            root.send();
                            return accept;
                        }
                        reject
                    }
                    thread-input := TextInput {
                        x: 10px;
                        y: 9px;
                        width: parent.width - 54px;
                        height: parent.height - 18px;
                        text <=> ChannelStore.thread-text;
                        color: Theme.fg;
                        font-size: 14px * Theme.font-scale;
                        wrap: word-wrap;
                        accessible-role: text-input;
                        accessible-label: @tr("Reply in thread");
                        property <int> tick: ChannelStore.thread-focus-tick;
                        changed tick => { self.focus(); }
                        init => {
                            if ChannelStore.thread-focus {
                                self.focus();
                            }
                        }
                    }
                }
                if ChannelStore.thread-text == "": Text {
                    x: 10px;
                    text: @tr("Reply");
                    color: Theme.fg-subtle;
                    font-size: 14px * Theme.font-scale;
                    vertical-alignment: center;
                    accessible-role: none;
                }
                IconButton {
                    x: parent.width - 38px;
                    y: (parent.height - 32px) / 2;
                    icon: @image-url("../icons/send.svg");
                    tooltip: @tr("Send reply");
                    tint: ChannelStore.thread-text != "" ? Theme.accent : Theme.fg-subtle;
                    clicked => { root.send(); }
                }
            }
        }
    }
    // The left edge, over the shadow.
    Rectangle { x: 0; width: 1px; background: Theme.border; }
    if !root.ready: Spinner { x: (parent.width - self.width) / 2; y: 90px; }
}

export component ChannelPosts inherits Rectangle {
    callback react(string, string);
    callback edit(string);
    callback more-reactions(string, length, length);
    callback menu(Msg, length, length);
    callback open-url(string);
    callback profile(string);
    callback retry-send(string);
    callback discard-send(string);
    callback load-older();
    // Bumped when the conversation opens (and when End is pressed): back to the newest post.
    in property <int> scroll-tick;
    // The next older page is being read.
    in property <bool> loading-older;
    // The channel's name, under the thread panel's title.
    in property <string> channel;
    // The thread panel: beside the posts on a wide window, over them on a narrow one.
    property <length> panel-w: root.width < 760px ? root.width : max(400px, min(480px, root.width * 0.4));
    background: Theme.main;

    VerticalLayout {
        Rectangle {
            height: 44px;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 8px;
                Rectangle {
                    width: post-label.preferred-width + 32px;
                    height: 30px;
                    y: 7px;
                    border-radius: 4px;
                    background: post-touch.has-hover ? Theme.accent : Theme.accent-strong;
                    accessible-role: button;
                    accessible-label: "Post in channel";
                    post-label := Text { x: 16px; text: "Post in channel"; color: #ffffff; font-size: 13px * Theme.font-scale; font-weight: 600; vertical-alignment: center; }
                    post-touch := TouchArea { mouse-cursor: pointer; clicked => { ChannelStore.compose-open = !ChannelStore.compose-open; } }
                }
                Rectangle { horizontal-stretch: 1; }
                IconButton {
                    icon: @image-url("../icons/more.svg");
                    tooltip: "Posts options";
                    y: 6px;
                    clicked => { order-menu.show(); }
                }
            }
        }
        Rectangle { height: 1px; background: Theme.border; }
        posts-list := ListView {
            vertical-stretch: 1;
            // Teams opens a channel at its newest post: at the bottom (at the top with "See new
            // posts at top"), and stays there while cards grow, until the list is scrolled away.
            property <bool> pinned: true;
            property <int> tick: root.scroll-tick;
            property <int> a-tick: ChannelStore.anchor-tick;
            // Older posts landed: the card that was first goes back to the top of the view.
            property <bool> anchoring: false;
            // An older page was asked for: one request per arrival at the oldest post.
            property <bool> asked: false;
            // The content height the last `changed content-height` saw. A move of the view that
            // comes with another height is the cards getting their real height under the view
            // (the list only estimates the cards it has not laid out), not the user scrolling
            // away from the newest post: it must not unpin the list.
            property <length> seen-height: 0px;
            function to-newest() {
                self.content-y = ChannelStore.newest-top ? 0px : min(0px, self.visible-height - self.content-height);
            }
            // Whether the view is at the newest post, as the user left it.
            function recheck() {
                self.pinned = ChannelStore.newest-top ? self.content-y >= -4px : self.content-y <= self.visible-height - self.content-height + 4px;
            }
            function ask-older() {
                if !self.asked && !root.loading-older && ChannelStore.posts.length > 0 {
                    self.asked = true;
                    root.load-older();
                }
            }
            changed tick => {
                posts-glide.stop();
                self.pinned = true;
                self.to-newest();
            }
            // The card holding the view's top and how far the view's top is below the card's
            // top, as the user scrolls; and the same when older posts landed (`a-tick`).
            property <string> top-id;
            property <length> top-gap;
            property <string> anchor-id;
            property <length> anchor-gap;
            changed a-tick => {
                posts-glide.stop();
                self.anchor-id = self.top-id;
                self.anchor-gap = self.top-gap;
                self.pinned = false;
                // Also while the card is put back now: the view passes the newest post on its
                // way, which must not pin the list there.
                self.anchoring = true;
                if self.top-gap < 1px && ChannelStore.posts[ChannelStore.anchor-index].post.id == self.top-id {
                    // The first card's top was the view's top: putting it back is exact, so it
                    // is done now, in the layout that shows the new cards, and no frame shows
                    // them misplaced. The timer puts it back once more, measured (no anchor).
                    self.anchor-id = "";
                    // From far below: the content height is still the old one until the next
                    // layout, and from the old bottom the card would seem to be below the view
                    // and be put at its bottom edge. From below it goes to the top edge.
                    self.content-y = -1000000px;
                    self.ensure-row-visible(ChannelStore.anchor-index, ScrollBehavior.instant);
                }
            }
            // The user scrolled (wheel, drag, scrollbar).
            scrolled => {
                self.recheck();
                Motion.scrolling = true;
                posts-idle.restart();
            }
            // The pane got taller or shorter (the composer, the window) while at the newest post.
            changed visible-height => {
                if self.pinned && !self.anchoring {
                    self.to-newest();
                }
            }
            changed content-height => {
                self.seen-height = self.content-height;
                if self.pinned && !self.anchoring {
                    self.to-newest();
                }
                // Too few posts to scroll: the older ones are read at once.
                if self.content-height > 0px && self.content-height < self.visible-height {
                    self.ask-older();
                }
            }
            changed content-y => {
                if self.content-height == self.seen-height {
                    self.recheck();
                }
                // Near the oldest post (the top, or the bottom with the newest posts on top). Not
                // earlier: the card that was first goes back to the top of the view when the
                // older page lands, which is where the user is only when they reached it.
                if !self.pinned && !self.anchoring && self.content-height > self.visible-height + 40px
                    && (ChannelStore.newest-top ? self.content-y < self.visible-height - self.content-height + 40px : self.content-y > -40px) {
                    self.ask-older();
                }
            }
            for item in ChannelStore.posts: PostCard {
                item: item;
                wheel(e) => { return posts-glide.take(e); }
                // A card that starts above the view's top changed height (a reply count, an
                // edit): the view moves with it, so the cards being read stay where they are.
                // `seen-id`: the list reuses a card for another post.
                property <length> seen-h: 0px;
                property <string> seen-id;
                changed height => {
                    if self.seen-id == item.post.id && self.seen-h > 0px && !posts-list.pinned && !posts-list.anchoring
                        && self.y < -posts-list.content-y {
                        posts-list.content-y = min(0px, posts-list.content-y - (self.height - self.seen-h));
                    }
                    self.seen-h = self.height;
                    self.seen-id = item.post.id;
                }
                property <length> top-gap: -posts-list.content-y - self.y;
                property <bool> holds-top: self.top-gap >= 0px && self.top-gap < self.height;
                changed top-gap => {
                    if self.holds-top {
                        posts-list.top-id = item.post.id;
                        posts-list.top-gap = self.top-gap;
                    }
                }
                // Also when the list reuses the card holding the top for another post.
                property <string> top-mark: self.holds-top ? item.post.id : "";
                changed top-mark => {
                    if self.holds-top {
                        posts-list.top-id = item.post.id;
                        posts-list.top-gap = self.top-gap;
                    }
                }
                bubble: min(720px, root.width - 100px);
                react(id, k) => { root.react(id, k); }
                edit(id) => { root.edit(id); }
                more-reactions(id, x, y) => { root.more-reactions(id, x, y); }
                menu(m, x, y) => { root.menu(m, x, y); }
                open-url(u) => { root.open-url(u); }
                profile(id) => { root.profile(id); }
                retry-send(id) => { root.retry-send(id); }
                discard-send(id) => { root.discard-send(id); }
            }
        }
        if ChannelStore.posts.length == 0: Text {
            text: "No posts yet. Start the conversation with Post in channel.";
            color: Theme.fg-subtle;
            font-size: 13px * Theme.font-scale;
            horizontal-alignment: center;
            vertical-alignment: center;
            vertical-stretch: 1;
        }
    }

    // Once the bigger list is laid out, the card that was first goes back to the top of the view:
    // from below, ensure-row-visible puts it there, measured.
    Timer {
        interval: 30ms;
        running: posts-list.anchoring;
        triggered => {
            posts-list.anchoring = false;
            // The posts came in above the cards the list had built, and the list kept those where
            // they were: the card being read is where it was, nothing to put back.
            if posts-list.anchor-id == "" || posts-list.top-id != posts-list.anchor-id
                || abs(posts-list.top-gap - posts-list.anchor-gap) >= 1px {
                posts-list.content-y = min(0px, posts-list.visible-height - posts-list.content-height);
                posts-list.ensure-row-visible(ChannelStore.anchor-index, ScrollBehavior.instant);
            }
        }
    }
    Timer {
        interval: 700ms;
        running: posts-list.asked;
        triggered => { posts-list.asked = false; }
    }
    // The wheel notches the cards took: the list moves by them a little each frame.
    posts-glide := WheelGlide {
        glide(d) => {
            let to = min(0px, max(posts-list.visible-height - posts-list.content-height, posts-list.content-y + d));
            if to == posts-list.content-y {
                self.stop();
            }
            posts-list.content-y = to;
            posts-list.recheck();
            Motion.scrolling = true;
            posts-idle.restart();
        }
    }
    // The user stopped scrolling: cards that come into view animate again.
    posts-idle := Timer {
        interval: 250ms;
        running: false;
        triggered => {
            Motion.scrolling = false;
            self.running = false;
        }
    }

    if root.loading-older: Rectangle {
        z: 8;
        y: ChannelStore.newest-top ? root.height - 36px : 52px;
        height: 24px;
        width: older-text.preferred-width + 52px;
        x: (root.width - self.width) / 2;
        border-radius: 12px;
        background: Theme.surface;
        Spinner { x: 12px; y: 5px; }
        older-text := Text {
            x: 30px;
            width: parent.width - 42px;
            text: @tr("Loading older posts…");
            color: Theme.fg-muted;
            font-size: 12px * Theme.font-scale;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // A click on the posts beside the open thread panel closes it (the wheel still scrolls them).
    if ChannelStore.thread-id != "" && root.width > root.panel-w: TouchArea {
        z: 9;
        y: 45px;
        width: root.width - root.panel-w;
        height: root.height - 45px;
        clicked => { ChannelStore.close-thread(); }
    }

    if ChannelStore.thread-id != "": panel := ThreadPanel {
        // Starts off the right edge and slides in (at once with reduced motion).
        property <bool> shown: false;
        z: 10;
        width: root.panel-w;
        height: root.height;
        x: self.shown ? root.width - root.panel-w : root.width;
        animate x { duration: Theme.reduced-motion ? 0ms : 180ms; easing: ease-out; }
        channel: root.channel;
        react(id, k) => { root.react(id, k); }
        edit(id) => { root.edit(id); }
        more-reactions(id, x, y) => { root.more-reactions(id, x, y); }
        menu(m, x, y) => { root.menu(m, x, y); }
        open-url(u) => { root.open-url(u); }
        profile(id) => { root.profile(id); }
        retry-send(id) => { root.retry-send(id); }
        discard-send(id) => { root.discard-send(id); }
        Timer {
            interval: 16ms;
            running: !panel.shown;
            triggered => { panel.shown = true; }
        }
    }

    order-menu := PopupWindow {
        x: root.width - 264px;
        y: 44px;
        width: 248px;
        height: 44px;
        Rectangle {
            background: Theme.surface;
            border-radius: 6px;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 4px;
                Rectangle {
                    height: 32px;
                    border-radius: 4px;
                    background: order-touch.has-hover ? Theme.surface-hover : transparent;
                    accessible-role: button;
                    accessible-label: "See new posts at top";
                    accessible-checkable: true;
                    accessible-checked: ChannelStore.newest-top;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        Text { text: "See new posts at top"; color: Theme.fg; font-size: 13px * Theme.font-scale; vertical-alignment: center; horizontal-stretch: 1; }
                        if ChannelStore.newest-top: Text { text: "✓"; color: Theme.accent; font-size: 13px * Theme.font-scale; vertical-alignment: center; }
                    }
                    order-touch := TouchArea { mouse-cursor: pointer; clicked => { ChannelStore.command("order", ChannelStore.newest-top ? "bottom" : "top"); } }
                }
            }
        }
    }
}
