// An Adaptive Card drawn like Teams does (plan 8.8): colored container bands, fact sets as two
// columns, sized and colored text, column sets, images and action buttons. The rows come from
// `teams_proto::chat_card` through `Msg.card`.
import { Theme } from "../tokens/theme.slint";
import { CardRow } from "../tokens/types.slint";
import { Skeleton } from "../tokens/motion.slint";
import { Button, ButtonVariant } from "../atoms/button.slint";

export global CardColors {
    pure public function band(b: string) -> color {
        if b == "emphasis" { return Theme.surface-hover; }
        if b == "good" { return #1d3b27; }
        if b == "attention" { return #4d2024; }
        if b == "warning" { return #4a3912; }
        if b == "accent" { return #232b5c; }
        return transparent;
    }
    pure public function tone(t: string, subtle: bool) -> color {
        if t == "accent" { return #9aa5ff; }
        if t == "good" { return #6fd685; }
        if t == "warning" { return #f5c451; }
        if t == "attention" { return #ff7e83; }
        if t == "light" { return #ffffff; }
        return subtle ? Theme.fg-muted : Theme.fg;
    }
}

export component CardView inherits Rectangle {
    in property <[CardRow]> rows;
    callback open-url(string);
    height: lay.preferred-height + 2px;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.sidebar;
    clip: true;
    accessible-role: groupbox;
    accessible-label: "Card";

    lay := VerticalLayout {
        for r in root.rows: Rectangle {
            height: content.preferred-height;
            background: CardColors.band(r.band);
            content := VerticalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: r.kind == "banner" ? 14px : 5px;
                padding-bottom: r.kind == "banner" ? 14px : 5px;
                if r.kind == "banner": Text {
                    text: r.plain;
                    color: #ffffff;
                    font-size: r.size;
                    font-weight: 700;
                    wrap: word-wrap;
                    accessible-role: text;
                    accessible-label: "Announcement " + r.plain;
                }
                if r.kind == "text": StyledText {
                    text: r.text;
                    default-color: CardColors.tone(r.tone, r.subtle);
                    default-font-size: r.size;
                    link-color: Theme.accent;
                    selectable: true;
                    link-clicked(url) => { root.open-url(url); }
                }
                if r.kind == "fact": HorizontalLayout {
                    spacing: 12px;
                    Text {
                        text: r.label;
                        color: Theme.fg-muted;
                        font-size: 13px * Theme.font-scale;
                        font-weight: 700;
                        width: 150px;
                        wrap: word-wrap;
                    }
                    StyledText {
                        text: r.text;
                        default-color: Theme.fg;
                        default-font-size: 13px * Theme.font-scale;
                        link-color: Theme.accent;
                        selectable: true;
                        horizontal-stretch: 1;
                        link-clicked(url) => { root.open-url(url); }
                    }
                }
                if r.kind == "columns": HorizontalLayout {
                    spacing: 12px;
                    for c in r.cells: HorizontalLayout {
                        horizontal-stretch: c.stretch;
                        spacing: 8px;
                        if c.has-img: Image { source: c.img; width: 40px; height: 40px; image-fit: contain; y: 0px; }
                        if c.plain != "": StyledText {
                            text: c.text;
                            default-color: CardColors.tone(c.tone, false);
                            default-font-size: c.size;
                            link-color: Theme.accent;
                            selectable: true;
                            link-clicked(url) => { root.open-url(url); }
                        }
                    }
                }
                if r.kind == "image": Rectangle {
                    height: r.img-h;
                    if r.has-img: Image { source: r.img; width: min(r.img-w, parent.width); height: parent.height; image-fit: contain; x: 0px; }
                    if !r.has-img: Skeleton { x: 0px; width: min(r.img-w, parent.width); height: parent.height; accessible-role: image; accessible-label: "Loading image…"; }
                }
                if r.kind == "actions": HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    padding-top: 4px;
                    for b in r.buttons: Button { variant: ButtonVariant.accent-outline;
                        label: b.title;
                        enabled: b.url != "";
                        clicked => { root.open-url(b.url); }
                    }
                }
            }
        }
    }
}
