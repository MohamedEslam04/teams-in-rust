// The composer's text box: one TextInput per line, so each line is aligned by its own first strong
// character (Arabic lines right, English lines left). A TextInput has one alignment for all its
// lines, hence one input per line. The text stays one string (`text`, lines joined by "\n") and the
// cursor and selection are offsets into it, so the rest of the composer works as with one input;
// src/composer_lines.rs (render::lines) maps between that string and the lines.
//
// The rows of `lines` are linked to the inputs (typing writes the row), so the text of an input and
// the model never differ; setting the text from outside updates the rows in place (`LineApi.update`)
// and keeps the focused input, so a key typed right after works. Anything that has to move the
// cursor into another input (a joined line, a new line) is done when that input exists.
//
// Arrow keys: a TextInput moves the cursor in logical order (Left is always backward), but in a
// right to left line Left is visually forward: there the editor handles Left and Right itself, with
// the meaning swapped (Left = forward in the text, Right = backward; Shift extends the selection,
// Ctrl moves by word, and at the end or the start of the line the cursor crosses to the next or the
// previous line). An English word inside an Arabic line still moves in logical order.
//
// Home and End likewise: a TextInput resolves them on screen, so in a right to left line Home would
// go to the left edge (the end of the text). The editor handles them for every line: Home is the
// start of the line in the text (the right edge in a right to left line), End its end, Shift extends
// the selection, Ctrl+Home and Ctrl+End go to the start and the end of the whole text. A line that
// wraps is one line for them (not one screen row).
//
// Ctrl+A selects the whole text, over all lines (`whole`): every input shows its line selected, and
// `caret` and `anchor` are the whole text's ends. While it holds, Ctrl+C and Ctrl+X copy (cut) the
// whole text, Backspace and Delete clear it, a typed character or a paste replaces it, and an arrow
// key (Left or Up the start, Right or Down the end, Left and Right swapped in a right to left line),
// a click or an edit by the input itself ends it.
//
// The cursor of a right aligned line: at the start of a right to left line the cursor is at the
// right edge of the text, which is the right edge of the input, and an input clips what it draws
// to its own size, so the cursor it draws there is cut off (padding around the input does not help,
// and a TextInput has no padding of its own). So in that place the input draws no cursor and
// `caret` (a child of the input) is drawn instead, `text-cursor-width` wide, just inside the edge.
// It does not blink.
//
// What it does not do: any other selection stays inside one line (no Shift+Up/Down), and an
// input's own undo only knows its own line.
import { Tokens } from "../tokens/types.slint";
import { Theme } from "../tokens/theme.slint";

// Rust side: src/composer_lines.rs. Offsets are byte offsets into the whole text.
export global LineApi {
    pure callback split(string) -> [string];
    // the rows joined with "\n"
    pure callback join([string]) -> string;
    // Changes the rows of the model in place to the lines of the text (rows are set, added or removed)
    callback update([string], string);
    pure callback line-count(string) -> int;
    // line and byte column of an offset
    pure callback line-of(string, int) -> int;
    pure callback column-of(string, int) -> int;
    // text, line, column -> offset
    pure callback offset-of(string, int, int) -> int;
    pure callback line-length(string, int) -> int;
    // text, start, end, insert -> text
    pure callback splice(string, int, int, string) -> string;
    // text, offset, -1 (up) or 1 (down) -> offset one line up or down in the same column, or -1
    pure callback vertical(string, int, int) -> int;
    // text, line -> 1 right to left, -1 left to right, 0 not known yet
    pure callback direction(string, int) -> int;
    // text, offset, -1 or 1, by word -> offset one character (a letter with its marks) or one word
    // back or forward in the line of the offset; the offset itself at the end of the line
    pure callback step(string, int, int, bool) -> int;
    // Whether a key's text is a typed character (not a special key)
    pure callback printable(string) -> bool;
}

export component LineEditor inherits Rectangle {
    in property <Tokens> c: Theme.content;
    in-out property <string> text;
    in property <length> font-size: 14px;
    // The cursor and the other end of the selection, as offsets into `text`.
    out property <int> cursor-position-byte-offset: root.caret;
    out property <int> anchor-position-byte-offset: root.anchor;
    out property <bool> focused: root.focus-line >= 0;
    out property <length> text-height: lines-box.preferred-height;
    // The text was edited by typing or pasting (not when it is set from outside).
    callback edited();

    // The text as this editor last knew it. `text` differs from it after a write from outside.
    property <string> own;
    // One row per line. A row can hold a line break for a moment (Enter, a paste): `normalize`
    // makes it lines.
    property <[string]> lines: [""];
    property <int> caret;
    property <int> anchor;
    property <int> focus-line: -1;
    // Ctrl+A: the whole text is selected (`caret` and `anchor` are its ends); `selecting` is set
    // while the editor itself puts the selection in the inputs.
    property <bool> whole;
    property <bool> selecting;
    // A request to put the cursor in a line: a new input takes it in `init`, an old one when `poke`
    // changes or at its next key.
    property <bool> want-active;
    property <int> want-line;
    property <int> want-anchor-column;
    property <int> want-column;
    property <int> poke;
    property <length> row-height: probe.preferred-height;

    probe := Text { text: "Ag"; font-size: root.font-size; visible: false; }
    // Copies and pastes the whole text through the window's clipboard, as an input does its own.
    copier := TextInput { visible: false; width: 0px; height: 0px; }

    // The text was set from outside: the rows follow it.
    function sync() {
        if root.text != root.own {
            let had-focus = root.focus-line >= 0;
            root.whole = false;
            root.own = root.text;
            LineApi.update(root.lines, root.text);
            if had-focus && root.focus-line >= LineApi.line-count(root.text) {
                root.request(2000000000, 2000000000, true);
            }
        }
    }

    function request(a: int, c: int, now: bool) {
        root.whole = false;
        root.want-line = LineApi.line-of(root.own, c);
        root.want-column = LineApi.column-of(root.own, c);
        root.want-anchor-column = LineApi.line-of(root.own, a) == root.want-line ? LineApi.column-of(root.own, a) : root.want-column;
        root.caret = LineApi.offset-of(root.own, root.want-line, root.want-column);
        root.anchor = LineApi.offset-of(root.own, root.want-line, root.want-anchor-column);
        root.want-active = true;
        if now {
            root.poke += 1;
        }
    }

    // Rows that hold line breaks become lines.
    function normalize() {
        LineApi.update(root.lines, root.own);
        root.request(root.anchor, root.caret, true);
    }

    // Backspace at the start of line `k`: it joins the line before.
    function join(k: int) {
        let at = LineApi.offset-of(root.own, k, 0) - 1;
        root.own = LineApi.splice(root.own, at, at + 1, "");
        root.text = root.own;
        LineApi.update(root.lines, root.own);
        root.request(at, at, true);
        root.edited();
    }

    // Ctrl+A: every line shows as selected, the selection is the whole text.
    function select-all() {
        let total = LineApi.offset-of(root.own, 2000000000, 0);
        if total > 0 {
            root.whole = true;
            root.anchor = 0;
            root.caret = total;
        }
    }

    // The whole text is replaced (typed character, paste, cut, Backspace): one line to type in.
    function replace-all(t: string) {
        root.whole = false;
        root.own = t;
        root.text = t;
        LineApi.update(root.lines, t);
        root.request(2000000000, 2000000000, true);
        root.edited();
    }

    // Sets the text from outside, e.g. a completion.
    public function set-text(t: string) {
        root.text = t;
        root.sync();
    }

    // Same call as a TextInput's: the selection (the cursor line takes the focus).
    public function set-selection-offsets(a: int, c: int) {
        root.sync();
        root.request(a, c, true);
    }

    // Gives the keyboard focus to the line with the cursor, selection kept.
    public function focus-text() {
        root.sync();
        if !root.want-active {
            root.request(root.anchor, root.caret, true);
        }
    }

    init => {
        root.lines = LineApi.split(root.text);
        root.own = root.text;
    }
    changed text => { root.sync(); }

    norm-timer := Timer {
        interval: 1ms;
        running: false;
        triggered => {
            self.running = false;
            root.normalize();
        }
    }

    flick := Flickable {
        content-width: self.width;
        content-height: lines-box.height;

        lines-box := VerticalLayout {
            width: flick.width;
            height: max(flick.height, self.preferred-height);
            for line[i] in root.lines: ti := TextInput {
                text <=> line;
                color: root.c.fg;
                font-size: root.font-size;
                single-line: false;
                wrap: word-wrap;
                // The last line takes the room below the text, so a click there is a click in it.
                vertical-stretch: i == root.lines.length - 1 ? 1 : 0;
                horizontal-alignment: LineApi.direction(root.text, i) > 0 ? TextHorizontalAlignment.right : LineApi.direction(root.text, i) < 0 ? TextHorizontalAlignment.left : Theme.start-align;
                property <length> caret-y;
                // Where the input reports its cursor (its top left corner), from the callback below.
                property <length> caret-x;
                // The cursor is where the input cannot draw it: at or past its right edge (the
                // start of a right to left line). Then `caret` is drawn.
                property <bool> caret-clipped: self.has-focus && self.cursor-position-byte-offset == self.anchor-position-byte-offset && LineApi.direction(root.text, i) > 0 && self.caret-x + self.text-cursor-width > self.width + 0.5px;
                property <int> wanted: root.poke;
                property <bool> whole-selected: root.whole;

                function take() {
                    if root.want-active && root.want-line == i {
                        root.want-active = false;
                        self.focus();
                        // An input focused in its `init` starts with has-focus true, so the
                        // handler below never hears of it: the line is recorded here.
                        root.focus-line = i;
                        self.set-selection-offsets(root.want-anchor-column, root.want-column);
                    }
                }
                init => { self.take(); }
                changed wanted => { self.take(); }
                changed has-focus => {
                    if self.has-focus {
                        root.focus-line = i;
                    } else if root.focus-line == i {
                        root.focus-line = -1;
                        root.whole = false;
                    }
                }
                // Where the right edge is moves with the width: the cursor is asked for again.
                changed width => {
                    if self.has-focus && !root.whole && !root.selecting && self.cursor-position-byte-offset == self.anchor-position-byte-offset && LineApi.direction(root.own, i) > 0 {
                        self.set-selection-offsets(self.cursor-position-byte-offset, self.cursor-position-byte-offset);
                    }
                }
                // Ctrl+A shows every line selected, and ends it.
                changed whole-selected => {
                    root.selecting = true;
                    if root.whole {
                        self.set-selection-offsets(0, LineApi.line-length(root.own, i));
                    } else {
                        // The focused input is left as whatever ended the selection made it.
                        if !self.has-focus {
                            self.clear-selection();
                        }
                    }
                    root.selecting = false;
                }

                cursor-position-changed(pos) => {
                    // Not when the editor itself selects the line (`whole-selected` above).
                    if !root.selecting {
                        self.caret-y = pos.y;
                        self.caret-x = pos.x;
                        // Keep the cursor in view when the lines are taller than the box.
                        let top = self.y + pos.y;
                        if top < -flick.content-y {
                            flick.content-y = -top;
                        } else if top + root.row-height > -flick.content-y + flick.height {
                            flick.content-y = flick.height - top - root.row-height;
                        }
                        if self.has-focus {
                            // A click or a drag: every key is dealt with in `key-pressed`.
                            root.whole = false;
                            let start = LineApi.offset-of(root.own, i, 0);
                            root.caret = start + self.cursor-position-byte-offset;
                            root.anchor = start + self.anchor-position-byte-offset;
                        }
                    }
                }

                edited => {
                    root.whole = false;
                    let start = LineApi.offset-of(root.own, i, 0);
                    let t = LineApi.join(root.lines);
                    root.own = t;
                    root.text = t;
                    root.caret = start + self.cursor-position-byte-offset;
                    root.anchor = start + self.anchor-position-byte-offset;
                    if LineApi.line-count(t) != root.lines.length {
                        // Enter or a paste with line breaks: lines are made of them in a moment.
                        norm-timer.running = true;
                        norm-timer.restart();
                    }
                    root.edited();
                }

                // A selection made by a key (Ctrl+A, Shift+arrows) changes no cursor position the
                // callback above would hear of: read it when the key is released.
                key-released(event) => {
                    if self.has-focus && !root.whole {
                        let start = LineApi.offset-of(root.own, i, 0);
                        root.caret = start + self.cursor-position-byte-offset;
                        root.anchor = start + self.anchor-position-byte-offset;
                    }
                    return reject;
                }

                key-pressed(event) => {
                    // A write from outside the rows have not followed yet, or a cursor request for
                    // this input: done before the key acts.
                    root.sync();
                    self.take();
                    let plain = !event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta && !event.modifiers.shift;
                    let collapsed = self.cursor-position-byte-offset == self.anchor-position-byte-offset;
                    let at-start = collapsed && self.cursor-position-byte-offset == 0;
                    let at-end = collapsed && self.cursor-position-byte-offset == LineApi.line-length(root.own, i);
                    let normal = LineApi.line-count(root.own) == root.lines.length;
                    let rtl = LineApi.direction(root.own, i) > 0;
                    let ctrl-only = event.modifiers.control && !event.modifiers.shift && !event.modifiers.alt && !event.modifiers.meta;
                    let is-a = event.text == "a" || event.text == "A";
                    if ctrl-only && is-a && normal {
                        root.select-all();
                        return accept;
                    }
                    if root.whole && normal {
                        let is-c = event.text == "c" || event.text == "C";
                        let is-x = event.text == "x" || event.text == "X";
                        let is-v = event.text == "v" || event.text == "V";
                        let to-start = event.text == Key.UpArrow || event.text == Key.Home || event.text == (rtl ? Key.RightArrow : Key.LeftArrow);
                        let to-end = event.text == Key.DownArrow || event.text == Key.End || event.text == (rtl ? Key.LeftArrow : Key.RightArrow);
                        if ctrl-only && (is-c || is-x) {
                            copier.text = root.own;
                            copier.select-all();
                            copier.copy();
                            if is-x {
                                root.replace-all("");
                            }
                            return accept;
                        }
                        if ctrl-only && is-v {
                            copier.text = "";
                            copier.paste();
                            if copier.text != "" {
                                root.replace-all(copier.text);
                            }
                            return accept;
                        }
                        if event.text == Key.Backspace || event.text == Key.Delete {
                            root.replace-all("");
                            return accept;
                        }
                        if to-start || to-end {
                            let to = to-start ? 0 : LineApi.offset-of(root.own, 2000000000, 0);
                            root.request(to, to, true);
                            return accept;
                        }
                        if LineApi.printable(event.text) && !event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta {
                            root.replace-all(event.text);
                            return accept;
                        }
                    }
                    // Home and End: the start and the end of the line in the text, in any direction (a
                    // TextInput resolves them on screen, so in a right to left line Home went to the
                    // left edge, the end of the text). Shift extends the selection; Ctrl goes to the start
                    // or the end of the whole text, over lines (Ctrl+Shift stays in the line).
                    if (event.text == Key.Home || event.text == Key.End) && !event.modifiers.alt && !event.modifiers.meta && normal {
                        let home = event.text == Key.Home;
                        if event.modifiers.control && !event.modifiers.shift {
                            let far = home ? 0 : LineApi.offset-of(root.own, 2000000000, 0);
                            root.request(far, far, true);
                            return accept;
                        }
                        let line-start = LineApi.offset-of(root.own, i, 0);
                        let anc = line-start + self.anchor-position-byte-offset;
                        let col = home ? 0 : LineApi.line-length(root.own, i);
                        self.set-selection-offsets(event.modifiers.shift ? self.anchor-position-byte-offset : col, col);
                        root.caret = line-start + col;
                        root.anchor = event.modifiers.shift ? anc : line-start + col;
                        return accept;
                    }
                    // Left and Right in a right to left line: Left is forward in the text.
                    if rtl && (event.text == Key.LeftArrow || event.text == Key.RightArrow) && !event.modifiers.alt && !event.modifiers.meta {
                        let forward = event.text == Key.LeftArrow;
                        let line-start = LineApi.offset-of(root.own, i, 0);
                        let cur = line-start + self.cursor-position-byte-offset;
                        let anc = line-start + self.anchor-position-byte-offset;
                        if plain && forward && at-end && normal && i < root.lines.length - 1 {
                            root.request(LineApi.offset-of(root.own, i + 1, 0), LineApi.offset-of(root.own, i + 1, 0), true);
                            return accept;
                        }
                        if plain && !forward && at-start && normal && i > 0 {
                            root.request(line-start - 1, line-start - 1, true);
                            return accept;
                        }
                        // A selection that is not extended collapses to the end the arrow points to.
                        let collapse = !event.modifiers.shift && !event.modifiers.control && anc != cur;
                        let to = collapse ? (forward ? max(anc, cur) : min(anc, cur)) : LineApi.step(root.own, cur, forward ? 1 : -1, event.modifiers.control);
                        self.set-selection-offsets(event.modifiers.shift ? self.anchor-position-byte-offset : to - line-start, to - line-start);
                        root.caret = to;
                        root.anchor = event.modifiers.shift ? anc : to;
                        return accept;
                    }
                    if event.text == Key.Backspace && at-start && normal && i > 0 && !event.modifiers.control {
                        root.join(i);
                        return accept;
                    }
                    if event.text == Key.Delete && at-end && normal && i < root.lines.length - 1 && !event.modifiers.control {
                        root.join(i + 1);
                        return accept;
                    }
                    if event.text == Key.LeftArrow && plain && at-start && normal && i > 0 {
                        root.request(LineApi.offset-of(root.own, i, 0) - 1, LineApi.offset-of(root.own, i, 0) - 1, true);
                        return accept;
                    }
                    if event.text == Key.RightArrow && plain && at-end && normal && i < root.lines.length - 1 {
                        root.request(LineApi.offset-of(root.own, i + 1, 0), LineApi.offset-of(root.own, i + 1, 0), true);
                        return accept;
                    }
                    if event.text == Key.UpArrow && plain && normal && i > 0 && self.caret-y < root.row-height * 0.5 {
                        let to = LineApi.vertical(root.own, root.caret, -1);
                        if to >= 0 {
                            root.request(to, to, true);
                            return accept;
                        }
                    }
                    if event.text == Key.DownArrow && plain && normal && i < root.lines.length - 1 && self.caret-y > self.height - root.row-height * 1.5 {
                        let to = LineApi.vertical(root.own, root.caret, 1);
                        if to >= 0 {
                            root.request(to, to, true);
                            return accept;
                        }
                    }
                    return reject;
                }

                caret := Rectangle {
                    x: ti.width - ti.text-cursor-width;
                    y: ti.caret-y;
                    width: ti.caret-clipped ? ti.text-cursor-width : 0px;
                    height: root.row-height;
                    background: ti.color;
                }
            }
        }
    }
}
