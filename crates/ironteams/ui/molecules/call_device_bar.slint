// One account in the call on two devices: a bar at the top of the call window that says we are
// in this call on another device too (the roster lists a second device of ours) and whether this
// device plays the call's sound, with the toggle. "Add this device" on the pre-join screen joins
// with the sound off, so a phone and a laptop in one room do not echo.
import { Theme } from "../tokens/theme.slint";
import { Icon } from "../atoms/widgets.slint";
import { CallStore } from "../stores/call_store.slint";
import { Button, ButtonVariant } from "../atoms/button.slint";

export component DeviceBar inherits Rectangle {
    property <string> message: CallStore.other-device
        ? (CallStore.sound-off ? "You're also in this call on another device. Sound is off here." : "You're also in this call on another device.")
        : "Sound is off on this device.";
    height: 40px;
    // A light wash of the accent, so the bar reads as information in both themes.
    background: Theme.accent.transparentize(0.82);
    accessible-role: groupbox;
    accessible-label: root.message;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 8px;
        spacing: 6px;
        alignment: stretch;
        VerticalLayout {
            alignment: center;
            Icon {
                source: @image-url("../icons/volume.svg");
                tint: Theme.fg-muted;
                width: 16px;
                height: 16px;
            }
        }
        Text {
            text: root.message;
            color: Theme.fg;
            font-size: 13px * Theme.font-scale;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
            accessible-role: text;
            accessible-label: self.text;
        }
        VerticalLayout {
            alignment: center;
            Button { variant: ButtonVariant.solid; base-width: 120px;
                label: CallStore.sound-off ? "Turn on sound" : "Turn off sound";
                primary: CallStore.sound-off;
                clicked => { CallStore.command("sound", ""); }
            }
        }
    }
}
