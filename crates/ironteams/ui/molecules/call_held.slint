// Call waiting: the call on hold, as a bar at the top of the call window and in the floating
// call, like Teams': "<name> · On hold" with Resume (the held call comes back and the shown one
// goes on hold) and End. Shown while `CallStore.held-name` is set.
import { Tokens } from "../tokens/types.slint";
import { Theme } from "../tokens/theme.slint";
import { Icon } from "../atoms/widgets.slint";
import { CallStore } from "../stores/call_store.slint";
import { Button, ButtonVariant } from "../atoms/button.slint";

export component HeldBar inherits Rectangle {
    in property <Tokens> c: Theme.content;
    // The floating call's slimmer bar.
    in property <bool> compact;
    height: root.compact ? 34px : 40px;
    border-radius: root.compact ? 4px : 0px;
    background: root.c.warning-soft;
    accessible-role: groupbox;
    accessible-label: CallStore.held-name + " · On hold";
    HorizontalLayout {
        padding-left: root.compact ? 8px : 14px;
        padding-right: root.compact ? 4px : 8px;
        spacing: 6px;
        alignment: stretch;
        VerticalLayout {
            alignment: center;
            Icon {
                c: root.c;
                source: @image-url("../icons/call-direct.svg");
                tint: root.c.fg-muted;
                width: 16px;
                height: 16px;
            }
        }
        Text {
            text: CallStore.held-name + " · On hold";
            color: root.c.fg;
            font-size: 13px * Theme.font-scale;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
            accessible-role: text;
            accessible-label: self.text;
        }
        VerticalLayout {
            alignment: center;
            Button { c: root.c; variant: ButtonVariant.solid; base-width: 64px;
                label: "Resume";
                accessible-label: "Resume the call on hold";
                primary: true;
                clicked => { CallStore.command("resume", ""); }
            }
        }
        VerticalLayout {
            alignment: center;
            Button { c: root.c; variant: ButtonVariant.solid; base-width: 64px;
                label: "End";
                accessible-label: "End the call on hold";
                clicked => { CallStore.command("end-held", ""); }
            }
        }
    }
}
