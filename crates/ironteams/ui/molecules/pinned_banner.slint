// Pinned messages banner: a strip under the chat header showing one pinned message. Clicking it
// jumps to the message and moves on to the next pin; the arrows cycle without jumping; the "…"
// menu has Unpin. Resolving a pin to its sender and text happens in Rust.
import { Theme } from "../tokens/theme.slint";
import { PinnedItem, Tokens } from "../tokens/types.slint";
import { Icon, IconButton } from "../atoms/widgets.slint";

export component PinnedBanner inherits Rectangle {
    in property <Tokens> c: Theme.content;
    in property <[PinnedItem]> items;
    in-out property <int> index: 0;
    callback jump(string);
    callback unpin(string);

    property <int> shown: max(0, min(root.index, root.items.length - 1));
    property <PinnedItem> current: root.items[root.shown];

    height: 36px;
    background: root.c.panel;
    accessible-role: groupbox;
    accessible-label: @tr("Pinned messages");

    HorizontalLayout {
        padding-left: 20px;
        padding-right: 8px;
        spacing: 8px;
        Icon { c: root.c; source: @image-url("../icons/pin.svg"); width: 14px; height: 14px; y: 11px; tint: root.c.accent; }
        pin-body := Rectangle {
            horizontal-stretch: 1;
            accessible-role: button;
            accessible-label: @tr("Go to pinned message");
            HorizontalLayout {
                spacing: 6px;
                if root.current.sender != "": Text { text: root.current.sender; color: root.c.fg; font-size: 12px * Theme.font-scale; font-weight: 600; vertical-alignment: center; horizontal-stretch: 0; overflow: elide; max-width: 160px; }
                pin-text := Text { text: root.current.preview; color: root.c.fg-muted; font-size: 12px * Theme.font-scale; vertical-alignment: center; overflow: elide; }
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.jump(root.current.id);
                    root.index = mod(root.shown + 1, root.items.length);
                }
            }
        }
        if root.items.length > 1: pin-prev := IconButton {
            c: root.c;
            icon: @image-url("../icons/chevron-left.svg");
            tooltip: @tr("Previous pinned message");
            size: 28px;
            y: 4px;
            clicked => { root.index = mod(root.shown - 1 + root.items.length, root.items.length); }
        }
        pin-counter := Text {
            text: (root.shown + 1) + "/" + root.items.length;
            color: root.c.fg-subtle;
            font-size: 12px * Theme.font-scale;
            vertical-alignment: center;
            horizontal-stretch: 0;
        }
        if root.items.length > 1: pin-next := IconButton {
            c: root.c;
            icon: @image-url("../icons/chevron-right.svg");
            tooltip: @tr("Next pinned message");
            size: 28px;
            y: 4px;
            clicked => { root.index = mod(root.shown + 1, root.items.length); }
        }
        pin-more := IconButton {
            c: root.c;
            icon: @image-url("../icons/more.svg");
            tooltip: @tr("Pinned message options");
            size: 28px;
            y: 4px;
            clicked => { pin-menu.show(); }
        }
    }
    Rectangle { y: parent.height - 1px; height: 1px; background: root.c.border; }

    pin-menu := PopupWindow {
        x: parent.width - 160px;
        y: parent.height;
        width: 140px;
        height: 40px;
        Rectangle {
            background: root.c.surface;
            border-radius: 6px;
            border-width: 1px;
            border-color: root.c.border;
            VerticalLayout {
                padding: 4px;
                pin-unpin := Rectangle {
                    height: 32px;
                    border-radius: 4px;
                    background: unpin-touch.has-hover ? root.c.surface-hover : transparent;
                    accessible-role: button;
                    accessible-label: @tr("Unpin");
                    Text { x: 10px; text: @tr("Unpin"); color: root.c.fg; font-size: 13px * Theme.font-scale; vertical-alignment: center; }
                    unpin-touch := TouchArea { mouse-cursor: pointer; clicked => { root.unpin(root.current.id); } }
                }
            }
        }
    }
}
