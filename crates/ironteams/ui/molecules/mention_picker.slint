// @mention picker: the popup above the composer that lists who can be mentioned while an
// `@query` is being typed. The pure text functions live in Rust (src/mention.rs).
import { Theme } from "../tokens/theme.slint";
import { Edited, PersonItem, Tokens } from "../tokens/types.slint";
import { Avatar } from "../atoms/avatar.slint";

export global MentionApi {
    // text, cursor byte offset -> is there an `@query` right before the cursor
    pure callback active(string, int) -> bool;
    // text, cursor byte offset -> the query after the `@`
    pure callback query(string, int) -> string;
    // text, cursor, "@Name " -> the text with the `@query` replaced
    pure callback complete(string, int, string) -> Edited;
    // text, cursor, picked names joined by newlines -> the text without the name token before the
    // cursor (cursor -1 when Backspace is an ordinary one)
    pure callback backspace(string, int, string) -> Edited;
}

export component MentionPicker inherits Rectangle {
    in property <Tokens> c: Theme.content;
    in property <[PersonItem]> items;
    in property <int> index: 0;
    callback picked(int);

    width: 320px;
    height: min(items.length, 8) * 40px + 8px;
    background: root.c.surface;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.c.border;
    accessible-role: list;
    accessible-label: "Mention";
    VerticalLayout {
        padding: 4px;
        for p[i] in root.items: Rectangle {
            height: 40px;
            border-radius: 4px;
            background: i == root.index || row.has-hover ? root.c.surface-hover : transparent;
            accessible-role: list-item;
            accessible-label: p.name;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 10px;
                Avatar { c: root.c; initials: p.initials; tone: p.color; img: p.avatar; has-img: p.has-avatar; size: 28px; y: 6px; }
                VerticalLayout {
                    alignment: center;
                    Text { text: p.name; color: root.c.fg; font-size: 13px * Theme.font-scale; overflow: elide; }
                    if p.subtitle != "": Text { text: p.subtitle; color: root.c.fg-subtle; font-size: 11px * Theme.font-scale; overflow: elide; }
                }
            }
            row := TouchArea { mouse-cursor: pointer; clicked => { root.picked(i); } }
        }
    }
}
