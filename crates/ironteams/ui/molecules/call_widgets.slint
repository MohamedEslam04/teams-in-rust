// Controls of the call window: the top bar's buttons (with a hover tooltip, also on the disabled
// ones that say why), the device dropdowns and the text buttons.
import { Theme } from "../tokens/theme.slint";
import { Icon } from "../atoms/widgets.slint";
import { CallStore } from "../stores/call_store.slint";
import { VideoFxStore } from "../stores/video_fx_store.slint";

// An icon over a label. A disabled one is drawn faded, does nothing when clicked and its tooltip
// says why.
export component CallButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <string> tip;
    in property <bool> enabled: true;
    // Toggled on: a raised hand, an open panel.
    in property <bool> active;
    // The red Leave.
    in property <bool> danger;
    in property <bool> checkable;
    callback clicked();
    width: max(52px, lbl.preferred-width + 14px);
    height: 50px;
    border-radius: 6px;
    background: root.danger ? (touch.has-hover ? #a4262c : Theme.danger)
        : root.active ? Theme.selected
        : touch.has-hover && root.enabled ? Theme.surface-hover : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-description: root.tip;
    accessible-enabled: root.enabled;
    accessible-checkable: root.checkable;
    accessible-checked: root.active;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    Rectangle {
        opacity: root.enabled ? 1 : 0.4;
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            HorizontalLayout {
                alignment: center;
                Icon {
                    source: root.icon;
                    tint: root.danger ? #ffffff : root.active ? Theme.accent : Theme.fg;
                    width: 20px;
                    height: 20px;
                }
            }
            lbl := Text {
                text: root.label;
                color: root.danger ? #ffffff : Theme.fg-muted;
                font-size: 11px * Theme.font-scale;
                horizontal-alignment: center;
            }
        }
    }
    touch := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { if root.enabled { root.clicked(); } }
    }
    if touch.has-hover && root.tip != "": Rectangle {
        y: root.height + 4px;
        x: min(0px, root.width - self.width);
        z: 100;
        width: tip-text.preferred-width + 16px;
        height: tip-text.preferred-height + 10px;
        border-radius: 4px;
        border-width: 1px;
        border-color: Theme.border;
        background: Theme.surface;
        tip-text := Text {
            text: root.tip;
            color: Theme.fg;
            font-size: 12px * Theme.font-scale;
        }
    }
}

// A text button: Join now, Cancel, Rejoin, Close.
export component CallAction inherits Rectangle {
    in property <string> label;
    in property <bool> primary;
    callback clicked();
    height: 34px;
    width: max(88px, txt.preferred-width + 28px);
    border-radius: 4px;
    border-width: root.primary ? 0px : 1px;
    border-color: Theme.border;
    background: root.primary ? (touch.has-hover ? Theme.accent : Theme.accent-strong)
        : touch.has-hover ? Theme.surface-hover : Theme.surface;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    txt := Text {
        text: root.label;
        color: root.primary ? #ffffff : Theme.fg;
        font-size: 13px * Theme.font-scale;
        font-weight: 600;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A device dropdown. The list opens in place (it pushes what is below it down), so it is never
// hidden behind a sibling. `key` names it in `CallStore.menu`.
export component DevicePicker inherits VerticalLayout {
    in property <string> caption;
    in property <[string]> options;
    in property <int> current;
    in property <string> key;
    callback picked(int);
    property <bool> open: CallStore.menu == root.key;
    spacing: 4px;
    Text {
        text: root.caption;
        color: Theme.fg-muted;
        font-size: 12px * Theme.font-scale;
    }
    Rectangle {
        height: 34px;
        border-radius: 4px;
        border-width: 1px;
        border-color: root.open ? Theme.accent : Theme.border;
        background: head.has-hover ? Theme.surface-hover : Theme.surface;
        accessible-role: combobox;
        accessible-label: root.caption;
        accessible-value: root.options[root.current];
        accessible-expandable: true;
        accessible-expanded: root.open;
        accessible-action-default => { CallStore.menu = root.open ? "" : root.key; }
        HorizontalLayout {
            padding-left: 10px;
            padding-right: 8px;
            spacing: 6px;
            Text {
                text: root.options[root.current];
                color: Theme.fg;
                font-size: 13px * Theme.font-scale;
                overflow: elide;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Icon {
                source: @image-url("../icons/chevron-down.svg");
                width: 14px;
                height: 14px;
                y: 10px;
            }
        }
        head := TouchArea {
            mouse-cursor: pointer;
            clicked => { CallStore.menu = root.open ? "" : root.key; }
        }
    }
    if root.open: Rectangle {
        border-radius: 4px;
        border-width: 1px;
        border-color: Theme.border;
        background: Theme.surface;
        VerticalLayout {
            padding: 4px;
            for name[i] in root.options: Rectangle {
                height: 30px;
                border-radius: 3px;
                background: item.has-hover ? Theme.surface-hover : transparent;
                accessible-role: list-item;
                accessible-label: name;
                accessible-item-selectable: true;
                accessible-item-selected: i == root.current;
                accessible-action-default => { CallStore.menu = ""; root.picked(i); }
                HorizontalLayout {
                    padding-left: 8px;
                    spacing: 8px;
                    Text {
                        text: i == root.current ? "✓" : "";
                        width: 12px;
                        color: Theme.accent;
                        font-size: 13px * Theme.font-scale;
                        vertical-alignment: center;
                    }
                    Text {
                        text: name;
                        color: Theme.fg;
                        font-size: 13px * Theme.font-scale;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                }
                item := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { CallStore.menu = ""; root.picked(i); }
                }
            }
        }
    }
}

// The microphone, speaker and camera pickers, as the More panel, the mic dropdown (no camera) and
// the pre-join screen show them. `prefix` keeps each place's dropdowns apart.
export component DeviceSettings inherits VerticalLayout {
    in property <string> prefix;
    spacing: 12px;
    DevicePicker {
        caption: "Microphone";
        key: root.prefix + "-mic";
        options: CallStore.mics;
        current: CallStore.mic;
        picked(i) => { CallStore.command("mic", "" + i); }
    }
    DevicePicker {
        caption: "Speaker";
        key: root.prefix + "-speaker";
        options: CallStore.speakers;
        current: CallStore.speaker;
        picked(i) => { CallStore.command("speaker", "" + i); }
    }
    // The camera, where video is chosen (not the mic button's audio dropdown).
    if root.prefix != "card": DevicePicker {
        caption: "Camera";
        key: root.prefix + "-camera";
        options: VideoFxStore.cameras;
        current: VideoFxStore.camera;
        picked(i) => { CallStore.command("camera-device", "" + i); }
    }
}
