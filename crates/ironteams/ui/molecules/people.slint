// State and commands shared by the people-and-conversations pieces (plan 6.1 to 6.7): the @mention
// picker, the New chat pane, the participants popover, the profile card, the pinned messages
// banner and read receipts. Rust fills the properties; the UI sends `command(name, argument)`.
import { PersonItem, PinnedItem } from "../tokens/types.slint";

export global PeopleStore {
    // @mention picker: candidates for the `@query` before the composer cursor.
    in property <[PersonItem]> mention-items;

    // New chat pane (Alt+Shift+N): who is addressed, the search suggestions and a hint such as
    // "A chat with these people already exists".
    in-out property <bool> new-chat-open: false;
    in property <[PersonItem]> new-chat-to;
    in property <[PersonItem]> new-chat-results;
    in property <string> new-chat-hint;

    // Group chat header: the pencil (rename) and the participants button.
    in property <bool> header-group: false;
    in property <int> member-count: 0;
    in-out property <bool> participants-open: false;
    in property <[PersonItem]> members;
    in property <[PersonItem]> add-results;
    // Chat id waiting for a "Leave this chat?" confirmation; empty when none.
    in-out property <string> leave-confirm;

    // Profile card.
    in-out property <bool> card-open: false;
    // The person whose clicked card this press closed (app.slint `pointer-pressed`): the click on
    // their photo leaves it closed instead of opening it again.
    in-out property <string> card-closed-for;
    in property <bool> card-loading: false;
    in property <PersonItem> card;
    in property <string> card-email;
    in property <string> card-work;
    in property <string> card-location;
    in property <string> card-time;
    in property <string> card-presence;
    in property <string> card-presence-label;
    in property <string> card-work-location;
    // Status message, "Out of office", work and mobile phone, manager ("" hides the row).
    in property <string> card-note;
    in property <string> card-ooo;
    in property <string> card-phone;
    in property <string> card-mobile;
    in property <string> card-manager;
    // "External" or "Guest" for someone outside our organization ("" for a colleague).
    in property <string> card-badge;
    // When they are next free ("10:00 AM", "" when not busy or unknown), their work hours
    // ("8:00 AM - 5:00 PM"), "office" or "remote" for the location icon, and the job fields.
    in property <string> card-free-at;
    in property <string> card-work-hours;
    in property <string> card-work-location-kind;
    in property <string> card-job-title;
    in property <string> card-department;
    // Up to six direct reports, how many there are (0 hides the section) and the manager.
    in property <[PersonItem]> card-reports;
    in property <int> card-reports-count: 0;
    in property <PersonItem> card-manager-person;

    // The full profile: a window over the app with the Overview, Profile and Organization tabs.
    // It shows the card's person (`card-*`); the chart has its own person in focus (`org-*`).
    in-out property <bool> profile-open: false;
    in-out property <int> profile-tab: 0;
    in property <PersonItem> org-focus;
    in property <string> org-location-kind;
    in property <PersonItem> org-manager;
    in property <[PersonItem]> org-reports;
    // -1 when the reports could not be read.
    in property <int> org-reports-count: -1;
    in property <bool> org-can-back: false;
    in property <bool> org-can-forward: false;
    in property <bool> org-loading: false;
    // Our own MRI (the photo at the top right opens our card).
    in property <string> me;
    // The card was opened by hovering (it closes when the pointer leaves it and its photo).
    in-out property <bool> card-by-hover: false;
    // The photo (or name) the card belongs to, in window coordinates: the card opens next to
    // it. A width of 0 means none (the card opens in the middle of the window).
    in-out property <length> anchor-x;
    in-out property <length> anchor-y;
    in-out property <length> anchor-w;
    in-out property <length> anchor-h;
    // The photo under the pointer, and where it is. `hover-armed` is cleared once its card has
    // been opened, so resting on it does not open the card again and again.
    in-out property <string> hover-id;
    in-out property <bool> hover-armed;
    in-out property <length> hover-x;
    in-out property <length> hover-y;
    in-out property <length> hover-w;
    in-out property <length> hover-h;

    // Opens the full profile of the card's person on a tab (0 Overview, 1 Profile, 2
    // Organization); the organization chart starts at them.
    public function open-profile(tab: int) {
        root.profile-tab = tab;
        root.profile-open = true;
        root.card-open = false;
        root.command("org-open", root.card.id);
    }

    // Opens the profile card of `id` next to the rectangle (window coordinates); `hover` opens
    // it as a hover card.
    public function open-card(id: string, x: length, y: length, w: length, h: length, hover: bool) {
        if id == "" { return; }
        if !hover && id == root.card-closed-for {
            root.card-closed-for = "";
            return;
        }
        root.anchor-x = x;
        root.anchor-y = y;
        root.anchor-w = w;
        root.anchor-h = h;
        root.card-by-hover = hover;
        root.command("profile", id);
    }
    // The pointer came onto a person's photo: their card opens after a short rest (the window's
    // timer, so a list row that is rebuilt meanwhile does not lose it).
    public function hover-enter(id: string, x: length, y: length, w: length, h: length) {
        if id == "" { return; }
        root.hover-id = id;
        root.hover-x = x;
        root.hover-y = y;
        root.hover-w = w;
        root.hover-h = h;
        root.hover-armed = true;
    }
    public function hover-leave(id: string) {
        if root.hover-id == id {
            root.hover-id = "";
            root.hover-armed = false;
        }
    }

    // Pinned messages banner: the pins of the open chat and the one shown.
    in property <[PinnedItem]> pinned;
    in-out property <int> pinned-index: 0;

    // Read receipts on (shown on your newest message).
    in property <bool> receipts-on: true;

    // The "Jump to a date" dialog of the open chat is shown.
    in-out property <bool> jump-date-open: false;

    // (name, argument). Names: mention-query, mention-pick, new-chat-open, new-chat-close,
    // new-chat-query, new-chat-add, new-chat-remove, new-chat-name, new-chat-send, rename,
    // participants-open, add-query, add-pick, add-history, leave, profile, profile-copy-email,
    // profile-chat, pin-jump, pin-unpin, receipts, jump-first, jump-date (YYYY-MM-DD or days:N),
    // quote-jump (the quoted message's id).
    callback command(string, string);
}

// The one hover-card trigger every person's photo uses, so they all open the card the same way:
// resting on it opens the hover card next to it (after the window's short delay), a click opens
// the card for good. With `click-opens: false` a click runs `activated` instead (the row's own
// action, such as opening the chat). Place it over the photo (or the person's row), above any
// other TouchArea there.
export component PersonHover inherits TouchArea {
    in property <string> person;
    in property <bool> click-opens: true;
    callback activated();
    // Whether the pointer is on this area. A row binds it two-way (`over <=> root.photo-over`)
    // to keep its own highlight under its photo, which sits above the row's TouchArea.
    in-out property <bool> over;
    // A list may reuse this row for someone else while the pointer rests on it: the leave names
    // the person the pointer came to.
    property <string> hovered: "";
    mouse-cursor: pointer;
    clicked => {
        if root.click-opens && root.person != "" {
            PeopleStore.open-card(root.person, root.absolute-position.x, root.absolute-position.y, root.width, root.height, false);
        } else {
            root.activated();
        }
    }
    changed has-hover => {
        root.over = root.has-hover;
        if root.has-hover && root.person != "" {
            root.hovered = root.person;
            PeopleStore.hover-enter(root.person, root.absolute-position.x, root.absolute-position.y, root.width, root.height);
        } else if !root.has-hover && root.hovered != "" {
            PeopleStore.hover-leave(root.hovered);
        }
    }
}
