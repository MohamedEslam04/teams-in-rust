// Small controls shared by the Teams management page and its dialogs.
import { Theme } from "../tokens/theme.slint";
import { Icon, IconButton } from "../atoms/widgets.slint";

export component TButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    callback clicked();
    height: 32px;
    width: max(64px, lbl.preferred-width + 28px);
    border-radius: 4px;
    border-width: root.primary || root.danger ? 0px : 1px;
    border-color: Theme.border;
    background: !root.enabled ? Theme.surface : (root.primary ? (t.has-hover ? Theme.accent : Theme.accent-strong) : (root.danger ? (t.has-hover ? #e0474b : Theme.danger) : (t.has-hover ? Theme.surface-hover : Theme.surface)));
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    lbl := Text {
        text: root.label;
        color: root.enabled ? #ffffff : Theme.fg-subtle;
        font-size: 13px * Theme.font-scale;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    t := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A labelled single-line text box. `text` follows what is typed; `initial` is the starting text.
export component TField inherits Rectangle {
    in property <string> label;
    in property <string> initial;
    in property <string> placeholder;
    out property <string> text <=> input.text;
    callback edited(string);
    callback accepted(string);
    height: 58px;
    VerticalLayout {
        spacing: 4px;
        Text { text: root.label; color: Theme.fg-muted; font-size: 12px * Theme.font-scale; }
        Rectangle {
            height: 32px;
            border-radius: 4px;
            background: Theme.sidebar;
            border-width: 1px;
            border-color: input.has-focus ? Theme.accent : Theme.border;
            input := TextInput {
                x: 10px;
                width: parent.width - 20px;
                text: root.initial;
                color: Theme.fg;
                font-size: 13px * Theme.font-scale;
                single-line: true;
                vertical-alignment: center;
                accessible-role: text-input;
                accessible-label: root.label;
                edited => { root.edited(self.text); }
                accepted => { root.accepted(self.text); }
            }
            if input.text == "" && root.placeholder != "": Text {
                x: 10px;
                text: root.placeholder;
                color: Theme.fg-subtle;
                font-size: 13px * Theme.font-scale;
                vertical-alignment: center;
            }
        }
    }
}

// A check box row.
export component TCheck inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    in-out property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);
    height: root.hint == "" ? 30px : 46px;
    accessible-role: checkbox;
    accessible-label: root.label;
    accessible-checked: root.checked;
    accessible-action-default => { root.flip(); }
    function flip() {
        if root.enabled {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
    HorizontalLayout {
        spacing: 10px;
        Rectangle {
            width: 18px;
            height: 18px;
            y: 6px;
            border-radius: 3px;
            border-width: 1px;
            border-color: root.checked ? Theme.accent : Theme.border;
            background: root.checked ? Theme.accent-strong : transparent;
            if root.checked: Icon { source: @image-url("../icons/check.svg"); tint: #ffffff; width: 14px; height: 14px; }
        }
        VerticalLayout {
            alignment: center;
            Text { text: root.label; color: root.enabled ? Theme.fg : Theme.fg-subtle; font-size: 13px * Theme.font-scale; }
            if root.hint != "": Text { text: root.hint; color: Theme.fg-subtle; font-size: 11px * Theme.font-scale; }
        }
    }
    TouchArea { mouse-cursor: pointer; clicked => { root.flip(); } }
}

// One choice out of a few, as a row of pills.
export component TChoice inherits Rectangle {
    in property <[{v: string, l: string}]> options;
    in property <string> value;
    in property <bool> enabled: true;
    callback picked(string);
    height: 30px;
    HorizontalLayout {
        spacing: 6px;
        alignment: start;
        for o in root.options: Rectangle {
            height: 28px;
            width: opt-text.preferred-width + 24px;
            border-radius: 14px;
            border-width: 1px;
            border-color: root.value == o.v ? Theme.accent : Theme.border;
            background: root.value == o.v ? #3b3d6b : (ot.has-hover && root.enabled ? Theme.surface-hover : transparent);
            accessible-role: radio-button;
            accessible-label: o.l;
            accessible-checked: root.value == o.v;
            accessible-action-default => { if root.enabled { root.picked(o.v); } }
            opt-text := Text { text: o.l; color: root.enabled ? Theme.fg : Theme.fg-subtle; font-size: 12px * Theme.font-scale; horizontal-alignment: center; vertical-alignment: center; }
            ot := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.picked(o.v); } }
        }
    }
}

export component TMenuItem inherits Rectangle {
    in property <string> label;
    in property <bool> danger: false;
    callback clicked();
    height: 32px;
    border-radius: 4px;
    background: t.has-hover ? Theme.surface-hover : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    Text { x: 10px; text: root.label; color: root.danger ? #ff7b7e : Theme.fg; font-size: 13px * Theme.font-scale; vertical-alignment: center; }
    t := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// A modal dialog: dimmed backdrop, a titled panel, and its content in `@children`.
export component TFrame inherits Rectangle {
    in property <string> title;
    in property <length> panel-width: 520px;
    in property <length> panel-height: 420px;
    in property <string> error;
    callback close();
    background: #000000a0;
    TouchArea { }
    panel := Rectangle {
        x: (root.width - self.width) / 2;
        y: max(8px, (root.height - self.height) / 2);
        width: min(root.panel-width, root.width - 24px);
        height: min(root.panel-height, root.height - 16px);
        border-radius: 8px;
        background: Theme.sidebar;
        border-width: 1px;
        border-color: Theme.border;
        clip: true;
        VerticalLayout {
            Rectangle {
                height: 48px;
                HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 10px;
                    Text { text: root.title; color: Theme.fg; font-size: 16px * Theme.font-scale; font-weight: 700; vertical-alignment: center; accessible-role: text; }
                    Rectangle { horizontal-stretch: 1; }
                    IconButton { icon: @image-url("../icons/close.svg"); tooltip: "Close"; size: 28px; y: 10px; clicked => { root.close(); } }
                }
            }
            if root.error != "": Rectangle {
                height: err.preferred-height + 14px;
                background: #3b1f22;
                err := Text {
                    x: 18px;
                    y: 7px;
                    width: parent.width - 36px;
                    text: root.error;
                    color: #ffffff;
                    font-size: 12px * Theme.font-scale;
                    wrap: word-wrap;
                    accessible-role: text;
                    accessible-label: "Error: " + root.error;
                }
            }
            Rectangle {
                vertical-stretch: 1;
                @children
            }
        }
    }
}
