// Small controls shared by the Teams management page and its dialogs.
import { Theme } from "../tokens/theme.slint";
import { Icon, IconButton } from "../atoms/widgets.slint";

// One choice out of a few, as a row of pills.
export component TChoice inherits Rectangle {
    in property <[{v: string, l: string}]> options;
    in property <string> value;
    in property <bool> enabled: true;
    callback picked(string);
    height: 30px;
    HorizontalLayout {
        spacing: 6px;
        alignment: start;
        for o in root.options: Rectangle {
            height: 28px;
            width: opt-text.preferred-width + 24px;
            border-radius: 14px;
            border-width: 1px;
            border-color: root.value == o.v ? Theme.accent : Theme.border;
            background: root.value == o.v ? #3b3d6b : (ot.has-hover && root.enabled ? Theme.surface-hover : transparent);
            accessible-role: radio-button;
            accessible-label: o.l;
            accessible-checked: root.value == o.v;
            accessible-action-default => { if root.enabled { root.picked(o.v); } }
            opt-text := Text { text: o.l; color: root.enabled ? Theme.fg : Theme.fg-subtle; font-size: 12px * Theme.font-scale; horizontal-alignment: center; vertical-alignment: center; }
            ot := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.picked(o.v); } }
        }
    }
}

// A modal dialog: dimmed backdrop, a titled panel, and its content in `@children`.
export component TFrame inherits Rectangle {
    in property <string> title;
    in property <length> panel-width: 520px;
    in property <length> panel-height: 420px;
    in property <string> error;
    callback close();
    background: #000000a0;
    TouchArea { }
    panel := Rectangle {
        x: (root.width - self.width) / 2;
        y: max(8px, (root.height - self.height) / 2);
        width: min(root.panel-width, root.width - 24px);
        height: min(root.panel-height, root.height - 16px);
        border-radius: 8px;
        background: Theme.sidebar;
        border-width: 1px;
        border-color: Theme.border;
        clip: true;
        VerticalLayout {
            Rectangle {
                height: 48px;
                HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 10px;
                    Text { text: root.title; color: Theme.fg; font-size: 16px * Theme.font-scale; font-weight: 700; vertical-alignment: center; accessible-role: text; }
                    Rectangle { horizontal-stretch: 1; }
                    IconButton { icon: @image-url("../icons/close.svg"); tooltip: "Close"; size: 28px; y: 10px; clicked => { root.close(); } }
                }
            }
            if root.error != "": Rectangle {
                height: err.preferred-height + 14px;
                background: #3b1f22;
                err := Text {
                    x: 18px;
                    y: 7px;
                    width: parent.width - 36px;
                    text: root.error;
                    color: #ffffff;
                    font-size: 12px * Theme.font-scale;
                    wrap: word-wrap;
                    accessible-role: text;
                    accessible-label: "Error: " + root.error;
                }
            }
            Rectangle {
                vertical-stretch: 1;
                @children
            }
        }
    }
}
