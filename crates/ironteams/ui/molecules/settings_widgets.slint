// Controls of the Settings page. They only use `Theme` colours, so they follow the light, dark
// and high-contrast palettes, and their text follows `Theme.font-scale`.
import { Theme } from "../tokens/theme.slint";
import { Icon } from "../atoms/widgets.slint";
import { SOption, SettingsStore } from "../stores/settings_store.slint";
import { Button, ButtonVariant } from "../atoms/button.slint";

// A round +/- button of the zoom row.
component ZoomButton inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    callback clicked();
    width: 28px;
    height: 28px;
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.border;
    background: zt.has-hover ? Theme.surface-hover : transparent;
    accessible-role: button;
    accessible-label: root.hint;
    accessible-action-default => { root.clicked(); }
    Text { text: root.label; color: Theme.fg; font-size: Theme.font-heading; horizontal-alignment: center; vertical-alignment: center; }
    zt := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// "Zoom  -  100%  +": the same size setting as Appearance › Font size, in the "…" menu and the
// profile menu.
export component ZoomRow inherits Rectangle {
    height: 36px;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 6px;
        spacing: 6px;
        Text { text: @tr("Zoom"); color: Theme.fg; font-size: Theme.font-body; vertical-alignment: center; horizontal-stretch: 1; }
        ZoomButton { y: 4px; label: "−"; hint: @tr("Zoom out"); clicked => { SettingsStore.command("font-step", "-1"); } }
        Rectangle {
            width: 48px;
            accessible-role: text;
            accessible-label: @tr("Zoom level");
            accessible-value: Math.round(SettingsStore.font-scale * 100) + "%";
            Text { text: Math.round(SettingsStore.font-scale * 100) + "%"; color: Theme.fg; font-size: Theme.font-body; horizontal-alignment: center; vertical-alignment: center; }
        }
        ZoomButton { y: 4px; label: "+"; hint: @tr("Zoom in"); clicked => { SettingsStore.command("font-step", "1"); } }
    }
}

// A titled group of settings.
export component SSection inherits VerticalLayout {
    in property <string> title;
    in property <string> hint;
    spacing: 8px;
    padding-bottom: 18px;
    if root.title != "": Text { horizontal-alignment: Theme.start-align; text: root.title; color: Theme.fg; font-size: Theme.font-heading; font-weight: 600; }
    if root.hint != "": Text { horizontal-alignment: Theme.start-align; text: root.hint; color: Theme.fg-muted; font-size: Theme.font-small; wrap: word-wrap; }
    @children
}

// One choice out of a few, as a row of pills. Each pill is labelled "<group>: <option>" for
// screen readers, so groups with the same options (Auto, On, Off) stay distinct.
// One pill of a `SChoice`.
component SChoicePill inherits Rectangle {
    in property <string> group;
    in property <SOption> o;
    in property <bool> on;
    in property <bool> enabled: true;
    callback picked();
    width: opt-text.preferred-width + 24px;
    border-radius: self.height / 2;
    border-width: 1px;
    border-color: root.on ? Theme.accent : Theme.border;
    background: root.on ? Theme.selected : (ot.has-hover && root.enabled ? Theme.surface-hover : transparent);
    accessible-role: radio-button;
    accessible-label: root.group + ": " + root.o.l;
    accessible-checked: root.on;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.picked(); } }
    opt-text := Text {
        text: root.o.l;
        color: root.on ? Theme.accent : (root.enabled ? Theme.fg : Theme.fg-subtle);
        font-size: Theme.font-body;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ot := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.picked(); } }
}

// Choices as pills in a row; when the row is wider than the space it has (a narrow window), the
// pills stack one under another instead of pushing the page wider than the window.
export component SChoice inherits Rectangle {
    in property <string> group;
    in property <[SOption]> options;
    in property <string> value;
    in property <bool> enabled: true;
    callback picked(string);
    property <length> pill-height: 30px * max(1, Theme.font-scale) - 2px;
    // The row's own width, measured whenever the row is shown.
    property <length> row-width;
    property <bool> fits: root.row-width <= root.width;
    // The page decides the width: the pills never widen it.
    min-width: 0px;
    height: root.fits ? root.pill-height + 2px : root.options.length * (root.pill-height + 6px);
    if root.fits: HorizontalLayout {
        spacing: 6px;
        alignment: start;
        init => { root.row-width = self.preferred-width; }
        for o in root.options: SChoicePill {
            height: root.pill-height;
            group: root.group;
            o: o;
            on: root.value == o.v;
            enabled: root.enabled;
            picked => { root.picked(o.v); }
        }
    }
    if !root.fits: VerticalLayout {
        spacing: 6px;
        alignment: start;
        for o in root.options: HorizontalLayout {
            alignment: start;
            SChoicePill {
                height: root.pill-height;
                group: root.group;
                o: o;
                on: root.value == o.v;
                enabled: root.enabled;
                picked => { root.picked(o.v); }
            }
        }
    }
}

// A labelled choice: the label above, the pills below.
export component SChoiceRow inherits VerticalLayout {
    in property <string> label;
    in property <string> hint;
    in property <[SOption]> options;
    in property <string> value;
    in property <bool> enabled: true;
    callback picked(string);
    spacing: 4px;
    // Opened by a Find result: tells the page where this row is.
    Timer {
        running: root.label != "" && root.label == SettingsStore.target;
        interval: 60ms;
        triggered => {
            SettingsStore.target-y = root.absolute-position.y;
            SettingsStore.target = "";
        }
    }
    Text { horizontal-alignment: Theme.start-align; text: root.label; color: Theme.fg; font-size: Theme.font-body; }
    if root.hint != "": Text { horizontal-alignment: Theme.start-align; text: root.hint; color: Theme.fg-subtle; font-size: Theme.font-small; wrap: word-wrap; }
    SChoice {
        group: root.label;
        options: root.options;
        value: root.value;
        enabled: root.enabled;
        picked(v) => { root.picked(v); }
    }
}

// A vertical list of choices (devices, accounts): one radio row each.
export component SRadio inherits Rectangle {
    in property <string> group;
    in property <string> label;
    in property <string> detail;
    in property <bool> checked;
    callback picked();
    min-height: max(32px, rcol.preferred-height + 8px);
    border-radius: 4px;
    background: rt.has-hover ? Theme.surface-hover : transparent;
    accessible-role: radio-button;
    accessible-label: root.group + ": " + root.label;
    accessible-checked: root.checked;
    accessible-action-default => { root.picked(); }
    HorizontalLayout {
        padding-left: 6px;
        spacing: 10px;
        Rectangle {
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;
            border-radius: 8px;
            border-width: 2px;
            border-color: root.checked ? Theme.accent : Theme.fg-muted;
            if root.checked: Rectangle { width: 8px; height: 8px; border-radius: 4px; background: Theme.accent; }
        }
        rcol := VerticalLayout {
            alignment: center;
            Text { horizontal-alignment: Theme.start-align; text: root.label; color: Theme.fg; font-size: Theme.font-body; wrap: word-wrap; }
            if root.detail != "": Text { horizontal-alignment: Theme.start-align; text: root.detail; color: Theme.fg-subtle; font-size: Theme.font-small; }
        }
    }
    rt := TouchArea { mouse-cursor: pointer; clicked => { root.picked(); } }
}

// A person row with one action button (Unblock, Remove).
export component SPersonRow inherits Rectangle {
    in property <string> name;
    in property <string> action;
    callback act();
    height: 40px;
    HorizontalLayout {
        spacing: 10px;
        Text { text: root.name; color: Theme.fg; font-size: Theme.font-body; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
        Button { variant: ButtonVariant.settings; label: root.action; accessible-label: root.action + " " + root.name; y: 5px; clicked => { root.act(); } }
    }
}

// The left list entry of the page.
export component SNavItem inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> active;
    callback clicked();
    height: max(36px, nl.preferred-height + 14px);
    border-radius: 4px;
    background: root.active ? Theme.selected : (nt.has-hover ? Theme.surface-hover : transparent);
    accessible-role: tab;
    accessible-label: root.label;
    accessible-checked: root.active;
    accessible-action-default => { root.clicked(); }
    Rectangle {
        x: 0;
        width: 3px;
        height: 18px;
        border-radius: 2px;
        background: root.active ? Theme.accent : transparent;
    }
    HorizontalLayout {
        padding-left: 12px;
        spacing: 10px;
        Icon { source: root.icon; tint: root.active ? Theme.accent : Theme.fg-muted; width: 18px; height: 18px; y: (parent.height - 18px) / 2; }
        nl := Text { horizontal-alignment: Theme.start-align; text: root.label; color: root.active ? Theme.fg : Theme.fg-muted; font-size: Theme.font-body; font-weight: root.active ? 600 : 400; vertical-alignment: center; overflow: elide; }
    }
    nt := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}
