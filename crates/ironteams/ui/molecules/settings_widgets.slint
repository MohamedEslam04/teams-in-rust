// Controls of the Settings page. They only use `Theme` colours, so they follow the light, dark
// and high-contrast palettes, and their text follows `Theme.font-scale`.
import { Tokens } from "../tokens/types.slint";
import { Theme } from "../tokens/theme.slint";
import { Icon } from "../atoms/widgets.slint";
import { SOption, SettingsStore } from "../stores/settings_store.slint";

// A round +/- button of the zoom row.
component ZoomButton inherits Rectangle {
    in property <Tokens> c: Theme.content;
    in property <string> label;
    in property <string> hint;
    callback clicked();
    width: 28px;
    height: 28px;
    border-radius: 4px;
    border-width: 1px;
    border-color: root.c.border;
    background: zt.has-hover ? root.c.surface-hover : transparent;
    accessible-role: button;
    accessible-label: root.hint;
    accessible-action-default => { root.clicked(); }
    Text { text: root.label; color: root.c.fg; font-size: Theme.font-heading; horizontal-alignment: center; vertical-alignment: center; }
    zt := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// "Zoom  -  100%  +": the same size setting as Appearance › Font size, in the "…" menu and the
// profile menu.
export component ZoomRow inherits Rectangle {
    in property <Tokens> c: Theme.content;
    height: 36px;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 6px;
        spacing: 6px;
        Text { text: @tr("Zoom"); color: root.c.fg; font-size: Theme.font-body; vertical-alignment: center; horizontal-stretch: 1; }
        ZoomButton { c: root.c; y: 4px; label: "−"; hint: @tr("Zoom out"); clicked => { SettingsStore.command("font-step", "-1"); } }
        Rectangle {
            width: 48px;
            accessible-role: text;
            accessible-label: @tr("Zoom level");
            accessible-value: Math.round(SettingsStore.font-scale * 100) + "%";
            Text { text: Math.round(SettingsStore.font-scale * 100) + "%"; color: root.c.fg; font-size: Theme.font-body; horizontal-alignment: center; vertical-alignment: center; }
        }
        ZoomButton { c: root.c; y: 4px; label: "+"; hint: @tr("Zoom in"); clicked => { SettingsStore.command("font-step", "1"); } }
    }
}

// One choice out of a few, as a row of pills. Each pill is labelled "<group>: <option>" for
// screen readers, so groups with the same options (Auto, On, Off) stay distinct.
// One pill of a `SChoice`.
component SChoicePill inherits Rectangle {
    in property <Tokens> c: Theme.content;
    in property <string> group;
    in property <SOption> o;
    in property <bool> on;
    in property <bool> enabled: true;
    callback picked();
    // A Tab put the focus here: the ring shows (a click does not show it).
    property <bool> focus-visible: false;
    width: opt-text.preferred-width + 24px;
    border-radius: self.height / 2;
    border-width: 1px;
    border-color: root.on ? root.c.accent : root.c.border;
    background: root.on ? root.c.selected : (ot.has-hover && root.enabled ? root.c.surface-hover : transparent);
    accessible-role: radio-button;
    accessible-label: root.group + ": " + root.o.l;
    accessible-checked: root.on;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.picked(); } }
    opt-text := Text {
        text: root.o.l;
        color: root.on ? root.c.accent : (root.enabled ? root.c.fg : root.c.fg-subtle);
        font-size: Theme.font-body;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    keys := FocusScope {
        width: 0px;
        height: 0px;
        enabled: root.enabled;
        focus-on-click: false;
        focus-changed-event(reason) => {
            root.focus-visible = self.has-focus && reason == FocusReason.tab-navigation;
        }
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) && !event.repeat {
                root.picked();
                return accept;
            }
            reject
        }
    }
    ot := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            keys.focus();
            root.focus-visible = false;
            root.picked();
        }
    }
    if root.focus-visible: focus-ring := Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: self.height / 2;
        border-width: 2px;
        border-color: root.c.accent;
    }
}

// Choices as pills in a row; when the row is wider than the space it has (a narrow window), the
// pills stack one under another instead of pushing the page wider than the window. The first
// option is on the start side: the left, or the right in a right to left language (Slint does not
// mirror a row, so the row lists the options backwards there). Stacked, the first is on top.
export component SChoice inherits Rectangle {
    in property <Tokens> c: Theme.content;
    in property <string> group;
    in property <[SOption]> options;
    in property <string> value;
    in property <bool> enabled: true;
    callback picked(string);
    property <length> pill-height: 30px * max(1, Theme.font-scale) - 2px;
    // The width the pills need side by side, measured from their labels below (always, so the
    // choice follows a window that grows or shrinks, and a label that is translated).
    property <bool> fits: measure.preferred-width <= root.width;
    // The page decides the width: the pills never widen it.
    min-width: 0px;
    height: root.fits ? root.pill-height + 2px : root.options.length * (root.pill-height + 6px);
    if root.fits: HorizontalLayout {
        spacing: 6px;
        alignment: Theme.rtl ? LayoutAlignment.end : LayoutAlignment.start;
        for i in root.options.length: SChoicePill {
            c: root.c;
            property <SOption> opt: root.options[Theme.rtl ? root.options.length - 1 - i : i];
            height: root.pill-height;
            group: root.group;
            o: self.opt;
            on: root.value == self.opt.v;
            enabled: root.enabled;
            picked => { root.picked(self.opt.v); }
        }
    }
    // The labels again, never drawn and squeezed to nothing: only their preferred width counts
    // (a pill is its label plus 12px on each side, as `SChoicePill`).
    Rectangle {
        x: 0px;
        y: 0px;
        width: 0px;
        height: 0px;
        visible: false;
        measure := HorizontalLayout {
            spacing: 6px;
            for o in root.options: HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                Text {
                    text: o.l;
                    font-size: Theme.font-body;
                    overflow: elide;
                    accessible-role: none;
                }
            }
        }
    }
    if !root.fits: VerticalLayout {
        spacing: 6px;
        alignment: start;
        for o in root.options: HorizontalLayout {
            alignment: Theme.rtl ? LayoutAlignment.end : LayoutAlignment.start;
            SChoicePill {
                c: root.c;
                height: root.pill-height;
                group: root.group;
                o: o;
                on: root.value == o.v;
                enabled: root.enabled;
                picked => { root.picked(o.v); }
            }
        }
    }
}

// A vertical list of choices (devices, accounts): one radio row each.
export component SRadio inherits Rectangle {
    in property <Tokens> c: Theme.content;
    in property <string> group;
    in property <string> label;
    in property <string> detail;
    in property <bool> checked;
    callback picked();
    // A Tab put the focus here: the ring shows (a click does not show it).
    property <bool> focus-visible: false;
    // The dot sits at the row's start edge, in line with the labels of the rows around it; the
    // label follows it (both mirrored in a right to left language).
    property <length> label-x: 16px + 10px;
    min-height: max(32px, rcol.preferred-height + 8px);
    border-radius: 4px;
    background: rt.has-hover ? root.c.surface-hover : transparent;
    accessible-role: radio-button;
    accessible-label: root.group + ": " + root.label;
    accessible-checked: root.checked;
    accessible-action-default => { root.picked(); }
    dot := Rectangle {
        x: Theme.rtl ? root.width - self.width : 0px;
        width: 16px;
        height: 16px;
        y: (parent.height - self.height) / 2;
        border-radius: 8px;
        border-width: 2px;
        border-color: root.checked ? root.c.accent : root.c.fg-muted;
        if root.checked: Rectangle { width: 8px; height: 8px; border-radius: 4px; background: root.c.accent; }
    }
    rcol := VerticalLayout {
        x: Theme.rtl ? 0px : root.label-x;
        width: max(0px, root.width - root.label-x);
        alignment: center;
        Text { horizontal-alignment: Theme.start-align; text: root.label; color: root.c.fg; font-size: Theme.font-body; wrap: word-wrap; }
        if root.detail != "": Text { horizontal-alignment: Theme.start-align; text: root.detail; color: root.c.fg-subtle; font-size: Theme.font-small; }
    }
    keys := FocusScope {
        width: 0px;
        height: 0px;
        focus-on-click: false;
        focus-changed-event(reason) => {
            root.focus-visible = self.has-focus && reason == FocusReason.tab-navigation;
        }
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) && !event.repeat {
                root.picked();
                return accept;
            }
            reject
        }
    }
    rt := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            keys.focus();
            root.focus-visible = false;
            root.picked();
        }
    }
    // Around the row, clear of the dot.
    if root.focus-visible: focus-ring := Rectangle {
        x: -6px;
        width: parent.width + 12px;
        border-radius: 4px;
        border-width: 2px;
        border-color: root.c.accent;
    }
}

// The sounds of one setting (ringtone, message sound, urgent sound): Teams' own, listed from the
// table the engine keeps, then IronTeams's and the others, one radio row each.
export component SRadioList inherits VerticalLayout {
    in property <Tokens> c: Theme.content;
    in property <string> label;
    in property <[SOption]> teams;
    in property <[SOption]> others;
    in property <string> value;
    callback picked(string);
    // Opened by a Find result: tells the page where this list is.
    Timer {
        running: root.label != "" && root.label == SettingsStore.target;
        interval: 60ms;
        triggered => {
            SettingsStore.target-y = root.absolute-position.y;
            SettingsStore.target = "";
        }
    }
    for o in root.teams: SRadio { c: root.c; group: root.label; label: o.l; checked: root.value == o.v; picked => { root.picked(o.v); } }
    for o in root.others: SRadio { c: root.c; group: root.label; label: o.l; checked: root.value == o.v; picked => { root.picked(o.v); } }
}

// The left list entry of the page.
export component SNavItem inherits Rectangle {
    in property <Tokens> c: Theme.content;
    in property <string> label;
    in property <image> icon;
    in property <bool> active;
    callback clicked();
    height: max(36px, nl.preferred-height + 14px);
    border-radius: 4px;
    background: root.active ? root.c.selected : (nt.has-hover ? root.c.surface-hover : transparent);
    accessible-role: tab;
    accessible-label: root.label;
    accessible-checked: root.active;
    accessible-action-default => { root.clicked(); }
    Rectangle {
        x: 0;
        width: 3px;
        height: 18px;
        border-radius: 2px;
        background: root.active ? root.c.accent : transparent;
    }
    HorizontalLayout {
        padding-left: 12px;
        spacing: 10px;
        Icon { c: root.c; source: root.icon; tint: root.active ? root.c.accent : root.c.fg-muted; width: 18px; height: 18px; y: (parent.height - 18px) / 2; }
        nl := Text { horizontal-alignment: Theme.start-align; text: root.label; color: root.active ? root.c.fg : root.c.fg-muted; font-size: Theme.font-body; font-weight: root.active ? 600 : 400; vertical-alignment: center; overflow: elide; }
    }
    nt := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}
