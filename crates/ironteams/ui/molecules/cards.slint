// Cards a message shows for a file, a Loop component and a Teams meeting link.
import { Fixed } from "../tokens/fixed.slint";
import { Theme } from "../tokens/theme.slint";
import { FileItem, Tokens } from "../tokens/types.slint";
import { Motion } from "../tokens/motion.slint";
import { Icon, IconButton } from "../atoms/widgets.slint";
import { MenuItem, MenuItemVariant } from "../atoms/menu.slint";
import { Button, ButtonVariant } from "../atoms/button.slint";

export component FileCard inherits Rectangle {
    in property <Tokens> c: Theme.content;
    in property <FileItem> f;
    callback open();
    // The "…" menu: download, copy, share or web (see `MediaCmd::FileCard`).
    callback action(string);
    height: 56px;
    border-radius: 4px;
    background: ta.has-hover ? root.c.surface-hover : root.c.panel;
    animate background { duration: Motion.quick; }
    border-width: 1px;
    border-color: root.c.border;
    HorizontalLayout {
        padding: 10px;
        padding-right: 44px;
        spacing: 10px;
        Rectangle {
            width: 36px;
            background: Fixed.white;
            border-radius: 2px;
            Text { text: root.f.ext; color: Fixed.ink; font-size: 10px * Theme.font-scale; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
        }
        VerticalLayout {
            alignment: center;
            Text { text: root.f.name; color: root.c.fg; font-size: 13px * Theme.font-scale; font-weight: 600; overflow: elide; }
            Text { text: root.f.detail != "" ? root.f.detail : @tr("Opens in the browser"); color: root.c.fg-muted; font-size: 11px * Theme.font-scale; overflow: elide; }
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        accessible-role: button;
        accessible-label: "Open " + root.f.name;
        accessible-action-default => { root.open(); }
        clicked => { root.open(); }
    }
    file-more := IconButton {
        c: root.c;
        x: parent.width - 38px;
        y: (parent.height - 28px) / 2;
        size: 28px;
        icon: @image-url("../icons/more.svg");
        tooltip: @tr("More options for {}", root.f.name);
        clicked => { file-menu.show(); }
    }
    file-menu := PopupWindow {
        x: parent.width - 200px;
        // Above the card when there is room (new messages sit at the bottom of the window).
        y: root.absolute-position.y > 240px ? -((root.f.place != "" ? 5 : 4) * 32px + 12px) : parent.height;
        width: 200px;
        height: file-items.preferred-height + 2px;
        close-policy: close-on-click-outside;
        Rectangle {
            background: root.c.surface;
            border-radius: 6px;
            border-width: 1px;
            border-color: root.c.border;
            drop-shadow-blur: 8px;
            drop-shadow-color: Fixed.black-80;
            file-items := VerticalLayout {
                padding: 4px;
                MenuItem { c: root.c; variant: MenuItemVariant.card; label: @tr("Open"); clicked => { file-menu.close(); root.open(); } }
                MenuItem { c: root.c; variant: MenuItemVariant.card; label: @tr("Download"); clicked => { file-menu.close(); root.action("download"); } }
                MenuItem { c: root.c; variant: MenuItemVariant.card; label: @tr("Copy link"); clicked => { file-menu.close(); root.action("copy"); } }
                MenuItem { c: root.c; variant: MenuItemVariant.card; label: @tr("Share"); clicked => { file-menu.close(); root.action("share"); } }
                MenuItem { c: root.c; variant: MenuItemVariant.card;
                    visible: root.f.place != "";
                    height: root.f.place != "" ? 32px : 0px;
                    label: @tr("Open in {}", root.f.place);
                    clicked => { file-menu.close(); root.action("web"); }
                }
            }
        }
    }
}

// A Loop component link, drawn as a card: the Loop mark, its title and "Open in Loop".
export component LoopCardView inherits Rectangle {
    in property <Tokens> c: Theme.content;
    in property <string> title;
    in property <string> url;
    callback open(string);
    height: 56px;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.c.border;
    background: loop-touch.has-hover ? root.c.surface-hover : root.c.panel;
    accessible-role: button;
    accessible-label: @tr("Open {} in Loop", root.title);
    accessible-action-default => { root.open(root.url); }
    HorizontalLayout {
        padding: 10px;
        spacing: 10px;
        Rectangle {
            width: 36px;
            border-radius: 6px;
            background: @linear-gradient(135deg, Fixed.loop-from 0%, Fixed.loop-to 100%);
            Text { text: "L"; color: Fixed.white; font-size: 18px * Theme.font-scale; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
        }
        VerticalLayout {
            alignment: center;
            Text { text: root.title; color: root.c.fg; font-size: 13px * Theme.font-scale; font-weight: 600; overflow: elide; }
            Text { text: @tr("Open in Loop"); color: root.c.accent; font-size: 11px * Theme.font-scale; overflow: elide; }
        }
    }
    loop-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.open(root.url); }
    }
}

// A Teams meeting link in a message, drawn as a compact card: "Meeting link" and a Join button
// that opens the pre-join screen for it.
export component MeetLinkCard inherits Rectangle {
    in property <Tokens> c: Theme.content;
    in property <string> url;
    callback join(string);
    height: 56px;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.c.border;
    background: root.c.panel;
    HorizontalLayout {
        padding: 10px;
        spacing: 10px;
        Rectangle {
            width: 36px;
            border-radius: 6px;
            background: root.c.accent-strong;
            Icon { c: root.c; source: @image-url("../icons/video.svg"); x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; width: 20px; height: 20px; tint: root.c.on-accent; }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text { text: @tr("Meeting link"); color: root.c.fg; font-size: 13px * Theme.font-scale; font-weight: 600; overflow: elide; }
            Text { text: @tr("Teams meeting"); color: root.c.fg-muted; font-size: 11px * Theme.font-scale; overflow: elide; }
        }
        Rectangle {
            width: join-label.preferred-width + 24px;
            border-radius: 4px;
            background: join-touch.has-hover ? root.c.accent : root.c.accent-strong;
            accessible-role: button;
            accessible-label: @tr("Join meeting");
            accessible-action-default => { root.join(root.url); }
            join-label := Text {
                text: @tr("Join");
                color: root.c.on-accent;
                font-size: 13px * Theme.font-scale;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
                accessible-role: none;
            }
            join-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.join(root.url); }
            }
        }
    }
}

// A theme someone sent as a share line: its name, the nav, content and accent colours it draws, and
// Preview, which opens the import preview with the line (nothing is saved until Save there).
export component ThemeChipCard inherits Rectangle {
    in property <Tokens> c: Theme.content;
    in property <string> name;
    in property <color> nav;
    in property <color> content;
    in property <color> accent;
    callback preview();
    height: 48px;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.c.border;
    background: root.c.panel;
    HorizontalLayout {
        padding: 10px;
        spacing: 10px;
        Rectangle {
            width: 60px;
            for sw[k] in [root.nav, root.content, root.accent]: Rectangle {
                x: k * 20px;
                y: (parent.height - self.height) / 2;
                width: 18px;
                height: 18px;
                border-radius: 4px;
                border-width: 1px;
                border-color: root.c.border;
                background: sw;
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text { text: root.name; color: root.c.fg; font-size: 13px * Theme.font-scale; font-weight: 600; overflow: elide; }
            Text { text: @tr("IronTeams theme"); color: root.c.fg-muted; font-size: 11px * Theme.font-scale; overflow: elide; }
        }
        Button { c: root.c; variant: ButtonVariant.settings; label: @tr("Preview"); clicked => { root.preview(); } }
    }
}
