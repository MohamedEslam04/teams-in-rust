// An "i" icon that explains a setting in a bubble to its left while the pointer is over it.
import { Theme } from "../tokens/theme.slint";
import { Icon } from "../atoms/widgets.slint";

export component InfoTip inherits Rectangle {
    in property <string> tip;
    width: 20px;
    height: 20px;
    accessible-role: text;
    accessible-label: root.tip;
    Icon {
        source: @image-url("../icons/info.svg");
        tint: touch.has-hover ? Theme.fg : Theme.fg-muted;
        width: 16px;
        height: 16px;
        x: 2px;
        y: 2px;
    }
    if touch.has-hover: Rectangle {
        z: 10;
        x: root.width - self.width;
        y: root.height + 4px;
        width: 210px;
        height: bubble.preferred-height + 16px;
        border-radius: 4px;
        border-width: 1px;
        border-color: Theme.border;
        background: Theme.surface;
        bubble := Text {
            x: 8px;
            y: 8px;
            width: parent.width - 16px;
            text: root.tip;
            color: Theme.fg;
            font-size: 12px * Theme.font-scale;
            wrap: word-wrap;
        }
    }
    touch := TouchArea { }
}
