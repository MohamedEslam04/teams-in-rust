// The message "…" menu (also opened by right click), like Teams.
import { Theme } from "../tokens/theme.slint";
import { Icon } from "../atoms/widgets.slint";
import { Motion } from "../tokens/motion.slint";
import { MenuItem, MenuItemVariant } from "menu.slint";

export component MessageMenu inherits Rectangle {
    in property <bool> mine;
    in property <bool> saved;
    // Pinning for everyone is a chat feature; channel posts use another endpoint.
    in property <bool> can-pin: true;
    // A channel post can be followed (replies to it show in Followed threads).
    in property <bool> can-follow: false;
    in property <bool> following: false;
    // Translation state of the message (`Msg.translate`).
    in property <string> translate: "";
    // Pinned for everyone: Unpin instead of Pin.
    in property <bool> pinned: false;
    // The links in the text (Open link, Copy link).
    in property <[string]> urls;
    // How many people have seen my message (`Msg.reader-list`): "Read by" shows when there are some.
    in property <int> reader-count: 0;
    // Opened from the Activity preview: only what works outside the open chat.
    in property <bool> preview: false;
    callback unpin();
    callback open-link(string);
    callback copy-link-url(string);
    callback immersive-reader();
    callback share-outlook();
    callback report();
    callback toggle-follow();
    callback translate-message();
    callback see-original();
    callback reply();
    callback forward-one();
    callback forward-many();
    callback copy-link();
    callback toggle-save();
    callback pin();
    callback mark-unread();
    callback show-readers();
    // "Remind me": 20m, 1h, 3h or tomorrow.
    callback remind(string);
    callback follow();
    callback edit();
    callback delete();
    // Esc.
    callback close();
    // Translation › Translation settings, and More actions › Create a task.
    callback translation-settings();
    callback create-task();
    property <bool> translation-open: false;
    property <bool> actions-open: false;

    // Whether the Forward entry shows its two choices.
    property <bool> forward-open: false;
    // Whether the Remind me entry shows its choices.
    property <bool> remind-open: false;
    // With several links, Open link and Copy link list them.
    property <bool> open-links: false;
    property <bool> copy-links: false;

    width: 240px;
    height: items.preferred-height + 12px;
    border-radius: 6px;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    drop-shadow-blur: 12px;
    drop-shadow-color: #00000090;
    // Fades in and grows from 0.97 (150 ms) each time it opens.
    property <bool> shown: Theme.reduced-motion;
    opacity: root.shown ? 1.0 : 0.0;
    transform-scale: root.shown ? 1.0 : Motion.pop-from;
    animate opacity { duration: Motion.fast; easing: ease-out; }
    animate transform-scale { duration: Motion.fast; easing: ease-out; }
    Timer {
        interval: 16ms;
        running: !root.shown;
        triggered => { root.shown = true; }
    }

    // Teams' letter shortcuts: R reply, F forward, S save, P pin, U mark as unread.
    FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if event.modifiers.control || event.modifiers.alt || event.modifiers.meta { return reject; }
            if event.text == Key.Escape { root.close(); return accept; }
            if event.text == "r" || event.text == "R" { root.reply(); return accept; }
            if event.text == "f" || event.text == "F" { root.forward-one(); return accept; }
            if (event.text == "s" || event.text == "S") && !root.mine { root.toggle-save(); return accept; }
            if (event.text == "p" || event.text == "P") && root.can-pin { if root.pinned { root.unpin(); } else { root.pin(); } return accept; }
            if (event.text == "u" || event.text == "U") && !root.preview { root.mark-unread(); return accept; }
            reject
        }
    }

    items := VerticalLayout {
        padding: 6px;
        spacing: 0px;
        if !root.preview: MenuItem { variant: MenuItemVariant.message; label: @tr("Reply with quote"); icon: @image-url("../icons/quote.svg"); clicked => { root.reply(); } }
        MenuItem { variant: MenuItemVariant.message; label: @tr("Forward"); icon: @image-url("../icons/forward.svg"); chevron: !root.preview; clicked => { if root.preview { root.forward-one(); } else { root.forward-open = !root.forward-open; } } }
        if root.forward-open: MenuItem { variant: MenuItemVariant.message; label: @tr("This message"); indent: true; clicked => { root.forward-one(); } }
        if root.forward-open: MenuItem { variant: MenuItemVariant.message; label: @tr("Multiple messages"); indent: true; clicked => { root.forward-many(); } }
        MenuItem { variant: MenuItemVariant.message; label: @tr("Copy message link"); icon: @image-url("../icons/link.svg"); clicked => { root.copy-link(); } }
        // A right click cannot tell which link was under the pointer, so every link is offered.
        if root.urls.length > 0: MenuItem { variant: MenuItemVariant.message;
            label: @tr("Open link");
            icon: @image-url("../icons/open.svg");
            chevron: root.urls.length > 1;
            clicked => { if root.urls.length == 1 { root.open-link(root.urls[0]); } else { root.open-links = !root.open-links; } }
        }
        if root.open-links: VerticalLayout { for u in root.urls: MenuItem { variant: MenuItemVariant.message; label: u; indent: true; clicked => { root.open-link(u); } } }
        if root.urls.length > 0: MenuItem { variant: MenuItemVariant.message;
            label: @tr("Copy link");
            icon: @image-url("../icons/copy.svg");
            chevron: root.urls.length > 1;
            clicked => { if root.urls.length == 1 { root.copy-link-url(root.urls[0]); } else { root.copy-links = !root.copy-links; } }
        }
        if root.copy-links: VerticalLayout { for u in root.urls: MenuItem { variant: MenuItemVariant.message; label: u; indent: true; clicked => { root.copy-link-url(u); } } }
        if !root.mine: MenuItem { variant: MenuItemVariant.message;
            label: root.saved ? @tr("Unsave this message") : @tr("Save this message");
            icon: @image-url("../icons/star.svg");
            clicked => { root.toggle-save(); }
        }
        if root.can-pin && !root.pinned: MenuItem { variant: MenuItemVariant.message; label: @tr("Pin for everyone"); icon: @image-url("../icons/pin.svg"); clicked => { root.pin(); } }
        if root.pinned: MenuItem { variant: MenuItemVariant.message; label: @tr("Unpin"); icon: @image-url("../icons/pin.svg"); clicked => { root.unpin(); } }
        if root.can-follow: MenuItem { variant: MenuItemVariant.message;
            label: root.following ? @tr("Unfollow thread") : @tr("Follow thread");
            icon: @image-url("../icons/thread.svg");
            clicked => { root.toggle-follow(); }
        }
        if !root.preview: MenuItem { variant: MenuItemVariant.message; label: @tr("Mark as unread"); icon: @image-url("../icons/unread.svg"); clicked => { root.mark-unread(); } }
        if root.mine && !root.preview && root.reader-count > 0: MenuItem { variant: MenuItemVariant.message; label: @tr("Read by"); icon: @image-url("../icons/eye.svg"); clicked => { root.show-readers(); } }
        MenuItem { variant: MenuItemVariant.message; label: @tr("Remind me"); icon: @image-url("../icons/history.svg"); chevron: true; clicked => { root.remind-open = !root.remind-open; } }
        if root.remind-open: MenuItem { variant: MenuItemVariant.message; label: @tr("In 20 minutes"); indent: true; clicked => { root.remind("20m"); } }
        if root.remind-open: MenuItem { variant: MenuItemVariant.message; label: @tr("In 1 hour"); indent: true; clicked => { root.remind("1h"); } }
        if root.remind-open: MenuItem { variant: MenuItemVariant.message; label: @tr("In 3 hours"); indent: true; clicked => { root.remind("3h"); } }
        if root.remind-open: MenuItem { variant: MenuItemVariant.message; label: @tr("Tomorrow at 9:00"); indent: true; clicked => { root.remind("tomorrow"); } }
        MenuItem { variant: MenuItemVariant.message; label: @tr("Immersive Reader"); icon: @image-url("../icons/eye.svg"); clicked => { root.immersive-reader(); } }
        MenuItem { variant: MenuItemVariant.message; label: @tr("Share to Outlook"); icon: @image-url("../icons/share.svg"); clicked => { root.share-outlook(); } }
        // Teams' "Translation ›": translate or show the original, and where the settings are.
        MenuItem { variant: MenuItemVariant.message; label: @tr("Translation"); icon: @image-url("../icons/translate.svg"); chevron: true; clicked => { root.translation-open = !root.translation-open; } }
        if root.translation-open && root.translate == "shown": MenuItem { variant: MenuItemVariant.message; label: @tr("See original"); indent: true; clicked => { root.see-original(); } }
        if root.translation-open && root.translate != "" && root.translate != "shown" && root.translate != "busy": MenuItem { variant: MenuItemVariant.message; label: @tr("Translate"); indent: true; clicked => { root.translate-message(); } }
        if root.translation-open: MenuItem { variant: MenuItemVariant.message; label: @tr("Translation settings"); indent: true; clicked => { root.translation-settings(); } }
        if !root.mine: MenuItem { variant: MenuItemVariant.message; label: @tr("Report this message"); icon: @image-url("../icons/info.svg"); clicked => { root.report(); } }
        // Teams' "More actions ›": a task from the message (To Do, through the Tasks app).
        MenuItem { variant: MenuItemVariant.message; label: @tr("More actions"); icon: @image-url("../icons/more.svg"); chevron: true; clicked => { root.actions-open = !root.actions-open; } }
        if root.actions-open: MenuItem { variant: MenuItemVariant.message; label: @tr("Create a task"); indent: true; clicked => { root.create-task(); } }
        if root.mine && !root.preview: MenuItem { variant: MenuItemVariant.message; label: @tr("Edit"); icon: @image-url("../icons/edit.svg"); clicked => { root.edit(); } }
        if root.mine && !root.preview: MenuItem { variant: MenuItemVariant.message; label: @tr("Delete"); icon: @image-url("../icons/trash.svg"); danger: true; clicked => { root.delete(); } }
    }
}
