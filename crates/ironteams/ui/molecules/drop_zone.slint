// What the chat shows while a file is dragged over the window: a tint, a dashed frame and
// "Drop to attach". It takes no events: the drag belongs to the window system, and the drop
// reaches the app through the window's own events. Slint has no dashed border, so the frame is
// drawn from short bars along each edge.
import { Theme } from "../tokens/theme.slint";

export component DropZone inherits Rectangle {
    // Bars of 10px with 8px between them.
    property <float> across: Math.floor((root.width - 16px) / 18px);
    property <float> down: Math.floor((root.height - 16px) / 18px);

    background: Theme.accent.with-alpha(0.14);

    frame := Rectangle {
        x: 8px;
        y: 8px;
        width: parent.width - 16px;
        height: parent.height - 16px;
        for i in root.across: Rectangle {
            x: i * 18px;
            y: 0px;
            width: 10px;
            height: 2px;
            background: Theme.accent;
        }
        for i in root.across: Rectangle {
            x: i * 18px;
            y: parent.height - 2px;
            width: 10px;
            height: 2px;
            background: Theme.accent;
        }
        for i in root.down: Rectangle {
            x: 0px;
            y: i * 18px;
            width: 2px;
            height: 10px;
            background: Theme.accent;
        }
        for i in root.down: Rectangle {
            x: parent.width - 2px;
            y: i * 18px;
            width: 2px;
            height: 10px;
            background: Theme.accent;
        }
    }

    Rectangle {
        width: label.preferred-width + 40px;
        height: 48px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: Theme.radius;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.accent;
        label := Text {
            width: parent.width;
            height: parent.height;
            text: @tr("Drop to attach");
            color: Theme.fg;
            font-size: 15px * Theme.font-scale;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
