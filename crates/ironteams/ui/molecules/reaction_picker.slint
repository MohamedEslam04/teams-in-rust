// "More reactions": a searchable emoji grid. The rows come from Rust (`reactions.rs`), which
// owns the Teams reaction keys.
import { Fixed } from "../tokens/fixed.slint";
import { Theme } from "../tokens/theme.slint";
import { EmojiItem, Tokens } from "../tokens/types.slint";
import { Icon } from "../atoms/widgets.slint";
import { Motion } from "../tokens/motion.slint";

export component ReactionPicker inherits Rectangle {
    in property <Tokens> c: Theme.content;
    in property <[EmojiItem]> items;
    in-out property <string> query;
    in-out property <int> focus-tick;
    callback search(string);
    callback pick(string);

    width: 308px;
    height: 300px;
    border-radius: 6px;
    background: root.c.surface;
    border-width: 1px;
    border-color: root.c.border;
    drop-shadow-blur: 12px;
    drop-shadow-color: Fixed.black-90;
    // Fades in and grows from 0.97 (150 ms) each time it opens.
    property <bool> shown: Theme.reduced-motion;
    opacity: root.shown ? 1.0 : 0.0;
    transform-scale: root.shown ? 1.0 : Motion.pop-from;
    animate opacity { duration: Motion.fast; easing: ease-out; }
    animate transform-scale { duration: Motion.fast; easing: ease-out; }
    Timer {
        interval: 16ms;
        running: !root.shown;
        triggered => { root.shown = true; }
    }

    VerticalLayout {
        padding: 8px;
        spacing: 8px;
        Rectangle {
            height: 32px;
            border-radius: 4px;
            background: root.c.panel;
            border-width: 1px;
            border-color: input.has-focus ? root.c.accent : root.c.border;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 6px;
                Icon { c: root.c; source: @image-url("../icons/search.svg"); width: 16px; height: 16px; y: 8px; }
                input := TextInput {
                    property <int> tick: root.focus-tick;
                    color: root.c.fg;
                    font-size: 13px * Theme.font-scale;
                    single-line: true;
                    vertical-alignment: center;
                    accessible-role: text-input;
                    accessible-placeholder-text: "Search reactions";
                    init => { self.focus(); }
                    changed tick => { self.focus(); }
                    edited => {
                        root.query = self.text;
                        root.search(self.text);
                    }
                }
            }
            if input.text == "": Text {
                x: 32px;
                text: "Search reactions";
                color: root.c.fg-subtle;
                font-size: 13px * Theme.font-scale;
                vertical-alignment: center;
            }
        }
        Flickable {
            content-height: grid.preferred-height;
            grid := GridLayout {
                spacing: 2px;
                for e[i] in root.items: Rectangle {
                    row: floor(i / 8);
                    col: mod(i, 8);
                    width: 34px;
                    height: 34px;
                    border-radius: 4px;
                    background: cell.has-hover ? root.c.surface-hover : transparent;
                    Text { text: e.emoji; font-size: 20px * Theme.font-scale; horizontal-alignment: center; vertical-alignment: center; }
                    cell := TouchArea {
                        mouse-cursor: pointer;
                        accessible-role: button;
                        accessible-label: e.name;
                        clicked => { root.pick(e.key); }
                    }
                }
            }
        }
        if root.items.length == 0: Text {
            text: "No reactions found";
            color: root.c.fg-subtle;
            font-size: 12px * Theme.font-scale;
            horizontal-alignment: center;
        }
    }
}
