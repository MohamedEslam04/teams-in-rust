// Live captions at the bottom of the call stage, as Teams shows them: the latest lines, each with
// the speaker's name in bold. Shown while captions are on (More › Show live captions).
import { Theme } from "../tokens/theme.slint";
import { Fixed } from "../tokens/fixed.slint";
import { CallStore, CallCaption } from "../stores/call_store.slint";

component CaptionLine inherits Rectangle {
    in property <CallCaption> c;
    accessible-role: text;
    accessible-label: root.c.speaker + ": " + root.c.text;
    min-height: row.preferred-height;
    row := HorizontalLayout {
        spacing: 8px;
        Text {
            text: root.c.speaker;
            color: Fixed.white;
            font-size: 14px * Theme.font-scale;
            font-weight: 700;
            overflow: elide;
            max-width: 200px;
            accessible-role: none;
        }
        Text {
            text: root.c.text;
            color: Fixed.white;
            font-size: 14px * Theme.font-scale;
            wrap: word-wrap;
            horizontal-stretch: 1;
            accessible-role: none;
        }
    }
}

export component CaptionStrip inherits Rectangle {
    height: lines.preferred-height;
    border-radius: 6px;
    background: Fixed.black-c0;
    lines := VerticalLayout {
        padding: 10px;
        padding-left: 14px;
        padding-right: 14px;
        spacing: 4px;
        if CallStore.caption-lines.length == 0: Text {
            text: "Waiting for someone to speak…";
            color: Fixed.white-b0;
            font-size: 13px * Theme.font-scale;
        }
        for c in CallStore.caption-lines: CaptionLine { c: c; }
    }
}
