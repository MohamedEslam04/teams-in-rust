// The spacing scale: every gap and padding of a screen built on it is one of these steps, so
// related things sit closer together than unrelated ones (Settings is the first user).
export global Space {
    out property <length> xxs: 2px;
    out property <length> xs: 4px;
    out property <length> s: 8px;
    out property <length> m: 12px;
    out property <length> l: 16px;
    out property <length> xl: 24px;
    out property <length> xxl: 32px;
}
