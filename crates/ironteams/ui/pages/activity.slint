// The Activity view: the notification feed on the left, a preview of the source message on the right.
import { ListView, ScrollView } from "std-widgets.slint";
import { Theme } from "../tokens/theme.slint";
import { ActivityRow, Msg } from "../tokens/types.slint";
import { Icon, IconButton } from "../atoms/widgets.slint";
import { Pill } from "../atoms/chip.slint";
import { Avatar } from "../atoms/avatar.slint";
import { MessageRow } from "../organisms/message_row.slint";
import { DirectCallStore } from "../organisms/call_incoming.slint";
import { PersonHover } from "../molecules/people.slint";
import { SkeletonList, Spinner } from "../tokens/motion.slint";

component MenuEntry inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    callback activated();
    height: 34px;
    background: t.has-hover ? Theme.surface-hover : transparent;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 16px;
        Text { text: root.label; color: Theme.fg; font-size: 13px * Theme.font-scale; vertical-alignment: center; }
        Rectangle { horizontal-stretch: 1; }
        Text { text: root.hint; color: Theme.fg-subtle; font-size: 11px * Theme.font-scale; vertical-alignment: center; }
    }
    t := TouchArea { mouse-cursor: pointer; clicked => { root.activated(); } }
}

component ActivityItem inherits Rectangle {
    in property <ActivityRow> data;
    in property <bool> selected;
    callback clicked();
    callback toggle-read();
    // A missed call's inline buttons.
    callback call-back();
    callback open-chat();
    property <length> menu-x;
    property <length> menu-y;
    // The pointer is on the actor's photo, which sits above the row's TouchArea: the row keeps
    // its highlight.
    property <bool> photo-over;
    height: 76px;
    border-radius: 4px;
    background: root.selected ? Theme.selected : (touch.has-hover || (root.photo-over && root.data.person != "") ? Theme.surface-hover : transparent);
    accessible-role: list-item;
    accessible-label: root.data.title + (root.data.unread ? ", unread" : "");
    accessible-item-selected: root.selected;
    accessible-description: root.data.preview + " · " + root.data.location;

    HorizontalLayout {
        padding-left: 12px;
        // Room for a missed call's Call and Chat buttons.
        padding-right: root.data.call-mri != "" ? 130px : 10px;
        spacing: 10px;
        Rectangle {
            width: 40px;
            Avatar {
                y: (parent.height - 36px) / 2;
                initials: root.data.initials;
                tone: root.data.color;
                img: root.data.avatar;
                has-img: root.data.has-avatar;
                size: 36px;
            }
            Rectangle {
                x: 22px;
                y: (parent.height - 36px) / 2 + 20px;
                width: 20px;
                height: 20px;
                border-radius: 10px;
                background: Theme.sidebar;
                border-width: 1px;
                border-color: Theme.border;
                Text { text: root.data.badge; color: Theme.mention; font-size: 11px * Theme.font-scale; horizontal-alignment: center; vertical-alignment: center; }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: root.data.title;
                    color: Theme.fg;
                    font-size: 14px * Theme.font-scale;
                    font-weight: root.data.unread ? 700 : 400;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                Text { text: root.data.time; color: Theme.fg-subtle; font-size: 11px * Theme.font-scale; horizontal-stretch: 0; vertical-alignment: center; }
            }
            Text {
                text: root.data.preview;
                color: root.data.unread ? Theme.fg : Theme.fg-subtle;
                font-weight: root.data.unread ? 600 : 400;
                font-size: 12px * Theme.font-scale;
                overflow: elide;
                horizontal-alignment: root.data.rtl-preview ? right : left;
            }
            Text { text: root.data.location; color: Theme.fg-subtle; font-size: 11px * Theme.font-scale; overflow: elide; }
        }
        if root.data.unread: Rectangle {
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: Theme.accent;
            y: (parent.height - 8px) / 2;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        pointer-event(e) => {
            if e.button == PointerEventButton.right && e.kind == PointerEventKind.up {
                root.menu-x = touch.mouse-x;
                root.menu-y = touch.mouse-y;
                menu.show();
            }
        }
    }

    // The photo opens the actor's card on hover; a click still opens the item (above the row's
    // own click area, which would otherwise take the pointer from the photo).
    if root.data.person != "": photo-hover := PersonHover {
        x: 12px;
        y: (root.height - 36px) / 2;
        width: 36px;
        height: 36px;
        person: root.data.person;
        click-opens: false;
        over <=> root.photo-over;
        activated => { root.clicked(); }
    }

    // A missed call: call back or open the chat from the row, as Teams does (above the row's
    // own click area).
    if root.data.call-mri != "": HorizontalLayout {
        x: root.width - 126px;
        y: (root.height - 26px) / 2;
        width: 118px;
        height: 26px;
        spacing: 6px;
        Pill { label: @tr("Call"); clicked => { root.call-back(); } }
        Pill { label: @tr("Chat"); clicked => { root.open-chat(); } }
    }

    menu := PopupWindow {
        x: root.menu-x;
        y: root.menu-y;
        width: 190px;
        height: 36px;
        Rectangle {
            background: Theme.surface;
            border-radius: 4px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 6px;
            drop-shadow-color: #00000080;
            toggle := MenuEntry {
                y: 1px;
                label: root.data.unread ? "Mark as read" : "Mark as unread";
                activated => { root.toggle-read(); menu.close(); }
            }
        }
    }
}

component PreviewList inherits Rectangle {
    in property <[Msg]> messages;
    in property <string> highlight;
    in property <string> key;          // changes with every new preview
    callback open-url(string);
    // Reactions and the "…" menu of a preview row (window coordinates).
    callback react(string, string);
    callback more-reactions(string, length, length);
    callback menu(Msg, length, length);

    // The backend sends a short window with the source a few rows from the top, so a new
    // preview only has to start at the top.
    changed key => { pv.content-y = 0px; }

    pv := ScrollView {
        VerticalLayout {
            alignment: start;
            for m in root.messages: hl-row := Rectangle {
                property <bool> hl: m.id == root.highlight;
                height: mr.height;
                background: self.hl ? #23253f : transparent;
                if self.hl: hl-marker := Rectangle { x: 0; width: 3px; background: Theme.accent; }
                mr := MessageRow {
                    width: parent.width;
                    m: m;
                    max-bubble: min(720px, pv.width * 0.8);
                    open-url(u) => { root.open-url(u); }
                    react(k) => { root.react(m.id, k); }
                    more-reactions(x, y) => { root.more-reactions(m.id, x, y); }
                    menu(x, y) => { root.menu(m, x, y); }
                }
            }
        }
    }
}

export component ActivityView inherits Rectangle {
    in property <[ActivityRow]> items;
    in property <int> unread-count;
    in-out property <string> filter: "all"; // all | unread | mentions | tags
    in-out property <string> selected-id;
    in property <string> preview-id;
    in property <string> preview-title;
    in property <string> preview-location;
    in property <bool> preview-is-channel;
    in property <bool> preview-loading;
    // The first sync has not finished: the feed may still be empty because it is being read.
    in property <bool> loading;
    in property <[Msg]> preview;
    in property <string> highlight;
    in property <string> banner;
    in-out property <string> reply-text;

    callback select(string);
    callback set-filter(string);
    callback search(string);
    callback mark(string, bool);
    callback mark-all();
    callback go-to();
    callback send-reply(string);
    callback open-url(string);
    callback react(string, string);
    callback more-reactions(string, length, length);
    callback menu(Msg, length, length);
    callback notification-settings();
    callback open-later();
    callback dismiss-banner();

    background: Theme.main;

    function toggle-filter(f: string) {
        root.filter = root.filter == f ? "all" : f;
        root.set-filter(root.filter);
    }

    function reply-now() {
        if root.reply-text != "" {
            root.send-reply(root.reply-text);
            root.reply-text = "";
        }
    }

    // Covers the chat view underneath: clicks must not reach it.
    TouchArea { }

    scope := FocusScope {
        init => { self.focus(); }
        key-pressed(e) => {
            if e.modifiers.shift && e.text == Key.Escape {
                root.mark-all();
                return accept;
            }
            if e.modifiers.control && e.modifiers.alt {
                if e.text == "u" || e.text == "U" {
                    root.toggle-filter("unread");
                    return accept;
                }
                if e.text == "m" || e.text == "M" {
                    root.toggle-filter("mentions");
                    return accept;
                }
            }
            reject
        }

        HorizontalLayout {
            // The feed
            Rectangle {
                width: 380px;
                background: Theme.sidebar;
                VerticalLayout {
                    HorizontalLayout {
                        height: 56px;
                        padding-left: 16px;
                        padding-right: 12px;
                        Text { text: "Activity"; color: Theme.fg; font-size: 20px * Theme.font-scale; font-weight: 700; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        // Reminders and saved messages in one list.
                        VerticalLayout {
                            alignment: center;
                            Pill { label: @tr("Later"); clicked => { root.open-later(); } }
                        }
                        Rectangle { width: 6px; }
                        more := IconButton {
                            icon: @image-url("../icons/more.svg");
                            y: 12px;
                            clicked => { more-menu.show(); }
                        }
                    }

                    Rectangle {
                        height: 32px;
                        border-radius: 4px;
                        background: search-input.has-focus ? Theme.sidebar : Theme.surface;
                        border-width: 1px;
                        border-color: search-input.has-focus ? Theme.accent : Theme.border;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 8px;
                            Icon { source: @image-url("../icons/search.svg"); width: 16px; height: 16px; y: 8px; }
                            search-input := TextInput {
                                color: Theme.fg;
                                font-size: 13px * Theme.font-scale;
                                vertical-alignment: center;
                                single-line: true;
                                accessible-label: "Search activity";
                                edited => { root.search(self.text); }
                            }
                        }
                        if search-input.text == "": Text {
                            x: 36px;
                            text: "Search activity";
                            color: Theme.fg-subtle;
                            font-size: 13px * Theme.font-scale;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle { height: 8px; }

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-bottom: 8px;
                        spacing: 6px;
                        alignment: start;
                        f-unread := Pill { label: "Unread"; active: root.filter == "unread"; clicked => { root.toggle-filter("unread"); } }
                        f-mentions := Pill { label: "@Mentions"; active: root.filter == "mentions"; clicked => { root.toggle-filter("mentions"); } }
                        f-tags := Pill { label: "Tag mentions"; active: root.filter == "tags"; clicked => { root.toggle-filter("tags"); } }
                    }
                    Rectangle { height: 1px; background: Theme.border; }

                    if root.banner != "": Rectangle {
                        height: 34px;
                        background: #3b1f22;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 6px;
                            spacing: 8px;
                            Text { text: root.banner; color: #ffffff; font-size: 12px * Theme.font-scale; vertical-alignment: center; overflow: elide; }
                            IconButton { icon: @image-url("../icons/close.svg"); size: 24px; y: 5px; clicked => { root.dismiss-banner(); } }
                        }
                    }

                    Rectangle {
                        vertical-stretch: 1;
                        ListView {
                            for r in root.items: ActivityItem {
                                data: r;
                                selected: r.id == root.selected-id;
                                clicked => {
                                    root.selected-id = r.id;
                                    root.select(r.id);
                                    scope.focus();
                                }
                                toggle-read => { root.mark(r.id, r.unread); }
                                call-back => { DirectCallStore.command("dial-person", r.call-mri); }
                                open-chat => {
                                    root.selected-id = r.id;
                                    root.select(r.id);
                                    root.go-to();
                                }
                            }
                        }
                        if root.items.length == 0 && root.loading: SkeletonList { count: 8; label: "Loading activity"; }
                        if root.items.length == 0 && !root.loading: Text {
                            text: root.filter == "all" && search-input.text == "" ? "No activity yet" : "Nothing matches";
                            color: Theme.fg-subtle;
                            font-size: 13px * Theme.font-scale;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // The preview
            Rectangle {
                horizontal-stretch: 1;
                background: Theme.main;
                if root.selected-id == "": VerticalLayout {
                    alignment: center;
                    Image { source: @image-url("../icons/activity.svg"); colorize: Theme.border; width: 96px; height: 96px; x: (parent.width - 96px) / 2; }
                    Text { text: "Select an item to preview it"; color: Theme.fg-subtle; horizontal-alignment: center; }
                }
                if root.selected-id != "": VerticalLayout {
                    Rectangle {
                        height: 64px;
                        background: Theme.sidebar;
                        HorizontalLayout {
                            padding-left: 20px;
                            padding-right: 16px;
                            spacing: 12px;
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Text { text: root.preview-title; color: Theme.fg; font-size: 16px * Theme.font-scale; font-weight: 700; overflow: elide; }
                                Text { text: root.preview-location; color: Theme.fg-muted; font-size: 12px * Theme.font-scale; overflow: elide; }
                            }
                            go := Rectangle {
                                width: go-text.preferred-width + 28px;
                                height: 30px;
                                y: 17px;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: Theme.accent;
                                background: go-touch.has-hover ? #3b3d6b : transparent;
                                go-text := Text {
                                    text: root.preview-is-channel ? "Go to channel" : "Go to chat";
                                    color: Theme.fg;
                                    font-size: 12px * Theme.font-scale;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                go-touch := TouchArea { mouse-cursor: pointer; clicked => { root.go-to(); } }
                            }
                        }
                        Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
                    }

                    Rectangle {
                        vertical-stretch: 1;
                        PreviewList {
                            messages: root.preview;
                            highlight: root.highlight;
                            key: root.preview-id;
                            open-url(u) => { root.open-url(u); }
                            react(id, k) => { root.react(id, k); }
                            more-reactions(id, x, y) => { root.more-reactions(id, x, y); }
                            menu(m, x, y) => { root.menu(m, x, y); }
                        }
                        if root.preview-loading || (root.preview-id != root.selected-id && root.preview.length == 0): Rectangle {
                            accessible-role: text;
                            accessible-label: "Loading";
                            Spinner { size: 22px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                        }
                    }

                    // Reply in place: in the post's thread for a channel, in the chat otherwise.
                    Rectangle {
                        height: 56px;
                        background: Theme.sidebar;
                        HorizontalLayout {
                            padding: 10px;
                            spacing: 8px;
                            Rectangle {
                                horizontal-stretch: 1;
                                border-radius: 4px;
                                background: Theme.surface;
                                border-width: 1px;
                                border-color: reply-input.has-focus ? Theme.accent : Theme.border;
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    reply-input := TextInput {
                                        text <=> root.reply-text;
                                        color: Theme.fg;
                                        font-size: 13px * Theme.font-scale;
                                        vertical-alignment: center;
                                        single-line: true;
                                        accessible-label: root.preview-is-channel ? "Reply in thread" : "Reply";
                                        accepted => { root.reply-now(); }
                                    }
                                }
                                if reply-input.text == "": Text {
                                    x: 10px;
                                    text: root.preview-is-channel ? "Reply in thread" : "Reply";
                                    color: Theme.fg-subtle;
                                    font-size: 13px * Theme.font-scale;
                                    vertical-alignment: center;
                                }
                            }
                            reply-send := IconButton {
                                icon: @image-url("../icons/send.svg");
                                tint: Theme.accent;
                                y: 4px;
                                clicked => { root.reply-now(); }
                            }
                        }
                    }
                }
            }
        }
    }

    more-menu := PopupWindow {
        x: 122px;
        y: 52px;
        width: 250px;
        height: 70px;
        Rectangle {
            background: Theme.surface;
            border-radius: 4px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 6px;
            drop-shadow-color: #00000080;
            VerticalLayout {
                padding-top: 1px;
                mark-all-entry := MenuEntry {
                    label: "Mark all as read";
                    hint: "Shift+Esc";
                    activated => { root.mark-all(); more-menu.close(); }
                }
                settings-entry := MenuEntry {
                    label: "Notification settings";
                    activated => { root.notification-settings(); more-menu.close(); }
                }
            }
        }
    }
}
