// OneNote (notebooks, sections, pages and a page's text; New page adds a page to the open
// section) and Lists (SharePoint lists: columns and items; New item and a row's Edit button).
// A OneNote page's content is edited in OneNote.
import { ScrollView } from "std-widgets.slint";
import { Theme } from "../tokens/theme.slint";
import { IconButton } from "../atoms/widgets.slint";
import { NotesStore, ListsStore, AppRow } from "../stores/apps_store.slint";
import { KitNote } from "../molecules/apps_kit.slint";
import { Button, ButtonVariant } from "../atoms/button.slint";

// A column of selectable rows (notebooks, sections, pages, sites, lists).
component PickColumn inherits Rectangle {
    in property <string> title;
    in property <[AppRow]> rows;
    in property <length> col-width: 220px;
    callback picked(string);
    width: root.col-width;
    background: Theme.sidebar;
    VerticalLayout {
        Rectangle { height: 34px; Text { x: 14px; width: parent.width - 28px; text: root.title; color: Theme.fg-subtle; font-size: 11px * Theme.font-scale; font-weight: 700; vertical-alignment: bottom; } }
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                width: parent.width - 12px;
                padding: 8px;
                spacing: 2px;
                alignment: start;
                for r in root.rows: Rectangle {
                    height: r.subtitle != "" ? 46px : 34px;
                    border-radius: 4px;
                    background: r.selected ? Theme.selected : (t.has-hover ? Theme.surface-hover : transparent);
                    accessible-role: button;
                    accessible-label: r.title;
                    accessible-description: r.subtitle;
                    accessible-item-selected: r.selected;
                    Rectangle { x: 0; y: 7px; width: 3px; height: parent.height - 14px; border-radius: 2px; background: r.selected ? Theme.accent : transparent; }
                    VerticalLayout {
                        padding-left: 14px;
                        padding-right: 8px;
                        alignment: center;
                        Text { text: r.title; color: Theme.fg; font-size: 13px * Theme.font-scale; font-weight: r.selected ? 600 : 400; overflow: elide; }
                        if r.subtitle != "": Text { text: r.subtitle; color: Theme.fg-subtle; font-size: 11px * Theme.font-scale; overflow: elide; }
                    }
                    t := TouchArea { mouse-cursor: pointer; clicked => { root.picked(r.id); } }
                }
            }
        }
    }
}

export component NotesView inherits Rectangle {
    background: Theme.main;
    init => { NotesStore.command("notes-enter", ""); }
    HorizontalLayout {
        PickColumn { title: "NOTEBOOKS"; rows: NotesStore.notebooks; picked(id) => { NotesStore.command("notes-notebook", id); } }
        Rectangle { width: 1px; background: Theme.border; }
        PickColumn { title: "SECTIONS"; rows: NotesStore.sections; picked(id) => { NotesStore.command("notes-section", id); } }
        Rectangle { width: 1px; background: Theme.border; }
        PickColumn { title: "PAGES"; rows: NotesStore.pages; picked(id) => { NotesStore.command("notes-page", id); } }
        VerticalLayout {
            horizontal-stretch: 1;
            Rectangle {
                height: 56px;
                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 16px;
                    spacing: 8px;
                    Text { text: NotesStore.page-title == "" ? "OneNote" : NotesStore.page-title; color: Theme.fg; font-size: 18px * Theme.font-scale; font-weight: 700; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                    Button { variant: ButtonVariant.kit; y: 12px; label: "New page"; primary: true; enabled: NotesStore.can-new-page; clicked => { NotesStore.command("page-new", ""); } }
                    Button { variant: ButtonVariant.kit; y: 12px; label: "Open in OneNote on the web"; enabled: NotesStore.can-open-web; clicked => { NotesStore.command("notes-open-web", ""); } }
                }
            }
            if NotesStore.loading: KitNote { text: "Loading…"; busy: true; }
            if NotesStore.status != "": KitNote { text: NotesStore.status; }
            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    width: parent.width - 12px;
                    padding: 20px;
                    alignment: start;
                    Text { text: NotesStore.page-text; color: Theme.fg; font-size: 14px * Theme.font-scale; wrap: word-wrap; }
                }
            }
            KitNote { text: "New page adds a page with a title and a first line. Edit a page's content in OneNote."; text-size: 11px; }
        }
    }
}

export component ListsView inherits Rectangle {
    background: Theme.main;
    init => { ListsStore.command("lists-enter", ""); }
    property <length> cell: 170px;
    // Room for the Edit button at the start of an item's row.
    property <length> edit-col: 36px;
    HorizontalLayout {
        PickColumn { title: "SITES"; rows: ListsStore.sites; picked(id) => { ListsStore.command("lists-site", id); } }
        Rectangle { width: 1px; background: Theme.border; }
        PickColumn { title: "LISTS"; rows: ListsStore.lists; picked(id) => { ListsStore.command("lists-list", id); } }
        VerticalLayout {
            horizontal-stretch: 1;
            Rectangle {
                height: 56px;
                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 16px;
                    spacing: 8px;
                    Text { text: ListsStore.title == "" ? "Lists" : ListsStore.title; color: Theme.fg; font-size: 18px * Theme.font-scale; font-weight: 700; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                    Button { variant: ButtonVariant.kit; y: 12px; label: "New item"; primary: true; enabled: ListsStore.can-edit; clicked => { ListsStore.command("item-new", ""); } }
                }
            }
            if ListsStore.loading: KitNote { text: "Loading…"; busy: true; }
            if ListsStore.status != "": KitNote { text: ListsStore.status; }
            if ListsStore.columns.length > 0: Rectangle {
                height: 32px;
                background: Theme.sidebar;
                HorizontalLayout {
                    padding-left: 20px + root.edit-col;
                    spacing: 8px;
                    for c in ListsStore.columns: Text { text: c; color: Theme.fg-muted; font-size: 12px * Theme.font-scale; font-weight: 700; width: root.cell; vertical-alignment: center; overflow: elide; }
                }
            }
            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    width: parent.width - 12px;
                    alignment: start;
                    for row in ListsStore.items: Rectangle {
                        height: 36px;
                        background: hover.has-hover ? Theme.surface-hover : transparent;
                        accessible-role: list-item;
                        accessible-label: row.cells.length > 0 ? row.cells[0] : "";
                        hover := TouchArea { }
                        HorizontalLayout {
                            padding-left: 20px;
                            spacing: 8px;
                            Rectangle {
                                width: root.edit-col - 8px;
                                if ListsStore.can-edit: IconButton {
                                    y: 4px;
                                    size: 28px;
                                    icon: @image-url("../icons/edit.svg");
                                    tooltip: "Edit " + (row.cells.length > 0 ? row.cells[0] : "item");
                                    clicked => { ListsStore.command("item-edit", row.id); }
                                }
                            }
                            for cell in row.cells: Text { text: cell; color: Theme.fg; font-size: 13px * Theme.font-scale; width: root.cell; vertical-alignment: center; overflow: elide; }
                        }
                    }
                }
            }
            KitNote { text: "New item and Edit fill in the first columns. Delete items in Lists on the web."; text-size: 11px; }
        }
    }
}
