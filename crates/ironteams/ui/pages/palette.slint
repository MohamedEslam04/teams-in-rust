// The command palette (Ctrl+Shift+P): a search box over every action of the app and the chat
// list. Which entries show and in which order is decided in Rust (src/ui/palette.rs); running one
// calls the same callbacks and store commands as the rail, the shortcuts and Settings
// (`run-palette` in app.slint).
import { Theme } from "../tokens/theme.slint";
import { ChatRow } from "../tokens/types.slint";
import { Icon } from "../atoms/widgets.slint";
import { Avatar } from "../atoms/avatar.slint";
import { ListStore, SectionRow } from "../organisms/lists.slint";
import { CallsPageStore } from "../stores/calls_page_store.slint";
import { PaletteStore } from "../stores/palette_store.slint";
export { PaletteStore } from "../stores/palette_store.slint";

// One action of the catalog. `cmd` and `arg` tell `run-palette` what to do (the id is the key of
// the recent-actions list), `keys` is the chord shown on the right, `hidden` drops the entry.
export struct PaletteAction { id: string, cmd: string, arg: string, label: string, keys: string, icon: image, hidden: bool }
// A row of the result list. `kind` is action | chat; `section` is recent | actions | chats.
// `head`: a section heading sits above the row; `top` and `height` (px) place the row in the list.
export struct PaletteItem { id: string, cmd: string, arg: string, label: string, keys: string, kind: string, section: string, icon: image, has-icon: bool, initials: string, color: color, head: bool, top: int, height: int }

export global PaletteApi {
    // query, the catalog, the chat list (favorites, chats, channels, custom sections), recents -> rows
    pure callback results(string, [PaletteAction], [ChatRow], [ChatRow], [ChatRow], [SectionRow], string) -> [PaletteItem];
    // recents, the action just run -> recents
    pure callback push-recent(string, string) -> string;
}

export global PaletteCatalog {
    out property <[PaletteAction]> actions: [
        { id: "go-activity", cmd: "go", arg: "activity", label: @tr("Go to Activity"), keys: "", icon: @image-url("../icons/activity.svg"), hidden: false },
        { id: "go-chat", cmd: "go", arg: "chat", label: @tr("Go to Chat"), keys: "", icon: @image-url("../icons/chat.svg"), hidden: false },
        { id: "go-teams", cmd: "go", arg: "teams", label: @tr("Go to Teams"), keys: "", icon: @image-url("../icons/teams.svg"), hidden: false },
        { id: "go-calendar", cmd: "go", arg: "calendar", label: @tr("Go to Calendar"), keys: "", icon: @image-url("../icons/calendar.svg"), hidden: false },
        { id: "go-calls", cmd: "go", arg: "calls", label: @tr("Go to Calls"), keys: "", icon: @image-url("../icons/call-direct.svg"), hidden: !CallsPageStore.available },
        { id: "go-onedrive", cmd: "go", arg: "onedrive", label: @tr("Go to OneDrive"), keys: "", icon: @image-url("../icons/cloud.svg"), hidden: false },
        { id: "new-chat", cmd: "new-chat", arg: "", label: @tr("New chat"), keys: "Alt+Shift+N", icon: @image-url("../icons/compose.svg"), hidden: false },
        { id: "search", cmd: "search", arg: "", label: @tr("Search"), keys: "Ctrl+Alt+E", icon: @image-url("../icons/search.svg"), hidden: false },
        { id: "goto", cmd: "goto", arg: "", label: @tr("Go to a chat or channel"), keys: "Ctrl+Alt+G", icon: @image-url("../icons/hash.svg"), hidden: false },
        { id: "next-unread", cmd: "next-unread", arg: "", label: @tr("Next unread chat"), keys: "Alt+Shift+Down", icon: @image-url("../icons/chat.svg"), hidden: false },
        { id: "previous-unread", cmd: "previous-unread", arg: "", label: @tr("Previous unread chat"), keys: "Alt+Shift+Up", icon: @image-url("../icons/chat.svg"), hidden: false },
        { id: "mark-all-read", cmd: "mark-all-read", arg: "", label: @tr("Mark all as read"), keys: "Shift+Esc", icon: @image-url("../icons/check.svg"), hidden: false },
        { id: "settings", cmd: "settings", arg: "general", label: @tr("Open Settings"), keys: "Ctrl+Shift+,", icon: @image-url("../icons/settings.svg"), hidden: false },
        { id: "settings-general", cmd: "settings", arg: "general", label: @tr("Settings") + ": " + @tr("General"), keys: "", icon: @image-url("../icons/settings.svg"), hidden: false },
        { id: "settings-accounts", cmd: "settings", arg: "accounts", label: @tr("Settings") + ": " + @tr("Accounts and orgs"), keys: "", icon: @image-url("../icons/settings.svg"), hidden: false },
        { id: "settings-privacy", cmd: "settings", arg: "privacy", label: @tr("Settings") + ": " + @tr("Privacy"), keys: "", icon: @image-url("../icons/settings.svg"), hidden: false },
        { id: "settings-notifications", cmd: "settings", arg: "notifications", label: @tr("Settings") + ": " + @tr("Notifications and activity"), keys: "", icon: @image-url("../icons/settings.svg"), hidden: false },
        { id: "settings-appearance", cmd: "settings", arg: "appearance", label: @tr("Settings") + ": " + @tr("Appearance"), keys: "", icon: @image-url("../icons/settings.svg"), hidden: false },
        { id: "settings-accessibility", cmd: "settings", arg: "accessibility", label: @tr("Settings") + ": " + @tr("Accessibility"), keys: "", icon: @image-url("../icons/settings.svg"), hidden: false },
        { id: "settings-devices", cmd: "settings", arg: "devices", label: @tr("Settings") + ": " + @tr("Devices"), keys: "", icon: @image-url("../icons/settings.svg"), hidden: false },
        { id: "settings-files", cmd: "settings", arg: "files", label: @tr("Settings") + ": " + @tr("Files and links"), keys: "", icon: @image-url("../icons/settings.svg"), hidden: false },
        { id: "settings-permissions", cmd: "settings", arg: "permissions", label: @tr("Settings") + ": " + @tr("App permissions"), keys: "", icon: @image-url("../icons/settings.svg"), hidden: false },
        { id: "settings-about", cmd: "settings", arg: "about", label: @tr("Settings") + ": " + @tr("About"), keys: "", icon: @image-url("../icons/settings.svg"), hidden: false },
        { id: "toggle-theme", cmd: "toggle-theme", arg: "", label: @tr("Toggle dark/light theme"), keys: "", icon: @image-url("../icons/eye.svg"), hidden: false },
        { id: "shortcuts", cmd: "shortcuts", arg: "", label: @tr("Keyboard shortcuts"), keys: "Ctrl+.", icon: @image-url("../icons/shortcut.svg"), hidden: false },
        { id: "report-problem", cmd: "report-problem", arg: "", label: @tr("Report a problem"), keys: "", icon: @image-url("../icons/info.svg"), hidden: false },
        { id: "status-available", cmd: "status", arg: "Available", label: @tr("Set status") + ": " + @tr("Available"), keys: "", icon: @image-url("../icons/people.svg"), hidden: false },
        { id: "status-busy", cmd: "status", arg: "Busy", label: @tr("Set status") + ": " + @tr("Busy"), keys: "", icon: @image-url("../icons/people.svg"), hidden: false },
        { id: "status-dnd", cmd: "status", arg: "DoNotDisturb", label: @tr("Set status") + ": " + @tr("Do not disturb"), keys: "", icon: @image-url("../icons/people.svg"), hidden: false },
        { id: "status-brb", cmd: "status", arg: "BeRightBack", label: @tr("Set status") + ": " + @tr("Be right back"), keys: "", icon: @image-url("../icons/people.svg"), hidden: false },
        { id: "status-away", cmd: "status", arg: "Away", label: @tr("Set status") + ": " + @tr("Appear away"), keys: "", icon: @image-url("../icons/people.svg"), hidden: false },
        { id: "status-reset", cmd: "status", arg: "", label: @tr("Reset status"), keys: "", icon: @image-url("../icons/people.svg"), hidden: false },
        { id: "sign-out", cmd: "sign-out", arg: "", label: @tr("Sign out"), keys: "", icon: @image-url("../icons/lock.svg"), hidden: false },
    ];
}

export component CommandPalette inherits Rectangle {
    // The chat list, for the "chats and channels" part of the results.
    in property <[ChatRow]> chats-favorites;
    in property <[ChatRow]> chats-main;
    in property <[ChatRow]> chats-channels;
    callback run(PaletteItem);
    callback close();

    // Scrolls the list so row `index` shows (rows are placed by Rust, see `build`).
    function reveal(index: int) {
        if root.results[index].top * 1px + root.results[index].height * 1px + 6px + list.content-y > list.height {
            list.content-y = list.height - root.results[index].top * 1px - root.results[index].height * 1px - 6px;
        }
        if root.results[index].top * 1px + list.content-y < 0px {
            list.content-y = -root.results[index].top * 1px;
        }
    }

    property <[PaletteItem]> results: PaletteApi.results(PaletteStore.query, PaletteCatalog.actions, root.chats-favorites, root.chats-main, root.chats-channels, ListStore.sections, PaletteStore.recents);

    background: Theme.scrim;
    accessible-role: groupbox;
    accessible-label: @tr("Command palette");
    // A click on the dim area closes the palette.
    TouchArea { clicked => { root.close(); } }
    // Esc closes, Up and Down move, Enter runs, wherever the focus is inside the panel.
    FocusScope {
        width: parent.width;
        height: parent.height;
        capture-key-pressed(event) => {
            if event.text == Key.Escape {
                root.close();
                return accept;
            }
            if (event.text == "p" || event.text == "P") && event.modifiers.control && event.modifiers.shift {
                root.close();
                return accept;
            }
            if event.text == Key.DownArrow {
                PaletteStore.selected = max(0, min(PaletteStore.selected + 1, root.results.length - 1));
                root.reveal(PaletteStore.selected);
                return accept;
            }
            if event.text == Key.UpArrow {
                PaletteStore.selected = max(0, PaletteStore.selected - 1);
                root.reveal(PaletteStore.selected);
                return accept;
            }
            if event.text == Key.Return && root.results.length > 0 {
                root.run(root.results[max(0, min(PaletteStore.selected, root.results.length - 1))]);
                return accept;
            }
            reject
        }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(560px, parent.width - 40px);
            height: min(440px, parent.height - 40px);
            border-radius: 8px;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 16px;
            drop-shadow-color: #000000a0;
            // Keeps clicks inside the panel from closing it.
            TouchArea { }
            VerticalLayout {
                Rectangle {
                    height: 48px;
                    Icon { x: 16px; y: 16px; source: @image-url("../icons/search.svg"); width: 16px; height: 16px; }
                    input := TextInput {
                        x: 44px;
                        width: parent.width - 60px;
                        height: parent.height;
                        color: Theme.fg;
                        font-size: 15px * Theme.font-scale;
                        single-line: true;
                        vertical-alignment: center;
                        horizontal-alignment: Theme.start-align;
                        accessible-role: text-input;
                        accessible-label: @tr("Command palette");
                        accessible-placeholder-text: @tr("Type a command or search chats");
                        init => { PaletteStore.query = ""; PaletteStore.selected = 0; self.focus(); }
                        edited => { PaletteStore.query = self.text; PaletteStore.selected = 0; list.content-y = 0px; }
                    }
                    if input.text == "": Text {
                        x: 44px;
                        width: parent.width - 60px;
                        text: @tr("Type a command or search chats");
                        color: Theme.fg-subtle;
                        font-size: 15px * Theme.font-scale;
                        horizontal-alignment: Theme.start-align;
                        vertical-alignment: center;
                    }
                }
                Rectangle { height: 1px; background: Theme.border; }
                list := Flickable {
                    vertical-stretch: 1;
                    content-height: col.preferred-height;
                    col := VerticalLayout {
                        width: parent.width;
                        padding-top: 4px;
                        padding-bottom: 6px;
                        for r[i] in root.results: row := Rectangle {
                            property <bool> sel: PaletteStore.selected == i;
                            height: r.height * 1px;
                            if r.head: Text {
                                x: 16px;
                                y: 6px;
                                width: parent.width - 32px;
                                text: r.section == "recent" ? @tr("Recent") : r.section == "chats" ? @tr("Chats and channels") : @tr("Actions");
                                color: Theme.fg-subtle;
                                font-size: 11px * Theme.font-scale;
                                font-weight: 700;
                                horizontal-alignment: Theme.start-align;
                            }
                            entry := Rectangle {
                                x: 6px;
                                y: r.head ? 26px : 0px;
                                width: parent.width - 12px;
                                height: 36px;
                                border-radius: 4px;
                                background: row.sel ? Theme.selected : touch.has-hover ? Theme.surface-hover : transparent;
                                accessible-role: button;
                                accessible-label: r.label;
                                accessible-action-default => { root.run(r); }
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 12px;
                                    spacing: 10px;
                                    VerticalLayout {
                                        width: 24px;
                                        alignment: center;
                                        if r.has-icon: Icon { source: r.icon; tint: row.sel ? Theme.accent : Theme.fg-muted; width: 18px; height: 18px; }
                                        if !r.has-icon: Avatar { initials: r.initials; tone: r.color; size: 24px; }
                                    }
                                    Text { text: r.label; color: Theme.fg; font-size: 13px * Theme.font-scale; vertical-alignment: center; horizontal-alignment: Theme.start-align; overflow: elide; horizontal-stretch: 1; }
                                    if r.keys != "": Text { text: r.keys; color: Theme.fg-subtle; font-size: 12px * Theme.font-scale; vertical-alignment: center; }
                                }
                                touch := TouchArea { mouse-cursor: pointer; clicked => { root.run(r); } }
                            }
                        }
                    }
                }
                if root.results.length == 0: Rectangle {
                    height: 56px;
                    Text { text: @tr("No matching commands or chats"); color: Theme.fg-muted; font-size: 13px * Theme.font-scale; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
        }
    }
}
