import { Theme } from "../tokens/theme.slint";
import { Fixed } from "../tokens/fixed.slint";

// The logo from packaging/io.github.mohamedeslam04.ironteams.svg as shapes, so the parts can move:
// the back tile slides in, the front tile pops, the I draws in, then the dots pulse like a typing
// indicator while signing in. Sizes are in the SVG's 128 x 128 units times `u`.
component SplashLogo inherits Rectangle {
    in property <bool> pulsing;
    in property <bool> leaving;
    property <length> u: 0.5px;
    property <bool> entered: false;
    // 0 turns every transition into a jump (reduced motion).
    property <float> k: Theme.reduced-motion ? 0 : 1;
    // The animations run from the first drawn state (not entered) to the entered one, so the flip
    // waits a frame after the first draw.
    Timer {
        interval: 16ms;
        running: !root.entered;
        triggered => { root.entered = true; }
    }
    property <float> tick: root.pulsing && !Theme.reduced-motion ? animation-tick() / 1ms : 0;
    width: 128 * root.u;
    height: 128 * root.u;
    transform-scale: root.leaving ? 1.08 : 1;
    animate transform-scale { duration: 200ms * root.k; easing: ease-out; }

    // 0.35 to 1 to 0.35 over 900 ms, each dot 150 ms after the one before.
    pure function pulse(i: int) -> float {
        if (!root.pulsing || Theme.reduced-motion) {
            return 1;
        }
        let p = mod(root.tick - i * 150, 900) / 900;
        return 0.35 + 0.65 * (p < 0.5 ? p * 2 : (1 - p) * 2);
    }

    // The back tile, with the three dots on it.
    Rectangle {
        x: (42 + (root.entered ? 0 : 24)) * root.u;
        y: (8 - (root.entered ? 0 : 24)) * root.u;
        width: 78 * root.u;
        height: 78 * root.u;
        border-radius: 20 * root.u;
        background: @linear-gradient(135deg, Fixed.login-from 0%, Fixed.login-mid 100%);
        opacity: root.entered ? 1 : 0;
        animate x, y { duration: 350ms * root.k; easing: ease-out; }
        animate opacity { duration: 350ms * root.k; easing: ease-out; }
        for cx[i] in [79, 93, 107]: Rectangle {
            x: (cx - 5 - 42) * root.u;
            y: 12 * root.u;
            width: 10 * root.u;
            height: 10 * root.u;
            border-radius: 5 * root.u;
            background: Fixed.white;
            opacity: root.pulse(i);
        }
    }
    // The front tile pops in a little after, overshooting.
    Rectangle {
        x: 8 * root.u;
        y: 36 * root.u;
        width: 84 * root.u;
        height: 84 * root.u;
        border-radius: 22 * root.u;
        background: @linear-gradient(135deg, Fixed.login-mid 0%, Fixed.login-to 100%);
        drop-shadow-color: Fixed.login-shadow;
        drop-shadow-blur: 6 * root.u;
        drop-shadow-offset-x: 2 * root.u;
        drop-shadow-offset-y: 3 * root.u;
        opacity: root.entered ? 1 : 0;
        transform-scale: root.entered ? 1 : 0.6;
        animate opacity { delay: 120ms * root.k; duration: 200ms * root.k; easing: ease-out; }
        animate transform-scale { delay: 120ms * root.k; duration: 450ms * root.k; easing: ease-out-back; }
    }
    // The I: both bars grow from the centre, then the stem.
    for bar-y in [54, 96]: Rectangle {
        x: 24 * root.u;
        y: bar-y * root.u;
        width: 52 * root.u;
        height: 10 * root.u;
        border-radius: 5 * root.u;
        background: Fixed.white;
        transform-scale-x: root.entered ? 1 : 0;
        animate transform-scale-x { delay: 420ms * root.k; duration: 250ms * root.k; easing: ease-out; }
    }
    Rectangle {
        x: 44 * root.u;
        y: 64 * root.u;
        width: 12 * root.u;
        height: 32 * root.u;
        background: Fixed.white;
        transform-scale-y: root.entered ? 1 : 0;
        animate transform-scale-y { delay: 420ms * root.k; duration: 250ms * root.k; easing: ease-out; }
    }
}

export component LoginView inherits Rectangle {
    in property <string> state; // checking | code | error
    // Sign-in is done: the splash fades out (and leaves the tree's hit testing) over the main UI.
    in property <bool> done;
    out property <bool> shown: root.visible;
    in property <string> user-code;
    in property <string> verify-url;
    in property <string> error;
    // Details of a sign-in blocked by policy, copied by its button; empty hides the button.
    in property <string> report;
    callback copy-code();
    callback copy-report();
    callback open-url(string);
    callback retry();
    background: Theme.main;
    opacity: root.done ? 0 : 1;
    visible: self.opacity > 0;
    animate opacity { duration: Theme.reduced-motion ? 0ms : 200ms; easing: ease-out; }
    VerticalLayout {
        alignment: center;
        spacing: 18px;
        HorizontalLayout {
            alignment: center;
            SplashLogo { pulsing: root.state == "checking"; leaving: root.done; }
        }
        Text { text: "IronTeams"; color: Theme.fg; font-size: 28px * Theme.font-scale; font-weight: 700; horizontal-alignment: center; }
        if root.state == "checking": Text { text: "Signing in…"; color: Theme.fg-muted; horizontal-alignment: center; }
        if root.state == "code": VerticalLayout {
            spacing: 12px;
            Text { text: "Open this page and enter the code to sign in:"; color: Theme.fg-muted; horizontal-alignment: center; }
            Text {
                text: root.verify-url;
                color: Theme.accent;
                horizontal-alignment: center;
                TouchArea { mouse-cursor: pointer; clicked => { root.open-url(root.verify-url); } }
            }
            HorizontalLayout {
                alignment: center;
                spacing: 12px;
                Rectangle {
                    background: Theme.surface;
                    border-radius: 6px;
                    width: code-text.preferred-width + 40px;
                    height: 56px;
                    code-text := Text { text: root.user-code; color: Theme.fg; font-size: 28px * Theme.font-scale; font-weight: 700; letter-spacing: 4px; }
                }
                Rectangle {
                    width: 90px;
                    height: 56px;
                    border-radius: 6px;
                    background: ct.has-hover ? Theme.accent : Theme.accent-strong;
                    Text { text: "Copy"; color: Theme.on-accent; font-weight: 600; }
                    ct := TouchArea { mouse-cursor: pointer; clicked => { root.copy-code(); } }
                }
            }
            Text { text: "Waiting for you to finish signing in…"; color: Theme.fg-subtle; font-size: 12px * Theme.font-scale; horizontal-alignment: center; }
        }
        if root.state == "error": VerticalLayout {
            spacing: 12px;
            Text { text: root.error; color: Theme.danger; wrap: word-wrap; horizontal-alignment: center; }
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 120px;
                    height: 36px;
                    border-radius: 6px;
                    background: Theme.accent-strong;
                    Text { text: "Try again"; color: Theme.on-accent; }
                    TouchArea { mouse-cursor: pointer; clicked => { root.retry(); } }
                }
                if root.report != "": Rectangle {
                    width: 160px;
                    height: 36px;
                    border-radius: 6px;
                    background: rt.has-hover ? Theme.accent : Theme.surface;
                    Text { text: "Copy error details"; color: Theme.fg; }
                    rt := TouchArea { mouse-cursor: pointer; clicked => { root.copy-report(); } }
                }
            }
        }
    }
}
