// Planner and To Do: navigation, a task list and a board. A task can be completed, edited and
// deleted from the list; New task adds one to the open To Do list or plan.
import { ScrollView } from "std-widgets.slint";
import { Theme } from "../tokens/theme.slint";
import { Icon, IconButton } from "../atoms/widgets.slint";
import { TasksStore, AppRow } from "../stores/apps_store.slint";
import { KitButton, KitNavRow, KitNavHeader, KitBadge, KitNote } from "../molecules/apps_kit.slint";

component TaskCheck inherits Rectangle {
    in property <bool> done;
    in property <string> label;
    callback toggled();
    width: 18px;
    height: 18px;
    border-radius: 9px;
    border-width: 1.5px;
    border-color: root.done ? #6bd69b : Theme.fg-subtle;
    background: root.done ? #1d3a2a : transparent;
    accessible-role: checkbox;
    accessible-label: root.label;
    accessible-checked: root.done;
    accessible-action-default => { root.toggled(); }
    Text { text: root.done ? "✓" : ""; color: #6bd69b; font-size: 11px * Theme.font-scale; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
    TouchArea { mouse-cursor: pointer; clicked => { root.toggled(); } }
}

component TaskRowView inherits Rectangle {
    in property <AppRow> t;
    height: 52px;
    border-radius: 4px;
    background: hover.has-hover ? Theme.surface-hover : transparent;
    accessible-role: list-item;
    accessible-label: root.t.title;
    accessible-description: root.t.badge + (root.t.subtitle != "" ? ", " + root.t.subtitle : "");
    hover := TouchArea { }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        TaskCheck {
            y: 17px;
            done: root.t.done;
            label: root.t.done ? "Mark " + root.t.title + " as not completed" : "Complete " + root.t.title;
            toggled => { TasksStore.command("task-toggle", root.t.id); }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            min-width: 0px;
            Text { text: root.t.title; color: root.t.done ? Theme.fg-subtle : Theme.fg; font-size: 13px * Theme.font-scale; overflow: elide; }
            Text { text: root.t.subtitle + (root.t.subtitle != "" && root.t.meta != "" ? " · " : "") + root.t.meta; color: root.t.subtitle.ends-with("(overdue)") ? #ff8a8f : Theme.fg-subtle; font-size: 11px * Theme.font-scale; overflow: elide; }
        }
        KitBadge { y: 16px; text: root.t.badge; tone: root.t.tone; }
        IconButton { y: 12px; size: 28px; icon: @image-url("../icons/edit.svg"); tooltip: "Edit " + root.t.title; clicked => { TasksStore.command("task-edit", root.t.id); } }
        IconButton { y: 12px; size: 28px; icon: @image-url("../icons/trash.svg"); tooltip: "Delete " + root.t.title; clicked => { TasksStore.command("task-delete", root.t.id); } }
    }
}

component BoardCard inherits Rectangle {
    in property <AppRow> t;
    height: card.preferred-height + 20px;
    border-radius: 6px;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    accessible-role: list-item;
    accessible-label: root.t.title;
    accessible-description: root.t.subtitle + " " + root.t.meta;
    card := VerticalLayout {
        padding: 10px;
        spacing: 3px;
        Text { text: root.t.title; color: root.t.done ? Theme.fg-subtle : Theme.fg; font-size: 13px * Theme.font-scale; wrap: word-wrap; }
        if root.t.subtitle != "": Text { text: root.t.subtitle; color: root.t.subtitle.ends-with("(overdue)") ? #ff8a8f : Theme.fg-subtle; font-size: 11px * Theme.font-scale; }
        if root.t.meta != "": Text { text: root.t.meta; color: Theme.fg-subtle; font-size: 11px * Theme.font-scale; }
    }
}

export component TasksView inherits Rectangle {
    background: Theme.main;
    init => { TasksStore.command("tasks-enter", ""); }
    HorizontalLayout {
        Rectangle {
            width: 240px;
            background: Theme.sidebar;
            ScrollView {
                VerticalLayout {
                    width: parent.width - 12px;
                    padding: 12px;
                    spacing: 2px;
                    alignment: start;
                    Text { text: "Tasks"; color: Theme.fg; font-size: 18px * Theme.font-scale; font-weight: 700; height: 36px; vertical-alignment: center; }
                    for n in TasksStore.nav: VerticalLayout {
                        if n.header: KitNavHeader { label: n.title; }
                        if !n.header: KitNavRow {
                            label: n.title;
                            active: n.selected;
                            clicked => { TasksStore.command("tasks-nav", n.id); }
                        }
                    }
                }
            }
        }
        VerticalLayout {
            Rectangle {
                height: 56px;
                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 16px;
                    spacing: 8px;
                    Text { text: TasksStore.title; color: Theme.fg; font-size: 18px * Theme.font-scale; font-weight: 700; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                    KitButton { y: 12px; label: "New task"; primary: true; enabled: TasksStore.can-add; clicked => { TasksStore.command("task-new", ""); } }
                    KitButton { y: 12px; label: "List"; active: TasksStore.mode == "list"; clicked => { TasksStore.command("tasks-mode", "list"); } }
                    KitButton { y: 12px; label: "Board"; active: TasksStore.mode == "board"; enabled: TasksStore.can-board; clicked => { TasksStore.command("tasks-mode", "board"); } }
                    IconButton { y: 12px; icon: @image-url("../icons/sync.svg"); tooltip: "Refresh tasks"; clicked => { TasksStore.command("tasks-refresh", ""); } }
                }
            }
            if TasksStore.summary != "": Rectangle {
                height: 44px;
                VerticalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    spacing: 6px;
                    alignment: center;
                    Text { text: TasksStore.summary; color: Theme.fg-muted; font-size: 12px * Theme.font-scale; accessible-role: text; }
                    Rectangle {
                        height: 6px;
                        border-radius: 3px;
                        background: Theme.surface-hover;
                        accessible-role: progress-indicator;
                        accessible-value: Math.round(TasksStore.progress * 100) + "%";
                        accessible-label: "Completed";
                        Rectangle { width: parent.width * TasksStore.progress; border-radius: 3px; background: #6bd69b; }
                    }
                }
            }
            if TasksStore.loading: KitNote { text: "Loading tasks…"; busy: true; }
            if TasksStore.status != "": KitNote { text: TasksStore.status; }
            if TasksStore.mode == "list": ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    width: parent.width - 12px;
                    padding-left: 8px;
                    padding-right: 8px;
                    alignment: start;
                    for t in TasksStore.tasks: TaskRowView { t: t; }
                }
            }
            if TasksStore.mode == "board": ScrollView {
                vertical-stretch: 1;
                HorizontalLayout {
                    padding: 16px;
                    spacing: 12px;
                    alignment: start;
                    for c in TasksStore.columns: Rectangle {
                        width: 260px;
                        VerticalLayout {
                            spacing: 8px;
                            alignment: start;
                            Text { text: c.title + " (" + c.count + ")"; color: Theme.fg-muted; font-size: 12px * Theme.font-scale; font-weight: 700; height: 22px; }
                            for t in c.cards: BoardCard { t: t; }
                        }
                    }
                }
            }
        }
    }
}
