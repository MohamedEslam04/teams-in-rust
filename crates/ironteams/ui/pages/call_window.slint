// The call window: the pre-join screen, the Teams-like meeting view (top bar, stage, People and
// More panels, lobby, reconnecting banner) and the call-ended screen. It covers the area right of
// the rail (see app.slint); `CallMini` is the floating call while another page is open.
//
// Camera and screen sharing work when the call negotiates them (on by default; IRONTEAMS_CAMERA=0
// and IRONTEAMS_SCREEN_SHARE=0 switch them off); someone else's share takes the stage (View >
// Focus on content).
// Reactions are drawn but disabled (no reaction API, crates/calling/src/signaling/controls.rs).
import { Theme } from "../tokens/theme.slint";
import { Icon } from "../atoms/widgets.slint";
import { Avatar } from "../atoms/avatar.slint";
import { CallStore, CallPerson, CallCaption, CallFound, CallVideo } from "../stores/call_store.slint";
import { DeviceSettings } from "../molecules/call_widgets.slint";
import { PreJoin } from "../organisms/call_prejoin.slint";
import { PeoplePanel, MorePanel, PeopleSearch } from "../organisms/call_people.slint";
import { CaptionStrip } from "../molecules/call_captions.slint";
import { HeldBar } from "../molecules/call_held.slint";
import { CallFeedback } from "../organisms/call_feedback.slint";
import { ReactionMenu, ReactionsOverlay } from "../molecules/call_reactions.slint";
import { Button, ButtonVariant } from "../atoms/button.slint";
import { MenuItem, MenuItemVariant } from "../molecules/menu.slint";

export { CallStore, CallPerson, CallCaption, CallFound, CallVideo }

component TopBar inherits Rectangle {
    // A narrow window: People, Hold, Transfer, Raise, React and View are in the More panel.
    in property <bool> fold: false;
    callback open-chat();
    // Where the View button starts, for the dropdown under it (set when it is clicked).
    out property <length> view-x;
    // Where the React button starts, for its menu.
    out property <length> react-x;
    height: 62px;
    background: Theme.topbar;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 8px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 4px;
        HorizontalLayout {
            spacing: 6px;
            if CallStore.recording: VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 10px;
                    height: 10px;
                    border-radius: 5px;
                    background: Theme.danger;
                    accessible-role: text;
                    accessible-label: "Recording";
                }
            }
            Text {
                text: CallStore.timer;
                color: Theme.fg;
                font-size: 14px * Theme.font-scale;
                font-weight: 600;
                vertical-alignment: center;
                accessible-role: text;
                accessible-label: "Call duration " + CallStore.timer;
            }
        }
        Text {
            text: CallStore.title;
            color: Theme.fg-muted;
            font-size: 13px * Theme.font-scale;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Button { variant: ButtonVariant.call;
            icon: @image-url("../icons/chat.svg");
            label: "Chat";
            enabled: CallStore.chat-id != "";
            tip: CallStore.kind == "direct"
                ? (CallStore.chat-id != "" ? "Open the chat with " + CallStore.title : "This chat isn't available here")
                : (CallStore.chat-id != "" ? "Open the meeting chat" : "This meeting's chat isn't available here");
            clicked => { root.open-chat(); }
        }
        if !root.fold: Button { variant: ButtonVariant.call;
            icon: @image-url("../icons/people.svg");
            label: "People";
            checkable: true;
            active: CallStore.panel == "people";
            clicked => { CallStore.panel = CallStore.panel == "people" ? "" : "people"; }
        }
        // A 1:1 call's Hold and Transfer (Teams has them under "..." > More actions).
        if CallStore.kind == "direct" && !root.fold: Button { variant: ButtonVariant.call;
            icon: @image-url("../icons/pause.svg");
            label: CallStore.held ? "Resume" : "Hold";
            checkable: true;
            active: CallStore.held;
            tip: CallStore.held ? "Take the call off hold" : "Put the call on hold";
            clicked => { CallStore.command("hold", ""); }
        }
        if CallStore.kind == "direct" && !root.fold: Button { variant: ButtonVariant.call;
            icon: @image-url("../icons/forward.svg");
            label: "Transfer";
            active: CallStore.menu == "transfer";
            tip: "Transfer the call to someone else";
            clicked => {
                if CallStore.menu == "transfer" {
                    CallStore.menu = "";
                } else {
                    CallStore.menu = "transfer";
                    CallStore.command("transfer-open", "");
                }
            }
        }
        if !root.fold: Button { variant: ButtonVariant.call;
            icon: @image-url("../icons/hand.svg");
            label: CallStore.hand ? "Lower" : "Raise";
            checkable: true;
            active: CallStore.hand;
            clicked => { CallStore.command("hand", ""); }
        }
        if !root.fold: Button { variant: ButtonVariant.call;
            icon: @image-url("../icons/emoji.svg");
            label: "React";
            enabled: CallStore.phase == "connected";
            tip: CallStore.phase == "connected" ? "Send a reaction" : "Reactions work once you're in the meeting";
            active: CallStore.menu == "react";
            clicked => {
                root.react-x = self.absolute-position.x - root.absolute-position.x;
                CallStore.menu = CallStore.menu == "react" ? "" : "react";
            }
        }
        if !root.fold: Button { variant: ButtonVariant.call;
            icon: @image-url("../icons/grid.svg");
            label: "View";
            tip: "Gallery, speaker or focus on content";
            active: CallStore.menu == "view";
            clicked => {
                root.view-x = self.absolute-position.x - root.absolute-position.x;
                CallStore.menu = CallStore.menu == "view" ? "" : "view";
            }
        }
        Button { variant: ButtonVariant.call;
            icon: @image-url("../icons/more.svg");
            label: "More";
            checkable: true;
            active: CallStore.panel == "more";
            tip: "Device settings";
            clicked => { CallStore.panel = CallStore.panel == "more" ? "" : "more"; }
        }
        Rectangle {
            width: 1px;
            background: Theme.border;
        }
        Button { variant: ButtonVariant.call;
            icon: CallStore.camera ? @image-url("../icons/video.svg") : @image-url("../icons/video-off.svg");
            label: "Camera";
            checkable: true;
            active: CallStore.camera;
            enabled: CallStore.can-camera || CallStore.camera;
            tip: CallStore.can-camera || CallStore.camera ? (CallStore.camera ? "Turn camera off" : "Turn camera on")
                : CallStore.kind == "meeting" ? "Video isn't available in meetings yet" : "Video isn't available in this call";
            clicked => { CallStore.command("camera", ""); }
        }
        HorizontalLayout {
            Button { variant: ButtonVariant.call;
                icon: CallStore.muted ? @image-url("../icons/mic-off.svg") : @image-url("../icons/mic.svg");
                label: CallStore.muted ? "Unmute" : "Mute";
                checkable: true;
                active: CallStore.muted;
                clicked => { CallStore.command("mute", ""); }
            }
            Button { variant: ButtonVariant.call;
                width: 22px;
                icon: @image-url("../icons/chevron-down.svg");
                label: "";
                tip: "Microphone and speaker";
                active: CallStore.menu == "devices";
                accessible-label: "Audio devices";
                clicked => { CallStore.menu = CallStore.menu == "devices" ? "" : "devices"; }
            }
        }
        HorizontalLayout {
            Button { variant: ButtonVariant.call;
                icon: @image-url("../icons/screen-share.svg");
                label: CallStore.sharing ? "Stop sharing" : "Share";
                checkable: true;
                active: CallStore.sharing;
                enabled: CallStore.can-share || CallStore.sharing;
                tip: CallStore.can-share || CallStore.sharing ? ""
                    : CallStore.kind == "meeting" ? "Sharing isn't available in meetings yet" : "Screen sharing isn't available in this call";
                clicked => { CallStore.command("share", ""); }
            }
            // Give control (remote control of our share).
            if CallStore.remote-control && CallStore.sharing: Button { variant: ButtonVariant.call;
                width: 22px;
                icon: @image-url("../icons/chevron-down.svg");
                label: "";
                tip: "Give control";
                active: CallStore.menu == "share";
                accessible-label: "Sharing options";
                clicked => { CallStore.menu = CallStore.menu == "share" ? "" : "share"; }
            }
        }
        Button { variant: ButtonVariant.call;
            icon: @image-url("../icons/call-end.svg");
            label: "Leave";
            danger: true;
            clicked => { CallStore.command("leave", ""); }
        }
    }
}

component Banner inherits Rectangle {
    in property <string> message;
    in property <color> tone;
    in property <bool> dismissable;
    // What Dismiss sends, and its name for screen readers.
    in property <string> dismiss: "dismiss-error";
    in property <string> dismiss-label: "Dismiss";
    height: 36px;
    background: root.tone;
    accessible-role: text;
    accessible-label: root.message;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 8px;
        Text {
            text: root.message;
            color: #ffffff;
            font-size: 13px * Theme.font-scale;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if root.dismissable: Button { variant: ButtonVariant.action;
            label: "Dismiss";
            accessible-label: root.dismiss-label;
            y: 1px;
            clicked => { CallStore.command(root.dismiss, ""); }
        }
    }
}

// Remote control's banners: who controls whose screen, and a viewer's request to ours.
component ControlBanner inherits Rectangle {
    property <string> mode: CallStore.control-mode;
    property <string> who: CallStore.control-name != "" ? CallStore.control-name : "Someone";
    height: 40px;
    background: mode == "incoming" ? #3d3e66 : mode == "requested" ? #3d3e66 : #8a5a00;
    accessible-role: text;
    accessible-label: msg.text;
    // While someone controls our screen, a key pressed here takes control back (Escape twice
    // always does).
    if root.mode == "controlled": FocusScope {
        width: 0px;
        height: 0px;
        init => { self.focus(); }
        key-pressed(e) => {
            CallStore.command("control-key", e.text);
            reject
        }
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 8px;
        spacing: 8px;
        msg := Text {
            text: root.mode == "controlled" ? @tr("{} is controlling your screen", root.who)
                : root.mode == "controlling" ? @tr("You're controlling {}'s screen", root.who)
                : root.mode == "incoming" ? @tr("{} wants control of your screen", root.who)
                : @tr("You asked {} for control", root.who);
            color: #ffffff;
            font-size: 13px * Theme.font-scale;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if root.mode == "controlled": Button { variant: ButtonVariant.action;
            label: "Take back";
            primary: true;
            y: 3px;
            clicked => { CallStore.command("control-take-back", ""); }
        }
        if root.mode == "controlling": Button { variant: ButtonVariant.action;
            label: "Release";
            y: 3px;
            clicked => { CallStore.command("control-release", ""); }
        }
        if root.mode == "requested": Button { variant: ButtonVariant.action;
            label: "Cancel request";
            y: 3px;
            clicked => { CallStore.command("control-release", ""); }
        }
        if root.mode == "incoming": Button { variant: ButtonVariant.action;
            label: "Allow";
            primary: true;
            y: 3px;
            clicked => { CallStore.command("control-allow", ""); }
        }
        if root.mode == "incoming": Button { variant: ButtonVariant.action;
            label: "Deny";
            y: 3px;
            clicked => { CallStore.command("control-deny", ""); }
        }
    }
}

// The Share chevron's dropdown: give control of our screen to someone in the call, or take it
// back.
component ShareMenu inherits Rectangle {
    width: 240px;
    height: card.preferred-height;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.surface;
    drop-shadow-blur: 12px;
    drop-shadow-color: #00000080;
    accessible-role: list;
    accessible-label: "Give control";
    card := VerticalLayout {
        padding: 6px;
        spacing: 2px;
        if CallStore.control-mode == "controlled": MenuItem { variant: MenuItemVariant.share;
            label: "Take back control";
            clicked => {
                CallStore.command("control-take-back", "");
                CallStore.menu = "";
            }
        }
        Text {
            text: "Give control";
            color: Theme.fg-subtle;
            font-size: 12px * Theme.font-scale;
            height: 24px;
            vertical-alignment: center;
        }
        for p in CallStore.people: MenuItem { variant: MenuItemVariant.share;
            visible: !p.me && !p.lobby && p.id != "";
            height: self.visible ? 32px : 0px;
            label: p.name;
            clicked => {
                CallStore.command("control-give", p.id);
                CallStore.menu = "";
            }
        }
    }
}

component Tile inherits Rectangle {
    in property <CallPerson> p;
    // The avatar's size, at most (the speaker view's large tile has a bigger one).
    in property <length> avatar-size: 96px;
    // Hovering shows a "…" button after the name (Pin, and what a person's tile offers); the floating
    // call's tiles have none.
    in property <bool> menu-enabled: false;
    // The "…" button was pressed: the person and where its top left is in the window.
    callback more-clicked(CallPerson, length, length);
    // Our camera in our tile, the other side's video in theirs: their meeting gallery slot, else
    // the call's one remote picture.
    property <bool> self-view: root.p.me && CallStore.camera && CallStore.has-self-view;
    property <bool> gallery: !root.p.me && root.p.gallery-slot > 0
        && CallStore.slot-videos[root.p.gallery-slot - 1].shown;
    property <bool> remote: !root.p.me && !root.gallery && root.p.video && CallStore.has-remote-video;
    property <bool> pinned: root.p.id != "" && CallStore.pinned == root.p.id;
    border-radius: 8px;
    clip: true;
    background: Theme.surface;
    // Under everything: only tells whether the pointer is over the tile.
    hover := TouchArea { enabled: root.menu-enabled; }
    if root.self-view || root.gallery || root.remote: Image {
        source: root.self-view ? CallStore.self-view
            : root.gallery ? CallStore.slot-videos[root.p.gallery-slot - 1].frame
            : CallStore.remote-video;
        width: root.width;
        height: root.height;
        image-fit: root.self-view ? ImageFit.cover : ImageFit.contain;
        accessible-role: image;
        accessible-label: root.self-view ? "Your video" : root.p.name + "'s video";
    }
    if !root.self-view && !root.gallery && !root.remote: Avatar {
        initials: root.p.initials;
        img: root.p.photo;
        has-img: root.p.has-photo;
        size: min(root.avatar-size, root.height * 0.5);
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
    }
    // The name in a dark pill at the bottom left: the name, then pinned, muted, then the raised hand.
    pill := Rectangle {
        x: 8px;
        y: root.height - self.height - 8px;
        height: 24px;
        width: max(0px, min(row.preferred-width, root.width - 16px));
        border-radius: 4px;
        background: #00000099;
        row := HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 6px;
            Text {
                text: CallStore.tagged-name(root.p) + (root.p.me ? " (You)" : "");
                color: Theme.fg;
                font-size: 12px * Theme.font-scale;
                overflow: elide;
                vertical-alignment: center;
            }
            if root.pinned: Rectangle {
                width: 16px;
                accessible-role: image;
                accessible-label: @tr("Pinned");
                Icon {
                    source: @image-url("../icons/pin.svg");
                    tint: Theme.fg;
                    width: 16px;
                    height: 16px;
                    y: (parent.height - self.height) / 2;
                }
            }
            if root.p.muted: Rectangle {
                width: 16px;
                Icon {
                    source: @image-url("../icons/mic-off.svg");
                    width: 16px;
                    height: 16px;
                    y: (parent.height - self.height) / 2;
                }
            }
            if root.p.hand: Rectangle {
                width: 16px;
                Icon {
                    source: @image-url("../icons/hand.svg");
                    tint: Theme.accent;
                    width: 16px;
                    height: 16px;
                    y: (parent.height - self.height) / 2;
                }
            }
        }
    }
    // "…" right after the pill, while the pointer is over the tile. Always there for the screen
    // reader, which has no hover.
    more := Rectangle {
        visible: root.menu-enabled;
        x: min(pill.x + pill.width + 4px, root.width - self.width - 8px);
        y: pill.y;
        width: 24px;
        height: 24px;
        border-radius: 4px;
        background: more-touch.has-hover ? #000000cc : #00000099;
        opacity: hover.has-hover || more-touch.has-hover ? 1 : 0;
        accessible-role: button;
        accessible-label: @tr("More options for {}", root.p.name);
        accessible-action-default => { root.open-more(); }
        Icon {
            source: @image-url("../icons/more.svg");
            tint: Theme.fg;
            width: 16px;
            height: 16px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
        more-touch := TouchArea {
            enabled: root.menu-enabled;
            mouse-cursor: pointer;
            clicked => { root.open-more(); }
        }
    }
    function open-more() {
        root.more-clicked(root.p, more.absolute-position.x, more.absolute-position.y);
    }
    // Their live reaction, in the corner while it floats.
    if root.p.reaction != "": Text {
        x: root.width - self.width - 8px;
        y: 6px;
        width: 36px;
        height: 36px;
        text: root.p.reaction;
        font-size: 26px;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: text;
        accessible-label: root.p.name + "'s reaction: " + root.p.reaction-name;
    }
    // Speaking: the accent outline, as Teams draws it; a raised hand also shows it. A last child,
    // so it draws over the video too.
    Rectangle {
        width: root.width;
        height: root.height;
        border-radius: root.border-radius;
        border-width: root.p.speaking || root.p.hand ? 2px : 0px;
        border-color: Theme.accent;
    }
}

// A shared screen on the whole stage, and who presents it. While we control it, our pointer,
// wheel and keys over the picture go to the presenter as points of the picture (0..1).
component ContentStage inherits Rectangle {
    property <string> who: CallStore.presenter != "" ? CallStore.presenter
        : CallStore.kind == "direct" ? CallStore.title : "Someone";
    property <bool> controlling: CallStore.control-mode == "controlling";
    VerticalLayout {
        padding: 16px;
        spacing: 8px;
        screen := Rectangle {
            // Where the picture is drawn inside (image-fit contain), for normalized points.
            property <float> iw: max(1, CallStore.content-video.width);
            property <float> ih: max(1, CallStore.content-video.height);
            property <float> scale: min(self.width / 1px / iw, self.height / 1px / ih);
            property <length> dw: iw * scale * 1px;
            property <length> dh: ih * scale * 1px;
            property <length> ox: (self.width - dw) / 2;
            property <length> oy: (self.height - dh) / 2;
            vertical-stretch: 1;
            border-radius: 8px;
            clip: true;
            background: #000000;
            border-width: root.controlling ? 2px : 0px;
            border-color: Theme.accent;
            if CallStore.has-content: Image {
                source: CallStore.content-video;
                width: parent.width;
                height: parent.height;
                image-fit: ImageFit.contain;
                accessible-role: image;
                accessible-label: @tr("{}'s shared screen", root.who);
            }
            if !CallStore.has-content: Text {
                text: "Waiting for the shared screen…";
                color: Theme.fg-muted;
                font-size: 14px * Theme.font-scale;
            }
            if root.controlling && CallStore.has-content: keys := FocusScope {
                init => { self.focus(); }
                key-pressed(e) => {
                    CallStore.command("control-input", "key-down " + e.text);
                    accept
                }
                key-released(e) => {
                    CallStore.command("control-input", "key-up " + e.text);
                    accept
                }
                TouchArea {
                    mouse-cursor: crosshair;
                    pointer-event(e) => {
                        if e.kind == PointerEventKind.move {
                            CallStore.command("control-input", "move "
                                + ((self.mouse-x - screen.ox) / screen.dw) + " "
                                + ((self.mouse-y - screen.oy) / screen.dh));
                        } else if e.kind == PointerEventKind.down || e.kind == PointerEventKind.up {
                            keys.focus();
                            CallStore.command("control-input", (e.kind == PointerEventKind.down ? "down " : "up ")
                                + (e.button == PointerEventButton.left ? "1"
                                    : e.button == PointerEventButton.right ? "2"
                                    : e.button == PointerEventButton.middle ? "3" : "0"));
                        }
                    }
                    scroll-event(e) => {
                        CallStore.command("control-input", "scroll " + (e.delta-x / 1px) + " " + (-e.delta-y / 1px));
                        accept
                    }
                }
            }
        }
        HorizontalLayout {
            alignment: start;
            spacing: 8px;
            Icon {
                source: @image-url("../icons/screen-share.svg");
                tint: Theme.accent;
                width: 16px;
                height: 16px;
                y: 2px;
            }
            Text {
                text: @tr("{} is presenting", root.who);
                color: Theme.fg;
                font-size: 13px * Theme.font-scale;
                font-weight: 600;
                overflow: elide;
                accessible-role: text;
                horizontal-stretch: 1;
            }
            // Remote control (IRONTEAMS_REMOTE_CONTROL=1): ask the presenter, or give it back.
            if CallStore.remote-control && CallStore.presenter != "" && CallStore.control-mode == "": Button { variant: ButtonVariant.action;
                label: "Request control";
                clicked => { CallStore.command("control-request", ""); }
            }
            if CallStore.control-mode == "requested": Button { variant: ButtonVariant.action;
                label: "Cancel request";
                clicked => { CallStore.command("control-release", ""); }
            }
            if root.controlling: Button { variant: ButtonVariant.action;
                label: "Release control";
                clicked => { CallStore.command("control-release", ""); }
            }
        }
    }
}

// While we present: the people stay in view, and this says so (our own screen is never shown
// back to us, as Teams does).
component SharingBanner inherits Rectangle {
    height: 44px;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.surface;
    Icon {
        source: @image-url("../icons/screen-share.svg");
        tint: Theme.accent;
        x: 14px;
        y: (root.height - self.height) / 2;
        width: 16px;
        height: 16px;
    }
    Text {
        text: @tr("You're sharing your screen");
        color: Theme.fg;
        font-size: 13px * Theme.font-scale;
        font-weight: 600;
        overflow: elide;
        vertical-alignment: center;
        accessible-role: text;
        x: 38px;
        y: 0px;
        height: root.height;
        width: max(0px, stop.x - self.x - 8px);
    }
    stop := Button { variant: ButtonVariant.action;
        x: root.width - self.width - 5px;
        y: (root.height - self.height) / 2;
        label: @tr("Stop presenting");
        clicked => { CallStore.command("share", ""); }
    }
}

// One row of a tile's "…" menu: a 16px icon and a label. The keyboard-focused row has a white
// outline.
component TileMenuRow inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <string> why;
    in property <bool> enabled: true;
    // Drawn with the keyboard focus outline.
    in property <bool> ring: false;
    callback activated();
    height: 36px;
    border-radius: 4px;
    border-width: root.ring && root.enabled ? 1px : 0px;
    border-color: #ffffff;
    background: touch.has-hover && root.enabled ? Theme.surface-hover : transparent;
    accessible-role: list-item;
    accessible-label: root.label;
    accessible-description: root.why;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.activated();
        }
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        opacity: root.enabled ? 1 : 0.4;
        Icon {
            source: root.icon;
            tint: Theme.fg;
            width: 16px;
            height: 16px;
            y: (root.height - self.height) / 2;
        }
        Text {
            text: root.label;
            color: Theme.fg;
            font-size: 13px * Theme.font-scale;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    touch := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if root.enabled {
                root.activated();
            }
        }
    }
}

// What a tile's "…" button opens, as Teams: Mute participant, Pin for me (Unpin while pinned),
// Spotlight for everyone. Mute and Spotlight stay disabled: the calling crate has no request for
// them yet (see `signaling/controls.rs`). Our own tile only offers Pin. No Report: no API.
component TileMenu inherits Rectangle {
    in property <CallPerson> p;
    callback close();
    // Set by the first arrow or Tab key, so the outline shows for keyboard users only.
    property <bool> keys: false;
    property <bool> pinned: root.p.id != "" && CallStore.pinned == root.p.id;
    property <bool> can-pin: root.pinned || root.p.id != "";
    function pin() {
        if root.can-pin {
            CallStore.pin(root.pinned ? "" : root.p.id);
            root.close();
        }
    }
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.surface;
    drop-shadow-blur: 12px;
    drop-shadow-color: #00000080;
    accessible-role: groupbox;
    accessible-label: @tr("Options for {}", root.p.name);
    scope := FocusScope {
        init => { self.focus(); }
        key-pressed(e) => {
            if e.text == Key.Escape {
                root.close();
                return accept;
            }
            if e.text == Key.Return {
                root.pin();
                return accept;
            }
            if e.text == Key.UpArrow || e.text == Key.DownArrow || e.text == Key.Tab {
                root.keys = true;
                return accept;
            }
            return reject;
        }
        VerticalLayout {
            padding: 4px;
            if !root.p.me: TileMenuRow {
                icon: @image-url("../icons/mic-off.svg");
                label: @tr("Mute participant");
                why: @tr("Not available yet");
                enabled: false;
            }
            TileMenuRow {
                icon: @image-url("../icons/pin.svg");
                label: root.pinned ? @tr("Unpin") : @tr("Pin for me");
                enabled: root.can-pin;
                ring: root.keys && scope.has-focus;
                activated => { root.pin(); }
            }
            if !root.p.me: TileMenuRow {
                icon: @image-url("../icons/star.svg");
                label: @tr("Spotlight for everyone");
                why: @tr("Not available yet");
                enabled: false;
            }
        }
    }
}

// The small arrows of the gallery pager.
component PagerArrow inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked();
    width: 28px;
    height: 28px;
    border-radius: 4px;
    background: touch.has-hover && root.enabled ? Theme.surface-hover : transparent;
    opacity: root.enabled ? 1 : 0.35;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }
    Icon {
        source: root.icon;
        tint: Theme.fg;
        width: 16px;
        height: 16px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// "‹ 1/2 ›" under the gallery when it has more than one page.
component GalleryPager inherits Rectangle {
    in property <int> page;
    in property <int> pages;
    width: row.preferred-width;
    height: 28px;
    row := HorizontalLayout {
        spacing: 6px;
        PagerArrow {
            icon: @image-url("../icons/chevron-left.svg");
            label: @tr("Previous page");
            enabled: root.page > 0;
            clicked => { CallStore.gallery-page = root.page - 1; }
        }
        Text {
            text: @tr("{}/{}", root.page + 1, root.pages);
            color: Theme.fg;
            font-size: 13px * Theme.font-scale;
            vertical-alignment: center;
        }
        PagerArrow {
            icon: @image-url("../icons/chevron-right.svg");
            label: @tr("Next page");
            enabled: root.page < root.pages - 1;
            clicked => { CallStore.gallery-page = root.page + 1; }
        }
    }
}

// What fills the middle: the lobby, connecting, the participants' tiles, or a shared screen.
component Stage inherits Rectangle {
    property <bool> content: CallStore.view-mode == "content" && CallStore.content-shared();
    // The gallery's pages of `gallery-per-page` tiles: the page shown (never past the last one)
    // and the people on it. A pinned person makes it the speaker view.
    property <int> pages: max(1, Math.ceil(CallStore.in-call / CallStore.gallery-per-page));
    property <int> page: max(0, min(CallStore.gallery-page, root.pages - 1));
    property <int> page-start: root.page * CallStore.gallery-per-page;
    property <bool> speaker: CallStore.view-mode == "speaker" || CallStore.pinned != "";
    property <int> count: max(1, min(CallStore.gallery-per-page, CallStore.in-call - root.page-start));
    // The room the pager takes under the tiles.
    property <length> pager-h: root.pages > 1 ? 36px : 0px;
    property <int> cols: count <= 1 ? 1 : count <= 4 ? 2 : count <= 9 ? 3 : 4;
    property <int> rows: Math.ceil(count / cols);
    property <length> gap: 8px;
    // The room under the "You're sharing your screen" banner while we present.
    property <length> top: CallStore.sharing ? 60px : 0px;
    // Tiles are always 16:9: as wide as the width allows, shrunk when the height is the limit.
    property <length> tile-h: max(0px, min(
        (root.width - 32px - (cols - 1) * gap) / cols * 9 / 16,
        (root.height - top - pager-h - 32px - (rows - 1) * gap) / rows));
    property <length> tile-w: tile-h * 16 / 9;
    property <length> grid-h: rows * tile-h + (rows - 1) * gap;
    // How many tiles the last row has, so it is centred like the others.
    property <int> last-n: count - (rows - 1) * cols;
    pure function row-w(n: int) -> length { return n * tile-w + (n - 1) * gap; }
    // The speaker view: the others in a strip under the speaker's tile, at most eight.
    property <int> strip-n: max(0, min(CallStore.speaker-people.length - 1, 8));
    property <length> strip-h: min(120px, root.height / 4);
    property <length> strip-w: min(strip-h * 16 / 9, (root.width - 32px - max(0, strip-n - 1) * gap) / max(1, strip-n));
    background: Theme.main;
    // A tile's "…" menu: whose, where its button is in the stage, and where the menu goes: under
    // the button, above it when that does not fit.
    property <bool> menu-open: false;
    property <CallPerson> menu-p;
    property <length> anchor-x;
    property <length> anchor-y;
    property <length> menu-w: 240px;
    // Rows of 36px (TileMenuRow) in 4px of padding.
    property <length> menu-h: (root.menu-p.me ? 1 : 3) * 36px + 8px;
    property <length> menu-x: max(8px, min(root.anchor-x, root.width - root.menu-w - 8px));
    property <length> menu-y: root.anchor-y + 28px + root.menu-h > root.height - 8px
        ? max(8px, root.anchor-y - root.menu-h - 4px)
        : root.anchor-y + 28px;
    function open-menu(p: CallPerson, ax: length, ay: length) {
        root.menu-p = p;
        root.anchor-x = ax - root.absolute-position.x;
        root.anchor-y = ay - root.absolute-position.y;
        root.menu-open = true;
    }
    if CallStore.phase == "lobby" || CallStore.phase == "connecting": VerticalLayout {
        alignment: center;
        spacing: 14px;
        HorizontalLayout {
            alignment: center;
            Avatar { initials: CallStore.my-initials; size: 88px; }
        }
        Text {
            text: CallStore.phase == "lobby" ? "Someone in the meeting should let you in soon" : "Connecting…";
            color: Theme.fg;
            font-size: 16px * Theme.font-scale;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        if CallStore.phase == "lobby": Text {
            text: "You're in the lobby of " + CallStore.title;
            color: Theme.fg-subtle;
            font-size: 13px * Theme.font-scale;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
    if CallStore.phase == "connected" || CallStore.phase == "reconnecting": Rectangle {
        if CallStore.in-call == 0: Text {
            text: CallStore.kind == "direct" ? CallStore.title : "You're the only one here";
            color: Theme.fg-muted;
            font-size: 15px * Theme.font-scale;
            width: parent.width;
            overflow: elide;
        }
        if root.content: ContentStage {
            width: root.width;
            height: root.height;
        }
        if CallStore.sharing: SharingBanner {
            x: 16px;
            y: 12px;
            width: root.width - 32px;
        }
        // Gallery, also for "content" while nobody shares: one page of it.
        if !root.content && !root.speaker: Rectangle {
            for p[i] in CallStore.people: Rectangle {
                if i >= root.page-start && i < root.page-start + root.count && i < CallStore.in-call: Tile {
                    p: p;
                    menu-enabled: true;
                    more-clicked(who, ax, ay) => { root.open-menu(who, ax, ay); }
                    width: root.tile-w;
                    height: root.tile-h;
                    // Each row is centred: a full one has `cols` tiles, the last one what remains.
                    x: (root.width - root.row-w(Math.floor((i - root.page-start) / root.cols) == root.rows - 1 ? root.last-n : root.cols)) / 2
                        + Math.mod(i - root.page-start, root.cols) * (root.tile-w + root.gap);
                    y: root.top + (root.height - root.top - root.pager-h - root.grid-h) / 2
                        + Math.floor((i - root.page-start) / root.cols) * (root.tile-h + root.gap);
                }
            }
        }
        if !root.content && !root.speaker && root.pages > 1: GalleryPager {
            x: (root.width - self.width) / 2;
            y: root.height - self.height - 4px;
            page: root.page;
            pages: root.pages;
        }
        if !root.content && root.speaker && CallStore.speaker-people.length > 0: Rectangle {
            Tile {
                p: CallStore.speaker-people[0];
                avatar-size: 128px;
                menu-enabled: true;
                more-clicked(who, ax, ay) => { root.open-menu(who, ax, ay); }
                x: 16px;
                y: 16px + root.top;
                width: root.width - 32px;
                height: root.height - root.top - 32px - (root.strip-n > 0 ? root.strip-h + root.gap : 0px);
                accessible-role: text;
                accessible-label: CallStore.pinned != "" && CallStore.pinned == CallStore.speaker-people[0].id
                    ? @tr("Pinned: {}", CallStore.speaker-people[0].name)
                    : "Active speaker: " + CallStore.speaker-people[0].name;
            }
            for p[i] in CallStore.speaker-people: Rectangle {
                x: (root.width - root.strip-n * root.strip-w - (root.strip-n - 1) * root.gap) / 2
                    + (i - 1) * (root.strip-w + root.gap);
                y: root.height - 16px - root.strip-h;
                width: root.strip-w;
                height: root.strip-h;
                if i > 0 && i <= root.strip-n: Tile {
                    p: p;
                    menu-enabled: true;
                    more-clicked(who, ax, ay) => { root.open-menu(who, ax, ay); }
                }
            }
        }
    }
    // The tile menu over everything on the stage; a click outside closes it.
    if root.menu-open && CallStore.phase == "connected": TouchArea {
        width: root.width;
        height: root.height;
        clicked => { root.menu-open = false; }
    }
    if root.menu-open && CallStore.phase == "connected": TileMenu {
        p: root.menu-p;
        x: root.menu-x;
        y: root.menu-y;
        width: root.menu-w;
        height: root.menu-h;
        close => { root.menu-open = false; }
    }
}

// The View button's dropdown: how the stage lays out the people.
component ViewMenu inherits Rectangle {
    width: 220px;
    height: card.preferred-height;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.surface;
    drop-shadow-blur: 12px;
    drop-shadow-color: #00000080;
    card := VerticalLayout {
        padding: 6px;
        for item[i] in [
            { mode: "gallery", label: "Gallery", why: "" },
            { mode: "speaker", label: "Speaker", why: "" },
            { mode: "content", label: "Focus on content", why: CallStore.content-shared() ? "" : "Nobody is sharing" },
        ]: Rectangle {
            property <bool> enabled: item.why == "";
            height: 32px;
            border-radius: 3px;
            background: touch.has-hover && self.enabled ? Theme.surface-hover : transparent;
            accessible-role: list-item;
            accessible-label: item.label;
            accessible-description: item.why;
            accessible-enabled: self.enabled;
            accessible-item-selectable: true;
            accessible-item-selected: CallStore.view-mode == item.mode;
            accessible-action-default => {
                if self.enabled {
                    CallStore.view-mode = item.mode;
                    CallStore.pin("");
                    CallStore.menu = "";
                }
            }
            HorizontalLayout {
                padding-left: 8px;
                spacing: 8px;
                opacity: parent.enabled ? 1 : 0.4;
                Text {
                    text: CallStore.view-mode == item.mode ? "✓" : "";
                    width: 12px;
                    color: Theme.accent;
                    font-size: 13px * Theme.font-scale;
                    vertical-alignment: center;
                }
                Text {
                    text: item.label;
                    color: Theme.fg;
                    font-size: 13px * Theme.font-scale;
                    vertical-alignment: center;
                }
            }
            touch := TouchArea {
                mouse-cursor: parent.enabled ? pointer : default;
                clicked => {
                    if parent.enabled {
                        CallStore.view-mode = item.mode;
                        CallStore.pin("");
                        CallStore.menu = "";
                    }
                }
            }
        }
    }
}

// "Transfer": pick a person, then "Transfer now" (blind transfer). Opening it holds the call.
component TransferCard inherits Rectangle {
    property <string> to-id;
    property <string> to-name;
    height: card.preferred-height;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.surface;
    drop-shadow-blur: 12px;
    drop-shadow-color: #00000080;
    accessible-role: groupbox;
    accessible-label: "Transfer";
    card := VerticalLayout {
        padding: 12px;
        spacing: 10px;
        Text {
            text: "Transfer";
            color: Theme.fg;
            font-size: 14px * Theme.font-scale;
            font-weight: 600;
        }
        Text {
            text: "The call is on hold. Pick who takes it.";
            color: Theme.fg-subtle;
            font-size: 12px * Theme.font-scale;
            wrap: word-wrap;
        }
        if root.to-id == "": PeopleSearch {
            placeholder: "Transfer to";
            picked(f) => {
                root.to-id = f.id;
                root.to-name = f.name;
            }
        }
        if root.to-id != "": HorizontalLayout {
            spacing: 8px;
            Text {
                text: "To: " + root.to-name;
                color: Theme.fg;
                font-size: 13px * Theme.font-scale;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            Button { variant: ButtonVariant.action;
                label: "Change";
                clicked => { root.to-id = ""; }
            }
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Button { variant: ButtonVariant.action;
                label: "Cancel";
                clicked => { CallStore.menu = ""; }
            }
            if root.to-id != "": Button { variant: ButtonVariant.action;
                label: "Transfer now";
                primary: true;
                clicked => {
                    CallStore.command("transfer", root.to-id);
                    CallStore.menu = "";
                }
            }
        }
    }
}

component InCall inherits Rectangle {
    callback open-chat();
    // Below this width the top bar's ~14 buttons do not fit: the less used ones go to More.
    property <bool> fold: root.width < 820px;
    VerticalLayout {
        bar := TopBar { fold: root.fold; open-chat => { root.open-chat(); } }
        // A meeting on hold (call waiting) has the "On hold" bar instead, with its Resume.
        if CallStore.held && CallStore.kind == "direct": Banner {
            message: "You put the call on hold. Select Resume to continue.";
            tone: #4b4f8a;
        }
        if CallStore.held-name != "": HeldBar { }
        if CallStore.phase == "reconnecting": Banner {
            message: "Reconnecting… Your connection was interrupted.";
            tone: #8a5a00;
        }
        if CallStore.error != "": Banner {
            message: CallStore.error;
            tone: #8b2a2d;
            dismissable: true;
        }
        if CallStore.notice != "": Banner {
            message: CallStore.notice;
            tone: #3d3e66;
            dismissable: true;
            dismiss: "dismiss-notice";
            dismiss-label: "Dismiss notice";
        }
        if CallStore.control-mode != "": ControlBanner { }
        HorizontalLayout {
            Stage { horizontal-stretch: 1; }
            if CallStore.panel == "people": PeoplePanel { width: 320px; }
            if CallStore.panel == "more": MorePanel { width: 320px; fold: root.fold; }
        }
    }
    // The View button's dropdown, under the button.
    if CallStore.menu == "view": ViewMenu {
        x: root.fold ? root.width - self.width - 332px : min(bar.view-x, root.width - self.width - 12px);
        y: 64px;
        z: 30;
    }
    // Live captions over the bottom of the stage.
    if CallStore.captions && CallStore.phase == "connected": CaptionStrip {
        x: 16px;
        width: root.width - 32px - (CallStore.panel != "" ? 320px : 0px);
        y: root.height - self.height - 16px;
        z: 20;
    }
    // Live reactions rise over the stage; the React menu sends ours.
    ReactionsOverlay {
        x: 0px;
        y: bar.height;
        width: root.width - (CallStore.panel != "" ? 320px : 0px);
        height: root.height - bar.height;
        z: 15;
    }
    if CallStore.menu == "react" && CallStore.phase == "connected": ReactionMenu {
        x: Math.max(12px, root.fold ? root.width - self.width - 332px : Math.min(bar.react-x, root.width - self.width - 12px));
        y: 64px;
        z: 30;
    }
    // The transfer dialog, under the top bar.
    if CallStore.menu == "transfer": TransferCard {
        x: root.width - self.width - 12px;
        y: 64px;
        z: 30;
        width: 340px;
    }
    // The Share chevron's dropdown (Give control).
    if CallStore.menu == "share": ShareMenu {
        x: root.width - self.width - 12px;
        y: 64px;
        z: 30;
    }
    // The mic button's dropdown.
    if CallStore.menu == "devices" || CallStore.menu == "card-mic" || CallStore.menu == "card-speaker": Rectangle {
        x: root.width - self.width - 12px;
        y: 64px;
        z: 30;
        width: 300px;
        height: card.preferred-height;
        border-radius: Theme.radius;
        border-width: 1px;
        border-color: Theme.border;
        background: Theme.surface;
        drop-shadow-blur: 12px;
        drop-shadow-color: #00000080;
        card := VerticalLayout {
            padding: 12px;
            spacing: 10px;
            Text {
                text: "Audio devices";
                color: Theme.fg;
                font-size: 14px * Theme.font-scale;
                font-weight: 600;
            }
            DeviceSettings { prefix: "card"; }
        }
    }
}

component Ended inherits Rectangle {
    background: Theme.main;
    VerticalLayout {
        alignment: center;
        spacing: 12px;
        Text {
            text: CallStore.title;
            color: Theme.fg;
            font-size: 20px * Theme.font-scale;
            font-weight: 600;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        Text {
            text: CallStore.ended;
            color: Theme.fg;
            font-size: 15px * Theme.font-scale;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        if CallStore.timer != "00:00": Text {
            text: "Call duration " + CallStore.timer;
            color: Theme.fg-subtle;
            font-size: 13px * Theme.font-scale;
            horizontal-alignment: center;
        }
        if CallStore.error != "": Text {
            text: CallStore.error;
            color: Theme.danger;
            font-size: 13px * Theme.font-scale;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: center;
            spacing: 8px;
            if CallStore.can-rejoin: Button { variant: ButtonVariant.action;
                label: "Rejoin";
                primary: true;
                clicked => { CallStore.command("rejoin", ""); }
            }
            Button { variant: ButtonVariant.action;
                label: "Close";
                clicked => { CallStore.command("close", ""); }
            }
        }
    }
    // The quality survey; Send and Dismiss both close the screen, as Close does. Send is one
    // command (the backend keeps the answer, then closes): two would run in no set order.
    if CallStore.feedback-open: CallFeedback {
        width: root.width;
        height: root.height;
        sent(answer) => { CallStore.command("feedback", answer); }
        dismissed => { CallStore.command("close", ""); }
    }
}

export component CallWindow inherits Rectangle {
    // The meeting chat: shrink the call to its floating bar and show the chat.
    callback open-chat();
    background: Theme.main;
    // Nothing behind the call window takes clicks.
    TouchArea { }
    if CallStore.phase == "prejoin": PreJoin { width: root.width; height: root.height; }
    if CallStore.in-call-phase(): InCall {
        width: root.width;
        height: root.height;
        open-chat => { root.open-chat(); }
    }
    if CallStore.phase == "ended": Ended { width: root.width; height: root.height; }
}

// The call while the meeting chat is open: title, timer, mute, back to the call, leave.
// The floating call's tiles: the latest speaker, or up to four people two by two, and how many
// more are in the call.
component MiniStage inherits Rectangle {
    property <bool> gallery: CallStore.mini-layout == "gallery" && CallStore.mini-people.length > 1;
    property <int> count: gallery ? CallStore.mini-people.length : min(1, CallStore.mini-people.length);
    property <length> gap: 4px;
    property <int> cols: count <= 1 ? 1 : 2;
    property <int> rows: count <= 2 ? 1 : 2;
    property <length> tile-w: (root.width - (cols - 1) * gap) / cols;
    property <length> tile-h: (root.height - (rows - 1) * gap) / rows;
    for person[i] in CallStore.mini-people: Tile {
        visible: i < root.count;
        p: person;
        x: Math.mod(i, root.cols) * (root.tile-w + root.gap);
        y: Math.floor(i / root.cols) * (root.tile-h + root.gap);
        width: root.tile-w;
        height: root.tile-h;
        background: Theme.main;
    }
    if CallStore.mini-more + CallStore.mini-people.length - root.count > 0: Rectangle {
        x: root.width - self.width - 6px;
        y: 6px;
        width: more.preferred-width + 12px;
        height: 20px;
        border-radius: 10px;
        background: Theme.surface;
        more := Text {
            text: "+" + (CallStore.mini-more + CallStore.mini-people.length - root.count);
            color: Theme.fg;
            font-size: 11px * Theme.font-scale;
            accessible-role: text;
            accessible-label: @tr("{} more in the call", CallStore.mini-more + CallStore.mini-people.length - root.count);
        }
    }
}

// A small icon button of the floating call: icon only, its label for screen readers and tests.
component MiniButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> danger;
    in property <bool> active;
    callback clicked();
    width: 30px;
    height: 30px;
    border-radius: 4px;
    background: touch.has-hover && root.enabled ? Theme.surface-hover : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-checked: root.active;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    Icon {
        source: root.icon;
        tint: root.danger ? Theme.danger : Theme.fg;
        width: 18px;
        height: 18px;
        opacity: root.enabled ? 1 : 0.4;
    }
    touch := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { if root.enabled { root.clicked(); } }
    }
}

// The call while another page is open, shaped like Teams' floating call: a header to drag it by
// with the title and a button back to the full call, the timer and the call buttons, and the tile
// of the person we talk to.
export component CallMini inherits Rectangle {
    width: 360px;
    height: 280px;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.surface;
    drop-shadow-blur: 16px;
    drop-shadow-color: #00000080;
    // Drag it anywhere in the window by any free spot.
    TouchArea {
        mouse-cursor: move;
        moved => {
            if self.pressed {
                CallStore.mini-dx += self.mouse-x - self.pressed-x;
                CallStore.mini-dy += self.mouse-y - self.pressed-y;
            }
        }
    }
    VerticalLayout {
        padding: 6px;
        padding-top: 2px;
        spacing: 4px;
        Text {
            text: "⠿";
            color: Theme.fg-muted;
            font-size: 12px;
            horizontal-alignment: center;
            accessible-role: none;
        }
        HorizontalLayout {
            padding-left: 6px;
            spacing: 4px;
            Text {
                text: CallStore.title;
                color: Theme.fg;
                font-size: 13px * Theme.font-scale;
                overflow: elide;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            MiniButton {
                icon: CallStore.mini-layout == "gallery" ? @image-url("../icons/people.svg") : @image-url("../icons/grid.svg");
                label: CallStore.mini-layout == "gallery" ? "Show the speaker" : "Show more people";
                enabled: CallStore.mini-people.length > 1;
                clicked => {
                    CallStore.mini-layout = CallStore.mini-layout == "gallery" ? "speaker" : "gallery";
                }
            }
            MiniButton {
                icon: @image-url("../icons/expand.svg");
                label: "Back to call";
                clicked => { CallStore.minimized = false; }
            }
        }
        HorizontalLayout {
            padding-left: 6px;
            spacing: 2px;
            Text {
                text: CallStore.phase == "ended" ? CallStore.ended : CallStore.timer;
                color: Theme.fg-muted;
                font-size: 12px * Theme.font-scale;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            MiniButton {
                icon: CallStore.camera ? @image-url("../icons/video.svg") : @image-url("../icons/video-off.svg");
                label: "Camera";
                active: CallStore.camera;
                enabled: CallStore.can-camera || CallStore.camera;
                clicked => { CallStore.command("camera", ""); }
            }
            MiniButton {
                icon: CallStore.muted ? @image-url("../icons/mic-off.svg") : @image-url("../icons/mic.svg");
                label: CallStore.muted ? "Unmute" : "Mute";
                active: CallStore.muted;
                clicked => { CallStore.command("mute", ""); }
            }
            MiniButton {
                icon: @image-url("../icons/screen-share.svg");
                label: CallStore.sharing ? "Stop sharing" : "Share";
                active: CallStore.sharing;
                enabled: CallStore.can-share || CallStore.sharing;
                clicked => { CallStore.command("share", ""); }
            }
            if CallStore.phase != "ended": MiniButton {
                icon: @image-url("../icons/call-end.svg");
                label: "Leave";
                danger: true;
                clicked => { CallStore.command("leave", ""); }
            }
            // The ended card closes like the full call-ended screen's Close.
            if CallStore.phase == "ended": MiniButton {
                icon: @image-url("../icons/close.svg");
                label: "Close call";
                clicked => { CallStore.command("close", ""); }
            }
        }
        if CallStore.held-name != "": HeldBar { compact: true; }
        MiniStage { vertical-stretch: 1; }
    }
}
