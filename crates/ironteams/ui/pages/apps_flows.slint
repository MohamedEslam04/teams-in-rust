// Workflows: your flows and the run history of the selected one, with Run (a manual flow) and
// Turn on or off for the selected flow.
import { ScrollView } from "std-widgets.slint";
import { Theme } from "../tokens/theme.slint";
import { IconButton } from "../atoms/widgets.slint";
import { FlowsStore, AppRow } from "../stores/apps_store.slint";
import { KitNote } from "../molecules/apps_kit.slint";
import { Button, ButtonVariant } from "../atoms/button.slint";
import { Badge, BadgeVariant } from "../atoms/chip.slint";

component FlowRowView inherits Rectangle {
    in property <AppRow> f;
    callback clicked();
    height: 64px;
    border-radius: 4px;
    background: root.f.selected ? Theme.selected : (touch.has-hover ? Theme.surface-hover : transparent);
    accessible-role: button;
    accessible-label: root.f.title;
    accessible-description: root.f.badge + ", " + root.f.subtitle;
    accessible-item-selected: root.f.selected;
    Rectangle { x: 0; y: 14px; width: 3px; height: 36px; border-radius: 2px; background: root.f.selected ? Theme.accent : transparent; }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 10px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            min-width: 0px;
            spacing: 2px;
            Text { text: root.f.title; color: Theme.fg; font-size: 13px * Theme.font-scale; font-weight: 600; overflow: elide; }
            Text { text: root.f.subtitle; color: Theme.fg-muted; font-size: 11px * Theme.font-scale; overflow: elide; }
            Text { text: root.f.meta; color: Theme.fg-subtle; font-size: 11px * Theme.font-scale; overflow: elide; }
        }
        Badge { variant: BadgeVariant.status; y: 22px; text: root.f.badge; tone: root.f.tone; }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

export component FlowsView inherits Rectangle {
    background: Theme.main;
    init => { FlowsStore.command("flows-enter", ""); }
    HorizontalLayout {
        Rectangle {
            width: 360px;
            background: Theme.panel;
            VerticalLayout {
                Rectangle {
                    height: 56px;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 8px;
                        spacing: 8px;
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text { text: "Workflows"; color: Theme.fg; font-size: 18px * Theme.font-scale; font-weight: 700; }
                            Text { text: FlowsStore.environment; color: Theme.fg-subtle; font-size: 11px * Theme.font-scale; overflow: elide; }
                        }
                        IconButton { y: 12px; icon: @image-url("../icons/sync.svg"); tooltip: "Refresh flows"; clicked => { FlowsStore.command("flows-refresh", ""); } }
                    }
                }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        width: parent.width - 12px;
                        padding-left: 8px;
                        padding-right: 8px;
                        alignment: start;
                        for f in FlowsStore.flows: FlowRowView {
                            f: f;
                            clicked => { FlowsStore.command("flows-select", f.id); }
                        }
                    }
                }
            }
        }
        VerticalLayout {
            Rectangle {
                height: 56px;
                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 16px;
                    spacing: 8px;
                    Text {
                        text: FlowsStore.selected-name == "" ? "Run history" : "Run history of " + FlowsStore.selected-name;
                        color: Theme.fg;
                        font-size: 16px * Theme.font-scale;
                        font-weight: 700;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    Button { variant: ButtonVariant.kit; y: 12px; label: "Run"; primary: true; enabled: FlowsStore.can-run; clicked => { FlowsStore.command("flow-run", FlowsStore.selected-id); } }
                    Button { variant: ButtonVariant.kit; y: 12px; label: FlowsStore.selected-on ? "Turn off" : "Turn on"; enabled: FlowsStore.can-toggle; clicked => { FlowsStore.command("flow-toggle", FlowsStore.selected-id); } }
                }
            }
            KitNote { text: "Run starts a flow with a button trigger once. Turn on or off changes whether a flow runs on its trigger. Building flows is done in Power Automate."; text-size: 12px; }
            if FlowsStore.loading: KitNote { text: "Loading…"; busy: true; }
            if FlowsStore.status != "": KitNote { text: FlowsStore.status; }
            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    width: parent.width - 12px;
                    padding: 12px;
                    alignment: start;
                    for r in FlowsStore.runs: Rectangle {
                        height: 44px;
                        accessible-role: list-item;
                        accessible-label: r.title;
                        accessible-description: r.badge + ", " + r.subtitle;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 12px;
                            Text { text: r.title; color: Theme.fg; font-size: 13px * Theme.font-scale; vertical-alignment: center; width: 150px; overflow: elide; }
                            Text { text: r.subtitle; color: Theme.fg-muted; font-size: 12px * Theme.font-scale; vertical-alignment: center; width: 70px; overflow: elide; }
                            Text { text: r.meta; color: Theme.fg-subtle; font-size: 12px * Theme.font-scale; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                            Badge { variant: BadgeVariant.status; y: 12px; text: r.badge; tone: r.tone; }
                        }
                        Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
                    }
                }
            }
        }
    }
}
