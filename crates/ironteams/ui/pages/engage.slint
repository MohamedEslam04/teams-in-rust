// Viva Engage communities: the read-only feed of one community. Everything shown comes from the
// `EngageStore` global, filled by `src/ui/engage.rs`. Posting, replying and liking are drawn but
// disabled: the backend has no command that writes (plan S3.2, storyline posts are BLOCKED).
import { ScrollView } from "std-widgets.slint";
import { Theme } from "../tokens/theme.slint";
import { IconButton } from "../atoms/widgets.slint";
import { Avatar } from "../atoms/avatar.slint";
import { SkeletonList, Spinner } from "../tokens/motion.slint";
import { Button, ButtonVariant } from "../atoms/button.slint";

export struct EPost {
    id: string,
    sender: string,
    initials: string,
    time: string,
    text: string,
    likes: int,
    replies: int,
    attachments: int,
    url: string,
    // A reply whose original post is not in the loaded pages.
    reply: bool,
}

// Text size multiplier. Until `Theme.font-scale` lands this is the one place to switch it on.
global EngageType {
    out property <float> scale: 1.0;
}

export global EngageStore {
    in-out property <bool> open: false;
    // The open community's id and name.
    in property <string> community;
    in property <string> title;
    in property <[EPost]> posts;
    // An older page may exist.
    in property <bool> more;
    in property <bool> loading;
    in property <string> error;
    // (name, argument): open, refresh, older, close, open-web. See `backend/engage.rs`.
    callback command(string, string);
}

// A control that is shown but cannot be used.
component Disabled inherits Rectangle {
    in property <string> label;
    height: 28px;
    width: lbl.preferred-width + 24px;
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.border;
    opacity: 0.55;
    accessible-role: button;
    accessible-label: root.label;
    accessible-description: "Posting is not available yet";
    accessible-enabled: false;
    lbl := Text {
        text: root.label;
        color: Theme.fg-muted;
        font-size: 12px * EngageType.scale;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component EngagePostCard inherits Rectangle {
    in property <EPost> p;
    height: lay.preferred-height;
    border-radius: Theme.radius;
    background: Theme.surface;
    accessible-role: list-item;
    accessible-label: root.p.sender;
    accessible-description: root.p.text;
    lay := HorizontalLayout {
        padding: 14px;
        spacing: 12px;
        Avatar { initials: root.p.initials; size: 36px; }
        VerticalLayout {
            spacing: 6px;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: root.p.sender;
                    color: Theme.fg;
                    font-size: 13px * EngageType.scale;
                    font-weight: 600;
                    overflow: elide;
                }
                Text { text: root.p.reply ? "replied · " + root.p.time : root.p.time; color: Theme.fg-subtle; font-size: 11px * EngageType.scale; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
            }
            if root.p.text != "": Text {
                text: root.p.text;
                color: Theme.fg;
                font-size: 13px * EngageType.scale;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 14px;
                Text { text: root.p.likes == 1 ? "1 like" : root.p.likes + " likes"; color: Theme.fg-subtle; font-size: 11px * EngageType.scale; vertical-alignment: center; }
                Text { text: root.p.replies == 1 ? "1 reply" : root.p.replies + " replies"; color: Theme.fg-subtle; font-size: 11px * EngageType.scale; vertical-alignment: center; }
                if root.p.attachments > 0: Text { text: root.p.attachments == 1 ? "1 attachment" : root.p.attachments + " attachments"; color: Theme.fg-subtle; font-size: 11px * EngageType.scale; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                Disabled { label: "Like"; }
                Disabled { label: "Reply"; }
                if root.p.url != "": Text {
                    text: "Open in browser";
                    color: Theme.accent;
                    font-size: 11px * EngageType.scale;
                    vertical-alignment: center;
                    accessible-role: button;
                    accessible-label: "Open in browser";
                    accessible-action-default => { EngageStore.command("open-web", root.p.url); }
                    TouchArea { mouse-cursor: pointer; clicked => { EngageStore.command("open-web", root.p.url); } }
                }
            }
        }
    }
}

// The feed, drawn over the area right of the rail.
export component EngageView inherits Rectangle {
    background: Theme.main;
    TouchArea { }
    VerticalLayout {
        padding: 16px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 10px;
            height: 36px;
            Text {
                text: EngageStore.title != "" ? EngageStore.title : "Community";
                color: Theme.fg;
                font-size: 18px * EngageType.scale;
                font-weight: 700;
                vertical-alignment: center;
                overflow: elide;
            }
            Rectangle { horizontal-stretch: 1; }
            IconButton {
                icon: @image-url("../icons/sync.svg");
                tooltip: "Refresh";
                clicked => { if !EngageStore.loading { EngageStore.command("refresh", ""); } }
            }
            IconButton {
                icon: @image-url("../icons/close.svg");
                tooltip: "Close community";
                clicked => { EngageStore.open = false; EngageStore.command("close", ""); }
            }
        }
        // The write controls, disabled.
        Rectangle {
            height: 44px;
            border-radius: Theme.radius;
            background: Theme.surface;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 10px;
                spacing: 12px;
                Text { text: "Start a post"; color: Theme.fg-subtle; font-size: 13px * EngageType.scale; vertical-alignment: center; horizontal-stretch: 1; }
                Text { text: "Posting is not available yet"; color: Theme.fg-subtle; font-size: 12px * EngageType.scale; vertical-alignment: center; }
                VerticalLayout { alignment: center; Button { variant: ButtonVariant.dialog; label: "Post"; enabled: false; } }
            }
        }
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 8px;
                alignment: start;
                if EngageStore.loading && EngageStore.posts.length == 0: SkeletonList {
                    count: 4;
                    avatar: 36px;
                    row-height: 96px;
                    label: "Loading posts";
                }
                if EngageStore.error != "": Rectangle {
                    height: err-lay.preferred-height;
                    border-radius: Theme.radius;
                    border-width: 1px;
                    border-color: Theme.danger;
                    background: Theme.surface;
                    accessible-role: text;
                    accessible-label: "Error: " + EngageStore.error;
                    err-lay := HorizontalLayout {
                        padding: 12px;
                        spacing: 12px;
                        Text { text: EngageStore.error; color: Theme.fg; font-size: 13px * EngageType.scale; wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1; }
                        Button { variant: ButtonVariant.dialog; label: "Try again"; clicked => { EngageStore.command("refresh", ""); } }
                    }
                }
                if !EngageStore.loading && EngageStore.error == "" && EngageStore.posts.length == 0: Text {
                    text: "No posts yet.";
                    color: Theme.fg-subtle;
                    font-size: 13px * EngageType.scale;
                    accessible-role: text;
                    accessible-label: "No posts yet";
                }
                for p in EngageStore.posts: EngagePostCard { p: p; }
                if EngageStore.loading && EngageStore.posts.length > 0: HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Spinner { }
                    Text {
                        text: "Loading…";
                        color: Theme.fg-subtle;
                        font-size: 12px * EngageType.scale;
                        accessible-role: text;
                        accessible-label: "Loading";
                    }
                }
                if EngageStore.more: Button { variant: ButtonVariant.dialog;
                    label: "Older posts";
                    enabled: !EngageStore.loading;
                    clicked => { EngageStore.command("older", ""); }
                }
            }
        }
    }
}
