// The pages of Settings. Each one reads `SettingsStore` and reports changes through
// `SettingsStore.command(name, argument)`; the Rust side saves local preferences and only plans
// (dry run) the changes that belong to Teams.
//
// Every page is built from the Settings kit (molecules/settings_kit.slint): sections with a
// heading over a card, one setting per row, the control on the end side of its row.
import { Theme } from "../tokens/theme.slint";
import { Space } from "../tokens/space.slint";
import { SettingsStore, SOption, SNotify } from "../stores/settings_store.slint";
import { EmojiItem } from "../tokens/types.slint";
import { PeopleStore } from "../molecules/people.slint";
import { SRadio, SRadioList, ThemeTile, ThemeTileMetrics } from "../molecules/settings_widgets.slint";
import { FontChoiceRow, SettingsBlock, SettingsButtonRow, SettingsChoiceRow, SettingsMetrics, SettingsNote, SettingsOrderRow, SettingsRow, SettingsSection, SettingsSections, SettingsSwitchRow, SPersonRow, ThemeChoiceRow } from "../molecules/settings_kit.slint";
import { SnippetsSection } from "settings_snippets.slint";
import { ListStore } from "../organisms/lists.slint";
import { AppsStore, RailItems } from "../stores/apps_store.slint";
import { Button, ButtonVariant } from "../atoms/button.slint";
import { Field, FieldVariant } from "../atoms/field.slint";
import { Fixed } from "../tokens/fixed.slint";
import { IconButton } from "../atoms/widgets.slint";
import { MenuColumn, MenuItem } from "../atoms/menu.slint";

// The Teams changes that were only planned, so the user sees exactly what was not sent.
component DryRuns inherits SettingsSection {
    title: @tr("Planned changes (not sent to Teams)");
    description: @tr("IronTeams does not change Teams settings yet. Each change is shown here as the request it would send.");
    SettingsBlock {
        if SettingsStore.dry-runs.length == 0: SettingsNote { text: @tr("None yet."); }
        for d[i] in SettingsStore.dry-runs: Rectangle {
            height: dr.preferred-height + 12px;
            border-radius: 4px;
            background: Theme.surface;
            accessible-role: text;
            accessible-label: @tr("Planned request {}", i + 1);
            accessible-description: d;
            dr := Text {
                x: 8px;
                width: parent.width - 16px;
                text: d;
                color: Theme.fg-muted;
                font-size: Theme.font-small;
                font-family: Theme.font-code;
                wrap: word-wrap;
                vertical-alignment: center;
            }
        }
    }
}

// A status line under a page's sections (what the last change answered).
component PageNote inherits HorizontalLayout {
    in property <string> text;
    padding-left: Space.xxs;
    padding-right: Space.xxs;
    SettingsNote { text: root.text; }
}

export component GeneralPage inherits SettingsSections {
    SettingsSection {
        title: @tr("Language and region");
        SettingsChoiceRow {
            label: @tr("App language");
            description: @tr("Now: {}. The main screens are translated; the rest stays in English for now.", SettingsStore.language-shown);
            options: SettingsStore.languages;
            value: SettingsStore.language;
            picked(v) => { SettingsStore.language = v; SettingsStore.command("language", v); }
        }
        SettingsChoiceRow {
            label: @tr("Date format");
            description: @tr("Used for dates in the chat list and in OneDrive.");
            options: [{v: "auto", l: @tr("Follow the language")}, {v: "dmy", l: "31/12/2026"}, {v: "mdy", l: "12/31/2026"}, {v: "ymd", l: "2026-12-31"}];
            value: SettingsStore.date-format;
            picked(v) => { SettingsStore.date-format = v; SettingsStore.command("date-format", v); }
        }
        SettingsChoiceRow {
            label: @tr("Time format");
            description: @tr("Used for every clock time: chats, the calendar, reminders, scheduled messages and OneDrive.");
            options: [{v: "h12", l: @tr("12-hour (1:30 PM)")}, {v: "h24", l: @tr("24-hour (13:30)")}];
            value: SettingsStore.time-format;
            picked(v) => { SettingsStore.time-format = v; SettingsStore.command("time-format", v); }
        }
        SettingsBlock {
            Field {
                variant: FieldVariant.settings;
                label: @tr("Time zone");
                placeholder: @tr("System: {}", SettingsStore.system-time-zone);
                text: SettingsStore.time-zone;
                committed(t) => { SettingsStore.command("time-zone", t); }
            }
            SettingsNote { text: @tr("An IANA name such as Africa/Cairo. Leave it empty to follow the system. Chat times, the calendar, OneDrive and Store dates use it. A name that is not a time zone is ignored and the system zone is used."); }
        }
    }
    SettingsSection {
        title: @tr("Start");
        SettingsChoiceRow {
            label: @tr("When IronTeams starts, open");
            description: @tr("Where I left off opens the page and the chat you had open when you closed IronTeams.");
            options: [{v: "activity", l: @tr("Activity")}, {v: "chat", l: @tr("Chat")}, {v: "teams", l: @tr("Teams")}, {v: "calendar", l: @tr("Calendar")}, {v: "last", l: @tr("Where I left off")}];
            value: SettingsStore.start-page;
            picked(v) => { SettingsStore.start-page = v; SettingsStore.command("start-page", v); }
        }
    }
    SettingsSection {
        title: @tr("Writing");
        SettingsSwitchRow {
            label: @tr("Check spelling");
            description: @tr("Underline misspelled words in the message box. Right-click a word for suggestions. Uses the English and Arabic Hunspell dictionaries installed on this computer.");
            checked: SettingsStore.check-spelling;
            toggled(on) => { SettingsStore.check-spelling = on; SettingsStore.command("check-spelling", on ? "1" : "0"); }
        }
    }
    SettingsSection {
        title: @tr("System");
        for t in SettingsStore.startup: SettingsSwitchRow {
            label: t.label;
            description: t.hint;
            checked: t.on;
            enabled: t.enabled;
            toggled(on) => { SettingsStore.command("startup", SettingsStore.j2(t.key, on ? "1" : "0")); }
        }
    }
    SettingsSection {
        title: @tr("Performance");
        SettingsChoiceRow {
            label: @tr("Graphics");
            description: @tr("CPU draws with the processor and uses the least memory. GPU uses the graphics card, can feel smoother and uses more memory.");
            options: [{v: "cpu", l: @tr("CPU (low memory, default)")}, {v: "gpu", l: @tr("GPU (smoother, uses more memory)")}];
            value: SettingsStore.renderer;
            picked(v) => { SettingsStore.renderer = v; SettingsStore.command("renderer", v); }
        }
        SettingsRow {
            label: SettingsStore.renderer-running == "gpu" ? @tr("Running: GPU") : @tr("Running: CPU");
            description: SettingsStore.renderer-restart ? @tr("Restart IronTeams to apply") : "";
            if SettingsStore.renderer-restart: Button {
                variant: ButtonVariant.settings;
                label: @tr("Restart now");
                clicked => { SettingsStore.command("restart", ""); }
            }
        }
        if SettingsStore.renderer-fallback: SettingsBlock {
            SettingsNote { text: @tr("GPU graphics are not available here, using CPU"); }
        }
    }
    // What IronTeams cannot do yet is greyed out, below the settings that work.
    SettingsSection {
        title: @tr("Translation");
        description: @tr("Translation preferences are a Teams account setting. IronTeams cannot change them yet, so these show Teams' choices greyed out. Translate in a message's … menu.");
        SettingsChoiceRow {
            label: @tr("Translate messages into");
            options: [{v: "app", l: @tr("The app language")}];
            value: "app";
            enabled: false;
            picked(v) => { }
        }
        SettingsSwitchRow {
            label: @tr("Ask me before translating");
            enabled: false;
            checked: true;
        }
        SettingsSwitchRow {
            label: @tr("Never translate messages in these languages");
            description: @tr("Adding languages needs the same Teams setting.");
            enabled: false;
            checked: false;
        }
    }
    SettingsSection {
        title: @tr("Spell check languages");
        SettingsBlock {
            SettingsNote { text: @tr("IronTeams checks with the English and Arabic Hunspell dictionaries installed on this computer. Choosing up to three languages is not available yet."); }
        }
    }
    SettingsSection {
        title: @tr("Meetings");
        SettingsSwitchRow {
            label: @tr("New meeting controls");
            description: @tr("IronTeams's call window has one set of controls.");
            enabled: false;
            checked: true;
        }
        SettingsSwitchRow {
            label: @tr("Ask me to confirm when I leave a meeting");
            description: @tr("Not available in IronTeams yet.");
            enabled: false;
            checked: false;
        }
    }
    SettingsSection {
        title: @tr("Out of office");
        SettingsButtonRow {
            description: @tr("Automatic replies with a start, an end and a message are an Outlook mailbox setting. IronTeams cannot read or schedule them yet: set them in Teams or Outlook.");
            button-label: @tr("Schedule");
            button-enabled: false;
        }
    }
    SettingsSection {
        title: @tr("Keyboard");
        SettingsChoiceRow {
            label: @tr("Keyboard shortcuts");
            description: @tr("IronTeams uses the Teams shortcuts (Ctrl+. lists them).");
            options: [{v: "teams", l: @tr("Teams")}];
            value: "teams";
            enabled: false;
            picked(v) => { }
        }
        SettingsSwitchRow {
            label: @tr("Use Enter or Spacebar to show content");
            description: @tr("Not available in IronTeams yet.");
            enabled: false;
            checked: false;
        }
    }
}

export component ChatsPage inherits SettingsSections {
    // The composer's own setting (it is also in the composer's "more" menu).
    in property <bool> enter-sends: true;
    callback set-enter-sends(bool);
    // A quick reaction slot was chosen: its index, and the window position under it.
    callback pick-quick-reaction(int, length, length);
    // The chat list's display options, also in the list's "... > Customize view" menu (the same
    // `ListStore` state and commands).
    SettingsSection {
        title: @tr("Chat list");
        SettingsSwitchRow {
            label: @tr("Show message previews");
            description: @tr("Off: each chat takes one line, with the name only.");
            checked: ListStore.show-previews;
            toggled(on) => { ListStore.command("option", "previews\u{9}" + (on ? "on" : "off")); }
        }
        SettingsSwitchRow {
            label: @tr("Show time stamps");
            description: @tr("The time of the last message at the end of each chat.");
            checked: ListStore.show-times;
            toggled(on) => { ListStore.command("option", "times\u{9}" + (on ? "on" : "off")); }
        }
        SettingsSwitchRow {
            label: @tr("Chats and channels together");
            description: @tr("Channels are listed in the Chats section instead of their own.");
            checked: ListStore.combined;
            toggled(on) => { ListStore.command("option", "combined\u{9}" + (on ? "on" : "off")); }
        }
        SettingsButtonRow {
            label: @tr("Sections");
            description: @tr("Group chats in a section of your own in the chat list.");
            button-label: @tr("New section");
            clicked => { ListStore.open-new-section(); }
        }
    }
    SettingsSection {
        title: @tr("Opening a chat");
        SettingsChoiceRow {
            label: @tr("When I open a chat take me to");
            description: @tr("Last read opens at the first message you have not read, with the New messages line.");
            options: [{v: "newest", l: @tr("Newest message")}, {v: "last-read", l: @tr("Last read")}];
            value: SettingsStore.open-chat-at;
            picked(v) => { SettingsStore.open-chat-at = v; SettingsStore.command("open-chat-at", v); }
        }
    }
    SettingsSection {
        title: @tr("Writing");
        SettingsSwitchRow {
            label: @tr("Press Enter to send");
            description: @tr("Off: Enter starts a new line and Ctrl+Enter sends.");
            checked: root.enter-sends;
            toggled(on) => { root.set-enter-sends(on); }
        }
    }
    SettingsSection {
        title: @tr("Reactions");
        SettingsRow {
            label: @tr("Quick reactions");
            description: @tr("The reactions shown when you point at a message. Choose one to replace it with any reaction Teams offers; an empty slot adds one.");
            stacked: true;
            HorizontalLayout {
                spacing: Space.xs;
                alignment: Theme.rtl ? LayoutAlignment.end : LayoutAlignment.start;
                for i in 6: Rectangle {
                    property <bool> filled: i < SettingsStore.quick-reactions.length;
                    property <EmojiItem> item: SettingsStore.quick-reactions[i];
                    width: 36px;
                    height: 36px;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: slot.has-hover ? Theme.accent : Theme.border;
                    background: slot.has-hover ? Theme.surface-hover : transparent;
                    accessible-role: button;
                    accessible-label: self.filled ? @tr("Quick reaction {}: {}", i + 1, self.item.name) : @tr("Quick reaction {}: empty", i + 1);
                    accessible-action-default => { root.pick-quick-reaction(i, self.absolute-position.x, self.absolute-position.y + self.height + 4px); }
                    Text {
                        text: parent.filled ? parent.item.emoji : "+";
                        color: parent.filled ? Theme.fg : Theme.fg-subtle;
                        font-size: parent.filled ? 18px * Theme.font-scale : Theme.font-heading;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        accessible-role: none;
                    }
                    slot := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.pick-quick-reaction(i, parent.absolute-position.x, parent.absolute-position.y + parent.height + 4px); }
                    }
                }
            }
        }
        SettingsButtonRow {
            label: @tr("Reset quick reactions");
            description: @tr("Back to Like, Heart, Laugh and Surprised.");
            button-label: @tr("Reset to default");
            clicked => { SettingsStore.command("quick-reaction-reset", ""); }
        }
    }
    SettingsSection {
        title: @tr("Scrolling");
        SettingsChoiceRow {
            label: @tr("Mouse wheel speed");
            description: @tr("How far one notch of the mouse wheel scrolls messages and posts. A touchpad scrolls as it always does.");
            options: [{v: "1", l: "1×"}, {v: "2", l: "2×"}, {v: "2.5", l: "2.5×"}, {v: "3", l: "3×"}, {v: "4", l: "4×"}, {v: "5", l: "5×"}];
            value: Math.round(SettingsStore.wheel-speed * 10) == 25 ? "2.5" : "" + Math.round(SettingsStore.wheel-speed);
            picked(v) => { SettingsStore.wheel-speed = v.to-float(); SettingsStore.command("wheel-speed", v); }
        }
    }
    SettingsSection {
        title: @tr("Privacy and previews");
        SettingsSwitchRow {
            label: @tr("Read receipts");
            description: @tr("People see when you have read their message. This is the same setting as in Privacy.");
            checked: PeopleStore.receipts-on;
            toggled(on) => { PeopleStore.command("receipts", on ? "on" : "off"); }
        }
        SettingsSwitchRow {
            label: @tr("Link previews");
            description: @tr("Show a card with the title and picture under messages that contain a link.");
            checked: SettingsStore.link-previews;
            toggled(on) => { SettingsStore.command("link-previews", on ? "1" : "0"); }
        }
    }
    // Saved quick replies for the composer's `/` (src/snippets.rs).
    SnippetsSection { }
}

export component AccountsPage inherits SettingsSections {
    // First, so the notice is seen right after a switch (and stays on screen in short windows).
    if SettingsStore.restart-needed: SettingsSection {
        title: @tr("Restart needed");
        SettingsButtonRow {
            description: @tr("The change is saved. IronTeams uses it after a restart.");
            button-label: @tr("Restart IronTeams");
            primary: true;
            clicked => { SettingsStore.command("restart", ""); }
        }
    }
    SettingsSection {
        title: @tr("Accounts");
        description: @tr("The account IronTeams signs in with. Switching restarts IronTeams. Each account keeps its own chats on this computer.");
        SettingsBlock {
            for a in SettingsStore.accounts: SRadio {
                group: @tr("Account");
                label: a.name != "" ? a.name : a.label;
                detail: a.upn;
                checked: a.active;
                picked => { SettingsStore.command("switch-account", a.label); }
            }
        }
    }
    SettingsSection {
        title: @tr("Add an account");
        description: @tr("Pick a short name (letters, digits, - _ .), then restart IronTeams: it shows a code to sign in with, on this computer, for the new account. The accounts stay separate.");
        SettingsBlock {
            new-account := Field {
                variant: FieldVariant.settings;
                label: @tr("Name for the new account");
                placeholder: "work";
            }
            HorizontalLayout {
                alignment: Theme.rtl ? LayoutAlignment.end : LayoutAlignment.start;
                Button {
                    variant: ButtonVariant.settings;
                    label: @tr("Add account");
                    clicked => { SettingsStore.command("add-account", new-account.text); }
                }
            }
        }
    }
    SettingsSection {
        title: @tr("Remove an account");
        description: @tr("Forgets the account's saved sign-in on this computer and takes it off the list. Nothing changes in Teams.");
        danger: true;
        for a in SettingsStore.accounts: SPersonRow {
            name: a.name != "" ? a.name : a.label;
            action: @tr("Remove");
            act => { SettingsStore.confirm-remove = a.label; }
        }
        if SettingsStore.confirm-remove != "": SettingsBlock {
            SettingsNote { text: @tr("Remove \"{}\" from IronTeams on this computer? Its saved sign-in is deleted.", SettingsStore.confirm-remove); }
            HorizontalLayout {
                spacing: Space.s;
                alignment: Theme.rtl ? LayoutAlignment.end : LayoutAlignment.start;
                Button { variant: ButtonVariant.settings; label: @tr("Cancel removal"); clicked => { SettingsStore.confirm-remove = ""; } }
                Button { variant: ButtonVariant.settings; label: @tr("Yes, remove the account"); danger: true; clicked => { SettingsStore.command("remove-account", SettingsStore.confirm-remove); SettingsStore.confirm-remove = ""; } }
            }
        }
    }
    SettingsSection {
        title: @tr("Organizations");
        description: @tr("Organizations this account belongs to, as a member or a guest.");
        SettingsBlock {
            if SettingsStore.orgs.length == 0: SettingsNote { text: @tr("No organization list yet."); }
            for o in SettingsStore.orgs: SRadio {
                group: @tr("Organization");
                label: o.name;
                detail: o.home ? @tr("Home organization") : @tr("Guest");
                checked: o.active;
                picked => { SettingsStore.command("switch-org", o.tenant); }
            }
        }
    }
    SettingsSection {
        title: @tr("Theme for each account");
        description: @tr("Give an account its own theme to tell the accounts apart. Same as app uses the theme chosen in Appearance. The theme of the account in use shows at once; another account's shows when IronTeams starts with it.");
        for a in SettingsStore.accounts: ThemeChoiceRow {
            label: a.name != "" ? a.name : a.label;
            themes: SettingsStore.themes;
            with-same: true;
            value: a.theme;
            picked(id) => { SettingsStore.command("account-theme", SettingsStore.j2(a.label, id)); }
        }
    }
    SettingsSection {
        title: @tr("License");
        SettingsButtonRow {
            description: @tr("Asks Microsoft for your sign-in and license details again, then restarts IronTeams. Use it after an admin changed your license or your organization's settings.");
            button-label: @tr("Refresh license and restart");
            clicked => { SettingsStore.command("refresh-license", ""); }
        }
    }
    if SettingsStore.accounts-status != "": PageNote { text: SettingsStore.accounts-status; }
}

export component PrivacyPage inherits SettingsSections {
    SettingsSection {
        title: @tr("Privacy");
        description: @tr("These are Teams settings.");
        for t in SettingsStore.privacy: SettingsSwitchRow {
            label: t.label;
            description: t.hint;
            checked: t.on;
            enabled: t.enabled;
            toggled(on) => { SettingsStore.command("privacy", SettingsStore.j2(t.key, on ? "1" : "0")); }
        }
    }
    SettingsSection {
        title: @tr("Blocked contacts");
        description: @tr("Blocked people cannot call you or see your presence.");
        if SettingsStore.blocked.length == 0: SettingsBlock {
            SettingsNote { text: @tr("You have not blocked anyone."); }
        }
        for p in SettingsStore.blocked: SPersonRow {
            name: p.name;
            action: @tr("Unblock");
            act => { SettingsStore.command("unblock", p.mri); }
        }
    }
    SettingsSection {
        title: @tr("Priority access");
        description: @tr("People who can reach you when you are set to Do not disturb.");
        if SettingsStore.priority.length == 0: SettingsBlock {
            SettingsNote { text: @tr("Nobody has priority access."); }
        }
        for p in SettingsStore.priority: SPersonRow {
            name: p.name;
            action: @tr("Remove");
            act => { SettingsStore.command("priority-remove", p.mri); }
        }
    }
    SettingsSection {
        title: @tr("Diagnostic data");
        SettingsBlock {
            SettingsNote { text: @tr("IronTeams sends no diagnostic data. Report a problem (in About) writes a redacted bundle on this computer."); }
        }
    }
    if SettingsStore.privacy-status != "": PageNote { text: SettingsStore.privacy-status; }
    if SettingsStore.dry-runs.length > 0: DryRuns { }
}

// A day of the week in the quiet hours row.
component DayChip inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    callback toggled();
    height: 30px * max(1, Theme.font-scale);
    width: max(44px, dl.preferred-width + 20px);
    border-radius: self.height / 2;
    border-width: 1px;
    border-color: root.on ? Theme.accent : Theme.border;
    background: root.on ? Theme.selected : (dt.has-hover ? Theme.surface-hover : transparent);
    accessible-role: checkbox;
    accessible-label: root.label;
    accessible-checked: root.on;
    accessible-action-default => { root.toggled(); }
    dl := Text { text: root.label; color: root.on ? Theme.accent : Theme.fg; font-size: Theme.font-body; horizontal-alignment: center; vertical-alignment: center; }
    dt := TouchArea { mouse-cursor: pointer; clicked => { root.toggled(); } }
}

// A text box with an Add button; the box empties after a word is added.
component KeywordAdd inherits HorizontalLayout {
    spacing: Space.s;
    alignment: Theme.rtl ? LayoutAlignment.end : LayoutAlignment.start;
    callback add(string);
    Rectangle {
        width: 260px;
        height: max(30px, kw.preferred-height + 12px);
        border-radius: 4px;
        background: Theme.surface;
        border-width: 1px;
        border-color: kw.has-focus ? Theme.accent : Theme.border;
        kw := TextInput {
            x: 10px;
            width: parent.width - 20px;
            color: Theme.fg;
            font-size: Theme.font-body;
            single-line: true;
            vertical-alignment: center;
            horizontal-alignment: Theme.start-align;
            accessible-role: text-input;
            accessible-label: @tr("Add a word or phrase");
            accepted => { root.add(self.text); self.text = ""; }
        }
        if kw.text == "": Text {
            x: 10px;
            width: parent.width - 20px;
            text: @tr("Add a word or phrase");
            color: Theme.fg-subtle;
            font-size: Theme.font-body;
            vertical-alignment: center;
            horizontal-alignment: Theme.start-align;
        }
    }
    Button { variant: ButtonVariant.settings; label: @tr("Add"); clicked => { root.add(kw.text); kw.text = ""; } }
}

// One kind of activity and how it reaches you; the first of a group (Chat, Teams and channels…)
// carries the group's name above it.
component NotifyTypeRow inherits Rectangle {
    in property <SNotify> n;
    if root.y > 2px: divider-line := Rectangle {
        x: SettingsMetrics.row-pad-x;
        y: 0px;
        width: max(0px, root.width - 2 * SettingsMetrics.row-pad-x);
        height: 1px;
        background: Theme.border;
    }
    VerticalLayout {
        if root.n.group != "": HorizontalLayout {
            padding-left: SettingsMetrics.row-pad-x;
            padding-right: SettingsMetrics.row-pad-x;
            padding-top: SettingsMetrics.row-pad-y;
            Text {
                horizontal-alignment: Theme.start-align;
                text: root.n.group;
                color: Theme.fg;
                font-size: Theme.font-body;
                font-weight: 600;
            }
        }
        SettingsChoiceRow {
            divider: false;
            label: root.n.label;
            options: [{v: "banner", l: @tr("Banner and feed")}, {v: "feed", l: @tr("Only show in feed")}, {v: "off", l: @tr("Off")}];
            value: root.n.value;
            picked(v) => { SettingsStore.command("notify", SettingsStore.j2(root.n.key, v)); }
        }
    }
}

export component NotificationsPage inherits SettingsSections {
    SettingsSection {
        title: @tr("Banners");
        SettingsChoiceRow {
            label: @tr("Pause notifications");
            description: SettingsStore.paused ? (SettingsStore.pause-until != "" ? SettingsStore.pause-until : @tr("Paused")) : @tr("No banners for as long as you choose. Until tomorrow means 8:00 the next morning.");
            options: [{v: "off", l: @tr("Off")}, {v: "1h", l: @tr("1 hour")}, {v: "2h", l: @tr("2 hours")}, {v: "tomorrow", l: @tr("Until tomorrow")}, {v: "custom", l: @tr("Custom")}];
            value: SettingsStore.pause-custom-open ? "custom" : (SettingsStore.paused ? "" : "off");
            picked(v) => {
                if v == "custom" {
                    SettingsStore.pause-custom-open = true;
                } else {
                    SettingsStore.pause-custom-open = false;
                    SettingsStore.command("pause", v);
                }
            }
        }
        if SettingsStore.pause-custom-open: SettingsBlock {
            pause-at := Field { variant: FieldVariant.settings; label: @tr("Pause until"); placeholder: "2026-12-31 17:30"; }
            HorizontalLayout {
                alignment: Theme.rtl ? LayoutAlignment.end : LayoutAlignment.start;
                Button {
                    variant: ButtonVariant.settings;
                    label: @tr("Pause notifications until then");
                    clicked => { SettingsStore.command("pause", SettingsStore.j2("custom", pause-at.text)); }
                }
            }
        }
        SettingsChoiceRow {
            label: @tr("Notification style");
            description: @tr("Teams cards show in the corner of the screen, above other windows.");
            options: [{v: "cards", l: @tr("Teams cards")}, {v: "system", l: @tr("System notifications")}];
            value: SettingsStore.notification-style;
            picked(v) => { SettingsStore.command("notification-style", v); }
        }
        SettingsSwitchRow {
            label: @tr("Show the sender's photo");
            description: @tr("Message notifications show who wrote, like Teams.");
            checked: SettingsStore.banner-photo;
            toggled(on) => { SettingsStore.command("banner-photo", on ? "1" : "0"); }
        }
        SettingsSwitchRow {
            label: @tr("Show Reply and Like buttons");
            description: @tr("Reply opens the chat with the cursor in the message box. Clicking a notification always opens its chat.");
            checked: SettingsStore.banner-actions;
            toggled(on) => { SettingsStore.command("banner-actions", on ? "1" : "0"); }
        }
        SettingsButtonRow {
            label: @tr("See how a notification looks");
            description: SettingsStore.notify-status;
            button-label: @tr("Test notification");
            clicked => { SettingsStore.command("test-notification", ""); }
        }
    }
    SettingsSection {
        title: @tr("Quiet hours");
        description: @tr("No banners and no notification sound during these hours. Messages still arrive and unread counts still update. This applies to this computer only.");
        SettingsSwitchRow {
            label: @tr("Turn on quiet hours");
            checked: SettingsStore.quiet-on;
            toggled(on) => { SettingsStore.command("quiet-on", on ? "1" : "0"); }
        }
        if SettingsStore.quiet-on: SettingsBlock {
            HorizontalLayout {
                spacing: 6px;
                alignment: Theme.rtl ? LayoutAlignment.end : LayoutAlignment.start;
                for d[i] in [@tr("Mon"), @tr("Tue"), @tr("Wed"), @tr("Thu"), @tr("Fri"), @tr("Sat"), @tr("Sun")]: DayChip {
                    label: d;
                    on: SettingsStore.quiet-days[i];
                    toggled => { SettingsStore.command("quiet-day", "" + i); }
                }
            }
            HorizontalLayout {
                spacing: Space.m;
                alignment: Theme.rtl ? LayoutAlignment.end : LayoutAlignment.start;
                Field { variant: FieldVariant.settings; label: @tr("From"); text: SettingsStore.quiet-start; width: 120px; committed(t) => { SettingsStore.command("quiet-start", t); } }
                Field { variant: FieldVariant.settings; label: @tr("To"); text: SettingsStore.quiet-end; width: 120px; committed(t) => { SettingsStore.command("quiet-end", t); } }
            }
        }
    }
    SettingsSection {
        title: @tr("Focus mode");
        description: @tr("Only @mentions of you, urgent messages, priority people, calls and your keywords still show a banner. Your Teams status does not change.");
        SettingsSwitchRow {
            label: @tr("Focus mode");
            description: SettingsStore.focus-label();
            checked: SettingsStore.focus-on;
            toggled(on) => { SettingsStore.command("focus", on ? "1" : "0"); }
        }
        SettingsChoiceRow {
            label: @tr("Turn on for");
            options: [{v: "1h", l: @tr("1 hour")}, {v: "2h", l: @tr("2 hours")}, {v: "tomorrow", l: @tr("Until tomorrow 9:00")}, {v: "manual", l: @tr("Until I turn it off")}];
            value: SettingsStore.focus-duration;
            picked(v) => { SettingsStore.focus-duration = v; SettingsStore.command("focus-duration", v); }
        }
    }
    SettingsSection {
        title: @tr("Keyword alerts");
        description: @tr("A message from someone else with one of these words or phrases shows a banner, even in a muted chat, but not during quiet hours. Focus mode lets them through.");
        SettingsBlock {
            KeywordAdd { add(t) => { SettingsStore.command("keyword-add", t); } }
            if SettingsStore.keywords.length == 0: SettingsNote { text: @tr("No keywords yet."); }
        }
        for k in SettingsStore.keywords: SPersonRow {
            name: k;
            action: @tr("Remove");
            act => { SettingsStore.command("keyword-remove", k); }
        }
    }
    SettingsSection {
        title: @tr("Sounds and previews");
        for t in SettingsStore.notify-sounds: SettingsSwitchRow {
            label: t.label;
            description: t.hint;
            checked: t.on;
            enabled: t.enabled;
            toggled(on) => { SettingsStore.command("notify-sound", SettingsStore.j2(t.key, on ? "1" : "0")); }
        }
        SettingsChoiceRow {
            label: @tr("Meeting chats");
            description: @tr("Which meeting chats notify you.");
            options: [{v: "all", l: @tr("All meetings I'm invited to")}, {v: "participated", l: @tr("Meetings I take part in")}, {v: "none", l: @tr("Only ones I unmuted")}];
            value: SettingsStore.meeting-chat;
            picked(v) => { SettingsStore.meeting-chat = v; SettingsStore.command("meeting-chat", v); }
        }
    }
    SettingsSection {
        title: @tr("Message sound");
        description: @tr("The sound IronTeams plays for a new message. It is kept on this computer, and follows the sound switches above.");
        SettingsBlock {
            SRadioList {
                label: @tr("Message sound");
                teams: SettingsStore.message-originals;
                others: [{v: "ironteams", l: @tr("IronTeams")}, {v: "chime", l: @tr("Chime")}, {v: "soft", l: @tr("Soft")}, {v: "pulse", l: @tr("Pulse")}, {v: "custom", l: @tr("Custom file")}];
                value: SettingsStore.message-sound;
                picked(v) => { SettingsStore.message-sound = v; SettingsStore.command("message-sound", v); }
            }
            if SettingsStore.message-sound-file != "": SettingsNote { text: SettingsStore.message-sound-file; }
            HorizontalLayout {
                spacing: Space.s;
                alignment: Theme.rtl ? LayoutAlignment.end : LayoutAlignment.start;
                Button { variant: ButtonVariant.settings; label: @tr("Play message sound"); clicked => { SettingsStore.command("message-sound-preview", SettingsStore.message-sound); } }
                Button { variant: ButtonVariant.settings; label: @tr("Choose a file…"); clicked => { SettingsStore.command("message-sound-file", ""); } }
            }
        }
        SettingsSwitchRow {
            label: @tr("Download Teams' original sounds");
            description: @tr("Teams' own ringtones and message sounds are Microsoft's. IronTeams downloads them once from Microsoft's servers and keeps them on this computer; they are not part of IronTeams. Until a sound is downloaded, and when this is off, IronTeams' own sounds play instead.");
            checked: SettingsStore.download-teams-sounds;
            toggled(on) => { SettingsStore.command("teams-sounds", on ? "1" : "0"); }
        }
    }
    SettingsSection {
        title: @tr("Urgent and priority messages");
        description: @tr("The sound for an urgent message or one from a priority contact, when the message sound is one of Teams'. Other message sounds stay as they are.");
        SettingsBlock {
            SRadioList {
                label: @tr("Urgent message sound");
                teams: SettingsStore.urgent-originals;
                others: [];
                value: SettingsStore.urgent-sound;
                picked(v) => { SettingsStore.urgent-sound = v; SettingsStore.command("urgent-sound", v); }
            }
            HorizontalLayout {
                alignment: Theme.rtl ? LayoutAlignment.end : LayoutAlignment.start;
                Button { variant: ButtonVariant.settings; label: @tr("Play urgent sound"); clicked => { SettingsStore.command("urgent-sound-preview", SettingsStore.urgent-sound); } }
            }
        }
    }
    SettingsSection {
        title: @tr("Activity types");
        description: @tr("How each kind of activity reaches you: a banner and the Activity feed, the feed only, or nothing.");
        for n in SettingsStore.notify: NotifyTypeRow { n: n; }
    }
    if SettingsStore.dry-runs.length > 0: DryRuns { }
}

// The "..." on a custom theme's tile: Edit, Copy theme, Rename and Delete, which asks first.
component ThemeTileMenu inherits Rectangle {
    in property <bool> custom;
    in property <string> id;
    in property <string> name;
    property <bool> confirming: false;
    width: 28px;
    height: 28px;
    if root.custom: IconButton {
        size: 28px;
        icon: @image-url("../icons/more.svg");
        tooltip: @tr("Theme options: {}", root.name);
        clicked => { root.confirming = false; pop.show(); }
    }
    pop := PopupWindow {
        x: Theme.rtl ? 0px : root.width - 200px;
        y: root.height + 2px;
        width: 200px;
        height: 4 * 32px + 12px;
        close-policy: close-on-click-outside;
        MenuColumn {
            menu-width: 200px;
            if !root.confirming: MenuItem { label: @tr("Edit"); clicked => { pop.close(); SettingsStore.command("theme-edit", root.id); } }
            if !root.confirming: MenuItem { label: @tr("Copy theme"); clicked => { pop.close(); SettingsStore.command("theme-copy", root.id); } }
            if !root.confirming: MenuItem { label: @tr("Rename"); clicked => { pop.close(); SettingsStore.editor-error = ""; SettingsStore.rename-name = root.name; SettingsStore.rename-id = root.id; } }
            if !root.confirming: MenuItem { label: @tr("Delete"); danger: true; clicked => { root.confirming = true; } }
            if root.confirming: Text {
                text: @tr("Delete \"{}\"?", root.name);
                color: Theme.fg;
                font-size: Theme.font-body;
                wrap: word-wrap;
                accessible-role: text;
            }
            if root.confirming: HorizontalLayout {
                spacing: 8px;
                alignment: end;
                Button { variant: ButtonVariant.settings; label: @tr("Cancel"); clicked => { root.confirming = false; pop.close(); } }
                Button { variant: ButtonVariant.settings; label: @tr("Delete"); danger: true; clicked => { root.confirming = false; pop.close(); SettingsStore.command("theme-delete", root.id); } }
            }
        }
    }
}

export component AppearancePage inherits SettingsSections {
    SettingsSection {
        title: @tr("Theme");
        // The gallery: built-in themes, then custom ones, as many to a line as fit.
        SettingsRow {
            label: @tr("Theme");
            description: @tr("Now showing: {}.", SettingsStore.theme-name(SettingsStore.theme-active, SettingsStore.theme-active-name));
            stacked: true;
            gallery := Rectangle {
                property <int> cols: max(1, Math.floor((self.width + 12px) / (ThemeTileMetrics.width + 12px)));
                min-height: max(0px, Math.ceil(SettingsStore.themes.length / self.cols) * (ThemeTileMetrics.height + 12px) - 12px);
                for t[i] in SettingsStore.themes: ThemeTile {
                    property <int> tile-col: Math.mod(i, gallery.cols);
                    x: Theme.rtl ? gallery.width - self.width - self.tile-col * (ThemeTileMetrics.width + 12px) : self.tile-col * (ThemeTileMetrics.width + 12px);
                    y: Math.floor(i / gallery.cols) * (ThemeTileMetrics.height + 12px);
                    t: t;
                    checked: SettingsStore.theme-mode == "one" && SettingsStore.theme-id == t.id;
                    clicked => { SettingsStore.command("theme-pick", t.id); }
                }
                for t[i] in SettingsStore.themes: ThemeTileMenu {
                    property <int> tile-col: Math.mod(i, gallery.cols);
                    property <length> tile-x: Theme.rtl ? gallery.width - ThemeTileMetrics.width - self.tile-col * (ThemeTileMetrics.width + 12px) : self.tile-col * (ThemeTileMetrics.width + 12px);
                    x: Theme.rtl ? self.tile-x + 6px : self.tile-x + ThemeTileMetrics.width - 6px - self.width;
                    y: Math.floor(i / gallery.cols) * (ThemeTileMetrics.height + 12px) + 6px;
                    custom: t.custom;
                    id: t.id;
                    name: t.name;
                }
            }
        }
        // New and imported themes. Both stop at 50 custom themes.
        SettingsBlock {
            VerticalLayout {
                spacing: Space.s;
                HorizontalLayout {
                    spacing: Space.m;
                    alignment: Theme.rtl ? LayoutAlignment.end : LayoutAlignment.start;
                    Button { variant: ButtonVariant.settings; label: @tr("New custom theme"); enabled: !SettingsStore.themes-full; clicked => { SettingsStore.command("theme-new", ""); } }
                    Button { variant: ButtonVariant.settings; label: @tr("Import"); enabled: !SettingsStore.themes-full; clicked => { SettingsStore.editor-error = ""; SettingsStore.import-open = true; } }
                }
                if SettingsStore.themes-full: SettingsNote { text: SettingsStore.share-error("limit"); }
            }
        }
        SettingsChoiceRow {
            label: @tr("Switch");
            options: [{v: "one", l: @tr("One theme")}, {v: "system", l: @tr("Follow the system")}, {v: "schedule", l: @tr("On a schedule")}];
            value: SettingsStore.theme-mode;
            picked(v) => { SettingsStore.theme-mode = v; SettingsStore.command("theme-mode", v); }
        }
        if SettingsStore.theme-mode != "one": ThemeChoiceRow {
            label: @tr("Light theme");
            themes: SettingsStore.themes-light-first;
            value: SettingsStore.theme-light;
            picked(id) => { SettingsStore.command("theme-slot", SettingsStore.j2("light", id)); }
        }
        if SettingsStore.theme-mode != "one": ThemeChoiceRow {
            label: @tr("Dark theme");
            themes: SettingsStore.themes-dark-first;
            value: SettingsStore.theme-dark;
            picked(id) => { SettingsStore.command("theme-slot", SettingsStore.j2("dark", id)); }
        }
        if SettingsStore.theme-mode == "schedule": SettingsBlock {
            HorizontalLayout {
                spacing: Space.m;
                alignment: Theme.rtl ? LayoutAlignment.end : LayoutAlignment.start;
                Field { variant: FieldVariant.settings; label: @tr("Light from"); text: SettingsStore.theme-light-from; width: 120px; committed(t) => { SettingsStore.command("theme-time", SettingsStore.j2("light", t)); } }
                Field { variant: FieldVariant.settings; label: @tr("Dark from"); text: SettingsStore.theme-dark-from; width: 120px; committed(t) => { SettingsStore.command("theme-time", SettingsStore.j2("dark", t)); } }
            }
        }
        SettingsRow {
            label: @tr("Accent colour");
            description: @tr("For IronTeams Dark and IronTeams Light. Now: {}.", SettingsStore.accent-shown)
                + (SettingsStore.accent-enabled ? "" : " " + @tr("The active theme has its own accent; edit the theme to change it."));
            enabled: SettingsStore.accent-enabled;
            stacked: true;
            HorizontalLayout {
                spacing: Space.s;
                alignment: Theme.rtl ? LayoutAlignment.end : LayoutAlignment.start;
                for a in [{v: "", l: @tr("Desktop accent"), c: Theme.accent}]: Rectangle {
                    width: 32px;
                    height: 32px;
                    border-radius: 16px;
                    opacity: SettingsStore.accent-enabled ? 1 : 0.4;
                    border-width: SettingsStore.accent == a.v ? 3px : 1px;
                    border-color: SettingsStore.accent == a.v ? Theme.fg : Theme.border;
                    background: a.v == "" ? transparent : a.c;
                    accessible-role: radio-button;
                    accessible-label: @tr("Accent colour: {}", a.l);
                    accessible-checked: SettingsStore.accent == a.v;
                    accessible-enabled: SettingsStore.accent-enabled;
                    accessible-action-default => { if SettingsStore.accent-enabled { SettingsStore.accent = a.v; SettingsStore.command("accent", a.v); } }
                    if a.v == "": Text { text: "A"; color: Theme.accent; font-size: Theme.font-body; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { enabled: SettingsStore.accent-enabled; mouse-cursor: pointer; clicked => { SettingsStore.accent = a.v; SettingsStore.command("accent", a.v); } }
                }
                for a in Fixed.accent-choices: Rectangle {
                    width: 32px;
                    height: 32px;
                    border-radius: 16px;
                    opacity: SettingsStore.accent-enabled ? 1 : 0.4;
                    border-width: SettingsStore.accent == a.v ? 3px : 1px;
                    border-color: SettingsStore.accent == a.v ? Theme.fg : Theme.border;
                    background: a.v == "" ? transparent : a.c;
                    accessible-role: radio-button;
                    accessible-label: @tr("Accent colour: {}", a.l);
                    accessible-checked: SettingsStore.accent == a.v;
                    accessible-enabled: SettingsStore.accent-enabled;
                    accessible-action-default => { if SettingsStore.accent-enabled { SettingsStore.accent = a.v; SettingsStore.command("accent", a.v); } }
                    if a.v == "": Text { text: "A"; color: Theme.accent; font-size: Theme.font-body; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { enabled: SettingsStore.accent-enabled; mouse-cursor: pointer; clicked => { SettingsStore.accent = a.v; SettingsStore.command("accent", a.v); } }
                }
            }
        }
        ThemeChoiceRow {
            label: @tr("Calls and meetings");
            description: @tr("The call screen and the menus opened from it.");
            themes: SettingsStore.themes;
            with-same: true;
            value: SettingsStore.call-theme;
            picked(id) => { SettingsStore.command("call-theme", id); }
        }
    }
    SettingsSection {
        title: @tr("Text");
        SettingsRow {
            label: @tr("Font size");
            description: @tr("Larger text in Accessibility adds to this.");
            stacked: true;
            HorizontalLayout {
                spacing: Space.s;
                alignment: Theme.rtl ? LayoutAlignment.end : LayoutAlignment.start;
                Button { variant: ButtonVariant.settings; label: @tr("Smaller font"); clicked => { SettingsStore.command("font-step", "-1"); } }
                Rectangle {
                    width: 70px;
                    accessible-role: text;
                    accessible-label: @tr("Current font size");
                    accessible-value: Math.round(SettingsStore.font-scale * 100) + "%";
                    Text { text: Math.round(SettingsStore.font-scale * 100) + "%"; color: Theme.fg; font-size: Theme.font-body; horizontal-alignment: center; vertical-alignment: center; }
                }
                Button { variant: ButtonVariant.settings; label: @tr("Larger font"); clicked => { SettingsStore.command("font-step", "1"); } }
            }
        }
        // The preview is in the body size, so it shows what the buttons above changed.
        SettingsButtonRow {
            label: "Preview: the quick brown fox. نص تجريبي.";
            button-label: @tr("Reset font size");
            clicked => { SettingsStore.command("font-scale", "1"); }
        }
        FontChoiceRow {
            label: @tr("Code font");
            description: @tr("Code blocks and other fixed-width text. Inline code in messages keeps the default font.");
            families: SettingsStore.font-families;
            value: SettingsStore.font-code;
            picked(v) => { SettingsStore.font-code = v; SettingsStore.command("font-code", v); }
        }
        FontChoiceRow {
            label: @tr("Interface font");
            description: @tr("Text in every window. Emoji and Arabic keep their own fonts where this one has no letters for them.");
            families: SettingsStore.font-families;
            value: SettingsStore.font-ui;
            picked(v) => { SettingsStore.font-ui = v; SettingsStore.command("font-ui", v); }
        }
    }
    SettingsSection {
        title: @tr("Layout");
        SettingsChoiceRow {
            label: @tr("Message density");
            options: [{v: "comfy", l: @tr("Comfy")}, {v: "compact", l: @tr("Compact")}];
            value: SettingsStore.density;
            picked(v) => { SettingsStore.density = v; SettingsStore.command("density", v); }
        }
        SettingsChoiceRow {
            label: @tr("Skin tone");
            description: @tr("Used for emoji in reactions and the composer.");
            options: [{v: "0", l: "👋"}, {v: "1", l: "👋🏻"}, {v: "2", l: "👋🏼"}, {v: "3", l: "👋🏽"}, {v: "4", l: "👋🏾"}, {v: "5", l: "👋🏿"}];
            value: SettingsStore.skin-tone;
            picked(v) => { SettingsStore.command("skin-tone", v); }
        }
    }
    SettingsSection {
        title: @tr("Messages");
        SettingsChoiceRow {
            label: @tr("Message style");
            description: @tr("Bubbles is the usual look. Flat and Compact draw every message, yours too, as a line with the photo and name on the left. Compact also tightens the spacing.");
            options: [{v: "bubbles", l: @tr("Bubbles")}, {v: "flat", l: @tr("Flat")}, {v: "compact", l: @tr("Compact")}];
            value: SettingsStore.message-style;
            picked(v) => { SettingsStore.message-style = v; SettingsStore.command("message-style", v); }
        }
        SettingsSwitchRow {
            label: @tr("Show avatars");
            description: @tr("The sender's photo beside each message. The name still opens the profile.");
            checked: SettingsStore.show-avatars;
            toggled(on) => { SettingsStore.command("show-avatars", on ? "1" : "0"); }
        }
        SettingsSwitchRow {
            label: @tr("Show time stamps");
            description: @tr("The time beside the sender's name. Resting the pointer on a message shows it.");
            checked: SettingsStore.show-timestamps;
            toggled(on) => { SettingsStore.command("show-timestamps", on ? "1" : "0"); }
        }
        SettingsSwitchRow {
            label: @tr("Show reactions");
            description: @tr("The reactions under a message. Hiding them keeps them; you can still react from the message's hover bar.");
            checked: SettingsStore.show-reactions;
            toggled(on) => { SettingsStore.command("show-reactions", on ? "1" : "0"); }
        }
    }
    SettingsSection {
        title: @tr("App bar");
        SettingsSwitchRow {
            label: @tr("Show app names");
            description: @tr("The names under the app bar's icons (the bar's own Collapse does the same).");
            checked: !AppsStore.rail-collapsed;
            toggled(on) => { if on == AppsStore.rail-collapsed { AppsStore.command("rail-collapse", ""); } }
        }
        SettingsSwitchRow {
            label: @tr("Auto collapse app bar");
            description: @tr("Shows only the icons while the window is narrow.");
            checked: AppsStore.auto-collapse;
            toggled(on) => { AppsStore.auto-collapse = on; SettingsStore.command("rail-auto", on ? "1" : "0"); }
        }
    }
    SettingsSection {
        title: @tr("App bar order");
        description: @tr("Move the app bar's icons up or down and hide the ones you do not use. Chat always stays. Apps pinned from Teams are moved with a right click on their icon.");
        for f[i] in AppsStore.rail-fixed: SettingsOrderRow {
            label: RailItems.label(f.key);
            shown: f.shown;
            can-hide: !f.locked;
            first: i == 0;
            last: i == AppsStore.rail-fixed.length - 1;
            up => { SettingsStore.command("rail-move", f.key + "\u{1f}up"); }
            down => { SettingsStore.command("rail-move", f.key + "\u{1f}down"); }
            toggled(on) => { SettingsStore.command("rail-show", f.key + "\u{1f}" + (on ? "1" : "0")); }
        }
    }
}

export component AccessibilityPage inherits SettingsSections {
    SettingsSection {
        title: @tr("Display");
        description: @tr("Now: {}.", SettingsStore.a11y-shown);
        SettingsChoiceRow {
            label: @tr("High contrast");
            options: [{v: "auto", l: @tr("Follow the system")}, {v: "on", l: @tr("On")}, {v: "off", l: @tr("Off")}];
            value: SettingsStore.high-contrast;
            picked(v) => { SettingsStore.high-contrast = v; SettingsStore.command("high-contrast", v); }
        }
        SettingsChoiceRow {
            label: @tr("Reduce motion");
            options: [{v: "auto", l: @tr("Follow the system")}, {v: "on", l: @tr("On")}, {v: "off", l: @tr("Off")}];
            value: SettingsStore.reduced-motion;
            picked(v) => { SettingsStore.reduced-motion = v; SettingsStore.command("reduced-motion", v); }
        }
        SettingsSwitchRow {
            label: @tr("Larger text");
            description: @tr("Makes text a quarter bigger than the font size in Appearance.");
            checked: SettingsStore.larger-text;
            toggled(on) => { SettingsStore.command("larger-text", on ? "1" : "0"); }
        }
    }
    SettingsSection {
        title: @tr("Captions and meetings");
        description: @tr("Saved now; meetings and calls use them when they come to IronTeams.");
        for t in SettingsStore.a11y-flags: SettingsSwitchRow {
            label: t.label;
            description: t.hint;
            checked: t.on;
            enabled: t.enabled;
            toggled(on) => { SettingsStore.command("a11y", SettingsStore.j2(t.key, on ? "1" : "0")); }
        }
    }
}

export component DevicesPage inherits SettingsSections {
    SettingsSection {
        title: @tr("Speaker");
        SettingsBlock {
            SRadio { group: @tr("Speaker"); label: @tr("System default"); checked: SettingsStore.speaker == ""; picked => { SettingsStore.command("speaker", ""); } }
            for d in SettingsStore.speakers: SRadio { group: @tr("Speaker"); label: d.name; checked: SettingsStore.speaker == d.id; picked => { SettingsStore.command("speaker", d.id); } }
            HorizontalLayout {
                alignment: Theme.rtl ? LayoutAlignment.end : LayoutAlignment.start;
                Button { variant: ButtonVariant.settings; label: @tr("Play test sound"); clicked => { SettingsStore.command("test-sound", ""); } }
            }
        }
    }
    SettingsSection {
        title: @tr("Microphone");
        SettingsBlock {
            SRadio { group: @tr("Microphone"); label: @tr("System default"); checked: SettingsStore.mic == ""; picked => { SettingsStore.command("mic", ""); } }
            for d in SettingsStore.mics: SRadio { group: @tr("Microphone"); label: d.name; checked: SettingsStore.mic == d.id; picked => { SettingsStore.command("mic", d.id); } }
            HorizontalLayout {
                spacing: Space.m;
                alignment: Theme.rtl ? LayoutAlignment.end : LayoutAlignment.start;
                Button {
                    variant: ButtonVariant.settings;
                    label: SettingsStore.mic-testing ? @tr("Stop microphone test") : @tr("Test microphone");
                    clicked => { SettingsStore.command("mic-test", SettingsStore.mic-testing ? "0" : "1"); }
                }
                if SettingsStore.mic-testing: Rectangle {
                    width: 200px;
                    height: 8px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 4px;
                    background: Theme.surface;
                    accessible-role: progress-indicator;
                    accessible-label: @tr("Microphone level");
                    accessible-value: Math.round(SettingsStore.mic-level * 100) + "%";
                    Rectangle {
                        x: 0;
                        width: parent.width * clamp(SettingsStore.mic-level, 0, 1);
                        border-radius: 4px;
                        background: Theme.accent;
                    }
                }
            }
        }
        SettingsSwitchRow {
            label: @tr("Show all devices");
            description: @tr("Also list the raw sound card entries.");
            checked: SettingsStore.all-devices;
            toggled(on) => { SettingsStore.command("all-devices", on ? "1" : "0"); }
        }
    }
    SettingsSection {
        title: @tr("Call audio");
        SettingsSwitchRow {
            label: @tr("Noise suppression");
            description: @tr("Removes background noise, like typing or a fan, from your microphone in calls.");
            checked: SettingsStore.noise-suppression;
            toggled(on) => { SettingsStore.command("noise-suppression", on ? "1" : "0"); }
        }
        SettingsSwitchRow {
            label: @tr("Echo cancellation");
            description: @tr("Stops others from hearing themselves when you use speakers instead of a headset.");
            checked: SettingsStore.echo-cancellation;
            toggled(on) => { SettingsStore.command("echo-cancellation", on ? "1" : "0"); }
        }
    }
    SettingsSection {
        title: @tr("Camera");
        description: @tr("Preview, mirroring and low-light correction come with calls.");
        SettingsBlock {
            SRadio { group: @tr("Camera"); label: @tr("System default"); checked: SettingsStore.camera == ""; picked => { SettingsStore.command("camera", ""); } }
            for d in SettingsStore.cameras: SRadio { group: @tr("Camera"); label: d.name; detail: d.id; checked: SettingsStore.camera == d.id; picked => { SettingsStore.command("camera", d.id); } }
        }
    }
    SettingsSection {
        title: @tr("Calls");
        SettingsChoiceRow {
            label: @tr("Ask about call quality after calls");
            options: [{v: "always", l: @tr("Always")}, {v: "sometimes", l: @tr("Sometimes")}, {v: "never", l: @tr("Never")}];
            value: SettingsStore.call-feedback;
            picked(v) => { SettingsStore.call-feedback = v; SettingsStore.command("call-feedback", v); }
        }
    }
    if SettingsStore.devices-status != "": PageNote { text: SettingsStore.devices-status; }
}

export component CallsSettingsPage inherits SettingsSections {
    SettingsSection {
        title: @tr("Ringtone");
        description: @tr("The sound IronTeams plays for an incoming call. It is kept on this computer.");
        SettingsBlock {
            SRadioList {
                label: @tr("Ringtone");
                teams: SettingsStore.ringtone-originals;
                others: [{v: "ironteams", l: @tr("IronTeams")}, {v: "chime", l: @tr("Chime")}, {v: "soft", l: @tr("Soft")}, {v: "pulse", l: @tr("Pulse")}, {v: "custom", l: @tr("Custom file")}];
                value: SettingsStore.ringtone;
                picked(v) => { SettingsStore.ringtone = v; SettingsStore.command("ringtone", v); }
            }
            if SettingsStore.ringtone-file != "": SettingsNote { text: SettingsStore.ringtone-file; }
            HorizontalLayout {
                spacing: Space.s;
                alignment: Theme.rtl ? LayoutAlignment.end : LayoutAlignment.start;
                Button { variant: ButtonVariant.settings; label: @tr("Play ringtone"); clicked => { SettingsStore.command("ringtone-preview", SettingsStore.ringtone); } }
                Button { variant: ButtonVariant.settings; label: @tr("Choose a file…"); clicked => { SettingsStore.command("ringtone-file", ""); } }
            }
        }
    }
    SettingsSection {
        title: @tr("Call forwarding");
        description: @tr("IronTeams can't read or change these yet: the Teams service that keeps them is not documented for it. Change them in Teams.");
        SettingsChoiceRow {
            label: @tr("Forward my calls");
            options: [{v: "none", l: @tr("Don't forward")}, {v: "voicemail", l: @tr("To voicemail")}];
            value: "";
            enabled: false;
            picked(v) => { }
        }
        SettingsChoiceRow {
            label: @tr("If unanswered");
            options: [{v: "voicemail", l: @tr("Voicemail")}, {v: "person", l: @tr("A person")}, {v: "number", l: @tr("A number")}];
            value: "";
            enabled: false;
            picked(v) => { }
        }
        SettingsChoiceRow {
            label: @tr("Ring for");
            options: [{v: "10", l: @tr("10 seconds")}, {v: "20", l: @tr("20 seconds")}, {v: "30", l: @tr("30 seconds")}, {v: "45", l: @tr("45 seconds")}];
            value: "";
            enabled: false;
            picked(v) => { }
        }
    }
    SettingsSection {
        title: @tr("Voicemail greeting");
        SettingsButtonRow {
            description: @tr("Recording or choosing a greeting needs the same Teams service, so it stays in Teams for now.");
            button-label: @tr("Record a greeting");
            button-enabled: false;
        }
    }
}

export component FilesPage inherits SettingsSections {
    SettingsSection {
        title: @tr("Files");
        SettingsChoiceRow {
            label: @tr("Open Word, Excel and PowerPoint files in");
            options: [{v: "browser", l: @tr("Browser")}, {v: "desktop", l: @tr("Desktop app")}, {v: "ironteams", l: @tr("IronTeams preview")}];
            value: SettingsStore.open-files;
            picked(v) => { SettingsStore.open-files = v; SettingsStore.command("open-files", v); }
        }
    }
    SettingsSection {
        title: @tr("Links");
        SettingsBlock {
            SettingsNote { text: @tr("Links open in your default browser."); }
        }
    }
}

// One line of the disk space list: what it is and how big it is. Read out as "<label> size".
component StorageRow inherits SettingsRow {
    in property <string> value;
    in property <bool> bold: false;
    property <string> shown: SettingsStore.storage-loaded ? root.value : @tr("Calculating…");
    quiet-text: true;
    accessible-role: text;
    accessible-label: root.label + " " + @tr("size");
    accessible-value: root.shown;
    Text {
        text: root.shown;
        color: root.bold ? Theme.fg : Theme.fg-muted;
        font-size: Theme.font-body;
        font-weight: root.bold ? 600 : 400;
        vertical-alignment: center;
        accessible-role: none;
    }
}

export component StoragePage inherits SettingsSections {
    SettingsSection {
        title: @tr("Disk space");
        description: @tr("What IronTeams keeps on this computer.");
        StorageRow { label: @tr("Messages database"); value: SettingsStore.storage-db; }
        StorageRow { label: @tr("Media (pictures, voice, video)"); value: SettingsStore.storage-media; }
        StorageRow { label: @tr("Temporary files"); value: SettingsStore.storage-temp; }
        StorageRow { label: @tr("Update backups"); value: SettingsStore.storage-backups; }
        StorageRow { label: @tr("Total"); value: SettingsStore.storage-total; bold: true; }
    }
    SettingsSection {
        title: @tr("Media cache");
        SettingsChoiceRow {
            label: @tr("Media cache limit");
            description: @tr("When the media cache grows past this, the oldest files are deleted.");
            options: [{v: "250", l: @tr("250 MB")}, {v: "500", l: @tr("500 MB (default)")}, {v: "1024", l: @tr("1 GB")}, {v: "2048", l: @tr("2 GB")}, {v: "none", l: @tr("No limit")}];
            value: SettingsStore.media-cache-limit;
            picked(v) => { SettingsStore.media-cache-limit = v; SettingsStore.command("media-cache-limit", v); }
        }
        SettingsButtonRow {
            description: @tr("Pictures and media download again when needed. Messages stay.");
            button-label: @tr("Clear media cache");
            clicked => { SettingsStore.command("clear-media-cache", ""); }
        }
    }
    SettingsSection {
        title: @tr("Update backups");
        SettingsButtonRow {
            description: @tr("Before a new version starts, IronTeams keeps a copy of your saved chats and settings from the version before. Deleting the copies frees space. Your current chats are not touched.");
            button-label: @tr("Delete old update backups");
            clicked => { SettingsStore.command("delete-update-backups", ""); }
        }
    }
    SettingsSection {
        title: @tr("All cached data");
        danger: true;
        if !SettingsStore.confirm-clear-all: SettingsButtonRow {
            description: @tr("Removes saved messages and media from this computer; they download again. Drafts, unsent messages, saved items and favourites stay.");
            button-label: @tr("Clear all cached data");
            danger: true;
            clicked => { SettingsStore.confirm-clear-all = true; }
        }
        if SettingsStore.confirm-clear-all: SettingsBlock {
            SettingsNote { text: @tr("Clear all saved messages and media from this computer? They download again when needed."); }
            HorizontalLayout {
                spacing: Space.s;
                alignment: Theme.rtl ? LayoutAlignment.end : LayoutAlignment.start;
                Button { variant: ButtonVariant.settings; label: @tr("Cancel clearing"); clicked => { SettingsStore.confirm-clear-all = false; } }
                Button { variant: ButtonVariant.settings; label: @tr("Yes, clear all cached data"); danger: true; clicked => { SettingsStore.confirm-clear-all = false; SettingsStore.command("clear-all-cache", ""); } }
            }
        }
    }
}

export component PermissionsPage inherits SettingsSections {
    SettingsSection {
        title: @tr("App permissions");
        description: @tr("What each app may use. Apps run in IronTeams's web host and ask for these first.");
        if SettingsStore.app-perms.length == 0: SettingsBlock {
            SettingsNote { text: @tr("No app has asked for a permission."); }
        }
    }
    for a in SettingsStore.app-perms: SettingsSection {
        title: a.name;
        for p in a.perms: SettingsSwitchRow {
            label: a.name + ": " + p.label;
            checked: p.on;
            toggled(on) => { SettingsStore.command("perm", SettingsStore.j3(a.app, p.key, on ? "1" : "0")); }
        }
    }
    if SettingsStore.perms-status != "": PageNote { text: SettingsStore.perms-status; }
}

export component AboutPage inherits SettingsSections {
    SettingsSection {
        title: "IronTeams " + SettingsStore.version;
        SettingsBlock {
            SettingsNote { text: @tr("An unofficial native Microsoft Teams client written in Rust."); }
        }
    }
    // A copy Velopack installed updates itself; any other copy checks for a newer release and says
    // so. Neither can be turned off.
    if SettingsStore.self-update: SettingsSection {
        title: @tr("Updates");
        description: @tr("IronTeams downloads new versions from its GitHub releases in the background, only the parts that changed, and installs them when you restart or quit it. Updates are required and cannot be turned off.");
        SettingsSwitchRow {
            label: @tr("Get beta updates");
            checked: SettingsStore.beta-updates;
            toggled(on) => { SettingsStore.command("beta-updates", on ? "1" : "0"); }
        }
        SettingsButtonRow {
            description: SettingsStore.update-status;
            button-label: @tr("Check now");
            button-enabled: !SettingsStore.update-checking && !SettingsStore.update-ready;
            clicked => { SettingsStore.command("check-now", ""); }
        }
        if SettingsStore.update-ready: SettingsButtonRow {
            button-label: @tr("Restart to update");
            primary: true;
            clicked => { SettingsStore.command("restart-update", ""); }
        }
    }
    if !SettingsStore.self-update: SettingsSection {
        title: @tr("Updates");
        description: @tr("IronTeams asks api.github.com for the latest release when it starts and cannot turn this off. The request has no cookies, no account and nothing about you. This copy cannot replace itself: update it the way you installed it (package manager, Flatpak, a new download).");
        SettingsButtonRow {
            description: SettingsStore.update-status;
            button-label: @tr("Check now");
            button-enabled: !SettingsStore.update-checking;
            clicked => { SettingsStore.command("check-now", ""); }
        }
        if SettingsStore.update-available: SettingsButtonRow {
            button-label: @tr("View release notes");
            clicked => { SettingsStore.command("release-notes", ""); }
        }
    }
    SettingsSection {
        title: @tr("Report a problem");
        SettingsButtonRow {
            description: @tr("Writes a bundle of logs with tokens, ids and addresses removed to your Downloads folder. Nothing is uploaded.");
            button-label: @tr("Report a problem");
            clicked => { SettingsStore.command("report-problem", ""); }
        }
    }
}
