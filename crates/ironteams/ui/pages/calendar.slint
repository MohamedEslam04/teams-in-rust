// The Calendar view: toolbar, left pane (New event, mini month, calendars), day / work week /
// week time grid, month grid, the popovers and dialogs, and the Join banner. Everything it
// shows comes from the CalStore and CalForm globals, filled by the Rust backend.
import { ScrollView } from "std-widgets.slint";
import { Theme } from "../tokens/theme.slint";
import { Icon, IconButton } from "../atoms/widgets.slint";
import { Pill } from "../atoms/chip.slint";
import { CalStore, CalForm, CalFmt } from "../stores/calendar_store.slint";
import { EventPeek, EventFull } from "../organisms/calendar_event.slint";
import { EventForm } from "../organisms/calendar_form.slint";
import { Skeleton } from "../tokens/motion.slint";
import { AddCalendarMenu, FiltersPanel, MeetLinkDialog, CalendarMoreMenu, NewMenu, PromptDialog, RangePicker, SettingsDialog, CalendarShareDialog, ViewsPanel, WorkLocationMenu } from "../organisms/calendar_dialogs.slint";
import { FlexButton, ButtonVariant } from "../atoms/button.slint";
import { Check, CheckVariant } from "../atoms/check.slint";
import { MenuItem, MenuItemVariant, MenuFrame, MenuFrameVariant } from "../atoms/menu.slint";
import { Scrim } from "../atoms/scrim.slint";

export { CalStore, CalForm, CalDay, CalBlock, CalAllDay, CalMonthItem, CalMonthCell, CalMiniCell, CalFilterOpt, CalCalendarRow, CalSavedView, CalSettingsData, CalPerm, CalPeek, CalAttendeeRow, CalAttachmentRow, CalProposalRow, CalZone, CalDetail, CalSchedRow, CalSuggest, CalRoomList, CalRoom } from "../stores/calendar_store.slint";


// One event: a block in a day column, a bar in the all-day row, or a line in the month grid.
// A press without movement is a click (the peek); a drag moves it, and the bottom edge resizes.
component CalBox inherits Rectangle {
    in property <string> title;
    in property <string> organizer;
    in property <string> time;
    in property <string> kind;
    in property <bool> declined;
    in property <bool> private;
    in property <bool> online;
    in property <bool> recurring;
    in property <color> tone;
    in property <bool> compact: false;
    in property <bool> draggable: false;
    callback clicked();
    // Pixels moved since the press, while dragging; and when the button is let go.
    callback moved(length, length);
    callback released(length, length);
    callback resize-moved(length);
    callback resize-released(length);
    property <bool> dragging: false;
    property <bool> resizing: false;
    border-radius: 4px;
    clip: true;
    background: root.kind == "free" ? transparent : (root.kind == "elsewhere" ? root.tone.with-alpha(0.35) : (root.kind == "tentative" ? root.tone.with-alpha(0.55) : root.tone));
    border-width: root.kind == "busy" || root.kind == "oof" ? 0px : 1px;
    border-color: root.tone;
    opacity: root.declined || root.dragging || root.resizing ? 0.65 : 1;

    // Tentative events are hatched.
    if root.kind == "tentative": Rectangle {
        background: @linear-gradient(135deg, #0000 0%, #0000 5%, #00000055 5%, #00000055 10%, #0000 10%, #0000 15%, #00000055 15%, #00000055 20%, #0000 20%, #0000 25%, #00000055 25%, #00000055 30%, #0000 30%, #0000 35%, #00000055 35%, #00000055 40%, #0000 40%, #0000 45%, #00000055 45%, #00000055 50%, #0000 50%, #0000 55%, #00000055 55%, #00000055 60%, #0000 60%, #0000 65%, #00000055 65%, #00000055 70%, #0000 70%, #0000 75%, #00000055 75%, #00000055 80%, #0000 80%, #0000 85%, #00000055 85%, #00000055 90%, #0000 90%, #0000 95%, #00000055 95%, #00000055 100%);
    }
    Rectangle {
        x: 0;
        width: 3px;
        background: root.kind == "free" ? root.tone : root.tone.darker(0.35);
    }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 4px;
        padding-top: 2px;
        spacing: 4px;
        VerticalLayout {
            horizontal-stretch: 1;
            Rectangle {
                height: 15px;
                title-text := Text {
                    width: parent.width;
                    text: root.title;
                    color: root.kind == "free" ? Theme.fg : #ffffff;
                    font-size: 12px * Theme.font-scale;
                    font-weight: 600;
                    overflow: elide;
                    vertical-alignment: center;
                }
                if root.declined: strike := Rectangle {
                    x: 0;
                    y: parent.height / 2;
                    width: min(title-text.preferred-width, title-text.width);
                    height: 1px;
                    background: title-text.color;
                }
            }
            if !root.compact && root.height >= 32px: Text {
                text: root.organizer;
                color: root.kind == "free" ? Theme.fg-muted : #ffffffcc;
                font-size: 11px * Theme.font-scale;
                overflow: elide;
            }
            if !root.compact && root.height >= 46px: Text {
                text: root.time;
                color: root.kind == "free" ? Theme.fg-muted : #ffffffcc;
                font-size: 11px * Theme.font-scale;
                overflow: elide;
            }
        }
        HorizontalLayout {
            horizontal-stretch: 0;
            spacing: 2px;
            padding-top: 2px;
            alignment: end;
            if root.private: Icon { source: @image-url("../icons/lock.svg"); tint: #ffffffdd; width: 12px; height: 12px; }
            if root.online: Icon { source: @image-url("../icons/video.svg"); tint: #ffffffdd; width: 12px; height: 12px; }
            if root.recurring: Icon { source: @image-url("../icons/repeat.svg"); tint: #ffffffdd; width: 12px; height: 12px; }
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.up {
                if root.dragging {
                    root.dragging = false;
                    root.released(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
                } else {
                    root.clicked();
                }
            }
        }
        moved => {
            if self.pressed && root.draggable {
                if root.dragging || Math.abs(self.mouse-x - self.pressed-x) + Math.abs(self.mouse-y - self.pressed-y) > 4px {
                    root.dragging = true;
                    root.moved(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
                }
            }
        }
    }
    // The bottom edge: drag to change the length.
    if root.draggable: grip := Rectangle {
        y: parent.height - 6px;
        height: 6px;
        TouchArea {
            mouse-cursor: ns-resize;
            accessible-role: none;
            pointer-event(e) => {
                if e.button == PointerEventButton.left && e.kind == PointerEventKind.up && root.resizing {
                    root.resizing = false;
                    root.resize-released(self.mouse-y - self.pressed-y);
                }
            }
            moved => {
                if self.pressed {
                    root.resizing = true;
                    root.resize-moved(self.mouse-y - self.pressed-y);
                }
            }
        }
    }
}

component TimeGrid inherits Rectangle {
    // Reports where an event was clicked, for the peek (view coordinates are set by the parent).
    callback peek(string, length, length);
    property <length> gutter: 52px;
    property <length> gutters: root.gutter * (CalStore.second-labels.length > 0 ? 2 : 1);
    property <length> head-h: 46px;
    property <int> ncols: max(1, CalStore.days.length);
    // A day column is at least `min-col` wide. When the days do not fit, as many as fit show,
    // with today in the middle (Teams goes to fewer days in a narrow window).
    property <length> min-col: 96px;
    property <int> fit: max(1, Math.floor((root.width - root.gutters) / root.min-col));
    property <int> shown: min(root.ncols, root.fit);
    property <int> first: root.ncols <= root.fit ? 0 : max(0, min(root.ncols - root.shown, max(0, CalStore.now-col) - Math.floor((root.shown - 1) / 2)));
    property <length> col-w: (root.width - root.gutters) / root.shown;
    property <length> pph: CalStore.scale == 15 ? 96px : (CalStore.scale == 60 ? 48px : 64px);
    property <int> slots: CalStore.scale == 15 ? 96 : (CalStore.scale == 60 ? 24 : 48);
    property <int> per-hour: CalStore.scale == 15 ? 4 : (CalStore.scale == 60 ? 1 : 2);
    property <length> allday-h: CalStore.all-day-rows > 0 ? CalStore.all-day-rows * 20px + 6px : 0px;

    // Drag to move or resize: the event being dragged, where it started and how far the pointer
    // went. The target is snapped to a quarter of an hour and kept inside the day.
    property <string> drag-id;
    property <string> drag-mode; // move | resize
    property <int> drag-col;
    property <int> drag-start;
    property <int> drag-dur;
    property <length> drag-dx;
    property <length> drag-dy;
    property <int> snap: 15;
    property <int> d-steps: Math.round(root.drag-dy / root.pph * 60 / root.snap) * root.snap;
    property <int> tgt-col: root.drag-mode == "move" ? max(root.first, min(root.first + root.shown - 1, root.drag-col + Math.round(root.drag-dx / root.col-w))) : root.drag-col;
    property <int> tgt-start: root.drag-mode == "move" ? max(0, min(24 * 60 - root.drag-dur, root.drag-start + root.d-steps)) : root.drag-start;
    property <int> tgt-dur: root.drag-mode == "resize" ? max(root.snap, min(24 * 60 - root.drag-start, root.drag-dur + root.d-steps)) : root.drag-dur;

    init => { grid.content-y = -max(0, (CalStore.work-start / 60 - 0.5)) * root.pph; }

    function begin(id: string, mode: string, col: int, start: int, dur: int) {
        root.drag-id = id;
        root.drag-mode = mode;
        root.drag-col = col;
        root.drag-start = start;
        root.drag-dur = dur;
    }

    function finish(id: string) {
        if root.drag-id == id && (root.tgt-col != root.drag-col || root.tgt-start != root.drag-start || root.tgt-dur != root.drag-dur) {
            CalStore.command("move", id + "|" + CalStore.days[root.tgt-col].iso + "|" + root.tgt-start + "|" + root.tgt-dur);
        }
        root.drag-id = "";
        root.drag-dx = 0px;
        root.drag-dy = 0px;
    }

    // Day headers
    Rectangle {
        y: 0px;
        width: parent.width;
        height: root.head-h;
        if CalStore.second-title != "": Text { x: 0px; y: root.head-h - 16px; width: root.gutter - 6px; text: CalStore.second-title; color: Theme.fg-subtle; font-size: 9px * Theme.font-scale; horizontal-alignment: right; }
        if CalStore.week-label != "": Text { x: root.gutters - root.gutter; y: root.head-h - 16px; width: root.gutter - 6px; text: CalStore.week-label; color: Theme.fg-subtle; font-size: 9px * Theme.font-scale; horizontal-alignment: right; }
        for d[i] in CalStore.days: Rectangle {
            property <bool> in-view: i >= root.first && i < root.first + root.shown;
            x: root.gutters + max(0, i - root.first) * root.col-w;
            width: self.in-view ? root.col-w : 0px;
            visible: self.in-view;
            height: parent.height;
            background: d.today ? #1c1c33 : transparent;
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                Text { text: d.pin == "" ? d.label : d.label + (d.pin == "office" ? " · Office" : " · Remote"); color: d.today ? Theme.accent : Theme.fg-muted; font-size: 11px * Theme.font-scale; horizontal-alignment: center; overflow: elide; }
                Rectangle {
                    height: 24px;
                    today-marker := Rectangle {
                        width: 24px;
                        x: (parent.width - 24px) / 2;
                        border-radius: 12px;
                        background: d.today ? Theme.accent-strong : transparent;
                        Text { text: d.number; color: Theme.fg; font-size: 13px * Theme.font-scale; font-weight: d.today ? 700 : 400; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }
            TouchArea {
                mouse-cursor: pointer;
                accessible-role: button;
                accessible-label: "Work location for " + d.iso;
                clicked => { CalStore.range-start = d.iso; CalStore.popup = "work-location"; }
            }
        }
    }

    // All-day row
    Rectangle {
        y: root.head-h;
        width: parent.width;
        height: root.allday-h;
        for a in CalStore.all-day: CalBox {
            property <int> from: max(a.col, root.first);
            property <int> to: min(a.col + a.span, root.first + root.shown);
            compact: true;
            visible: self.to > self.from;
            x: root.gutters + max(0, self.from - root.first) * root.col-w + 2px;
            y: 3px + a.row * 20px;
            width: max(0px, (self.to - self.from) * root.col-w - 4px);
            height: 18px;
            title: a.title;
            kind: a.kind;
            declined: a.declined;
            private: a.private;
            online: a.online;
            recurring: a.recurring;
            tone: a.tone;
            accessible-role: button;
            accessible-label: a.title;
            clicked => { root.peek(a.id, self.absolute-position.x + self.width, self.absolute-position.y); }
        }
        Rectangle { y: parent.height - 1px; height: root.allday-h > 0px ? 1px : 0px; background: Theme.border; }
    }

    grid := Flickable {
        interactive: false;
        y: root.head-h + root.allday-h;
        height: root.height - self.y;
        content-height: 24 * root.pph;
        content-width: self.width;

        // Day columns
        for d[i] in CalStore.days: Rectangle {
            property <bool> in-view: i >= root.first && i < root.first + root.shown;
            x: root.gutters + max(0, i - root.first) * root.col-w;
            width: self.in-view ? root.col-w : 0px;
            visible: self.in-view;
            height: 24 * root.pph;
            background: d.today ? #17172a : (d.weekend ? #181818 : transparent);
            // Outside work hours
            Rectangle { y: 0px; height: CalStore.work-start * root.pph / 60; background: #00000030; }
            // The events are being read: grey blocks hold their place.
            if CalStore.loading && CalStore.blocks.length == 0: Skeleton {
                x: 3px;
                y: root.pph * (9 + mod(i * 3, 5));
                width: parent.width - 6px;
                height: root.pph * (1 + mod(i, 2)) + 20px;
            }
            if CalStore.loading && CalStore.blocks.length == 0: Skeleton {
                x: 3px;
                y: root.pph * (14 + mod(i, 3));
                width: parent.width - 6px;
                height: root.pph + 12px;
            }
            Rectangle { y: CalStore.work-end * root.pph / 60; height: parent.height - self.y; background: #00000030; }
            TouchArea {
                accessible-role: button;
                accessible-label: "New event on " + d.iso;
                double-clicked => {
                    CalStore.command("new-at", d.iso + "|" + Math.floor(self.mouse-y / root.pph * 60 / 30) * 30);
                }
            }
        }
        // Slot lines
        for s in root.slots: Rectangle {
            x: root.gutters;
            y: s * 24 * root.pph / root.slots;
            width: root.width - root.gutters;
            height: 1px;
            background: Math.mod(s, root.per-hour) == 0 ? #3a3a3a : #262626;
        }
        for i in root.shown + 1: Rectangle { x: root.gutters + i * root.col-w; width: 1px; height: 24 * root.pph; background: Theme.border; }
        // Hour labels, and the second time zone's
        for h in 24: Text {
            x: root.gutters - root.gutter;
            y: h * root.pph - 7px;
            width: root.gutter - 8px;
            text: h == 0 ? "" : CalFmt.hour-label(h);
            color: Theme.fg-subtle;
            font-size: 11px * Theme.font-scale;
            horizontal-alignment: right;
        }
        for l[h] in CalStore.second-labels: Text {
            x: 0px;
            y: h * root.pph - 7px;
            width: root.gutter - 8px;
            text: h == 0 ? "" : l;
            color: Theme.fg-subtle;
            font-size: 11px * Theme.font-scale;
            horizontal-alignment: right;
        }
        // Events
        for b in CalStore.blocks: CalBox {
            property <bool> in-view: b.col >= root.first && b.col < root.first + root.shown;
            visible: self.in-view;
            x: root.gutters + max(0, b.col - root.first) * root.col-w + b.lane * ((root.col-w - 8px) / b.lanes) + 2px;
            y: b.start-min * root.pph / 60 + 1px;
            width: self.in-view ? (root.col-w - 8px) / b.lanes - 2px : 0px;
            height: max(b.dur-min * root.pph / 60 - 2px, 16px);
            draggable: true;
            title: b.title;
            organizer: b.organizer;
            time: b.time;
            kind: b.kind;
            declined: b.declined;
            private: b.private;
            online: b.online;
            recurring: b.recurring;
            tone: b.tone;
            accessible-role: button;
            accessible-label: b.title;
            accessible-description: (b.declined ? "Declined. " : "") + b.time;
            clicked => { root.peek(b.id, self.absolute-position.x + self.width, self.absolute-position.y); }
            moved(dx, dy) => {
                if root.drag-id != b.id || root.drag-mode != "move" {
                    root.begin(b.id, "move", b.col, b.start-min, b.dur-min);
                }
                root.drag-dx = dx;
                root.drag-dy = dy;
            }
            released(dx, dy) => {
                root.drag-dx = dx;
                root.drag-dy = dy;
                root.finish(b.id);
            }
            resize-moved(dy) => {
                if root.drag-id != b.id || root.drag-mode != "resize" {
                    root.begin(b.id, "resize", b.col, b.start-min, b.dur-min);
                }
                root.drag-dy = dy;
            }
            resize-released(dy) => {
                root.drag-dy = dy;
                root.finish(b.id);
            }
        }
        // Where a dragged event would land
        if root.drag-id != "": ghost := Rectangle {
            x: root.gutters + (root.tgt-col - root.first) * root.col-w + 2px;
            y: root.tgt-start * root.pph / 60;
            width: root.col-w - 4px;
            height: max(root.tgt-dur * root.pph / 60, 16px);
            border-radius: 4px;
            border-width: 2px;
            border-color: Theme.accent;
            background: #7f85f540;
            accessible-role: text;
            accessible-label: "Move to " + CalFmt.hhmm(root.tgt-start) + " – " + CalFmt.hhmm(root.tgt-start + root.tgt-dur);
            Text { x: 6px; y: 2px; text: CalFmt.hhmm(root.tgt-start) + " – " + CalFmt.hhmm(root.tgt-start + root.tgt-dur); color: Theme.fg; font-size: 11px * Theme.font-scale; font-weight: 600; }
        }
        // Current time
        if CalStore.now-min >= 0: Rectangle {
            x: root.gutters;
            y: CalStore.now-min * root.pph / 60;
            width: root.width - root.gutters;
            height: 1px;
            background: #e5484d80;
        }
        if CalStore.now-min >= 0 && CalStore.now-col >= root.first && CalStore.now-col < root.first + root.shown: now-line := Rectangle {
            x: root.gutters + (CalStore.now-col - root.first) * root.col-w;
            y: CalStore.now-min * root.pph / 60 - 1px;
            width: root.col-w;
            height: 2px;
            background: #e5484d;
            Rectangle { x: -4px; y: -3px; width: 8px; height: 8px; border-radius: 4px; background: #e5484d; }
        }
    }
}

component MonthGrid inherits Rectangle {
    callback peek(string, length, length);
    property <length> head-h: 26px;
    property <length> wn-w: CalStore.week-numbers ? 28px : 0px;
    property <int> cols: max(1, CalStore.month-cols);
    property <int> rows: max(1, Math.round(CalStore.month.length / root.cols));
    property <length> cw: (root.width - root.wn-w) / root.cols;
    property <length> ch: (root.height - root.head-h) / root.rows;

    for d[i] in CalStore.days: Text {
        x: root.wn-w + i * root.cw;
        y: 0px;
        width: root.cw;
        height: root.head-h;
        text: d.label;
        color: Theme.fg-muted;
        font-size: 11px * Theme.font-scale;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    for w[r] in CalStore.month-weeks: Text {
        x: 0px;
        y: root.head-h + r * root.ch;
        width: root.wn-w - 4px;
        height: 22px;
        text: root.wn-w > 0px ? "" + w : "";
        color: Theme.fg-subtle;
        font-size: 10px * Theme.font-scale;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
    for c[i] in CalStore.month: Rectangle {
        x: root.wn-w + Math.mod(i, root.cols) * root.cw;
        y: root.head-h + Math.floor(i / root.cols) * root.ch;
        width: root.cw;
        height: root.ch;
        background: c.today ? #17172a : (c.in-month ? transparent : #101010);
        border-width: 1px;
        border-color: Theme.border;
        clip: true;
        if CalStore.loading && c.items.length == 0 && mod(i, 3) != 1: Skeleton {
            x: 4px;
            y: 28px;
            width: parent.width * (mod(i, 2) == 0 ? 0.7 : 0.5);
            height: 12px;
        }
        VerticalLayout {
            padding: 3px;
            spacing: 1px;
            Rectangle {
                height: 22px;
                Rectangle {
                    x: 2px;
                    width: 22px;
                    border-radius: 11px;
                    background: c.today ? Theme.accent-strong : transparent;
                    Text { text: c.number; color: c.in-month ? Theme.fg : Theme.fg-subtle; font-size: 12px * Theme.font-scale; font-weight: c.today ? 700 : 400; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
            for it in c.items: Rectangle {
                height: 16px;
                accessible-role: button;
                accessible-label: it.title;
                Rectangle { x: 2px; y: 5px; width: 6px; height: 6px; border-radius: 3px; background: it.tone; }
                month-title := Text {
                    x: 12px;
                    width: parent.width - 14px;
                    text: it.time == "" ? it.title : it.time + " " + it.title;
                    color: it.declined ? Theme.fg-subtle : Theme.fg;
                    font-size: 11px * Theme.font-scale;
                    overflow: elide;
                    vertical-alignment: center;
                }
                if it.declined: Rectangle { x: 12px; y: parent.height / 2; width: min(month-title.preferred-width, month-title.width); height: 1px; background: Theme.fg-subtle; }
                TouchArea { mouse-cursor: pointer; clicked => { root.peek(it.id, self.absolute-position.x + self.width, self.absolute-position.y); } }
            }
            if c.more > 0: Text { text: "+" + c.more + " more"; color: Theme.fg-muted; font-size: 11px * Theme.font-scale; }
        }
    }
}

component MiniMonth inherits Rectangle {
    property <length> cell: 28px;
    property <length> wn-w: CalStore.week-numbers ? 20px : 0px;
    height: 36px + 20px + Math.round(CalStore.mini.length / 7) * root.cell + 8px;
    VerticalLayout {
        padding: 8px;
        HorizontalLayout {
            height: 32px;
            spacing: 2px;
            Text { text: CalStore.mini-title; color: Theme.fg; font-size: 13px * Theme.font-scale; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
            IconButton { icon: @image-url("../icons/chevron-left.svg"); size: 26px; y: 3px; clicked => { CalStore.command("mini", "-1"); } }
            IconButton { icon: @image-url("../icons/chevron-right.svg"); size: 26px; y: 3px; clicked => { CalStore.command("mini", "1"); } }
        }
        Rectangle {
            height: 20px + Math.round(CalStore.mini.length / 7) * root.cell;
            for l[i] in CalStore.mini-heads: Text {
                x: root.wn-w + i * ((parent.width - root.wn-w) / 7);
                y: 0px;
                width: (parent.width - root.wn-w) / 7;
                height: 20px;
                text: l;
                color: Theme.fg-subtle;
                font-size: 11px * Theme.font-scale;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            for w[r] in CalStore.mini-weeks: Text {
                x: 0px;
                y: 20px + r * root.cell;
                width: root.wn-w;
                height: root.cell;
                text: root.wn-w > 0px ? "" + w : "";
                color: Theme.fg-subtle;
                font-size: 10px * Theme.font-scale;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            for c[i] in CalStore.mini: Rectangle {
                x: root.wn-w + Math.mod(i, 7) * ((parent.width - root.wn-w) / 7);
                y: 20px + Math.floor(i / 7) * root.cell;
                width: (parent.width - root.wn-w) / 7;
                height: root.cell;
                background: c.selected ? #2b2d52 : transparent;
                Rectangle {
                    width: 24px;
                    height: 24px;
                    x: (parent.width - 24px) / 2;
                    y: (parent.height - 24px) / 2;
                    border-radius: 12px;
                    background: c.today ? Theme.accent-strong : (mini-touch.has-hover ? Theme.surface-hover : transparent);
                    Text { text: c.number; color: c.today ? #ffffff : (c.in-month ? Theme.fg : Theme.fg-subtle); font-size: 12px * Theme.font-scale; horizontal-alignment: center; vertical-alignment: center; }
                }
                mini-touch := TouchArea { mouse-cursor: pointer; clicked => { CalStore.command("goto", c.iso); } }
            }
        }
    }
}

// The calendars list: my calendars, other and group calendars, each with a checkbox and color.
component CalendarsList inherits VerticalLayout {
    padding-left: 12px;
    padding-right: 12px;
    spacing: 2px;
    HorizontalLayout {
        height: 26px;
        Text { text: "Calendars"; color: Theme.fg-muted; font-size: 12px * Theme.font-scale; vertical-alignment: center; horizontal-stretch: 1; }
        FlexButton { variant: ButtonVariant.toolbar; label: "Show all"; height: 22px; clicked => { CalStore.command("calendar-all", "1"); } }
    }
    for c in CalStore.calendars: Rectangle {
        height: c.header ? 22px : 26px;
        if c.header: Text { x: 0px; width: parent.width; text: c.name; color: Theme.fg-subtle; font-size: 11px * Theme.font-scale; vertical-alignment: bottom; horizontal-alignment: left; overflow: elide; }
        if !c.header: Check { variant: CheckVariant.toolbar;
            label: c.name;
            checked: c.checked;
            tone: c.color;
            accessible-label: "Calendar " + c.name;
            toggled(on) => { CalStore.command("calendar-toggle", c.id); }
        }
    }
    FlexButton { variant: ButtonVariant.toolbar; label: "Add calendar ▾"; active: CalStore.popup == "add-calendar"; clicked => { CalStore.popup = CalStore.popup == "add-calendar" ? "" : "add-calendar"; } }
}

export component CalendarView inherits Rectangle {
    background: Theme.main;
    // The window's width (from app.slint). The page's own width depends on what it shows, so
    // the choices below go by the window's.
    in property <length> window-width: 1400px;
    // A narrow window: no left pane (its New event moves to the toolbar).
    property <bool> narrow: root.window-width < 890px;
    // Teams' "collapse sidebar": the left pane hidden on a wide window too.
    in-out property <bool> pane-hidden: false;
    // Room for the pane toggle and the Meet now button in the toolbar; below it Meet now is in the ⋯ menu.
    property <bool> wide: root.window-width >= 1100px;
    property <bool> pane-off: root.pane-hidden && root.wide;
    // Where an event was clicked, in this view's coordinates, so the peek opens next to it.
    property <[{key: string, label: string}]> views: [{key: "day", label: "Day"}, {key: "workweek", label: "Work week"}, {key: "week", label: "Week"}, {key: "month", label: "Month"}, {key: "split", label: "Split view"}];
    property <string> view-label: CalStore.view-kind == "day" ? "Day" : CalStore.view-kind == "workweek" ? "Work week" : CalStore.view-kind == "week" ? "Week" : CalStore.view-kind == "month" ? "Month" : "Split view";
    function open-peek(id: string, ax: length, ay: length) {
        CalStore.peek-x = ax - root.absolute-position.x + 8px;
        CalStore.peek-y = ay - root.absolute-position.y;
        CalStore.popup = "";
        CalStore.peek-open = true;
        CalStore.command("peek", id);
    }
    HorizontalLayout {
        // Left: New event, mini month, calendars, time scale, days
        Rectangle {
            width: root.narrow || root.pane-off ? 0px : 232px;
            visible: !root.narrow && !root.pane-off;
            background: Theme.sidebar;
            ScrollView {
                VerticalLayout {
                    alignment: start;
                    padding-top: 8px;
                    spacing: 6px;
                    VerticalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 6px;
                        FlexButton { variant: ButtonVariant.toolbar; label: "New event ▾"; primary: true; height: 32px; active: CalStore.popup == "new"; clicked => { CalStore.popup = CalStore.popup == "new" ? "" : "new"; } }
                        HorizontalLayout {
                            spacing: 6px;
                            FlexButton { variant: ButtonVariant.toolbar; label: "Meet now"; horizontal-stretch: 1; clicked => { CalStore.ask("meet-now", "Meet now", "Starts a Teams meeting right away and gives you the link.", "Meeting title (optional)", "", "", "Start meeting"); } }
                            FlexButton { variant: ButtonVariant.toolbar; label: "Join with an ID"; horizontal-stretch: 1; clicked => { CalStore.ask("join-id", "Join with a meeting ID", "Type the meeting ID and the passcode from the invitation, or paste a meeting link.", "Meeting ID or link", "Passcode", "", "Join"); } }
                        }
                    }
                    MiniMonth { }
                    CalendarsList { }
                    VerticalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 6px;
                        Text { text: "Time scale"; color: Theme.fg-muted; font-size: 12px * Theme.font-scale; }
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            for s in [15, 30, 60]: Pill {
                                label: s + " min";
                                active: CalStore.scale == s;
                                clicked => { CalStore.command("scale", "" + s); }
                            }
                        }
                        if CalStore.view-kind == "day": HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Text { text: "Days"; color: Theme.fg-muted; font-size: 12px * Theme.font-scale; vertical-alignment: center; }
                            IconButton { icon: @image-url("../icons/chevron-left.svg"); size: 26px; clicked => { CalStore.command("days", "-1"); } }
                            Text { text: CalStore.day-count; color: Theme.fg; font-size: 13px * Theme.font-scale; vertical-alignment: center; }
                            IconButton { icon: @image-url("../icons/chevron-right.svg"); size: 26px; clicked => { CalStore.command("days", "1"); } }
                        }
                    }
                }
            }
        }
        VerticalLayout {
            // Toolbar. Without room for the five view pills they fold into one "View" menu (with the
            // saved views), so the month keeps its room.
            toolbar := Rectangle {
                property <bool> fold: root.window-width < 1300px;
                height: 48px;
                background: Theme.sidebar;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 8px;
                    if root.wide: IconButton { icon: @image-url("../icons/columns.svg"); y: 8px; tooltip: root.pane-hidden ? "Show the calendar pane" : "Hide the calendar pane"; active: root.pane-hidden; clicked => { root.pane-hidden = !root.pane-hidden; } }
                    if root.narrow || root.pane-off: FlexButton { variant: ButtonVariant.toolbar; label: "New ▾"; primary: true; y: 10px; accessible-label: "New event"; active: CalStore.popup == "new"; clicked => { CalStore.popup = CalStore.popup == "new" ? "" : "new"; } }
                    Pill { label: "Today"; y: 11px; clicked => { CalStore.command("today", ""); } }
                    IconButton { icon: @image-url("../icons/chevron-left.svg"); y: 8px; tooltip: "Previous"; clicked => { CalStore.command("prev", ""); } }
                    IconButton { icon: @image-url("../icons/chevron-right.svg"); y: 8px; tooltip: "Next"; clicked => { CalStore.command("next", ""); } }
                    Rectangle {
                        horizontal-stretch: 1;
                        min-width: min(title-text.preferred-width + 20px, 160px);
                        accessible-role: button;
                        accessible-label: "Pick dates";
                        accessible-description: CalStore.title;
                        accessible-action-default => { CalStore.popup = CalStore.popup == "range" ? "" : "range"; }
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            title-text := Text { text: CalStore.title + (CalStore.week-label != "" ? "  ·  " + CalStore.week-label : ""); color: Theme.fg; font-size: 16px * Theme.font-scale; font-weight: 700; vertical-alignment: center; overflow: elide; horizontal-stretch: 0; }
                            Text { text: "▾"; color: Theme.fg-muted; font-size: 12px * Theme.font-scale; vertical-alignment: center; }
                        }
                        TouchArea { mouse-cursor: pointer; clicked => { CalStore.range-start = ""; CalStore.popup = CalStore.popup == "range" ? "" : "range"; } }
                    }
                    if CalStore.status != "": Text { text: CalStore.status; color: #ffb900; font-size: 12px * Theme.font-scale; vertical-alignment: center; overflow: elide; }
                    FlexButton { variant: ButtonVariant.toolbar; label: CalStore.filtered ? "Filter ●" : "Filter"; y: 10px; active: CalStore.popup == "filters" || CalStore.filtered; clicked => { CalStore.popup = CalStore.popup == "filters" ? "" : "filters"; } }
                    if !toolbar.fold: HorizontalLayout {
                        spacing: 8px;
                        for v in root.views: Pill {
                            y: 11px;
                            label: v.label;
                            active: CalStore.view-kind == v.key;
                            clicked => { CalStore.command("view", v.key); }
                        }
                    }
                    if !toolbar.fold: FlexButton { variant: ButtonVariant.toolbar; label: "Views ▾"; y: 10px; active: CalStore.popup == "views"; clicked => { CalStore.popup = CalStore.popup == "views" ? "" : "views"; } }
                    if toolbar.fold: FlexButton { variant: ButtonVariant.toolbar;
                        label: root.view-label + " ▾";
                        accessible-label: "View: " + root.view-label;
                        y: 10px;
                        active: CalStore.popup == "view-pick";
                        clicked => { CalStore.popup = CalStore.popup == "view-pick" ? "" : "view-pick"; }
                    }
                    if root.wide: FlexButton { variant: ButtonVariant.toolbar; label: "Meet now ▾"; accessible-label: "Meet now menu"; y: 10px; active: CalStore.popup == "meet"; clicked => { CalStore.popup = CalStore.popup == "meet" ? "" : "meet"; } }
                    FlexButton { variant: ButtonVariant.toolbar; label: "⋯"; y: 10px; preferred-width: 36px; min-width: 36px; active: CalStore.popup == "more"; clicked => { CalStore.popup = CalStore.popup == "more" ? "" : "more"; } }
                }
                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
            }
            if CalStore.view-kind != "month": TimeGrid {
                vertical-stretch: 1;
                peek(id, ax, ay) => { root.open-peek(id, ax, ay); }
            }
            if CalStore.view-kind == "month": MonthGrid {
                vertical-stretch: 1;
                peek(id, ax, ay) => { root.open-peek(id, ax, ay); }
            }
        }
    }

    // The peek, closed by a click anywhere else
    if CalStore.peek-open && CalStore.modal == "": Scrim {
        z: 30;
        dismissed => { CalStore.close-all(); }
    }
    if CalStore.peek-open && CalStore.modal == "": EventPeek {
        z: 31;
        x: max(8px, min(root.width - self.width - 8px, CalStore.peek-x));
        y: max(8px, min(root.height - self.height - 8px, CalStore.peek-y));
    }

    // Popovers
    if CalStore.popup != "": Scrim {
        z: 40;
        dismissed => { CalStore.popup = ""; }
    }
    if CalStore.popup == "new": NewMenu { z: 41; x: 12px; y: 48px; }
    if CalStore.popup == "meet": MenuFrame { variant: MenuFrameVariant.card;
        z: 41;
        x: root.width - self.width - 56px;
        y: 52px;
        width: 220px;
        height: 2 * 30px + 8px;
        VerticalLayout {
            padding: 4px;
            MenuItem { variant: MenuItemVariant.calendar; label: "Meet now"; clicked => { CalStore.popup = ""; CalStore.ask("meet-now", "Meet now", "Starts a Teams meeting right away and gives you the link.", "Meeting title (optional)", "", "", "Start meeting"); } }
            MenuItem { variant: MenuItemVariant.calendar; label: "Join with a meeting ID"; clicked => { CalStore.popup = ""; CalStore.ask("join-id", "Join with a meeting ID", "Type the meeting ID and the passcode from the invitation, or paste a meeting link.", "Meeting ID or link", "Passcode", "", "Join"); } }
        }
    }
    if CalStore.popup == "add-calendar": AddCalendarMenu { z: 41; x: 12px; y: 240px; }
    if CalStore.popup == "range": RangePicker { z: 41; x: 248px; y: 52px; }
    if CalStore.popup == "filters": FiltersPanel { z: 41; x: root.width - self.width - 16px; y: 52px; }
    if CalStore.popup == "views": ViewsPanel { z: 41; x: root.width - self.width - 16px; y: 52px; }
    if CalStore.popup == "more": CalendarMoreMenu { meet: !root.wide; z: 41; x: root.width - self.width - 16px; y: 52px; }
    if CalStore.popup == "view-pick": MenuFrame { variant: MenuFrameVariant.card;
        z: 41;
        x: root.width - self.width - 16px;
        y: 52px;
        width: 200px;
        height: (root.views.length + 1) * 30px + 8px;
        VerticalLayout {
            padding: 4px;
            for v in root.views: MenuItem { variant: MenuItemVariant.calendar;
                label: v.label;
                checked: CalStore.view-kind == v.key;
                clicked => { CalStore.popup = ""; CalStore.command("view", v.key); }
            }
            MenuItem { variant: MenuItemVariant.calendar; label: "Saved views…"; clicked => { CalStore.popup = "views"; } }
        }
    }
    if CalStore.popup == "work-location": WorkLocationMenu { z: 41; x: 340px; y: 56px; }

    // Dialogs
    if CalForm.open: Rectangle {
        z: 50;
        background: #00000099;
        TouchArea { }
        EventForm {
            width: min(820px, parent.width - 48px);
            height: min(1100px, parent.height - 48px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
    }
    if CalStore.modal == "full": Rectangle {
        z: 51;
        background: #00000099;
        TouchArea { clicked => { CalStore.close-all(); } }
        EventFull {
            width: min(760px, parent.width - 48px);
            height: min(680px, parent.height - 48px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
    }
    if CalStore.modal == "prompt": PromptDialog { z: 60; }
    if CalStore.modal == "settings": SettingsDialog { z: 60; }
    if CalStore.modal == "share": CalendarShareDialog { z: 60; }
    if CalStore.modal == "meet-link": MeetLinkDialog { z: 60; }
}

// Shown above the app from 5 minutes before a Teams meeting until it ends.
export component JoinBanner inherits Rectangle {
    height: 40px;
    background: Theme.dark ? #1d3a2a : #dcf3e5;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 12px;
        spacing: 10px;
        Icon { source: @image-url("../icons/video.svg"); tint: Theme.dark ? #6bd69b : #237b4b; y: 10px; }
        Text { text: CalStore.join-text; color: Theme.fg; font-size: 13px * Theme.font-scale; font-weight: 600; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
        join-button := Rectangle {
            width: 64px;
            height: 26px;
            y: 7px;
            border-radius: 4px;
            background: join-touch.has-hover ? Theme.accent : Theme.accent-strong;
            Text { text: "Join"; color: #ffffff; font-size: 13px * Theme.font-scale; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
            join-touch := TouchArea { mouse-cursor: pointer; clicked => { CalStore.command("join", CalStore.join-url); } }
        }
        IconButton { icon: @image-url("../icons/close.svg"); size: 26px; y: 7px; clicked => { CalStore.command("dismiss-banner", ""); } }
    }
    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.dark ? #2f6b4a : #a6d9bb; }
}
