// State of the Settings page and the profile menu (plans/settings-and-platform.md X1, chat plan
// 9.1, 9.3 and 9.9). Everything shown comes from this global, filled by the Rust side
// (`ui/settings.rs`); the UI reports what the user did through `command(name, argument)`.
// Arguments with several values are joined with the unit separator "\u{1f}".

import { EmojiItem, Tokens } from "../tokens/types.slint";

export struct SOption { v: string, l: string }
// A switch row. `enabled: false` greys it out; `hint` is the second line.
export struct SToggle { key: string, label: string, hint: string, on: bool, enabled: bool }
// A notification type: `value` is banner | feed | off, or "" when Teams has no value yet.
export struct SNotify { key: string, label: string, group: string, value: string }
export struct SPerson { mri: string, name: string }
// `unread`: the unread total the account had when it last ran (0 when unknown).
export struct SAccount { label: string, name: string, upn: string, active: bool, unread: int, initials: string, theme: string }
export struct SOrg { tenant: string, name: string, home: bool, active: bool }
export struct SDevice { id: string, name: string }
export struct SAppPerm { app: string, name: string, perms: [SToggle] }
// A "Find in Settings" hit: the setting's label and the page that holds it.
export struct SFind { page: string, page-title: string, label: string }
// A theme of the gallery: its id (`builtin:dusk`, `custom:<uuid>`), name, kind (light | dark) and
// the colours its tile draws. `low-contrast`: the contrast check could not pass every pair.
export struct STheme { id: string, name: string, kind: string, nav: color, content: color, accent: color, bubble: color, custom: bool, low-contrast: bool }

// The custom theme editor (`ui/settings/themes.rs`): one base colour with its hex and the picker's
// slider positions (0 to 100 each: lightness, chroma, hue), a contrast pair that fails (names and
// ratios as text), and a token the adjustment moved (the colour picked and the one drawn).
export struct SBaseRow { hex: string, colour: color, l: float, c: float, h: float }
export struct SPairRow { fg: string, bg: string, ratio: string, min: string }
export struct SAdjusted { token: string, picked: color, drawn: color }

export global SettingsStore {
    // --- the page ---
    in-out property <bool> open: false;
    // general | accounts | privacy | notifications | appearance | accessibility | devices | files
    // | storage | permissions | about
    in-out property <string> page: "general";
    in-out property <string> query;
    // The setting a Find result opened (its label), and where its row is once the page is up
    // (window y); the page list scrolls it into view (settings.slint).
    in-out property <string> target;
    in-out property <length> target-y: -1px;
    in-out property <[SFind]> found;
    // A short message at the bottom of the page (saved, dry run, errors).
    in-out property <string> notice;
    // Teams writes that were only planned, newest first (`METHOD url` and the body).
    in-out property <[string]> dry-runs;

    // --- profile menu (9.9) ---
    in-out property <bool> profile-open: false;
    in-out property <string> me-name;
    in-out property <string> me-email;
    in-out property <string> me-initials;
    in-out property <string> me-status;
    // When the status message clears ("14:30", or "11/21 14:30"), "" when it has no end.
    in-out property <string> me-status-ends;
    in-out property <string> me-presence;
    // What I am doing (InACall, InAMeeting, OffWork, ...), and the words Teams shows for my status
    // ("In a call", else the availability's). Both are set together with me-presence (Rust).
    in-out property <string> me-activity;
    in-out property <string> me-status-label;
    // "Until 3:45 PM" when the status picked here ends at a set time, else "".
    in-out property <string> me-presence-until;
    in-out property <string> me-work-location; // office | remote | ""
    in-out property <bool> status-open: false;
    // The account card's "Set status message" editor is showing.
    in-out property <bool> message-open: false;
    in-out property <bool> confirm-sign-out: false;
    // My photo (top bar and profile menu); `me-has-photo` is false until one was read.
    in-out property <image> me-photo;
    in-out property <bool> me-has-photo: false;
    // "Reset status after" (never | 30m | 1h | 2h | today | week | custom) and the custom time.
    in-out property <string> status-duration: "never";
    in-out property <string> status-custom;
    // The status message's "Clear after" (never | 30m | 1h | 4h | today | week) and "Show when people
    // message me".
    in-out property <string> note-clear-after: "never";
    in-out property <bool> note-show-when-messaged: false;

    // --- Appearance (9.3) ---
    in-out property <string> theme-shown;     // light | dark: what is drawn now
    // The theme gallery (built-in, then custom) and the same themes for the light and dark
    // slots, that kind first.
    in-out property <[STheme]> themes;
    in-out property <[STheme]> themes-light-first;
    in-out property <[STheme]> themes-dark-first;
    // Switch: one (theme-id) | system (follow the desktop) | schedule (light and dark from times).
    in-out property <string> theme-mode: "system";
    in-out property <string> theme-id;
    in-out property <string> theme-light: "builtin:light";
    in-out property <string> theme-dark: "builtin:dark";
    in-out property <string> theme-light-from: "08:00";
    in-out property <string> theme-dark-from: "19:00";
    // The theme drawn now, and whether the accent setting applies to it (IronTeams Dark or Light).
    in-out property <string> theme-active: "builtin:dark";
    in-out property <string> theme-active-name: "IronTeams Dark";
    // The custom theme editor: new | edit | import, the 8 base colours, the preview's regions and
    // the contrast report. `editor-error` is a `share-error` code, "" when there is none.
    in-out property <bool> editor-open: false;
    in-out property <string> editor-mode: "new";
    in-out property <string> editor-id;
    in-out property <string> editor-name;
    in-out property <[SBaseRow]> editor-rows;
    in-out property <Tokens> editor-content;
    in-out property <Tokens> editor-nav;
    in-out property <[SPairRow]> editor-failing;
    in-out property <[SAdjusted]> editor-adjusted;
    in-out property <bool> editor-keep: false;
    in-out property <bool> editor-low-contrast: false;
    in-out property <string> editor-error;
    in-out property <string> editor-line;
    in-out property <bool> editor-can-save: false;
    // The Import dialog, the Rename dialog (the theme and the name it starts with) and the limit.
    in-out property <bool> import-open: false;
    in-out property <string> rename-id;
    in-out property <string> rename-name;
    in-out property <bool> themes-full: false;
    // The theme of the call screen and its menus: a theme id, or "" for the app's.
    in-out property <string> call-theme;
    in-out property <bool> accent-enabled: true;
    in-out property <string> accent: "";      // #rrggbb, "" follows the desktop
    in-out property <string> accent-shown;
    in-out property <string> density: "comfy"; // comfy | compact
    in-out property <float> font-scale: 1.0;
    // The fonts (Appearance > Text): the installed families the pickers list after "Default"
    // (filled when the page first opens), and the saved code and interface families ("" default).
    in-out property <[string]> font-families;
    in-out property <string> font-code;
    in-out property <string> font-ui;
    // How a message is drawn (organisms/message_row.slint): bubbles | flat | compact.
    in-out property <string> message-style: "bubbles";
    in-out property <bool> show-avatars: true;
    in-out property <bool> show-timestamps: true;
    in-out property <bool> show-reactions: true;
    in-out property <int> skin-tone: 0;

    // --- General (X1.2) ---
    in-out property <[SOption]> languages;
    in-out property <string> language: "";     // "" follows the system
    in-out property <string> language-shown;
    in-out property <string> date-format: "auto"; // auto | dmy | mdy | ymd
    in-out property <string> time-format: "auto"; // auto | h12 | h24
    // The page IronTeams opens on at start: activity | chat | teams | calendar | last.
    in-out property <string> start-page: "chat";
    in-out property <string> time-zone: "";       // "" follows the system
    in-out property <string> system-time-zone;
    in-out property <[SToggle]> startup;

    // --- Chats ---
    // When a chat opens: last-read (at the first unread message) | newest.
    in-out property <string> open-chat-at: "last-read";
    in-out property <bool> link-previews: true;
    // How far a mouse wheel notch scrolls the conversation lists: the notch times this (1 to 5).
    in-out property <float> wheel-speed: 2.5;
    // The reactions on a message's hover bar, up to six (Chats > Quick reactions). Teams' four
    // until the Rust side pushes the saved ones.
    in-out property <[EmojiItem]> quick-reactions: [
        { key: "like", emoji: "👍", name: "Like" },
        { key: "heart", emoji: "❤️", name: "Heart" },
        { key: "laugh", emoji: "😆", name: "Laugh" },
        { key: "surprised", emoji: "😮", name: "Surprised" },
    ];
    // The slot the reaction picker is choosing for (Settings opened it).
    in-out property <int> quick-slot: -1;

    // --- Accessibility (X1.3) ---
    in-out property <string> high-contrast: "auto"; // auto | on | off
    in-out property <string> reduced-motion: "auto";
    in-out property <bool> larger-text: false;
    in-out property <string> a11y-shown;
    in-out property <[SToggle]> a11y-flags;

    // --- Notifications and activity (9.1) ---
    in-out property <[SNotify]> notify;
    in-out property <bool> paused: false;
    // "Paused until 14:30" while paused; the custom pause time box.
    in-out property <string> pause-until;
    in-out property <bool> pause-custom-open: false;
    in-out property <string> notify-status;

    // --- Privacy (X1.5) ---
    in-out property <[SToggle]> privacy;
    in-out property <[SPerson]> blocked;
    in-out property <[SPerson]> priority;
    in-out property <string> privacy-status;

    // --- Devices (X1.4) ---
    in-out property <[SDevice]> mics;
    in-out property <[SDevice]> speakers;
    in-out property <[SDevice]> cameras;
    in-out property <string> mic: "";     // "" is the system default
    in-out property <string> speaker: "";
    in-out property <string> camera: "";
    in-out property <bool> all-devices: false;
    in-out property <bool> noise-suppression: true;
    in-out property <bool> echo-cancellation: true;
    // The call speaker's volume, 0 to 100 (the call window's speaker slider).
    in-out property <float> speaker-volume: 100;
    in-out property <float> mic-level;
    in-out property <bool> mic-testing: false;
    in-out property <string> devices-status;

    // --- Calls ---
    in-out property <string> call-feedback: "sometimes"; // always | sometimes | never
    in-out property <string> ringtone: "default"; // default | a Teams ringtone | ironteams | chime | soft | pulse | custom
    // Teams' own sounds, from the table in `teams_assets` (the default first).
    in-out property <[SOption]> ringtone-originals;
    in-out property <[SOption]> message-originals;
    in-out property <[SOption]> urgent-originals;
    in-out property <string> ringtone-file; // the custom file's name ("" for none)
    in-out property <string> message-sound: "default"; // default (Teams' Tap) | a Teams sound | ironteams | chime | soft | pulse | custom
    in-out property <string> urgent-sound: "default"; // default (Teams' Prioritize) | escalate | alarm
    in-out property <string> message-sound-file;
    in-out property <bool> download-teams-sounds: true;

    // --- Files and links (X1.6) ---
    in-out property <string> open-files: "browser"; // ironteams | browser | desktop
    in-out property <string> open-links: "default"; // default | ask

    // --- Storage ---
    // The sizes are read by the engine when the page opens (`storage-loaded` is false until
    // they arrive) and are text such as "1.2 GB".
    in-out property <bool> storage-loaded: false;
    in-out property <string> storage-db;
    in-out property <string> storage-media;
    in-out property <string> storage-temp;
    in-out property <string> storage-backups;
    in-out property <string> storage-total;
    // The media cache limit in MB: 250 | 500 | 1024 | 2048 | none.
    in-out property <string> media-cache-limit: "500";
    // "Clear all cached data" waits for its confirmation.
    in-out property <bool> confirm-clear-all: false;

    // --- App permissions (X1.7) ---
    in-out property <[SAppPerm]> app-perms;
    in-out property <string> perms-status;

    // --- Accounts and orgs (X2.1) ---
    in-out property <[SAccount]> accounts;
    in-out property <[SOrg]> orgs;
    in-out property <string> accounts-status;
    in-out property <bool> restart-needed: false;
    // The account switch (ui/settings/switch.rs): the confirmation listing what it would cut
    // short, and "Switching…" while it is decided or IronTeams is restarting.
    in-out property <bool> switch-confirm-open: false;
    in-out property <[string]> switch-confirm-lines;
    in-out property <bool> switch-busy: false;
    // The account label waiting for "Yes, remove the account", "" when none.
    in-out property <string> confirm-remove: "";

    // --- About ---
    in-out property <string> version;
    // `update-status` is the line under "Check now".
    in-out property <bool> banner-photo: true;
    // How notifications look: "cards" (Teams cards drawn by IronTeams) or "system".
    in-out property <string> notification-style: "cards";
    // Red underlines under misspelled words in the message box (General > Writing).
    in-out property <bool> check-spelling: true;
    // Teams' sound and preview switches, and which meeting chats notify (all | participated | none).
    in-out property <[SToggle]> notify-sounds;
    in-out property <string> meeting-chat;
    in-out property <bool> banner-actions: true;
    // Quiet hours, Focus mode and keyword alerts (all local to this device).
    in-out property <bool> quiet-on: false;
    in-out property <[bool]> quiet-days: [true, true, true, true, true, true, true]; // Monday first
    in-out property <string> quiet-start: "22:00";
    in-out property <string> quiet-end: "07:00";
    in-out property <bool> focus-on: false;
    // "" | forever | today | later, with the end time as HH:MM for today and later.
    in-out property <string> focus-end-kind: "";
    in-out property <string> focus-end-time: "";
    in-out property <string> focus-duration: "1h"; // 1h | 2h | tomorrow | manual
    in-out property <[string]> keywords;
    in-out property <bool> update-checking: false;
    in-out property <bool> update-available: false;
    in-out property <string> update-status;
    // Self-updates, for copies Velopack installed (`self-update`); others keep the opt-in check.
    in-out property <bool> self-update: false;
    in-out property <bool> beta-updates: false;
    // A downloaded update waits for "Restart to update" (or the next quit).
    in-out property <bool> update-ready: false;

    // Graphics (General > Performance): the saved choice and the renderer drawing now, "cpu" or
    // "gpu". A change applies on the next start (`renderer-restart`); `renderer-fallback`: the GPU
    // was asked for and could not start.
    in-out property <string> renderer: "cpu";
    in-out property <string> renderer-running: "cpu";
    in-out property <bool> renderer-restart: false;
    in-out property <bool> renderer-fallback: false;

    // The line under the Focus switch and in the indicator's description; "" when Focus is off.
    pure public function focus-label() -> string {
        return root.focus-end-kind == "forever" ? @tr("Until you turn it off")
            : root.focus-end-kind == "today" ? @tr("Until {}", root.focus-end-time)
            : root.focus-end-kind == "later" ? @tr("Until tomorrow {}", root.focus-end-time)
            : "";
    }

    // (name, argument). See `ui/settings.rs` for the list.
    callback command(string, string);

    // The name a theme shows: the built-in names are translated, a custom theme keeps its own.
    pure public function theme-name(id: string, name: string) -> string {
        return id == "builtin:dark" ? @tr("IronTeams Dark")
            : id == "builtin:light" ? @tr("IronTeams Light")
            : id == "builtin:dusk" ? @tr("Dusk")
            : id == "builtin:harbor" ? @tr("Harbor")
            : id == "builtin:moss" ? @tr("Moss")
            : id == "builtin:sandstone" ? @tr("Sandstone")
            : id == "builtin:ember" ? @tr("Ember")
            : id == "builtin:glacier" ? @tr("Glacier")
            : id == "builtin:graphite" ? @tr("Graphite")
            : id == "builtin:orchard" ? @tr("Orchard")
            : name;
    }
    // The sentence for a refused theme line or name (`appearance::share` codes), "" for no error.
    pure public function share-error(code: string) -> string {
        return code == "too-long" ? @tr("The line is longer than 200 characters.")
            : code == "not-a-theme" ? @tr("This is not an IronTeams theme line.")
            : code == "version" ? @tr("This theme line comes from a newer IronTeams.")
            : code == "name-empty" ? @tr("The theme has no name.")
            : code == "name-too-long" ? @tr("The name is longer than 40 characters.")
            : code == "name-colon" ? @tr("The name may not contain a colon.")
            : code == "name-hidden" ? @tr("The name contains hidden or control characters.")
            : code == "colours" ? @tr("The line must hold exactly 8 colours written as #rrggbb.")
            : code == "limit" ? @tr("You have 50 custom themes, the most IronTeams keeps. Delete one first.")
            : "";
    }
    pure public function j2(a: string, b: string) -> string { return a + "\u{1f}" + b; }
    pure public function j3(a: string, b: string, c: string) -> string { return a + "\u{1f}" + b + "\u{1f}" + c; }
    pure public function j4(a: string, b: string, c: string, d: string) -> string { return a + "\u{1f}" + b + "\u{1f}" + c + "\u{1f}" + d; }

    // Opens the Settings page on `p`.
    public function show(p: string) {
        root.page = p;
        root.query = "";
        root.profile-open = false;
        root.open = true;
        root.command("open", p);
    }

    // Opens the profile menu under the avatar.
    public function open-profile() {
        root.confirm-sign-out = false;
        root.status-open = false;
        root.message-open = false;
        root.profile-open = true;
        root.command("profile", "");
    }

    public function close() {
        root.open = false;
        root.command("close", "");
    }
}
