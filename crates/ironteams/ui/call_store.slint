// The call window's state, filled by `src/ui/call.rs` from the backend's CallManager
// (`src/backend/call.rs`). Commands go back through `command(name, argument)`.

export struct CallPerson {
    // Their MRI ("" when unknown), for "Give control" and the like.
    id: string,
    name: string,
    initials: string,
    muted: bool,
    hand: bool,
    // Their live reaction floating now (its emoji and name), "" for none.
    reaction: string,
    reaction-name: string,
    // Waiting in the lobby.
    lobby: bool,
    // Us.
    me: bool,
    // organizer | presenter | attendee | "".
    role: string,
    // Heard right now.
    speaking: bool,
    // Their profile photo, when known (else the tile shows the initials).
    photo: image,
    has-photo: bool,
    // This tile shows the other side's video (CallStore.remote-video) when there is one.
    video: bool,
    // The meeting gallery slot showing their camera, 1-based (CallStore.slot-videos); 0: none.
    gallery-slot: int,
    // "External" or "Guest" for someone outside our organization ("" for a colleague): shown as
    // "(External)" after their name in People, the lobby and the tiles.
    badge: string,
}

// One meeting gallery slot's picture.
export struct CallVideo {
    frame: image,
    shown: bool,
}

// One live reaction floating up the stage (call_reactions.slint).
export struct CallReaction {
    // Rising per call: the window keeps a reaction's place while others come and go.
    id: int,
    emoji: string,
    // Like | Heart | Laugh | Surprised | Applause.
    name: string,
    // Who sent it, "You" for us.
    who: string,
    mine: bool,
    // Where it rises across the stage, 0..1 (slightly random).
    lane: float,
}

// One live caption: who speaks and what they said.
export struct CallCaption {
    speaker: string,
    text: string,
}

// Someone the people search found (the invite box, the transfer dialog).
export struct CallFound {
    id: string,
    name: string,
    subtitle: string,
    initials: string,
}

export global CallStore {
    // "" (no call) | prejoin | connecting | lobby | connected | reconnecting | ended
    in property <string> phase;
    // meeting | direct
    in property <string> kind: "meeting";
    in property <string> title;
    in property <string> my-name;
    in property <string> my-initials;
    in property <string> timer: "00:00";
    in property <bool> muted;
    in property <bool> hand;
    // The call negotiated a screen-sharing line (Share works), and we are sharing.
    in property <bool> can-share;
    in property <bool> sharing;
    // Camera video is on (the default; IRONTEAMS_CAMERA=0 switches it off); the call negotiated a main-video line
    // (Camera works); the camera is on.
    in property <bool> camera-available;
    in property <bool> can-camera;
    in property <bool> camera;
    // The pre-join camera switch.
    in property <bool> prejoin-camera;
    // Our camera, drawn small in our tile, and the other side's video in theirs.
    in property <image> self-view;
    in property <bool> has-self-view;
    in property <image> remote-video;
    in property <bool> has-remote-video;
    // The meeting gallery's pictures, one per receive slot (CallPerson.gallery-slot).
    in property <[CallVideo]> slot-videos;
    // Who else shares a screen ("" when the roster names nobody), and the shared screen.
    in property <string> presenter;
    in property <image> content-video;
    in property <bool> has-content;
    // Remote control of a shared screen is offered (IRONTEAMS_REMOTE_CONTROL=1), where it stands
    // ("" | requested | incoming | controlling | controlled) and the other person's name.
    in property <bool> remote-control;
    in property <string> control-mode;
    in property <string> control-name;
    // The pre-join microphone switch.
    in property <bool> prejoin-mic: true;
    // Shown only when the call state says the meeting is recorded.
    in property <bool> recording;
    // The meeting is being transcribed.
    in property <bool> transcribing;
    // Live captions are on, and their latest lines (oldest first).
    in property <bool> captions;
    in property <[CallCaption]> caption-lines;
    // Teams' consent notice when recording or transcription starts.
    in property <string> notice;
    in property <string> error;
    // Why the call ended (the call-ended screen).
    in property <string> ended;
    // The call-ended screen asks how the call quality was (CallFeedback): the call lasted long
    // enough and the Settings choice picked it. Set when the call ends, cleared when the screen
    // closes.
    in-out property <bool> feedback-open;
    // The meeting chat's conversation id, when known.
    in property <string> chat-id;
    in property <bool> can-rejoin;
    // The call on the "On hold" bar ("" for none): the other call while this one is shown, or
    // this call when it is the one on hold.
    in property <string> held-name;
    // In the call first, then the lobby.
    in property <[CallPerson]> people;
    // In the call (not the lobby) for the speaker view: the latest speaker first, then the rest.
    in property <[CallPerson]> speaker-people;
    // Who the floating call shows, latest speakers first (us only when alone), at most four,
    // and how many more are in the call.
    in property <[CallPerson]> mini-people;
    in property <int> mini-more;
    // The floating call's layout: "speaker" (one tile) | "gallery" (up to four).
    in-out property <string> mini-layout: "speaker";
    in property <int> in-call;
    in property <int> in-lobby;
    // We may let people in from the lobby (Admit, Admit all).
    in property <bool> can-admit;
    in property <[string]> mics;
    in property <int> mic;
    in property <[string]> speakers;
    in property <int> speaker;
    // The call window's layout: "gallery" (everyone in a grid) | "speaker" (the latest speaker
    // large, the rest in a strip) | "content" (a shared screen on the stage). A share that starts
    // switches to "content", as Teams does.
    in-out property <string> view-mode: "gallery";
    // A 1:1 call we put on hold.
    in property <bool> held;
    // The people search's results for the invite box or the transfer dialog.
    in property <[CallFound]> found;
    // A short status under the invite box ("Calling Ada…").
    in property <string> invite-status;
    // The live reactions floating up the stage, oldest first. One model for the whole call
    // (`ui/call.rs` updates its rows), so a reaction keeps rising while others come and go.
    in property <[CallReaction]> reactions;
    // The side panel: "" | people | more.
    in-out property <string> panel;
    // The open dropdown or card: "" | devices | view | react | transfer | a device picker's key.
    in-out property <string> menu;
    // The call shrinks to a floating bar while the meeting chat is open.
    in-out property <bool> minimized;
    // Where the user dragged the minimized call to: its offset from the bottom-right corner.
    in-out property <length> mini-dx;
    in-out property <length> mini-dy;
    // (name, argument): feedback (good | issues, then one `category=issue` line per box ticked),
    // join-chat, join-now, cancel, prejoin-mic, mic, speaker, mute, hand, react (like | heart |
    // laugh | surprised | applause),
    // hold, transfer-open, find (query), invite (MRI), transfer (MRI), share, camera,
    // prejoin-camera, leave, close, rejoin, dismiss-error, captions (on|off), recording
    // (start|stop), transcription (start|stop), dismiss-notice, resume, end-held,
    // control-request, control-release, control-give (MRI), control-allow, control-deny,
    // admit (MRI), admit-all, control-take-back, control-key (key text), control-input (move x y | down b | up b |
    // scroll dx dy | key-down text | key-up text). See
    // `backend/call.rs` `CallCmd::parse`.
    callback command(string, string);
    // The conversation is a meeting's chat (its header shows Join).
    pure callback is-meeting-chat(string) -> bool;

    // Someone else shares a screen: the roster says so, or its picture came. Never while we
    // share ourselves: that is "You're sharing your screen", not a stage waiting for a picture.
    public pure function content-shared() -> bool {
        return !sharing && (presenter != "" || has-content);
    }

    // A person's name, followed by "(External)" or "(Guest)" when they are outside our organization.
    public pure function tagged-name(p: CallPerson) -> string {
        return p.badge == "" ? p.name : p.name + " (" + p.badge + ")";
    }

    public pure function in-call-phase() -> bool {
        return phase == "connecting" || phase == "lobby" || phase == "connected" || phase == "reconnecting";
    }
}
