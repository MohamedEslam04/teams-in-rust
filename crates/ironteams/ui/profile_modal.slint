// The full profile, as Teams opens it from the card: a window over the app with a dim scrim, the
// big photo and name with the action icons, and the Overview, Profile and Organization tabs.
// Esc, the cross or a click on the scrim closes it. The Overview and Profile tabs show the
// card's person (`card-*` in PeopleStore); the organization chart has its own person in focus
// (`org-*`), which a click on a report or the manager moves.
import { Theme } from "theme.slint";
import { PersonItem } from "types.slint";
import { Avatar, Icon, IconButton } from "widgets.slint";
import { PeopleStore } from "people.slint";
import { ProfileActions, ProfileBody, InfoRow } from "profile_parts.slint";
import { ScrollView } from "std-widgets.slint";

// One tab of the bar: accent text with a 2px accent underline when active.
component ProfileTab inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();
    width: lbl.preferred-width + 32px;
    height: 40px;
    accessible-role: tab;
    accessible-label: root.label;
    accessible-item-selected: root.active;
    accessible-action-default => { root.clicked(); }
    lbl := Text {
        text: root.label;
        color: root.active ? Theme.accent : touch.has-hover ? Theme.fg : Theme.fg-muted;
        font-size: 14px * Theme.font-scale;
        font-weight: root.active ? 700 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Rectangle {
        x: 12px;
        y: parent.height - 2px;
        width: parent.width - 24px;
        height: 2px;
        background: root.active ? Theme.accent : transparent;
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// A person in the chart: photo with presence and the name; a click moves the chart to them.
component OrgPersonCard inherits Rectangle {
    in property <PersonItem> p;
    callback clicked();
    height: 56px;
    border-radius: 6px;
    border-width: 1px;
    border-color: touch.has-hover ? Theme.accent : Theme.border;
    background: touch.has-hover ? Theme.surface-hover : transparent;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 9px;
        padding-bottom: 9px;
        spacing: 12px;
        Avatar {
            initials: root.p.initials;
            tone: root.p.color;
            img: root.p.avatar;
            has-img: root.p.has-avatar;
            presence: root.p.presence;
            size: 36px;
        }
        Text { text: root.p.name; color: Theme.fg; font-size: 14px * Theme.font-scale; font-weight: 700; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        accessible-role: button;
        accessible-label: root.p.name;
        accessible-action-default => { root.clicked(); }
        clicked => { root.clicked(); }
    }
}

// A short vertical line joining two cards of the chart.
component Connector inherits Rectangle {
    height: 22px;
    Rectangle { x: (parent.width - 1px) / 2; width: 1px; background: Theme.border; }
}

export component ProfileModal inherits Rectangle {
    callback close();
    callback chat(string);
    callback video(string);
    callback copy-email();
    callback quick-message(string);
    callback call-number(string);
    background: #000000a0;

    // A click on the scrim closes it.
    TouchArea { clicked => { root.close(); } }

    dialog := Rectangle {
        width: min(840px, root.width - 32px);
        height: min(840px, root.height - 32px);
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        clip: true;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.border;
        background: Theme.surface;
        accessible-role: groupbox;
        accessible-label: "Full profile";

        // Clicks on the window itself do not reach the scrim.
        TouchArea { }

        FocusScope {
            init => { self.focus(); }
            key-pressed(e) => {
                if e.text == Key.Escape {
                    root.close();
                    return accept;
                }
                return reject;
            }
            VerticalLayout {
                HorizontalLayout {
                    padding: 24px;
                    spacing: 20px;
                    Avatar {
                        initials: PeopleStore.card.initials;
                        tone: PeopleStore.card.color;
                        img: PeopleStore.card.avatar;
                        has-img: PeopleStore.card.has-avatar;
                        presence: PeopleStore.card-presence;
                        size: 96px;
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 10px;
                        modal-name := Text { text: PeopleStore.card.name; color: Theme.fg; font-size: 24px * Theme.font-scale; font-weight: 700; wrap: word-wrap; accessible-role: text; accessible-label: PeopleStore.card.name; }
                        ProfileActions {
                            spread: false;
                            height: 40px;
                            chat => { root.chat(PeopleStore.card.id); }
                            org => { PeopleStore.profile-tab = 2; }
                            video => { root.video(PeopleStore.card.id); }
                        }
                    }
                }
                HorizontalLayout {
                    padding-left: 12px;
                    spacing: 4px;
                    alignment: start;
                    overview-tab := ProfileTab { label: @tr("Overview"); active: PeopleStore.profile-tab == 0; clicked => { PeopleStore.profile-tab = 0; } }
                    profile-tab := ProfileTab { label: @tr("Profile"); active: PeopleStore.profile-tab == 1; clicked => { PeopleStore.profile-tab = 1; } }
                    organization-tab := ProfileTab { label: @tr("Organization"); active: PeopleStore.profile-tab == 2; clicked => { PeopleStore.profile-tab = 2; } }
                }
                Rectangle { height: 1px; background: Theme.border; }

                // Overview: what the hover card shows.
                if PeopleStore.profile-tab == 0: ScrollView {
                    vertical-stretch: 1;
                    viewport-width: self.visible-width;
                    viewport-height: overview-body.height;
                    overview-body := ProfileBody {
                        width: min(parent.width - 12px, 560px);
                        pad: 24px;
                        quick-message(t) => { root.quick-message(t); }
                        copy-email => { root.copy-email(); }
                        open-profile => { PeopleStore.profile-tab = 1; }
                        open-org => { PeopleStore.profile-tab = 2; }
                        call-number(n) => { root.call-number(n); }
                    }
                }

                // Profile: every contact and job field.
                if PeopleStore.profile-tab == 1: ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        width: parent.width - 12px;
                        padding: 24px;
                        spacing: 6px;
                        alignment: start;
                        if PeopleStore.card-email != "": Rectangle {
                            height: email-row.height;
                            email-row := InfoRow { label: @tr("Email"); value: PeopleStore.card-email; link: true; }
                            fields-email-touch := TouchArea { mouse-cursor: pointer; clicked => { root.copy-email(); } }
                        }
                        if PeopleStore.card-phone != "": InfoRow { label: @tr("Work phone"); value: PeopleStore.card-phone; }
                        if PeopleStore.card-mobile != "": InfoRow { label: @tr("Mobile"); value: PeopleStore.card-mobile; }
                        if PeopleStore.card-job-title != "": InfoRow { label: @tr("Job title"); value: PeopleStore.card-job-title; }
                        if PeopleStore.card-department != "": InfoRow { label: @tr("Department"); value: PeopleStore.card-department; }
                        if PeopleStore.card-work != "": InfoRow { label: @tr("Company"); value: PeopleStore.card-work; }
                        if PeopleStore.card-location != "": InfoRow { label: @tr("Office"); value: PeopleStore.card-location; }
                        if PeopleStore.card-manager != "": InfoRow { label: @tr("Manager"); value: PeopleStore.card-manager; }
                    }
                }

                // Organization: the chart.
                if PeopleStore.profile-tab == 2: VerticalLayout {
                    vertical-stretch: 1;
                    HorizontalLayout {
                        padding-left: 24px;
                        padding-top: 8px;
                        padding-bottom: 4px;
                        spacing: 4px;
                        alignment: start;
                        height: 44px;
                        IconButton { icon: @image-url("icons/home.svg"); tooltip: @tr("Organization home"); size: 32px; clicked => { PeopleStore.command("org-home", ""); } }
                        Rectangle {
                            width: 32px;
                            opacity: PeopleStore.org-can-back ? 1.0 : 0.4;
                            IconButton { icon: @image-url("icons/chevron-left.svg"); tooltip: @tr("Organization back"); size: 32px; clicked => { if PeopleStore.org-can-back { PeopleStore.command("org-back", ""); } } }
                        }
                        Rectangle {
                            width: 32px;
                            opacity: PeopleStore.org-can-forward ? 1.0 : 0.4;
                            IconButton { icon: @image-url("icons/chevron-right.svg"); tooltip: @tr("Organization forward"); size: 32px; clicked => { if PeopleStore.org-can-forward { PeopleStore.command("org-forward", ""); } } }
                        }
                    }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            width: parent.width - 12px;
                            padding: 20px;
                            alignment: start;
                            if PeopleStore.org-loading: Text { text: @tr("Loading…"); color: Theme.fg-muted; font-size: 13px * Theme.font-scale; horizontal-alignment: center; accessible-role: text; accessible-label: @tr("Loading organization"); }
                            // Their manager above them.
                            if PeopleStore.org-manager.id != "": VerticalLayout {
                                HorizontalLayout {
                                    alignment: center;
                                    OrgPersonCard {
                                        width: min(370px, parent.width);
                                        p: PeopleStore.org-manager;
                                        clicked => { PeopleStore.command("org-focus", PeopleStore.org-manager.id); }
                                    }
                                }
                                Connector { }
                            }
                            // The person in focus.
                            HorizontalLayout {
                                alignment: center;
                                focus-card := Rectangle {
                                    width: min(440px, parent.width);
                                    height: focus-lay.preferred-height + 2px;
                                    border-radius: 8px;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    focus-lay := VerticalLayout {
                                        padding: 16px;
                                        spacing: 12px;
                                        HorizontalLayout {
                                            spacing: 14px;
                                            Avatar {
                                                initials: PeopleStore.org-focus.initials;
                                                tone: PeopleStore.org-focus.color;
                                                img: PeopleStore.org-focus.avatar;
                                                has-img: PeopleStore.org-focus.has-avatar;
                                                presence: PeopleStore.org-focus.presence;
                                                size: 64px;
                                            }
                                            VerticalLayout {
                                                alignment: center;
                                                spacing: 2px;
                                                org-name := Text { text: PeopleStore.org-focus.name; color: Theme.fg; font-size: 18px * Theme.font-scale; font-weight: 700; wrap: word-wrap; accessible-role: text; accessible-label: PeopleStore.org-focus.name; }
                                                if PeopleStore.org-location-kind != "": org-location := Text {
                                                    text: PeopleStore.org-location-kind == "remote" ? @tr("Working remotely") : @tr("In the office");
                                                    color: Theme.fg-muted;
                                                    font-size: 13px * Theme.font-scale;
                                                }
                                            }
                                        }
                                        Rectangle { height: 1px; background: Theme.border; }
                                        HorizontalLayout {
                                            spacing: 12px;
                                            view-profile := Rectangle {
                                                width: 150px;
                                                height: 32px;
                                                border-radius: 4px;
                                                border-width: 1px;
                                                border-color: view-touch.has-hover ? Theme.accent : Theme.border;
                                                background: view-touch.has-hover ? Theme.surface-hover : transparent;
                                                HorizontalLayout {
                                                    padding-left: 12px;
                                                    padding-right: 12px;
                                                    spacing: 8px;
                                                    alignment: center;
                                                    Icon { source: @image-url("icons/id-card.svg"); tint: Theme.fg; width: 18px; height: 18px; y: 7px; }
                                                    Text { text: @tr("View profile"); color: Theme.fg; font-size: 13px * Theme.font-scale; font-weight: 600; vertical-alignment: center; }
                                                }
                                                view-touch := TouchArea {
                                                    mouse-cursor: pointer;
                                                    accessible-role: button;
                                                    accessible-label: @tr("View profile");
                                                    accessible-action-default => { root.view-focus(); }
                                                    clicked => { root.view-focus(); }
                                                }
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                            if PeopleStore.org-reports-count > 0: org-count := Text {
                                                text: PeopleStore.org-reports-count == 1 ? @tr("1 direct report") : @tr("{} direct reports", "" + PeopleStore.org-reports-count);
                                                color: Theme.fg-muted;
                                                font-size: 12px * Theme.font-scale;
                                                vertical-alignment: center;
                                                horizontal-alignment: right;
                                                accessible-role: text;
                                                accessible-label: self.text;
                                            }
                                        }
                                    }
                                }
                            }
                            // The people who report to them. Not drawn when the reports could not
                            // be read (-1) or there are none.
                            if PeopleStore.org-reports-count > 0: VerticalLayout {
                                Connector { }
                                HorizontalLayout {
                                    spacing: 10px;
                                    padding-bottom: 14px;
                                    Rectangle { horizontal-stretch: 1; Rectangle { y: (parent.height - 1px) / 2; height: 1px; background: Theme.border; } }
                                    Text { text: @tr("People reporting to"); color: Theme.fg-muted; font-size: 13px * Theme.font-scale; vertical-alignment: center; }
                                    Text { text: PeopleStore.org-focus.name; color: Theme.fg; font-size: 13px * Theme.font-scale; font-weight: 700; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; Rectangle { y: (parent.height - 1px) / 2; height: 1px; background: Theme.border; } }
                                }
                                HorizontalLayout {
                                    alignment: center;
                                    reports-grid := Rectangle {
                                        property <length> cw: min(370px, (self.width - 12px) / 2);
                                        width: min(752px, parent.width);
                                        height: ceil(PeopleStore.org-reports.length / 2) * 68px - 12px;
                                        for r[i] in PeopleStore.org-reports: OrgPersonCard {
                                            x: mod(i, 2) * (reports-grid.cw + 12px);
                                            y: floor(i / 2) * 68px;
                                            width: reports-grid.cw;
                                            p: r;
                                            clicked => { PeopleStore.command("org-focus", r.id); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        IconButton {
            icon: @image-url("icons/close.svg");
            tooltip: @tr("Close");
            size: 32px;
            x: parent.width - self.width - 12px;
            y: 12px;
            clicked => { root.close(); }
        }
    }

    // "View profile" on the chart: the Overview tab of the person in focus.
    function view-focus() {
        if PeopleStore.org-focus.id != PeopleStore.card.id {
            PeopleStore.command("profile-modal", PeopleStore.org-focus.id);
        }
        PeopleStore.profile-tab = 0;
    }
}
