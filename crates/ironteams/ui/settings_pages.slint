// The pages of Settings. Each one reads `SettingsStore` and reports changes through
// `SettingsStore.command(name, argument)`; the Rust side saves local preferences and only plans
// (dry run) the changes that belong to Teams.
import { Theme } from "theme.slint";
import { SettingsStore, SOption } from "settings_store.slint";
import { PeopleStore } from "people.slint";
import { SButton, SChoice, SChoiceRow, SField, SFont, SPersonRow, SRadio, SSection, SSwitch } from "settings_widgets.slint";
import { SnippetsSection } from "settings_snippets.slint";
import { AppsStore } from "apps_store.slint";

component Para inherits Text {
    color: Theme.fg-muted;
    font-size: SFont.small;
    wrap: word-wrap;
    horizontal-alignment: Theme.start-align;
}

// The Teams changes that were only planned, so the user sees exactly what was not sent.
component DryRuns inherits SSection {
    title: @tr("Planned changes (not sent to Teams)");
    hint: @tr("IronTeams does not change Teams settings yet. Each change is shown here as the request it would send.");
    if SettingsStore.dry-runs.length == 0: Para { text: @tr("None yet."); }
    for d[i] in SettingsStore.dry-runs: Rectangle {
        height: dr.preferred-height + 12px;
        border-radius: 4px;
        background: Theme.surface;
        accessible-role: text;
        accessible-label: @tr("Planned request {}", i + 1);
        accessible-description: d;
        dr := Text {
            x: 8px;
            width: parent.width - 16px;
            text: d;
            color: Theme.fg-muted;
            font-size: SFont.small;
            font-family: "monospace";
            wrap: word-wrap;
            vertical-alignment: center;
        }
    }
}

export component GeneralPage inherits VerticalLayout {
    alignment: start;
    SSection {
        title: @tr("Language and region");
        SChoiceRow {
            label: @tr("App language");
            hint: @tr("Now: {}. The main screens are translated; the rest stays in English for now.", SettingsStore.language-shown);
            options: SettingsStore.languages;
            value: SettingsStore.language;
            picked(v) => { SettingsStore.language = v; SettingsStore.command("language", v); }
        }
        SChoiceRow {
            label: @tr("Date format");
            hint: @tr("Used for dates in the chat list and in OneDrive.");
            options: [{v: "auto", l: @tr("Follow the language")}, {v: "dmy", l: "31/12/2026"}, {v: "mdy", l: "12/31/2026"}, {v: "ymd", l: "2026-12-31"}];
            value: SettingsStore.date-format;
            picked(v) => { SettingsStore.date-format = v; SettingsStore.command("date-format", v); }
        }
        SChoiceRow {
            label: @tr("Time format");
            hint: @tr("Used for every clock time: chats, the calendar, reminders, scheduled messages and OneDrive.");
            options: [{v: "h12", l: @tr("12-hour (1:30 PM)")}, {v: "h24", l: @tr("24-hour (13:30)")}];
            value: SettingsStore.time-format;
            picked(v) => { SettingsStore.time-format = v; SettingsStore.command("time-format", v); }
        }
        SField {
            label: @tr("Time zone");
            placeholder: @tr("System: {}", SettingsStore.system-time-zone);
            initial: SettingsStore.time-zone;
            committed(t) => { SettingsStore.command("time-zone", t); }
        }
        Para { text: @tr("An IANA name such as Africa/Cairo. Leave it empty to follow the system. Chat times, the calendar, OneDrive and Store dates use it. A name that is not a time zone is ignored and the system zone is used."); }
    }
    SSection {
        title: @tr("Writing");
        SSwitch {
            label: @tr("Check spelling");
            hint: @tr("Underline misspelled words in the message box. Right-click a word for suggestions. Uses the English and Arabic Hunspell dictionaries installed on this computer.");
            on: SettingsStore.check-spelling;
            toggled(on) => { SettingsStore.check-spelling = on; SettingsStore.command("check-spelling", on ? "1" : "0"); }
        }
    }
    SSection {
        title: @tr("System");
        for t in SettingsStore.startup: SSwitch {
            label: t.label;
            hint: t.hint;
            on: t.on;
            enabled: t.enabled;
            toggled(on) => { SettingsStore.command("startup", SettingsStore.j2(t.key, on ? "1" : "0")); }
        }
    }
    // What IronTeams cannot do yet is greyed out, below the settings that work.
    SSection {
        title: @tr("Translation");
        Para { text: @tr("Translation preferences are a Teams account setting. IronTeams cannot change them yet, so these show Teams' choices greyed out. Translate in a message's … menu."); }
        SChoiceRow {
            label: @tr("Translate messages into");
            options: [{v: "app", l: @tr("The app language")}];
            value: "app";
            enabled: false;
            picked(v) => { }
        }
        SSwitch { label: @tr("Ask me before translating"); enabled: false; on: true; }
        SSwitch { label: @tr("Never translate messages in these languages"); hint: @tr("Adding languages needs the same Teams setting."); enabled: false; on: false; }
    }
    SSection {
        title: @tr("Spell check languages");
        Para { text: @tr("IronTeams checks with the English and Arabic Hunspell dictionaries installed on this computer. Choosing up to three languages is not available yet."); }
    }
    SSection {
        title: @tr("Meetings");
        SSwitch { label: @tr("New meeting controls"); hint: @tr("IronTeams's call window has one set of controls."); enabled: false; on: true; }
        SSwitch { label: @tr("Ask me to confirm when I leave a meeting"); hint: @tr("Not available in IronTeams yet."); enabled: false; on: false; }
    }
    SSection {
        title: @tr("Out of office");
        Para { text: @tr("Automatic replies with a start, an end and a message are an Outlook mailbox setting. IronTeams cannot read or schedule them yet: set them in Teams or Outlook."); }
        SButton { label: @tr("Schedule"); enabled: false; clicked => { } }
    }
    SSection {
        title: @tr("Keyboard");
        SChoiceRow {
            label: @tr("Keyboard shortcuts");
            hint: @tr("IronTeams uses the Teams shortcuts (Ctrl+. lists them).");
            options: [{v: "teams", l: @tr("Teams")}];
            value: "teams";
            enabled: false;
            picked(v) => { }
        }
        SSwitch { label: @tr("Use Enter or Spacebar to show content"); hint: @tr("Not available in IronTeams yet."); enabled: false; on: false; }
    }
}

export component ChatsPage inherits VerticalLayout {
    alignment: start;
    // The composer's own setting (it is also in the composer's "more" menu).
    in property <bool> enter-sends: true;
    callback set-enter-sends(bool);
    SSection {
        title: @tr("Opening a chat");
        SChoiceRow {
            label: @tr("When I open a chat take me to");
            hint: @tr("Last read opens at the first message you have not read, with the New messages line.");
            options: [{v: "newest", l: @tr("Newest message")}, {v: "last-read", l: @tr("Last read")}];
            value: SettingsStore.open-chat-at;
            picked(v) => { SettingsStore.open-chat-at = v; SettingsStore.command("open-chat-at", v); }
        }
    }
    SSection {
        title: @tr("Writing");
        SSwitch {
            label: @tr("Press Enter to send");
            hint: @tr("Off: Enter starts a new line and Ctrl+Enter sends.");
            on: root.enter-sends;
            toggled(on) => { root.set-enter-sends(on); }
        }
    }
    SSection {
        title: @tr("Privacy and previews");
        SSwitch {
            label: @tr("Read receipts");
            hint: @tr("People see when you have read their message. This is the same setting as in Privacy.");
            on: PeopleStore.receipts-on;
            toggled(on) => { PeopleStore.command("receipts", on ? "on" : "off"); }
        }
        SSwitch {
            label: @tr("Link previews");
            hint: @tr("Show a card with the title and picture under messages that contain a link.");
            on: SettingsStore.link-previews;
            toggled(on) => { SettingsStore.command("link-previews", on ? "1" : "0"); }
        }
    }
    // Saved quick replies for the composer's `/` (src/snippets.rs).
    SnippetsSection { }
}

export component AccountsPage inherits VerticalLayout {
    alignment: start;
    // First, so the notice is seen right after a switch (and stays on screen in short windows).
    if SettingsStore.restart-needed: SSection {
        title: @tr("Restart needed");
        hint: @tr("The change is saved. IronTeams uses it after a restart.");
        SButton { label: @tr("Restart IronTeams"); primary: true; clicked => { SettingsStore.command("restart", ""); } }
    }
    SSection {
        title: @tr("Accounts");
        hint: @tr("The account IronTeams signs in with. Switching restarts IronTeams. Each account keeps its own chats on this computer.");
        for a in SettingsStore.accounts: SRadio {
            group: @tr("Account");
            label: a.name != "" ? a.name : a.label;
            detail: a.upn;
            checked: a.active;
            picked => { SettingsStore.command("switch-account", a.label); }
        }
    }
    SSection {
        title: @tr("Add an account");
        hint: @tr("Pick a short name (letters, digits, - _ .), then restart IronTeams: it shows a code to sign in with, on this computer, for the new account. The accounts stay separate.");
        new-account := SField {
            label: @tr("Name for the new account");
            placeholder: "work";
        }
        SButton {
            label: @tr("Add account");
            clicked => { SettingsStore.command("add-account", new-account.text); }
        }
    }
    SSection {
        title: @tr("Remove an account");
        hint: @tr("Forgets the account's saved sign-in on this computer and takes it off the list. Nothing changes in Teams.");
        for a in SettingsStore.accounts: SPersonRow {
            name: a.name != "" ? a.name : a.label;
            action: @tr("Remove");
            act => { SettingsStore.confirm-remove = a.label; }
        }
        if SettingsStore.confirm-remove != "": VerticalLayout {
            spacing: 6px;
            Para { text: @tr("Remove \"{}\" from IronTeams on this computer? Its saved sign-in is deleted.", SettingsStore.confirm-remove); }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                SButton { label: @tr("Cancel removal"); clicked => { SettingsStore.confirm-remove = ""; } }
                SButton { label: @tr("Yes, remove the account"); danger: true; clicked => { SettingsStore.command("remove-account", SettingsStore.confirm-remove); SettingsStore.confirm-remove = ""; } }
            }
        }
    }
    SSection {
        title: @tr("Organizations");
        hint: @tr("Organizations this account belongs to, as a member or a guest.");
        if SettingsStore.orgs.length == 0: Para { text: @tr("No organization list yet."); }
        for o in SettingsStore.orgs: SRadio {
            group: @tr("Organization");
            label: o.name;
            detail: o.home ? @tr("Home organization") : @tr("Guest");
            checked: o.active;
            picked => { SettingsStore.command("switch-org", o.tenant); }
        }
    }
    SSection {
        title: @tr("License");
        hint: @tr("Asks Microsoft for your sign-in and license details again, then restarts IronTeams. Use it after an admin changed your license or your organization's settings.");
        SButton { label: @tr("Refresh license and restart"); clicked => { SettingsStore.command("refresh-license", ""); } }
    }
    if SettingsStore.accounts-status != "": Para { text: SettingsStore.accounts-status; }
}

export component PrivacyPage inherits VerticalLayout {
    alignment: start;
    SSection {
        title: @tr("Privacy");
        hint: @tr("These are Teams settings.");
        for t in SettingsStore.privacy: SSwitch {
            label: t.label;
            hint: t.hint;
            on: t.on;
            enabled: t.enabled;
            toggled(on) => { SettingsStore.command("privacy", SettingsStore.j2(t.key, on ? "1" : "0")); }
        }
    }
    SSection {
        title: @tr("Blocked contacts");
        hint: @tr("Blocked people cannot call you or see your presence.");
        if SettingsStore.blocked.length == 0: Para { text: @tr("You have not blocked anyone."); }
        for p in SettingsStore.blocked: SPersonRow {
            name: p.name;
            action: @tr("Unblock");
            act => { SettingsStore.command("unblock", p.mri); }
        }
    }
    SSection {
        title: @tr("Priority access");
        hint: @tr("People who can reach you when you are set to Do not disturb.");
        if SettingsStore.priority.length == 0: Para { text: @tr("Nobody has priority access."); }
        for p in SettingsStore.priority: SPersonRow {
            name: p.name;
            action: @tr("Remove");
            act => { SettingsStore.command("priority-remove", p.mri); }
        }
    }
    SSection {
        title: @tr("Diagnostic data");
        Para { text: @tr("IronTeams sends no diagnostic data. Report a problem (in About) writes a redacted bundle on this computer."); }
    }
    if SettingsStore.privacy-status != "": Para { text: SettingsStore.privacy-status; }
    if SettingsStore.dry-runs.length > 0: DryRuns { }
}

// A day of the week in the quiet hours row.
component DayChip inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    callback toggled();
    height: 30px * max(1, Theme.font-scale);
    width: max(44px, dl.preferred-width + 20px);
    border-radius: self.height / 2;
    border-width: 1px;
    border-color: root.on ? Theme.accent : Theme.border;
    background: root.on ? Theme.selected : (dt.has-hover ? Theme.surface-hover : transparent);
    accessible-role: checkbox;
    accessible-label: root.label;
    accessible-checked: root.on;
    accessible-action-default => { root.toggled(); }
    dl := Text { text: root.label; color: root.on ? Theme.accent : Theme.fg; font-size: SFont.body; horizontal-alignment: center; vertical-alignment: center; }
    dt := TouchArea { mouse-cursor: pointer; clicked => { root.toggled(); } }
}

// A text box with an Add button; the box empties after a word is added.
component KeywordAdd inherits HorizontalLayout {
    spacing: 8px;
    alignment: start;
    callback add(string);
    Rectangle {
        width: 260px;
        height: max(30px, kw.preferred-height + 12px);
        border-radius: 4px;
        background: Theme.surface;
        border-width: 1px;
        border-color: kw.has-focus ? Theme.accent : Theme.border;
        kw := TextInput {
            x: 10px;
            width: parent.width - 20px;
            color: Theme.fg;
            font-size: SFont.body;
            single-line: true;
            vertical-alignment: center;
            horizontal-alignment: Theme.start-align;
            accessible-role: text-input;
            accessible-label: @tr("Add a word or phrase");
            accepted => { root.add(self.text); self.text = ""; }
        }
        if kw.text == "": Text {
            x: 10px;
            width: parent.width - 20px;
            text: @tr("Add a word or phrase");
            color: Theme.fg-subtle;
            font-size: SFont.body;
            vertical-alignment: center;
            horizontal-alignment: Theme.start-align;
        }
    }
    SButton { label: @tr("Add"); clicked => { root.add(kw.text); kw.text = ""; } }
}

export component NotificationsPage inherits VerticalLayout {
    alignment: start;
    SSection {
        title: @tr("Notifications and activity");
        SChoiceRow {
            label: @tr("Pause notifications");
            hint: SettingsStore.paused ? (SettingsStore.pause-until != "" ? SettingsStore.pause-until : @tr("Paused")) : @tr("No banners for as long as you choose. Until tomorrow means 8:00 the next morning.");
            options: [{v: "off", l: @tr("Off")}, {v: "1h", l: @tr("1 hour")}, {v: "2h", l: @tr("2 hours")}, {v: "tomorrow", l: @tr("Until tomorrow")}, {v: "custom", l: @tr("Custom")}];
            value: SettingsStore.pause-custom-open ? "custom" : (SettingsStore.paused ? "" : "off");
            picked(v) => {
                if v == "custom" {
                    SettingsStore.pause-custom-open = true;
                } else {
                    SettingsStore.pause-custom-open = false;
                    SettingsStore.command("pause", v);
                }
            }
        }
        if SettingsStore.pause-custom-open: VerticalLayout {
            spacing: 6px;
            pause-at := SField { label: @tr("Pause until"); placeholder: "2026-12-31 17:30"; }
            SButton {
                label: @tr("Pause notifications until then");
                clicked => { SettingsStore.command("pause", SettingsStore.j2("custom", pause-at.text)); }
            }
        }
        SSwitch {
            label: @tr("Show the sender's photo");
            hint: @tr("Message notifications show who wrote, like Teams.");
            on: SettingsStore.banner-photo;
            toggled(on) => { SettingsStore.command("banner-photo", on ? "1" : "0"); }
        }
        SSwitch {
            label: @tr("Show Reply and Like buttons");
            hint: @tr("Reply opens the chat with the cursor in the message box. Clicking a notification always opens its chat.");
            on: SettingsStore.banner-actions;
            toggled(on) => { SettingsStore.command("banner-actions", on ? "1" : "0"); }
        }
        SButton { label: @tr("Test notification"); clicked => { SettingsStore.command("test-notification", ""); } }
    }
    if SettingsStore.notify-status != "": Para { text: SettingsStore.notify-status; }
    SSection {
        title: @tr("Quiet hours");
        hint: @tr("No banners and no notification sound during these hours. Messages still arrive and unread counts still update. This applies to this computer only.");
        SSwitch {
            label: @tr("Turn on quiet hours");
            on: SettingsStore.quiet-on;
            toggled(on) => { SettingsStore.command("quiet-on", on ? "1" : "0"); }
        }
        if SettingsStore.quiet-on: VerticalLayout {
            spacing: 8px;
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                for d[i] in [@tr("Mon"), @tr("Tue"), @tr("Wed"), @tr("Thu"), @tr("Fri"), @tr("Sat"), @tr("Sun")]: DayChip {
                    label: d;
                    on: SettingsStore.quiet-days[i];
                    toggled => { SettingsStore.command("quiet-day", "" + i); }
                }
            }
            HorizontalLayout {
                spacing: 12px;
                alignment: start;
                SField { label: @tr("From"); initial: SettingsStore.quiet-start; width: 120px; committed(t) => { SettingsStore.command("quiet-start", t); } }
                SField { label: @tr("To"); initial: SettingsStore.quiet-end; width: 120px; committed(t) => { SettingsStore.command("quiet-end", t); } }
            }
        }
    }
    SSection {
        title: @tr("Focus mode");
        hint: @tr("Only @mentions of you, urgent messages, priority people, calls and your keywords still show a banner. Your Teams status does not change.");
        SSwitch {
            label: @tr("Focus mode");
            hint: SettingsStore.focus-label();
            on: SettingsStore.focus-on;
            toggled(on) => { SettingsStore.command("focus", on ? "1" : "0"); }
        }
        SChoiceRow {
            label: @tr("Turn on for");
            options: [{v: "1h", l: @tr("1 hour")}, {v: "2h", l: @tr("2 hours")}, {v: "tomorrow", l: @tr("Until tomorrow 9:00")}, {v: "manual", l: @tr("Until I turn it off")}];
            value: SettingsStore.focus-duration;
            picked(v) => { SettingsStore.focus-duration = v; SettingsStore.command("focus-duration", v); }
        }
    }
    SSection {
        title: @tr("Keyword alerts");
        hint: @tr("A message from someone else with one of these words or phrases shows a banner, even in a muted chat, but not during quiet hours. Focus mode lets them through.");
        KeywordAdd { add(t) => { SettingsStore.command("keyword-add", t); } }
        if SettingsStore.keywords.length == 0: Para { text: @tr("No keywords yet."); }
        for k in SettingsStore.keywords: SPersonRow {
            name: k;
            action: @tr("Remove");
            act => { SettingsStore.command("keyword-remove", k); }
        }
    }
    SSection {
        title: @tr("Sounds and previews");
        for t in SettingsStore.notify-sounds: SSwitch {
            label: t.label;
            hint: t.hint;
            on: t.on;
            enabled: t.enabled;
            toggled(on) => { SettingsStore.command("notify-sound", SettingsStore.j2(t.key, on ? "1" : "0")); }
        }
        SChoiceRow {
            label: @tr("Meeting chats");
            hint: @tr("Which meeting chats notify you.");
            options: [{v: "all", l: @tr("All meetings I'm invited to")}, {v: "participated", l: @tr("Meetings I take part in")}, {v: "none", l: @tr("Only ones I unmuted")}];
            value: SettingsStore.meeting-chat;
            picked(v) => { SettingsStore.meeting-chat = v; SettingsStore.command("meeting-chat", v); }
        }
    }
    for n in SettingsStore.notify: VerticalLayout {
        spacing: 4px;
        padding-bottom: 10px;
        if n.group != "": Text { text: n.group; color: Theme.fg; font-size: SFont.heading; font-weight: 600; }
        Text { text: n.label; color: Theme.fg; font-size: SFont.body; }
        SChoice {
            group: n.label;
            options: [{v: "banner", l: @tr("Banner and feed")}, {v: "feed", l: @tr("Only show in feed")}, {v: "off", l: @tr("Off")}];
            value: n.value;
            picked(v) => { SettingsStore.command("notify", SettingsStore.j2(n.key, v)); }
        }
    }
    if SettingsStore.dry-runs.length > 0: DryRuns { }
}

export component AppearancePage inherits VerticalLayout {
    alignment: start;
    SSection {
        title: @tr("Theme");
        SChoiceRow {
            label: @tr("Theme");
            hint: @tr("Now showing: {}.", SettingsStore.theme-shown);
            options: [{v: "light", l: @tr("Light")}, {v: "dark", l: @tr("Dark")}, {v: "system", l: @tr("Use system setting")}];
            value: SettingsStore.theme;
            picked(v) => { SettingsStore.theme = v; SettingsStore.command("theme", v); }
        }
        SSwitch { label: @tr("Always use dark theme for calls and meetings"); hint: @tr("IronTeams's call window follows the theme above. A separate call theme is not available yet."); enabled: false; on: false; }
    }
    SSection {
        title: @tr("App bar");
        SSwitch {
            label: @tr("Show app names");
            hint: @tr("The names under the app bar's icons (the bar's own Collapse does the same).");
            on: !AppsStore.rail-collapsed;
            toggled(on) => { if on == AppsStore.rail-collapsed { AppsStore.command("rail-collapse", ""); } }
        }
        SSwitch { label: @tr("Auto collapse app bar"); hint: @tr("Not available in IronTeams yet."); enabled: false; on: false; }
    }
    SSection {
        title: @tr("Accent colour");
        hint: @tr("Now: {}.", SettingsStore.accent-shown);
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            for a in [{v: "", l: @tr("Desktop accent"), c: Theme.accent}, {v: "#5b5fc7", l: @tr("Purple"), c: #5b5fc7}, {v: "#0f6cbd", l: @tr("Blue"), c: #0f6cbd}, {v: "#038387", l: @tr("Teal"), c: #038387}, {v: "#107c10", l: @tr("Green"), c: #107c10}, {v: "#ca5010", l: @tr("Orange"), c: #ca5010}, {v: "#c239b3", l: @tr("Pink"), c: #c239b3}]: Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 16px;
                border-width: SettingsStore.accent == a.v ? 3px : 1px;
                border-color: SettingsStore.accent == a.v ? Theme.fg : Theme.border;
                background: a.v == "" ? transparent : a.c;
                accessible-role: radio-button;
                accessible-label: @tr("Accent colour: {}", a.l);
                accessible-checked: SettingsStore.accent == a.v;
                accessible-action-default => { SettingsStore.accent = a.v; SettingsStore.command("accent", a.v); }
                if a.v == "": Text { text: "A"; color: Theme.accent; font-size: SFont.body; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { mouse-cursor: pointer; clicked => { SettingsStore.accent = a.v; SettingsStore.command("accent", a.v); } }
            }
        }
    }
    SSection {
        title: @tr("Layout");
        SChoiceRow {
            label: @tr("Message density");
            options: [{v: "comfy", l: @tr("Comfy")}, {v: "compact", l: @tr("Compact")}];
            value: SettingsStore.density;
            picked(v) => { SettingsStore.density = v; SettingsStore.command("density", v); }
        }
    }
    SSection {
        title: @tr("Font size");
        hint: @tr("Larger text in Accessibility adds to this.");
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            SButton { label: @tr("Smaller font"); clicked => { SettingsStore.command("font-step", "-1"); } }
            Rectangle {
                width: 70px;
                accessible-role: text;
                accessible-label: @tr("Current font size");
                accessible-value: Math.round(SettingsStore.font-scale * 100) + "%";
                Text { text: Math.round(SettingsStore.font-scale * 100) + "%"; color: Theme.fg; font-size: SFont.body; horizontal-alignment: center; vertical-alignment: center; }
            }
            SButton { label: @tr("Larger font"); clicked => { SettingsStore.command("font-step", "1"); } }
            SButton { label: @tr("Reset font size"); clicked => { SettingsStore.command("font-scale", "1"); } }
        }
        Text { text: "Preview: the quick brown fox. نص تجريبي."; color: Theme.fg; font-size: SFont.body; }
    }
    SSection {
        title: @tr("Skin tone");
        hint: @tr("Used for emoji in reactions and the composer.");
        SChoice {
            group: @tr("Skin tone");
            options: [{v: "0", l: "👋"}, {v: "1", l: "👋🏻"}, {v: "2", l: "👋🏼"}, {v: "3", l: "👋🏽"}, {v: "4", l: "👋🏾"}, {v: "5", l: "👋🏿"}];
            value: SettingsStore.skin-tone;
            picked(v) => { SettingsStore.command("skin-tone", v); }
        }
    }
}

export component AccessibilityPage inherits VerticalLayout {
    alignment: start;
    SSection {
        title: @tr("Display");
        hint: @tr("Now: {}.", SettingsStore.a11y-shown);
        SChoiceRow {
            label: @tr("High contrast");
            options: [{v: "auto", l: @tr("Follow the system")}, {v: "on", l: @tr("On")}, {v: "off", l: @tr("Off")}];
            value: SettingsStore.high-contrast;
            picked(v) => { SettingsStore.high-contrast = v; SettingsStore.command("high-contrast", v); }
        }
        SChoiceRow {
            label: @tr("Reduce motion");
            options: [{v: "auto", l: @tr("Follow the system")}, {v: "on", l: @tr("On")}, {v: "off", l: @tr("Off")}];
            value: SettingsStore.reduced-motion;
            picked(v) => { SettingsStore.reduced-motion = v; SettingsStore.command("reduced-motion", v); }
        }
        SSwitch {
            label: @tr("Larger text");
            hint: @tr("Makes text a quarter bigger than the font size in Appearance.");
            on: SettingsStore.larger-text;
            toggled(on) => { SettingsStore.command("larger-text", on ? "1" : "0"); }
        }
    }
    SSection {
        title: @tr("Captions and meetings");
        hint: @tr("Saved now; meetings and calls use them when they come to IronTeams.");
        for t in SettingsStore.a11y-flags: SSwitch {
            label: t.label;
            hint: t.hint;
            on: t.on;
            enabled: t.enabled;
            toggled(on) => { SettingsStore.command("a11y", SettingsStore.j2(t.key, on ? "1" : "0")); }
        }
    }
}

export component DevicesPage inherits VerticalLayout {
    alignment: start;
    SSection {
        title: @tr("Speaker");
        SRadio { group: @tr("Speaker"); label: @tr("System default"); checked: SettingsStore.speaker == ""; picked => { SettingsStore.command("speaker", ""); } }
        for d in SettingsStore.speakers: SRadio { group: @tr("Speaker"); label: d.name; detail: d.id; checked: SettingsStore.speaker == d.id; picked => { SettingsStore.command("speaker", d.id); } }
        SButton { label: @tr("Play test sound"); clicked => { SettingsStore.command("test-sound", ""); } }
    }
    SSection {
        title: @tr("Microphone");
        SRadio { group: @tr("Microphone"); label: @tr("System default"); checked: SettingsStore.mic == ""; picked => { SettingsStore.command("mic", ""); } }
        for d in SettingsStore.mics: SRadio { group: @tr("Microphone"); label: d.name; detail: d.id; checked: SettingsStore.mic == d.id; picked => { SettingsStore.command("mic", d.id); } }
        HorizontalLayout {
            spacing: 12px;
            alignment: start;
            SButton {
                label: SettingsStore.mic-testing ? @tr("Stop microphone test") : @tr("Test microphone");
                clicked => { SettingsStore.command("mic-test", SettingsStore.mic-testing ? "0" : "1"); }
            }
            if SettingsStore.mic-testing: Rectangle {
                width: 200px;
                height: 8px;
                y: (parent.height - self.height) / 2;
                border-radius: 4px;
                background: Theme.surface;
                accessible-role: progress-indicator;
                accessible-label: @tr("Microphone level");
                accessible-value: Math.round(SettingsStore.mic-level * 100) + "%";
                Rectangle {
                    x: 0;
                    width: parent.width * clamp(SettingsStore.mic-level, 0, 1);
                    border-radius: 4px;
                    background: Theme.accent;
                }
            }
        }
    }
    SSection {
        title: @tr("Call audio");
        SSwitch {
            label: @tr("Noise suppression");
            hint: @tr("Removes background noise, like typing or a fan, from your microphone in calls.");
            on: SettingsStore.noise-suppression;
            toggled(on) => { SettingsStore.command("noise-suppression", on ? "1" : "0"); }
        }
        SSwitch {
            label: @tr("Echo cancellation");
            hint: @tr("Stops others from hearing themselves when you use speakers instead of a headset.");
            on: SettingsStore.echo-cancellation;
            toggled(on) => { SettingsStore.command("echo-cancellation", on ? "1" : "0"); }
        }
    }
    SSection {
        title: @tr("Camera");
        hint: @tr("Preview, mirroring and low-light correction come with calls.");
        SRadio { group: @tr("Camera"); label: @tr("System default"); checked: SettingsStore.camera == ""; picked => { SettingsStore.command("camera", ""); } }
        for d in SettingsStore.cameras: SRadio { group: @tr("Camera"); label: d.name; detail: d.id; checked: SettingsStore.camera == d.id; picked => { SettingsStore.command("camera", d.id); } }
    }
    SSection {
        title: @tr("Calls");
        SChoiceRow {
            label: @tr("Ask about call quality after calls");
            options: [{v: "always", l: @tr("Always")}, {v: "sometimes", l: @tr("Sometimes")}, {v: "never", l: @tr("Never")}];
            value: SettingsStore.call-feedback;
            picked(v) => { SettingsStore.call-feedback = v; SettingsStore.command("call-feedback", v); }
        }
    }
    SSwitch {
        label: @tr("Show all devices");
        hint: @tr("Also list the raw sound card entries.");
        on: SettingsStore.all-devices;
        toggled(on) => { SettingsStore.command("all-devices", on ? "1" : "0"); }
    }
    if SettingsStore.devices-status != "": Para { text: SettingsStore.devices-status; }
}

export component CallsSettingsPage inherits VerticalLayout {
    alignment: start;
    SSection {
        title: @tr("Ringtone");
        hint: @tr("The sound IronTeams plays for an incoming call. It is kept on this computer.");
        SChoiceRow {
            label: @tr("Ringtone");
            options: [{v: "chime", l: @tr("Chime")}, {v: "soft", l: @tr("Soft")}, {v: "pulse", l: @tr("Pulse")}];
            value: SettingsStore.ringtone;
            picked(v) => { SettingsStore.ringtone = v; SettingsStore.command("ringtone", v); }
        }
        SButton { label: @tr("Play ringtone"); clicked => { SettingsStore.command("ringtone-preview", SettingsStore.ringtone); } }
    }
    SSection {
        title: @tr("Call forwarding");
        hint: @tr("IronTeams can't read or change these yet: the Teams service that keeps them is not documented for it. Change them in Teams.");
        SChoiceRow {
            label: @tr("Forward my calls");
            options: [{v: "none", l: @tr("Don't forward")}, {v: "voicemail", l: @tr("To voicemail")}];
            value: "";
            enabled: false;
            picked(v) => { }
        }
        SChoiceRow {
            label: @tr("If unanswered");
            options: [{v: "voicemail", l: @tr("Voicemail")}, {v: "person", l: @tr("A person")}, {v: "number", l: @tr("A number")}];
            value: "";
            enabled: false;
            picked(v) => { }
        }
        SChoiceRow {
            label: @tr("Ring for");
            options: [{v: "10", l: @tr("10 seconds")}, {v: "20", l: @tr("20 seconds")}, {v: "30", l: @tr("30 seconds")}, {v: "45", l: @tr("45 seconds")}];
            value: "";
            enabled: false;
            picked(v) => { }
        }
    }
    SSection {
        title: @tr("Voicemail greeting");
        hint: @tr("Recording or choosing a greeting needs the same Teams service, so it stays in Teams for now.");
        SButton { label: @tr("Record a greeting"); enabled: false; clicked => { } }
    }
}

export component FilesPage inherits VerticalLayout {
    alignment: start;
    SSection {
        title: @tr("Files");
        SChoiceRow {
            label: @tr("Open Word, Excel and PowerPoint files in");
            options: [{v: "browser", l: @tr("Browser")}, {v: "desktop", l: @tr("Desktop app")}, {v: "ironteams", l: @tr("IronTeams preview")}];
            value: SettingsStore.open-files;
            picked(v) => { SettingsStore.open-files = v; SettingsStore.command("open-files", v); }
        }
    }
    SSection {
        title: @tr("Links");
        Para { text: @tr("Links open in your default browser."); }
    }
}

export component PermissionsPage inherits VerticalLayout {
    alignment: start;
    SSection {
        title: @tr("App permissions");
        hint: @tr("What each app may use. Apps run in IronTeams's web host and ask for these first.");
        if SettingsStore.app-perms.length == 0: Para { text: @tr("No app has asked for a permission."); }
    }
    for a in SettingsStore.app-perms: SSection {
        title: a.name;
        for p in a.perms: SSwitch {
            label: a.name + ": " + p.label;
            on: p.on;
            toggled(on) => { SettingsStore.command("perm", SettingsStore.j3(a.app, p.key, on ? "1" : "0")); }
        }
    }
    if SettingsStore.perms-status != "": Para { text: SettingsStore.perms-status; }
}

export component AboutPage inherits VerticalLayout {
    alignment: start;
    SSection {
        title: "IronTeams " + SettingsStore.version;
        Para { text: @tr("An unofficial native Microsoft Teams client written in Rust."); }
    }
    // A copy Velopack installed updates itself; any other copy only offers the opt-in check.
    if SettingsStore.self-update: SSection {
        title: @tr("Updates");
        hint: @tr("IronTeams downloads new versions from its GitHub releases in the background, only the parts that changed, and installs them when you restart or quit it.");
        SSwitch {
            label: @tr("Automatic updates");
            on: SettingsStore.auto-update;
            toggled(on) => { SettingsStore.command("auto-update", on ? "1" : "0"); }
        }
        SSwitch {
            label: @tr("Get beta updates");
            on: SettingsStore.beta-updates;
            toggled(on) => { SettingsStore.command("beta-updates", on ? "1" : "0"); }
        }
        SButton {
            label: @tr("Check now");
            enabled: !SettingsStore.update-checking && !SettingsStore.update-ready;
            clicked => { SettingsStore.command("check-now", ""); }
        }
        if SettingsStore.update-status != "": Para { text: SettingsStore.update-status; }
        if SettingsStore.update-ready: SButton {
            label: @tr("Restart to update");
            clicked => { SettingsStore.command("restart-update", ""); }
        }
    }
    if !SettingsStore.self-update: SSection {
        title: @tr("Updates");
        hint: @tr("Off by default. When on, IronTeams asks api.github.com for the latest release when it starts. The request has no cookies, no account and nothing about you. IronTeams never downloads or installs anything.");
        SSwitch {
            label: @tr("Check for updates");
            on: SettingsStore.check-updates;
            toggled(on) => { SettingsStore.command("check-updates", on ? "1" : "0"); }
        }
        if SettingsStore.check-updates: SButton {
            label: @tr("Check now");
            enabled: !SettingsStore.update-checking;
            clicked => { SettingsStore.command("check-now", ""); }
        }
        if SettingsStore.update-status != "": Para { text: SettingsStore.update-status; }
        if SettingsStore.update-available: SButton {
            label: @tr("View release notes");
            clicked => { SettingsStore.command("release-notes", ""); }
        }
    }
    SSection {
        title: @tr("Report a problem");
        Para { text: @tr("Writes a bundle of logs with tokens, ids and addresses removed to your Downloads folder. Nothing is uploaded."); }
        SButton { label: @tr("Report a problem"); clicked => { SettingsStore.command("report-problem", ""); } }
    }
}
