// IronTeams main window: Teams-like dark layout (rail, chat list, conversation, composer).
// The pieces live in sibling modules; this file keeps the AppWindow state, callbacks and wiring.
import { ListView } from "std-widgets.slint";
import { Theme } from "tokens/theme.slint";
import { ActivityRow, ChatRow, ComposerEmoji, EmojiItem, Msg, PendingAttachment, Recipient, TeamRow } from "tokens/types.slint";
import { Icon, IconButton } from "atoms/widgets.slint";
import { Pill } from "atoms/chip.slint";
