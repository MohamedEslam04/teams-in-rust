export { EmojiApi } from "organisms/composer.slint";
export { SpellApi, SpellWord } from "molecules/spelling.slint";
export { LineApi } from "molecules/line_editor.slint";
export { InlineImageStore } from "stores/inline_image_store.slint";
export { FormatApi, FormatEdit } from "organisms/composer_format.slint";
export { ShortcutApi } from "organisms/shortcuts.slint";
export { ShortcutStore, ShortcutItem } from "stores/shortcut_store.slint";
export { PaletteApi, PaletteStore, PaletteAction, PaletteItem } from "pages/palette.slint";
export { MentionApi } from "molecules/mention_picker.slint";
export { SnippetApi, SnippetStore, SnippetItem } from "molecules/snippet_picker.slint";
export { VoiceStore } from "molecules/voice_player.slint";
export { VoiceRecStore } from "organisms/voice_recorder.slint";
export { ClipStore } from "organisms/video_clip.slint";
export { LoopStore, LoopRow } from "molecules/loop_editor.slint";
export { PeopleStore } from "molecules/people.slint";
export { ListStore, SectionRow, SectionChoice } from "organisms/lists.slint";
export { RemindStore, ReminderRow, SnoozedRow, LaterRow } from "organisms/remind.slint";
export { ChatNoteStore } from "organisms/chat_note.slint";
export { ChannelStore, PostItem, Replier } from "organisms/channel_posts.slint";
export { FindStore, HitRow, PickRow, SharedRow } from "stores/find_store.slint";
export { MediaStore } from "organisms/media.slint";
export { EngageStore, EPost } from "pages/engage.slint";
export { GifStore, GifItem } from "molecules/gif_picker.slint";
export { CallStore, CallPerson, CallCaption, CallFound, CallVideo } from "pages/call_window.slint";
export { DirectCallStore } from "organisms/call_incoming.slint";
export { CallsPageStore, CallHistoryItem, CallPersonItem, VoicemailItem } from "pages/calls_page.slint";
export { VideoFxStore, FxChoice } from "stores/video_fx_store.slint";
export { TeamsStore, TeamsActions, TChannel, TTeam, TDiscover, TPerson, TTag, TDeleted, TSetting, TStat, TCommunity, TPost } from "stores/teams_store.slint";
export { CalStore, CalForm, CalDay, CalBlock, CalAllDay, CalMonthItem, CalMonthCell, CalMiniCell, CalFilterOpt, CalCalendarRow, CalSavedView, CalSettingsData, CalPerm, CalPeek, CalAttendeeRow, CalAttachmentRow, CalProposalRow, CalZone, CalDetail, CalSchedRow, CalSuggest, CalRoomList, CalRoom } from "pages/calendar.slint";
export { DriveStore, DriveRow, DriveCard, DriveNav, SharePerson, SharePerm, DriveVersion } from "stores/drive_store.slint";
export { ComposerApps, CaCommand, CaResult, CaCard } from "organisms/composer_apps.slint";
export { SendStore, ScheduledItem, QuickChoice, PickCell } from "organisms/composer_send.slint";
export { ChatHeaderStore } from "organisms/chat_header.slint";
export { QuickViewsStore, ChatTipStore } from "organisms/chat_list_extras.slint";
export { StorylineStore } from "pages/storyline.slint";
export { CallReaction, CallAbsent } from "stores/call_store.slint";
export { OngoingCallStore, OngoingPerson } from "stores/ongoing_call_store.slint";
import { ChannelMeetButton, MeetingJoinButton, ParityNotice, WebParityStore } from "organisms/web_parity.slint";
import { AppTopBar } from "organisms/app_top_bar.slint";
import { AppRail } from "organisms/app_rail.slint";
import { ChatPaneHeader } from "organisms/chat_pane_header.slint";
import { MessagePane } from "organisms/message_pane.slint";
import { ProfileCardLayer, ParticipantsLayer, ForwardLayer, ReactionPickerLayer, SeenByLayer, MessageMenuLayer } from "organisms/chat_overlays.slint";
import { AppKeys } from "organisms/app_keys.slint";
import { NoticeBanner } from "organisms/notice_banner.slint";
import { DrivePickerLayer, SectionDialogLayer, RemindLayer, LeaveChannelLayer, AddTabLayer, RemoveHistoryLayer, LeaveChatLayer } from "organisms/app_dialogs.slint";
export { WebParityStore } from "organisms/web_parity.slint";
export { AppsStore, TasksStore, FlowsStore, NotesStore, ListsStore, RecapsStore, AppCard, AppNav, RailApp, RailFixed, PermRow, AppRow, BoardColumn, TableRow } from "stores/apps_store.slint";
export { SettingsStore, SOption, SToggle, SNotify, SPerson, SAccount, STheme, SOrg, SDevice, SAppPerm, SFind } from "pages/settings.slint";
export { TopBarStore, TopRow } from "organisms/topbar.slint";

export component AppWindow inherits Window {
    title: root.window-title;
    icon: @image-url("icons/app.svg");
    preferred-width: 1400px;
    preferred-height: 900px;
    min-width: 640px;
    min-height: 560px;
    background: Theme.main;
    default-font-size: 14px * Theme.font-scale;
    // The interface font (Settings > Appearance > Text); "" keeps the default chain.
    default-font-family: Theme.font-ui;
    // "Auto collapse app bar" needs the window's width (AppsStore.narrow-width is the
    // `single-pane` breakpoint below).
    init => { AppsStore.window-width = root.width; }
    changed width => { AppsStore.window-width = root.width; }

    // --- state set from Rust ---
    in property <string> login-state: "checking"; // checking | code | error | ready
    in property <string> user-code;
    in property <string> verify-url;
    in property <string> login-error;
    // The copyable details of a sign-in blocked by policy; empty for other failures.
    in property <string> login-report;
    // The sign-in splash is still on screen (it fades out over the main UI).
    out property <bool> splash-shown: splash.shown;
    in property <string> me-initials;
    in property <bool> connected: true;
    in property <string> banner;
    // An info notice (update available) instead of an error toast, with one action link.
    in property <bool> banner-info: false;
    in property <string> banner-action;

    in-out property <string> view: "chat"; // chat | teams | activity | calendar | onedrive
    // Any other page (an app, search, a notification) shrinks a running call to its floating bar.
    changed view => {
        // The Later page covers the page under it: another page leaves it.
        RemindStore.later-open = false;
        if CallStore.phase != "" { CallStore.minimized = true; }
        TopBarStore.command("visit", root.view + "\u{1f}" + root.current-id);
    }
    // Back and Forward follow the chats opened as well as the pages.
    changed current-id => {
        TopBarStore.command("visit", root.view + "\u{1f}" + root.current-id);
        // A chat opened (from anywhere) takes the window in one-pane mode.
        root.pane-list = false;
    }
    // Opens a page of the left rail the way a click on it does (also Back and Forward, and the
    // search box's commands).
    public function navigate(v: string) {
        // Settings covers the page: going to a page leaves it, as in Teams (also for the page
        // already open under it).
        root.leave-settings();
        RemindStore.later-open = false;
        // Leaving the call view keeps the call running in the small floating bar.
        if CallStore.phase != "" { CallStore.minimized = true; }
        let from = root.view;
        root.view = v;
        // Back from the Teams page: the chat that was open in the Chat view, not the channel
        // that was opened on the Teams page.
        if v == "chat" && from == "teams" && root.last-chat-id != "" && root.last-chat-id != root.current-id {
            root.select-chat(root.last-chat-id);
        }
        if v == "teams" && !root.current-is-channel && root.last-channel-id != "" {
            root.select-channel(root.last-channel-id, root.last-channel-title);
        }
        if v == "activity" { root.activity-refresh(); }
        if v == "onedrive" { DriveStore.command("enter", ""); }
        if v == "calls" { CallsPageStore.command("open", ""); }
    }
    // Settings covers the call window and its floating card, so a call that starts (answered,
    // placed or joined) closes Settings and shows itself, as Teams does.
    property <bool> call-showing: CallStore.phase != "";
    changed call-showing => {
        if self.call-showing && SettingsStore.open { SettingsStore.close(); }
    }
    in-out property <string> filter: "all";
    in property <[ChatRow]> chats-favorites;
    in property <[ChatRow]> chats-main;
    in property <[ChatRow]> chats-channels;
    in property <[TeamRow]> teams;
    in property <string> current-id;
    in property <string> current-title;
    in property <string> current-initials;
    in property <color> current-color: Theme.accent-strong;
    in property <image> current-avatar;
    in property <bool> current-has-avatar;
    // The kind of the open chat ("group", "meeting", "chat", "notes" or "channel").
    in property <string> current-kind;
    // The header draws a glyph instead of initials, as the chat list does: a calendar for a
    // meeting chat, the people for a group chat without a picture.
    property <string> header-glyph: root.current-kind == "meeting" ? "meeting" : (root.current-kind == "group" && !root.current-has-avatar ? "group" : "");
    // The other person of an open 1:1 chat ("" otherwise) and their availability.
    in property <string> current-person;
    in property <string> current-presence;
    in property <bool> current-is-channel;
    // The last channel that was open (Rust sets it; it is remembered across starts): the Teams
    // page opens it again instead of showing the chat that is open.
    in-out property <string> last-channel-id;
    in-out property <string> last-channel-title;
    // The last conversation opened outside the Teams page: the Chat page shows it again.
    in-out property <string> last-chat-id;
    // The Teams page with no channel open: its right pane asks for one, it never shows a chat.
    property <bool> teams-no-channel: root.view == "teams" && !root.current-is-channel;
    // A page that covers the chat list and the chat (Activity, Calendar, OneDrive, Calls, an app).
    // They stay under it, hidden and the same size, so coming back shows them as they were (the
    // same scroll place) without building the list and the message rows again.
    property <bool> page-shown: root.view == "activity" || root.view == "calendar" || root.view == "onedrive" || root.view == "calls" || AppsStore.owns(root.view);
    // The open chat is muted ("More chat options" offers Unmute).
    in property <bool> current-muted;
    // The open chat's meeting is going on: its header Join is filled.
    in property <bool> current-meeting-live;
    in property <string> thread-root;     // non-empty: viewing a channel thread
    in property <[Msg]> messages;
    in property <bool> loading-older;
    // Messages a jump (to the first message, to a date) has read so far: the loading line counts them.
    in property <int> loading-progress;
    // The open chat or channel is reading its newest page (what the store had already shows).
    in property <bool> loading-latest;
    // The open chat is one the user is not a member of (a meeting they have not joined): the pane
    // shows the text instead of the messages and the composer. Tied to the chat's id so a chat
    // switch drops it at once.
    in property <string> unavailable-id;
    in property <string> unavailable-text;
    property <bool> unavailable: root.unavailable-text != "" && root.unavailable-id == root.current-id && root.thread-root == "";
    // The chat the user chose in the search box, shown at once while the engine switches to it
    // (the header and a loading state): its composer waits for the engine, so nothing typed in
    // the meantime lands in the previous chat's draft. The engine's header for it clears this.
    in-out property <string> opening-id;
    property <bool> opening: root.opening-id != "" && root.opening-id == root.current-id;
    in-out property <string> reply-author;
    in-out property <string> reply-preview;
    in-out property <string> editing-id;
    in-out property <string> draft;
    in-out property <string> post-subject;
    // The message list sits at the newest message. Set by the list itself; Rust is told.
    in-out property <bool> at-bottom: true;
    // New messages that arrived while scrolled up (the jump button shows the count).
    in property <int> new-count;
    // Row of the "New messages" divider to scroll to when a chat opens there.
    in property <int> divider-index: -1;
    // Row of the open list's "New messages" divider (-1: none) and the messages from others from
    // there on: the "↑ New messages" button while the divider is above the view.
    in property <int> unread-index: -1;
    in property <int> unread-count;

    // Message menu, "More reactions" picker, forward dialog and multi-select (see the
    // message_menu, reaction_picker, forward_dialog and select_bar modules).
    in-out property <bool> menu-open: false;
    in-out property <length> menu-x;
    in-out property <length> menu-y;
    // Where the open message menu is (its size comes from the menu), and how tall the profile
    // menu's panel is: what `pointer-pressed` counts as inside them.
    property <length> menu-w;
    property <length> menu-h;
    property <length> menu-left: max(8px, min(root.menu-x, root.width - root.menu-w - 8px));
    property <length> menu-top: max(8px, min(root.menu-y, root.height - root.menu-h - 8px));
    property <length> profile-h;
    property <length> profile-left;
    // The same for the "…" menu's panel and a clicked profile card (window coordinates).
    property <length> more-h;
    property <length> card-left;
    property <length> card-top;
    property <length> card-w;
    property <length> card-h;
    in-out property <Msg> menu-msg;
    // The menu was opened from the Activity preview (not the open chat).
    in-out property <bool> menu-preview: false;
    // The "Seen by" list of one of my messages (`Msg.reader-list`), opened from the line under it
    // or from the menu's "Read by": it opens below `readers-bottom` (above `readers-top` when
    // there is no room), its right edge at `readers-x`. 280px wide (seen_by.slint); `readers-h` is
    // what the popup measures, like the menu's.
    in-out property <bool> readers-open: false;
    in-out property <Msg> readers-msg;
    in-out property <length> readers-x;
    in-out property <length> readers-top;
    in-out property <length> readers-bottom;
    property <length> readers-h;
    property <length> readers-left: max(8px, min(root.readers-x - 280px, root.width - 288px));
    property <length> readers-y: root.readers-bottom + 4px + root.readers-h > root.height - 8px ? max(8px, root.readers-top - 4px - root.readers-h) : root.readers-bottom + 4px;
    // Immersive Reader of a message.
    in-out property <bool> reader-open: false;
    in-out property <Msg> reader-msg;
    in-out property <bool> picker-open: false;
    in-out property <length> picker-x;
    in-out property <length> picker-y;
    in-out property <string> picker-msg-id;
    in property <[EmojiItem]> picker-items;
    in-out property <bool> forward-open: false;
    in property <[Recipient]> forward-results;
    in property <[Recipient]> forward-picked;
    in-out property <int> forward-count: 1;
    in-out property <string> forward-preview-author;
    in-out property <string> forward-preview-text;
    in-out property <bool> select-mode: false;
    in property <int> select-count;

    // Activity view
    in property <[ActivityRow]> activity-items;
    in property <int> activity-unread;
    in property <int> chats-unread;
    in-out property <string> activity-filter: "all";
    in-out property <string> activity-selected;
    in property <string> activity-preview-id;
    in property <string> activity-preview-title;
    in property <string> activity-preview-location;
    in property <bool> activity-preview-is-channel;
    in property <bool> activity-preview-loading;
    in property <[Msg]> activity-preview;
    in property <string> activity-highlight;
    // Unread Activity items plus unread chats, like Teams; shown in the window title.
    out property <int> badge-total: root.activity-unread + root.chats-unread;
    out property <string> window-title: root.badge-total > 0 ? "(" + root.badge-total + ") IronTeams" : "IronTeams";
    in-out property <bool> enter-sends: true;
    // Ctrl+. shows the shortcut list; Ctrl+Shift+X makes the composer taller (plan chat 5.9).
    in-out property <bool> shortcuts-open: false;
    in-out property <bool> composer-expanded: false;
    in-out property <int> msg-focus-tick: 0;
    // The first sync after start-up has finished; "While you were away" waits for it and shows once.
    in property <bool> synced: false;
    in-out property <bool> away-dismissed: false;
    // Unread chats and the ones that mention me, from the chat list as drawn (src/catch_up.rs).
    property <[int]> catch-counts: ShortcutApi.catch-up-counts(root.chats-favorites, ListStore.sections, root.chats-main, root.chats-channels);
    property <int> catch-chats: root.catch-counts.length > 0 ? root.catch-counts[0] : 0;
    // Catching up everything ends the card, so it does not come back with the next message.
    changed catch-chats => { if root.synced && root.catch-chats == 0 { root.away-dismissed = true; } }
    // Alt+Down / Alt+Up (1 / -1), Alt+Shift+Down / Alt+Shift+Up (2 / -2, wrapping around the list)
    // and the chip (0) open an unread chat, or say there is none.
    function catch-up(step: int) {
        if ShortcutApi.catch-up-target(root.current-id, step, root.chats-favorites, ListStore.sections, root.chats-main, root.chats-channels) != "" {
            root.view = "chat";
            FindStore.quick-open = false;
            root.select-chat(ShortcutApi.catch-up-target(root.current-id, step, root.chats-favorites, ListStore.sections, root.chats-main, root.chats-channels));
        } else {
            ShortcutApi.notify(@tr("You're all caught up"));
        }
    }
    // The composer's "Mark as important"; main.rs reads it when the message is sent.
    in-out property <bool> important: false;
    // "Set delivery options" › Urgent (the send button's menu); read the same way.
    in-out property <bool> urgent: false;
    in-out property <bool> composer-focused;
    in-out property <int> skin-tone: 0;
    in property <[ComposerEmoji]> recent-emoji;
    in property <[PendingAttachment]> pending-attachments;
    in property <int> cursor-tick; // Rust bumps it to put the composer cursor at the end
    // A channel's top level shows post cards (channel_posts.slint) instead of the flat list.
    property <bool> posts-mode: root.current-is-channel && root.thread-root == "" && ChannelStore.active;
    // A file is being dragged over the window (Rust sets it from the window system's drag events).
    in property <bool> file-hover: false;
    // A file dropped now becomes an attachment: a chat or channel is open with its composer showing.
    property <bool> accepts-files: (root.view == "chat" || root.view == "teams") && root.current-id != "" && !root.teams-no-channel && FindStore.chat-tab == "chat" && (!root.posts-mode || ChannelStore.compose-open) && !root.unavailable && !SettingsStore.open;

    // --- callbacks to Rust ---
    callback retry-login();
    callback copy-code();
    callback copy-login-report();
    callback select-chat(string);
    callback select-channel(string, string);
    callback toggle-team(int);
    callback toggle-favorite(string);
    callback set-filter(string);
    callback search(string);
    callback send(string);
    callback typing-tick();
    callback draft-edited(string);
    callback load-older();
    // The rows at the message or posts list's top and bottom edges (`Cmd::RowsShown`).
    callback rows-shown(string, string);
    callback react(string, string);
    callback reply(string);
    callback cancel-reply();
    callback edit(string);
    callback delete(string);
    callback open-url(string);
    callback open-thread(string);
    callback close-thread();
    callback attach-image();
    callback attach-file();
    callback set-enter-sends(bool);
    callback emoji-used(string);
    callback paste-image();
    callback remove-attachment(int);
    callback skin-tone-changed(int);
    callback dismiss-banner();
    callback banner-action-clicked();
    callback picker-search(string);
    callback copy-link(string);
    callback toggle-save(string);
    callback pin(string);
    callback mark-unread(string);
    callback forward-begin(string);
    callback forward-begin-selected();
    callback forward-search(string);
    callback forward-toggle(string);
    callback forward-send(string);
    callback forward-cancel();
    callback select-begin(string);
    callback toggle-select(string);
    callback select-cancel();
    callback at-bottom-changed(bool);
    // Chat list "Mark as unread" (the message menu has its own `mark-unread(message id)`).
    callback mark-chat-unread(string);
    callback mark-all-read();
    callback jump-to-newest();
    callback retry-send(string);
    callback discard-send(string);
    // The chat header's "Schedule a meeting": opens the calendar's new-event form with the chat's members.
    callback schedule-meeting(string);
    // Meet now from anywhere: the calendar's prompt, with an optional meeting title.
    function meet-now(title: string) {
        root.view = "calendar";
        CalStore.ask("meet-now", "Meet now", "Starts a Teams meeting right away and gives you the link.", "Meeting title (optional)", "", "", "Start meeting");
        CalStore.prompt-text1 = title;
    }
    callback activity-refresh();
    callback activity-select(string);
    callback activity-set-filter(string);
    callback activity-search(string);
    callback activity-mark(string, bool);
    callback activity-mark-all();
    callback activity-go-to();
    callback activity-reply(string);
    callback activity-settings();

    // Group chat header: renaming in place (the pencil).
    in-out property <bool> renaming: false;
    in-out property <string> rename-text;

    // Rust bumps these counters to request a scroll to the bottom / composer focus.
    in-out property <int> scroll-tick;
    in-out property <int> focus-tick;
    in-out property <int> divider-tick;
    // Older messages were added above: keep the row at `anchor-index` (the one that was first)
    // where it was on screen.
    in-out property <int> anchor-tick;
    // The row at the top of the message view and how far its top is above the view's top (the
    // pane tracks it as the user scrolls; Rust reads it when older messages land).
    in-out property <string> msg-top-id;
    in-out property <length> msg-top-off;
    in-out property <length> msg-top-cy;
    in-out property <length> msg-view-y;
    // How far above the view's top the anchor row sits once the older messages are in.
    in property <length> anchor-off;
    // Width of the chat and teams list (the divider next to it drags it; Rust remembers it).
    in-out property <length> sidebar-width: 320px;
    // Narrow windows. Below 800px one pane shows at a time, as in Teams: an open chat takes the
    // window and its header's Back shows the list again. Above it the list gives way so the
    // conversation keeps 480px.
    property <bool> single-pane: root.width < AppsStore.narrow-width;
    in-out property <bool> pane-list: false;
    property <bool> list-only: root.single-pane && (root.current-id == "" || root.pane-list || root.teams-no-channel);
    property <bool> chat-only: root.single-pane && !root.list-only;
    property <length> list-width: min(root.sidebar-width, max(220px, root.width - AppsStore.rail-width - 5px - 480px));
    // Split view (`SplitStore`): a second chat right of the open one. It shows while the room
    // right of the list holds both, the open chat at least 360px and the pane at least 300px;
    // a narrower window hides it until it is wide enough again. Rust reads `split-fits`.
    property <length> chat-room: root.width - AppsStore.rail-width - root.list-width - 5px;
    out property <bool> split-fits: !root.single-pane && root.chat-room >= 360px + 5px + 300px;
    property <bool> split-shown: SplitStore.open && root.split-fits && root.view != "search";
    property <length> split-width: max(300px, min(SplitStore.width > 0px ? SplitStore.width : (root.chat-room - 5px) / 2, root.chat-room - 5px - 360px));
    in property <int> anchor-index: -1;


    // The split pane's X and Esc: the engine stops filling it and the keys go back to the chat.
    function close-split() {
        SplitStore.open = false;
        SplitStore.active = false;
        MediaStore.command("split-close", "");
        root.focus-tick += 1;
    }

    // The command palette runs the same things the rail, the shortcuts and Settings run.
    function leave-settings() {
        if SettingsStore.open { SettingsStore.close(); }
    }
    // The palette's input had the keyboard focus and is gone: hand the keys back to the window
    // (and to the composer in a chat) so the shortcuts keep working.
    function palette-done() {
        PaletteStore.restore-tick += 1;
        if root.view == "chat" { root.focus-tick += 1; }
    }
    function run-palette(item: PaletteItem) {
        PaletteStore.open = false;
        if item.kind == "chat" {
            root.leave-settings();
            root.view = "chat";
            root.select-chat(item.id);
            root.palette-done();
        } else {
            PaletteStore.recents = PaletteApi.push-recent(PaletteStore.recents, item.id);
            root.run-palette-action(item.cmd, item.arg);
        }
    }
    function run-palette-action(cmd: string, arg: string) {
        if cmd == "go" {
            root.leave-settings();
            root.view = arg;
            if arg == "activity" { root.activity-refresh(); }
            if arg == "onedrive" { DriveStore.command("enter", ""); }
            if arg == "calls" { CallsPageStore.command("open", ""); }
            root.palette-done();
        }
        if cmd == "new-chat" {
            root.leave-settings();
            root.view = "chat";
            PeopleStore.new-chat-open = true;
            PeopleStore.command("new-chat-open", "");
        }
        if cmd == "search" {
            root.leave-settings();
            root.view = "search";
            FindStore.focus-tick += 1;
        }
        // The quick switcher (Ctrl+Alt+G).
        if cmd == "goto" {
            root.leave-settings();
            root.view = "search";
            FindStore.command("search-tab", "chats");
            FindStore.focus-tick += 1;
        }
        if cmd == "later" {
            root.leave-settings();
            RemindStore.later-open = true;
            RemindStore.command("refresh", "");
            root.palette-done();
        }
        if cmd == "mark-all-read" { root.mark-all-read(); root.palette-done(); }
        if cmd == "next-unread-wrap" { root.leave-settings(); root.catch-up(2); root.palette-done(); }
        if cmd == "previous-unread-wrap" { root.leave-settings(); root.catch-up(-2); root.palette-done(); }
        if cmd == "settings" { SettingsStore.show(arg); }
        if cmd == "toggle-theme" { SettingsStore.command("theme", SettingsStore.theme-shown == "dark" ? "light" : "dark"); root.palette-done(); }
        if cmd == "reset-theme" { SettingsStore.command("reset-theme", ""); root.palette-done(); }
        if cmd == "shortcuts" { root.shortcuts-open = true; root.palette-done(); }
        if cmd == "report-problem" { SettingsStore.command("report-problem", ""); root.palette-done(); }
        if cmd == "status" { SettingsStore.command("status", arg); root.palette-done(); }
        // Opens the profile menu on its own confirmation, so nothing signs out by itself.
        if cmd == "sign-out" {
            SettingsStore.open-profile();
            SettingsStore.confirm-sign-out = true;
        }
    }

    // A button went down at (x, y), before the window handles it (`main.rs`,
    // `pointer_pressed`): the message menu, the profile menu, the "…" menu and a clicked profile
    // card close when it is outside them, so the press then reaches what is under it (a rail
    // entry, a chat), as in Teams. Their full-window layers only catch a press this did not see.
    public function pointer-pressed(x: length, y: length) {
        if root.menu-open && (x < root.menu-left || x > root.menu-left + root.menu-w || y < root.menu-top || y > root.menu-top + root.menu-h) {
            root.menu-open = false;
        }
        if root.readers-open && (x < root.readers-left || x > root.readers-left + 280px || y < root.readers-y || y > root.readers-y + root.readers-h) {
            root.readers-open = false;
        }
        // The profile card (230px wide, 8px from the right edge, 46px from the top) and the
        // flyouts left of it: `profile-left` and `profile-h` say what the menu covers (settings.slint).
        root.profile-closed-by-press = false;
        if SettingsStore.profile-open && (x < root.profile-left || x > root.width - 8px || y < 46px || y > 46px + root.profile-h) {
            SettingsStore.profile-open = false;
            SettingsStore.confirm-sign-out = false;
            root.profile-closed-by-press = true;
        }
        // The "…" menu's panel: 260px wide, 52px from the right edge, 46px from the top (topbar.slint).
        TopBarStore.more-closed-by-press = false;
        if TopBarStore.more-open && (x < root.width - 312px || x > root.width - 52px || y < 46px || y > 46px + root.more-h) {
            TopBarStore.more-open = false;
            TopBarStore.more-closed-by-press = true;
        }
        // A hover card closes when the pointer leaves it; a clicked one on a press outside it.
        PeopleStore.card-closed-for = "";
        if PeopleStore.card-open && !PeopleStore.card-by-hover && (x < root.card-left || x > root.card-left + root.card-w || y < root.card-top || y > root.card-top + root.card-h) {
            PeopleStore.card-open = false;
            PeopleStore.card-closed-for = PeopleStore.card.id;
        }
    }
    // This press closed the profile menu: on my photo it stays closed (the photo toggles it).
    property <bool> profile-closed-by-press;

    // The splash stays in the tree and fades out over the main UI once signed in.
    splash := LoginView {
        z: 100;
        state: root.login-state;
        done: root.login-state == "ready";
        user-code: root.user-code;
        verify-url: root.verify-url;
        error: root.login-error;
        report: root.login-report;
        copy-code => { root.copy-code(); }
        copy-report => { root.copy-login-report(); }
        open-url(u) => { root.open-url(u); }
        retry => { root.retry-login(); }
    }

    if root.login-state == "ready": win-keys := AppKeys {
        attach-file => { root.attach-file(); }
        cancel-reply => { root.cancel-reply(); }
        catch-up(a0) => { root.catch-up(a0); }
        close-thread => { root.close-thread(); }
        edit-message(a0) => { root.edit(a0); }
        composer-expanded <=> root.composer-expanded;
        composer-focused: root.composer-focused;
        composer-empty: root.draft == "";
        current-id: root.current-id;
        filter <=> root.filter;
        focus-tick <=> root.focus-tick;
        mark-all-read => { root.mark-all-read(); }
        menu-open <=> root.menu-open;
        msg-focus-tick <=> root.msg-focus-tick;
        posts-mode: root.posts-mode;
        reply-preview: root.reply-preview;
        set-filter(a0) => { root.set-filter(a0); }
        shortcuts-open <=> root.shortcuts-open;
        split-shown: root.split-shown;
        close-split => { root.close-split(); }
        teams-no-channel: root.teams-no-channel;
        thread-root: root.thread-root;
        view <=> root.view;
        focus-search => { top-bar.focus-search(); }
        start-command => { top-bar.start-command(); }
        VerticalLayout {
        // Top bar with search
        top-bar := AppTopBar {
            connected: root.connected;
            me-initials: root.me-initials;
            profile-closed-by-press <=> root.profile-closed-by-press;
            window-width: root.width;
        }

        if CalStore.join-text != "": JoinBanner { }

        HorizontalLayout {
            // Left rail
            AppRail {
                activity-unread: root.activity-unread;
                chats-unread: root.chats-unread;
                navigate(a0) => { root.navigate(a0); }
                view <=> root.view;
            }

            // The area right of the rail: the chat list and the chat, with a page over them.
            area := Rectangle {
                horizontal-stretch: 1;
                // Under a page the list and the chat keep their size and place but are clipped to
                // nothing. A clip that changes size hides them in one step; `visible: false` would
                // make the renderer re-mark every row under it each time (docs/perf.md). While
                // they show, the clip reaches far past the area on every side, so it cuts nothing
                // (a panel sliding in from the edge, a tooltip over the top bar).
                Rectangle {
                    x: -100000px;
                    y: -100000px;
                    width: parent.width + 200000px;
                    height: root.page-shown ? 0px : parent.height + 200000px;
                    clip: true;
                    HorizontalLayout {
                        x: 100000px;
                        y: 100000px;
                        width: area.width;
                        height: area.height;
                        // Sidebar
                        Sidebar {
                            visible: root.view != "search" && !root.chat-only;
                            width: root.view == "search" || root.chat-only ? 0px
                                : root.list-only ? root.width - AppsStore.rail-width : root.list-width;
                            max-height: 100000px;
                            // Under a page the list keeps what it showed (Chat unless Teams).
                            view: root.view == "teams" ? "teams" : "chat";
                            filter <=> root.filter;
                            chats-favorites: root.chats-favorites;
                            chats-main: root.chats-main;
                            chats-channels: root.chats-channels;
                            teams: root.teams;
                            current-id: root.current-id;
                            catch-chats: root.catch-chats;
                            catch-mentions: root.catch-counts.length > 1 ? root.catch-counts[1] : 0;
                            away-visible: root.synced && !root.away-dismissed && root.catch-chats > 0;
                            loading: root.connected && !root.synced && root.chats-main.length == 0 && root.chats-favorites.length == 0 && root.chats-channels.length == 0;
                            catch-up => { root.catch-up(0); }
                            dismiss-away => { root.away-dismissed = true; }
                            mark-unread(id) => { root.mark-chat-unread(id); }
                            mark-all-read => { root.mark-all-read(); }
                            leave-chat(id) => { PeopleStore.leave-confirm = id; }
                            new-chat => {
                                PeopleStore.new-chat-open = true;
                                PeopleStore.command("new-chat-open", "");
                            }
                            meet-now => { root.meet-now(""); }
                            manage-teams => { TeamsStore.open = true; TeamsStore.command("open", ""); }
                            open-community(id) => { EngageStore.open = true; EngageStore.command("open", id); }
                            select-chat(id) => { FindStore.quick-open = false; root.select-chat(id); }
                            select-channel(id, title) => { FindStore.quick-open = false; root.select-channel(id, title); }
                            toggle-team(i) => { root.toggle-team(i); }
                            toggle-favorite(id) => { root.toggle-favorite(id); }
                            set-filter(f) => { root.set-filter(f); }
                            quick-view(kind) => { FindStore.command("quick", kind); }
                        }

                        // The divider: drag to resize the list, as in Teams.
                        if root.view != "search" && !root.single-pane: Rectangle {
                            width: 5px;
                            background: list-split.pressed || list-split.has-hover ? Theme.accent : Theme.border;
                            accessible-role: slider;
                            accessible-label: @tr("Chat list width");
                            accessible-value: round(root.sidebar-width / 1px);
                            accessible-value-minimum: 220;
                            accessible-value-maximum: 600;
                            accessible-action-increment => { root.sidebar-width = min(600px, root.sidebar-width + 20px); }
                            accessible-action-decrement => { root.sidebar-width = max(220px, root.sidebar-width - 20px); }
                            list-split := TouchArea {
                                mouse-cursor: col-resize;
                                moved => {
                                    if self.pressed {
                                        root.sidebar-width = max(220px, min(600px, root.sidebar-width + self.mouse-x - self.pressed-x));
                                    }
                                }
                            }
                        }

                        // Conversation (in one-pane mode, not while the list has the window)
                        if !(root.list-only && root.view != "search"): Rectangle {
                            background: Theme.main;
                            if root.view == "search": SearchView {
                                z: 40;
                                width: parent.width;
                                height: parent.height;
                                close => { root.view = "chat"; }
                            }
                            if FindStore.quick-open && root.view == "chat": QuickView {
                                z: 18;
                                width: parent.width;
                                height: parent.height;
                                close => { FindStore.quick-open = false; FindStore.command("quick-close", ""); root.palette-done(); }
                            }
                            if PeopleStore.new-chat-open && root.view != "activity": NewChatPane {
                                z: 30;
                                width: parent.width;
                                height: parent.height;
                                to: PeopleStore.new-chat-to;
                                results: PeopleStore.new-chat-results;
                                hint: PeopleStore.new-chat-hint;
                                query(q) => { PeopleStore.command("new-chat-query", q); }
                                add(id) => { PeopleStore.command("new-chat-add", id); }
                                remove(id) => { PeopleStore.command("new-chat-remove", id); }
                                name(n) => { PeopleStore.command("new-chat-name", n); }
                                send(t) => { PeopleStore.command("new-chat-send", t); }
                                close => {
                                    PeopleStore.new-chat-open = false;
                                    PeopleStore.command("new-chat-close", "");
                                }
                            }
                            if root.current-id == "" && !root.teams-no-channel: VerticalLayout {
                                alignment: center;
                                Image { source: @image-url("icons/chat.svg"); colorize: Theme.border; width: 96px; height: 96px; x: (parent.width - 96px) / 2; }
                                Text { text: @tr("Select a chat to start messaging"); color: Theme.fg-subtle; horizontal-alignment: center; }
                            }
                            if root.teams-no-channel: VerticalLayout {
                                alignment: center;
                                Image { source: @image-url("icons/teams.svg"); colorize: Theme.border; width: 96px; height: 96px; x: (parent.width - 96px) / 2; }
                                Text { text: @tr("Pick a channel"); color: Theme.fg-subtle; horizontal-alignment: center; }
                            }
                            if root.banner != "": NoticeBanner {
                                z: 10;
                                banner: root.banner;
                                banner-action: root.banner-action;
                                banner-action-clicked => { root.banner-action-clicked(); }
                                banner-info: root.banner-info;
                                dismiss-banner => { root.dismiss-banner(); }
                                area-width: parent.width;
                            }
                            if root.current-id != "" && !root.teams-no-channel: VerticalLayout {
                                // Header. When it is narrow (half a laptop screen), participants, find,
                                // details and Schedule a meeting move into the … menu so the name stays readable.
                                ChatPaneHeader {
                                    close-thread => { root.close-thread(); }
                                    current-avatar: root.current-avatar;
                                    current-color: root.current-color;
                                    current-has-avatar: root.current-has-avatar;
                                    current-id: root.current-id;
                                    current-initials: root.current-initials;
                                    current-is-channel: root.current-is-channel;
                                    current-meeting-live: root.current-meeting-live;
                                    current-muted: root.current-muted;
                                    current-person: root.current-person;
                                    current-presence: root.current-presence;
                                    current-title: root.current-title;
                                    header-glyph: root.header-glyph;
                                    mark-chat-unread(a0) => { root.mark-chat-unread(a0); }
                                    meet-now(a0) => { root.meet-now(a0); }
                                    pane-list <=> root.pane-list;
                                    rename-text <=> root.rename-text;
                                    renaming <=> root.renaming;
                                    schedule-meeting(a0) => { root.schedule-meeting(a0); }
                                    single-pane: root.single-pane;
                                    thread-root: root.thread-root;
                                    can-split: root.split-fits;
                                }

                                if FindStore.chat-find-open && root.thread-root == "": ChatFindBar { channel: root.current-is-channel; }

                                if PeopleStore.pinned.length > 0 && root.thread-root == "": PinnedBanner {
                                    items: PeopleStore.pinned;
                                    index <=> PeopleStore.pinned-index;
                                    jump(id) => { PeopleStore.command("pin-jump", id); }
                                    unpin(id) => { PeopleStore.command("pin-unpin", id); }
                                }

                                // Messages
                                MessagePane {
                                    anchor-index: root.anchor-index;
                                    anchor-off: root.anchor-off;
                                    anchor-tick: root.anchor-tick;
                                    top-id <=> root.msg-top-id;
                                    top-off <=> root.msg-top-off;
                                    top-cy <=> root.msg-top-cy;
                                    view-y <=> root.msg-view-y;
                                    at-bottom <=> root.at-bottom;
                                    at-bottom-changed(a0) => { root.at-bottom-changed(a0); }
                                    current-is-channel: root.current-is-channel;
                                    current-title: root.current-title;
                                    discard-send(a0) => { root.discard-send(a0); }
                                    divider-index: root.divider-index;
                                    divider-tick: root.divider-tick;
                                    edit(a0) => { root.edit(a0); }
                                    focus-tick <=> root.focus-tick;
                                    jump-to-message(a0) => { PeopleStore.command("quote-jump", a0); }
                                    jump-to-newest => { root.jump-to-newest(); }
                                    load-older => { root.load-older(); }
                                    rows-shown(a0, a1) => { root.rows-shown(a0, a1); }
                                    loading-latest: root.loading-latest;
                                    loading-older: root.loading-older;
                                    loading-progress: root.loading-progress;
                                    menu-msg <=> root.menu-msg;
                                    menu-open <=> root.menu-open;
                                    menu-preview <=> root.menu-preview;
                                    menu-x <=> root.menu-x;
                                    menu-y <=> root.menu-y;
                                    messages: root.messages;
                                    msg-focus-tick: root.msg-focus-tick;
                                    new-count: root.new-count;
                                    open-thread(a0) => { root.open-thread(a0); }
                                    open-url(a0) => { root.open-url(a0); }
                                    picker-msg-id <=> root.picker-msg-id;
                                    picker-open <=> root.picker-open;
                                    picker-search(a0) => { root.picker-search(a0); }
                                    picker-x <=> root.picker-x;
                                    picker-y <=> root.picker-y;
                                    posts-mode: root.posts-mode;
                                    react(a0, a1) => { root.react(a0, a1); }
                                    readers-bottom <=> root.readers-bottom;
                                    readers-msg <=> root.readers-msg;
                                    readers-open <=> root.readers-open;
                                    readers-top <=> root.readers-top;
                                    readers-x <=> root.readers-x;
                                    reply(a0) => { root.reply(a0); }
                                    retry-send(a0) => { root.retry-send(a0); }
                                    scroll-tick <=> root.scroll-tick;
                                    select-mode: root.select-mode;
                                    thread-root: root.thread-root;
                                    toggle-select(a0) => { root.toggle-select(a0); }
                                    unavailable: root.unavailable;
                                    unavailable-text: root.unavailable-text;
                                    unread-count: root.unread-count;
                                    unread-index: root.unread-index;
                                }

                                // The chat's scheduled messages ("Sending on …"), below the newest message.
                                if SendStore.scheduled.length > 0 && root.thread-root == "" && !root.posts-mode: ScheduledList {
                                    max-bubble: min(720px, parent.width * 0.75);
                                }

                                TypingIndicator { }

                                if root.select-mode: SelectBar {
                                    count: root.select-count;
                                    forward => {
                                        root.forward-count = root.select-count;
                                        root.forward-preview-author = "";
                                        root.forward-preview-text = "";
                                        root.forward-open = true;
                                        root.forward-begin-selected();
                                    }
                                    cancel => {
                                        root.select-mode = false;
                                        root.select-cancel();
                                    }
                                }

                                if root.posts-mode && ChannelStore.compose-open: AnnouncementBar { }

                                // Composer
                                if (!root.posts-mode || ChannelStore.compose-open) && !root.unavailable && !root.opening: Composer {
                                    vertical-stretch: 0;
                                    // The split pane takes its share of the window from the composer.
                                    window-width: root.split-shown ? root.width - root.split-width - 5px : root.width;
                                    current-is-channel: root.current-is-channel;
                                    thread-root: root.thread-root;
                                    reply-author: root.reply-author;
                                    reply-preview: root.reply-preview;
                                    editing-id: root.editing-id;
                                    draft <=> root.draft;
                                    post-subject <=> root.post-subject;
                                    focus-tick <=> root.focus-tick;
                                    enter-sends <=> root.enter-sends;
                                    expanded <=> root.composer-expanded;
                                    important <=> root.important;
                                    urgent <=> root.urgent;
                                    input-focus(f) => {
                                        root.composer-focused = f;
                                        if f { SplitStore.active = false; }
                                    }
                                    edit-last => {
                                        if ShortcutApi.last-own(root.messages) != "" { root.edit(ShortcutApi.last-own(root.messages)); }
                                    }
                                    set-enter-sends(on) => { root.set-enter-sends(on); }
                                    skin-tone <=> root.skin-tone;
                                    recent-emoji: root.recent-emoji;
                                    pending-attachments: root.pending-attachments;
                                    paste-image => { root.paste-image(); }
                                    remove-attachment(i) => { root.remove-attachment(i); }
                                    cursor-tick: root.cursor-tick;
                                    emoji-used(e) => { root.emoji-used(e); }
                                    skin-tone-changed(t) => { root.skin-tone-changed(t); }
                                    send(text) => {
                                        if root.posts-mode && ChannelStore.announcement {
                                            ChannelStore.command("announce", root.post-subject + "\u{9}" + ChannelStore.headline + "\u{9}" + ChannelStore.theme + "\u{9}" + text);
                                        } else {
                                            root.send(text);
                                        }
                                        if root.posts-mode {
                                            ChannelStore.compose-open = false;
                                            ChannelStore.announcement = false;
                                            ChannelStore.headline = "";
                                        }
                                    }
                                    typing-tick => { root.typing-tick(); }
                                    draft-edited(text) => { root.draft-edited(text); }
                                    cancel-reply => { root.cancel-reply(); }
                                    attach-image => { root.attach-image(); }
                                    attach-file => { root.attach-file(); }
                                    attach-cloud => { DriveStore.command("pick-begin", "attach"); }
                                }
                            }
                            if root.current-id != "" && FindStore.chat-tab == "storyline" && root.view != "activity": StorylineView {
                                z: 8;
                                y: 60px;
                                width: parent.width;
                                height: parent.height - 60px;
                            }
                            // The Shared (Files) tab and the details pane sit below the 60px header.
                            if root.current-id != "" && !root.teams-no-channel && FindStore.chat-tab == "shared" && root.view != "activity": SharedView {
                                z: 8;
                                y: 60px;
                                width: parent.width;
                                height: parent.height - 60px;
                            }
                            // A meeting chat's Recap tab (the Meeting Recaps recap page).
                            if root.current-id != "" && !root.teams-no-channel && FindStore.chat-tab == "recap" && root.view != "activity": RecapsChatPane {
                                z: 8;
                                y: 60px;
                                width: parent.width;
                                height: parent.height - 60px;
                            }
                            if root.current-id != "" && !root.teams-no-channel && FindStore.details-open && root.thread-root == "" && root.view != "activity": DetailsPane {
                                z: 9;
                                x: parent.width - self.width;
                                y: 60px;
                                height: parent.height - 60px;
                                title: root.current-title;
                            }
                            if root.file-hover && root.accepts-files: DropZone {
                                z: 25;
                                width: parent.width;
                                height: parent.height;
                            }
                        }

                        // The split view: its divider drags the pane's width.
                        if root.split-shown: Rectangle {
                            width: 5px;
                            background: split-drag.pressed || split-drag.has-hover ? Theme.accent : Theme.border;
                            accessible-role: slider;
                            accessible-label: @tr("Split view width");
                            accessible-value: round(root.split-width / 1px);
                            accessible-action-increment => { SplitStore.width = root.split-width + 20px; }
                            accessible-action-decrement => { SplitStore.width = max(300px, root.split-width - 20px); }
                            split-drag := TouchArea {
                                mouse-cursor: col-resize;
                                moved => {
                                    if self.pressed {
                                        SplitStore.width = max(300px, min(root.chat-room - 5px - 360px, root.split-width - (self.mouse-x - self.pressed-x)));
                                    }
                                }
                            }
                        }
                        if root.split-shown: ChatColumn {
                            width: root.split-width;
                            chat-title: SplitStore.title;
                            messages: SplitStore.messages;
                            draft <=> SplitStore.draft;
                            scroll-tick: SplitStore.scroll-tick;
                            focus-tick: SplitStore.focus-tick;
                            closable: true;
                            active: SplitStore.active;
                            take-focus: SplitStore.active;
                            send(t) => { MediaStore.command("split-send", SplitStore.conv-id + "\u{1f}" + t); }
                            react(id, k) => { root.react(id, k); }
                            open-url(u) => { root.open-url(u); }
                            activated => { SplitStore.active = true; }
                            close => { root.close-split(); }
                        }
                    }
                }
                // At least as large as their content needs, as the layout they were in gave them.
                if root.view == "calendar": CalendarView {
                    x: 0px;
                    y: 0px;
                    width: max(parent.width, self.min-width);
                    height: max(parent.height, self.min-height);
                    window-width: root.width;
                }
                if root.view == "onedrive": OneDriveView {
                    x: 0px;
                    y: 0px;
                    width: max(parent.width, self.min-width);
                    height: max(parent.height, self.min-height);
                    window-width: root.width;
                }
                if root.view == "calls": CallsPage {
                    x: 0px;
                    y: 0px;
                    width: max(parent.width, self.min-width);
                    height: max(parent.height, self.min-height);
                    window-width: root.width;
                    open-chat(mri) => {
                        root.view = "chat";
                        CallsPageStore.command("chat", mri);
                    }
                    view-contacts => {
                        root.view = "search";
                        FindStore.command("search-tab", "people");
                        FindStore.focus-tick += 1;
                    }
                }

                if root.view == "activity": ActivityView {
                    width: parent.width;
                    height: parent.height;
                    items: root.activity-items;
                    unread-count: root.activity-unread;
                    filter <=> root.activity-filter;
                    selected-id <=> root.activity-selected;
                    preview-id: root.activity-preview-id;
                    preview-title: root.activity-preview-title;
                    preview-location: root.activity-preview-location;
                    preview-is-channel: root.activity-preview-is-channel;
                    preview-loading: root.activity-preview-loading;
                    loading: root.connected && !root.synced;
                    preview: root.activity-preview;
                    highlight: root.activity-highlight;
                    banner: root.banner;
                    select(id) => { root.activity-select(id); }
                    set-filter(f) => { root.activity-set-filter(f); }
                    search(q) => { root.activity-search(q); }
                    mark(id, read) => { root.activity-mark(id, read); }
                    mark-all => { root.activity-mark-all(); }
                    go-to => { root.view = "chat"; root.activity-go-to(); }
                    send-reply(t) => { root.activity-reply(t); }
                    open-url(u) => { root.open-url(u); }
                    react(id, k) => { root.react(id, k); }
                    more-reactions(id, x, y) => {
                        root.picker-msg-id = id;
                        root.picker-x = x;
                        root.picker-y = y;
                        root.picker-open = true;
                        root.picker-search("");
                    }
                    menu(m, x, y) => {
                        root.menu-msg = m;
                        root.menu-preview = true;
                        root.menu-x = x;
                        root.menu-y = y;
                        root.menu-open = true;
                    }
                    notification-settings => { root.activity-settings(); }
                    open-later => {
                        RemindStore.later-open = true;
                        RemindStore.command("refresh", "");
                    }
                    dismiss-banner => { root.dismiss-banner(); }
                }
            }
        }
    }
    }

    // The chat popups (message menu, Seen by list, reaction picker) draw above the floating call
    // window (z 45), which can sit over the message they were opened from.
    if root.login-state == "ready" && root.menu-open: MessageMenuLayer {
        z: 46;
        width: root.width;
        height: root.height;
        copy-link(a0) => { root.copy-link(a0); }
        current-is-channel: root.current-is-channel;
        delete(a0) => { root.delete(a0); }
        edit(a0) => { root.edit(a0); }
        focus-tick <=> root.focus-tick;
        forward-begin(a0) => { root.forward-begin(a0); }
        forward-count <=> root.forward-count;
        forward-open <=> root.forward-open;
        forward-preview-author <=> root.forward-preview-author;
        forward-preview-text <=> root.forward-preview-text;
        mark-unread(a0) => { root.mark-unread(a0); }
        menu-h <=> root.menu-h;
        menu-left: root.menu-left;
        menu-msg: root.menu-msg;
        menu-open <=> root.menu-open;
        menu-preview: root.menu-preview;
        menu-top: root.menu-top;
        menu-w <=> root.menu-w;
        open-url(a0) => { root.open-url(a0); }
        pin(a0) => { root.pin(a0); }
        posts-mode: root.posts-mode;
        reader-msg <=> root.reader-msg;
        reader-open <=> root.reader-open;
        readers-bottom <=> root.readers-bottom;
        readers-msg <=> root.readers-msg;
        readers-open <=> root.readers-open;
        readers-top <=> root.readers-top;
        readers-x <=> root.readers-x;
        reply(a0) => { root.reply(a0); }
        select-begin(a0) => { root.select-begin(a0); }
        select-mode <=> root.select-mode;
        thread-root: root.thread-root;
        toggle-save(a0) => { root.toggle-save(a0); }
    }

    if root.login-state == "ready" && root.readers-open: SeenByLayer {
        z: 46;
        width: root.width;
        height: root.height;
        focus-tick <=> root.focus-tick;
        readers-h <=> root.readers-h;
        readers-left: root.readers-left;
        readers-msg: root.readers-msg;
        readers-open <=> root.readers-open;
        readers-y: root.readers-y;
    }

    if root.login-state == "ready" && root.reader-open: ImmersiveReader {
        z: 190;
        width: root.width;
        height: root.height;
        sender: root.reader-msg.sender;
        time: root.reader-msg.time;
        text: root.reader-msg.plain;
        rtl: root.reader-msg.rtl;
        close => { root.reader-open = false; }
    }

    if root.login-state == "ready" && root.shortcuts-open: ShortcutsDialog {
        z: 200;
        width: root.width;
        height: root.height;
        close => { root.shortcuts-open = false; }
        open-palette => { root.shortcuts-open = false; PaletteStore.open = true; }
        open-settings => { root.shortcuts-open = false; SettingsStore.show("shortcuts"); }
    }

    if root.login-state == "ready" && PaletteStore.open: CommandPalette {
        z: 210;
        width: root.width;
        height: root.height;
        chats-favorites: root.chats-favorites;
        chats-main: root.chats-main;
        chats-channels: root.chats-channels;
        run(item) => { root.run-palette(item); }
        close => { PaletteStore.open = false; root.palette-done(); }
    }

    if root.login-state == "ready" && root.picker-open: ReactionPickerLayer {
        // Above Settings (60) when it is choosing a quick reaction.
        z: root.picker-msg-id == "quick-slot" ? 65 : 46;
        width: root.width;
        height: root.height;
        picker-items: root.picker-items;
        picker-msg-id: root.picker-msg-id;
        picker-open <=> root.picker-open;
        picker-search(a0) => { root.picker-search(a0); }
        picker-x: root.picker-x;
        picker-y: root.picker-y;
        react(a0, a1) => {
            if a0 == "quick-slot" {
                SettingsStore.command("quick-reaction", "" + SettingsStore.quick-slot + ":" + a1);
            } else {
                root.react(a0, a1);
            }
        }
    }

    if root.login-state == "ready" && root.forward-open: ForwardLayer {
        width: root.width;
        height: root.height;
        forward-cancel => { root.forward-cancel(); }
        forward-count: root.forward-count;
        forward-open <=> root.forward-open;
        forward-picked: root.forward-picked;
        forward-preview-author: root.forward-preview-author;
        forward-preview-text: root.forward-preview-text;
        forward-results: root.forward-results;
        forward-search(a0) => { root.forward-search(a0); }
        forward-send(a0) => { root.forward-send(a0); }
        forward-toggle(a0) => { root.forward-toggle(a0); }
    }

    if root.login-state == "ready" && PeopleStore.participants-open: ParticipantsLayer {
        width: root.width;
        height: root.height;
        current-id: root.current-id;
    }

    if root.login-state == "ready" && PeopleStore.leave-confirm != "": LeaveChatLayer {
        width: root.width;
        height: root.height;
    }

    if root.login-state == "ready" && ChatHeaderStore.remove-history != "": RemoveHistoryLayer {
        width: root.width;
        height: root.height;
    }

    if root.login-state == "ready" && FindStore.tab-menu-id != "": ChannelTabOverlays {
        width: root.width;
        height: root.height;
    }

    if root.login-state == "ready" && FindStore.tab-add-open: AddTabLayer {
        width: root.width;
        height: root.height;
    }

    // Resting on a photo opens its person's card next to it, as in Teams. The timer lives here,
    // not in the list row, so a row rebuilt by a new message does not lose the rest.
    Timer {
        interval: 600ms;
        running: root.login-state == "ready" && PeopleStore.hover-id != "" && PeopleStore.hover-armed;
        triggered => {
            PeopleStore.hover-armed = false;
            if !PeopleStore.card-open || (PeopleStore.card-by-hover && PeopleStore.card.id != PeopleStore.hover-id) {
                PeopleStore.open-card(PeopleStore.hover-id, PeopleStore.hover-x, PeopleStore.hover-y, PeopleStore.hover-w, PeopleStore.hover-h, true);
            }
        }
    }
    // A card opened from somewhere else (no photo) opens in the middle.
    property <bool> card-shown: PeopleStore.card-open;
    changed card-shown => {
        if !self.card-shown { PeopleStore.anchor-w = 0; }
    }
    // A hover card opened from a dropdown row goes with the dropdown, however it closes.
    property <bool> search-shown: TopBarStore.search-open;
    changed search-shown => {
        if !self.search-shown && PeopleStore.card-open && PeopleStore.card-by-hover {
            PeopleStore.card-open = false;
            PeopleStore.hover-id = "";
            PeopleStore.hover-armed = false;
        }
    }
    property <string> hover-chat: root.current-id;
    changed hover-chat => {
        PeopleStore.hover-id = "";
        PeopleStore.hover-armed = false;
    }

    // Who reacted, under the chip being hovered (above every message row).
    if ReactionHover.open: ReactionCard {
        win-w: root.width;
        win-h: root.height;
    }

    if root.login-state == "ready" && PeopleStore.card-open: ProfileCardLayer {
        z: PeopleStore.card-by-hover && TopBarStore.search-open ? 66 : 50;
        width: root.width;
        height: root.height;
        card-h <=> root.card-h;
        card-left <=> root.card-left;
        card-top <=> root.card-top;
        card-w <=> root.card-w;
        open-url(a0) => { root.open-url(a0); }
    }

    // The full profile, opened from the card (Teams opens the same window).
    if root.login-state == "ready" && PeopleStore.profile-open: ProfileModal {
        width: root.width;
        height: root.height;
        z: 70;
        close => { PeopleStore.profile-open = false; }
        chat(id) => {
            PeopleStore.profile-open = false;
            PeopleStore.card-open = false;
            PeopleStore.command("profile-chat", id);
        }
        video(id) => {
            WebParityStore.notice = @tr("Video calls aren't available in IronTeams yet.");
        }
        copy-email => { PeopleStore.command("profile-copy-email", ""); }
        quick-message(t) => {
            PeopleStore.profile-open = false;
            PeopleStore.command("profile-message", t);
        }
        call-number(n) => { root.open-url("tel:" + n); }
    }

    if root.login-state == "ready" && ListStore.dialog == "leave-channel": LeaveChannelLayer {
        width: root.width;
        height: root.height;
    }

    if root.login-state == "ready" && RemindStore.open: RemindLayer {
        width: root.width;
        height: root.height;
    }

    if root.login-state == "ready" && (ListStore.dialog == "new-section" || ListStore.dialog == "rename-section"): SectionDialogLayer {
        // Above Settings (z 60): its Chats page has a "New section" button.
        z: 80;
        width: root.width;
        height: root.height;
    }

    // The OneDrive file picker, opened from the composer's "Attach cloud files" (the OneDrive view
    // draws its own).
    if root.login-state == "ready" && root.view != "onedrive" && DriveStore.dialog == "picker": DrivePickerLayer {
        width: root.width;
        height: root.height;
    }
    // Teams management: the "Your teams and channels" page covers the area right of the rail, and
    // its dialogs cover the window (see teams_page.slint and teams_dialogs.slint).
    if root.login-state == "ready" && TeamsStore.open: TeamsPage {
        x: AppsStore.rail-width;
        y: 48px;
        z: 40;
        width: root.width - AppsStore.rail-width;
        height: root.height - 48px;
        go(id, title) => {
            TeamsStore.open = false;
            root.view = "teams";
            root.select-channel(id, title);
        }
    }
    // Later: reminders and saved messages in one list, over the area right of the rail.
    if root.login-state == "ready" && RemindStore.later-open: LaterPage {
        x: AppsStore.rail-width;
        y: 48px;
        z: 40;
        width: root.width - AppsStore.rail-width;
        height: root.height - 48px;
    }
    // Viva Engage: a community's read-only feed covers the area right of the rail.
    if root.login-state == "ready" && EngageStore.open && (root.view == "chat" || root.view == "teams"): EngageView {
        x: 68px;
        y: 48px;
        z: 41;
        width: root.width - 68px;
        height: root.height - 48px;
    }
    if root.login-state == "ready" && TeamsStore.dialog != "": TeamsDialogs {
        z: 50;
        width: root.width;
        height: root.height;
    }

    // The app screens (Store, Planner, Workflows, OneNote, Lists, app pages) cover the area right
    // of the rail while the view is one of theirs; the overlays hold the app bar's flyout, its
    // right click menu and the install request dialog.
    if root.login-state == "ready" && AppsStore.owns(root.view): AppsHost {
        x: AppsStore.rail-width;
        y: 48px + (CalStore.join-text != "" ? 40px : 0px);
        width: root.width - AppsStore.rail-width;
        height: root.height - self.y;
        view: root.view;
    }

    // Above Settings (z 60): a right click on a rail icon opens its menu while Settings is open.
    if root.login-state == "ready": AppsOverlays {
        z: 61;
        width: root.width;
        height: root.height;
    }
    if root.login-state == "ready" && SettingsStore.open: SettingsPage {
        x: AppsStore.rail-width;
        y: 48px;
        z: 60;
        width: root.width - AppsStore.rail-width;
        height: root.height - 48px;
        enter-sends: root.enter-sends;
        set-enter-sends(on) => { root.enter-sends = on; root.set-enter-sends(on); }
        // Chats > Quick reactions: the reaction picker chooses for a slot instead of reacting.
        pick-quick-reaction(slot, x, y) => {
            SettingsStore.quick-slot = slot;
            root.picker-msg-id = "quick-slot";
            root.picker-x = x;
            root.picker-y = y;
            root.picker-open = true;
            root.picker-search("");
        }
    }
    // The account switch's question, above Settings and the profile menu it can come from.
    if root.login-state == "ready" && SettingsStore.switch-confirm-open: SwitchConfirmLayer {
        z: 75;
        width: root.width;
        height: root.height;
    }
    if root.login-state == "ready" && SettingsStore.profile-open: ProfileMenu {
        z: 70;
        width: root.width;
        height: root.height;
        init => { root.profile-h = self.panel-height; root.profile-left = self.hit-left; }
        changed panel-height => { root.profile-h = self.panel-height; }
        changed hit-left => { root.profile-left = self.hit-left; }
    }

    // The search box's dropdown: a layer below the top bar that closes it, and the list itself.
    if root.login-state == "ready" && TopBarStore.search-open: Rectangle {
        y: 48px;
        z: 64;
        width: root.width;
        height: root.height - 48px;
        TouchArea { clicked => { TopBarStore.command("close", ""); } }
    }
    if root.login-state == "ready" && TopBarStore.search-open: SearchDropdown {
        z: 65;
        x: max(8px, min(TopBarStore.box-x, root.width - self.width - 8px));
        y: 44px;
    }
    // The "…" menu next to the avatar.
    if root.login-state == "ready" && TopBarStore.more-open: MoreMenu {
        z: 70;
        width: root.width;
        height: root.height;
        show-shortcuts => { root.shortcuts-open = true; }
        open-saved => { root.navigate("chat"); FindStore.command("quick", "saved"); }
        init => { root.more-h = self.panel-height; }
        changed panel-height => { root.more-h = self.panel-height; }
    }

    // The call window (pre-join, meeting, call ended) covers the area right of the rail; while the meeting chat is open it is a floating bar.
    if root.login-state == "ready" && CallStore.phase != "" && !CallStore.minimized: CallWindow { x: CallStore.fullscreen ? 0px : AppsStore.rail-width; y: CallStore.fullscreen ? 0px : 48px; z: 45; width: CallStore.fullscreen ? root.width : root.width - AppsStore.rail-width; height: CallStore.fullscreen ? root.height : root.height - 48px; open-chat => { CallStore.minimized = true; root.view = "chat"; root.select-chat(CallStore.chat-id); } }
    if root.login-state == "ready" && CallStore.phase != "" && CallStore.minimized: CallMini { x: clamp(root.width - self.width - 16px + CallStore.mini-dx, AppsStore.rail-width, root.width - self.width); y: clamp(root.height - self.height - 16px + CallStore.mini-dy, 48px, root.height - self.height); z: 45; }

    // The full-size picture viewer (plan chat 9.5), above everything else.
    if root.login-state == "ready" && MediaStore.viewer-open: ImageViewer {
        z: 60;
        width: root.width;
        height: root.height;
    }

    // The composer's apps picker (the "+" button).
    if root.login-state == "ready": ComposerAppsOverlay {
        width: root.width;
        height: root.height;
        meetings: root.current-id != "" && !root.current-is-channel && root.thread-root == "";
        schedule-meeting => { root.schedule-meeting(root.current-id); }
        meet-now => { root.meet-now(PeopleStore.header-group ? root.current-title : ""); }
    }
    // What IronTeams cannot do yet, said plainly (see `WebParityStore`).
    if root.login-state == "ready" && WebParityStore.notice != "": ParityNotice {
        z: 70;
        width: min(root.width - 32px, 560px);
        x: (root.width - self.width) / 2;
        y: root.height - self.height - 16px;
    }
    // 1:1 calls: the ringing screen of an outgoing call and the incoming-call toast, on top.
    if root.login-state == "ready" && DirectCallStore.outgoing-open: CallOutgoing { z: 80; width: root.width; height: root.height; }
    if root.login-state == "ready" && DirectCallStore.incoming-open && DirectCallStore.incoming-shown: CallIncoming { z: 90; x: root.width - self.width - 20px; y: root.height - self.height - 20px; }
    // Message cards (a new message while this window is the active one), above the call window and
    // the stage; an incoming-call toast keeps the corner and the cards sit above it.
    if root.login-state == "ready" && MessageToastStore.toasts.length > 0: MessageToasts { z: 95; x: root.width - self.width - 20px; y: root.height - self.height - 20px - (DirectCallStore.incoming-open && DirectCallStore.incoming-shown ? 240px : 0px); }
}
