// A row of a flyout that opens something more: its label and a chevron at the end.
import { Theme } from "../tokens/theme.slint";
import { Icon } from "widgets.slint";

export component LinkRow inherits Rectangle {
    in property <string> label;
    callback clicked();
    height: 34px;
    border-radius: 4px;
    background: touch.has-hover ? Theme.surface-hover : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        Text {
            text: root.label;
            color: Theme.fg;
            font-size: 13px * Theme.font-scale;
            overflow: elide;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        VerticalLayout {
            alignment: center;
            Icon {
                source: @image-url("../icons/chevron-right.svg");
                tint: Theme.fg-muted;
                width: 14px;
                height: 14px;
            }
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}
