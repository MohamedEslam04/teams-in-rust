// A file's kind as a small coloured tag (W, X, P, PDF…) or a folder, as OneDrive draws it.
import { Theme } from "../tokens/theme.slint";
import { Fixed } from "../tokens/fixed.slint";
import { Tokens } from "../tokens/types.slint";
import { Icon } from "widgets.slint";

export global DriveLook {
    pure public function color(kind: string) -> color {
        kind == "word" ? Fixed.file-word
        : kind == "excel" ? Fixed.file-excel
        : kind == "powerpoint" ? Fixed.file-powerpoint
        : kind == "pdf" ? Fixed.file-pdf
        : kind == "image" ? Fixed.file-image
        : kind == "video" ? Fixed.file-media
        : kind == "audio" ? Fixed.file-media
        : kind == "markdown" ? Fixed.file-text
        : kind == "text" ? Fixed.file-text
        : kind == "code" ? Fixed.file-text
        : kind == "archive" ? Fixed.file-archive
        : Fixed.file-other
    }
    pure public function tag(kind: string) -> string {
        kind == "word" ? "W"
        : kind == "excel" ? "X"
        : kind == "powerpoint" ? "P"
        : kind == "pdf" ? "PDF"
        : kind == "image" ? "IMG"
        : kind == "video" ? "▶"
        : kind == "audio" ? "♪"
        : kind == "markdown" ? "MD"
        : kind == "text" ? "TXT"
        : kind == "code" ? "</>"
        : kind == "archive" ? "ZIP"
        : ""
    }
    out property <length> col-modified: 110px;
    out property <length> col-modified-by: 130px;
    out property <length> col-size: 84px;
    out property <length> col-location: 170px;
    out property <length> col-activity: 200px;
}

export component KindBadge inherits Rectangle {
    in property <Tokens> c: Theme.content;
    in property <string> kind;
    in property <length> size: 24px;
    width: root.size;
    height: root.size;
    if root.kind == "folder": Icon {
        c: root.c;
        source: @image-url("../icons/folder.svg");
        tint: Fixed.folder;
        width: root.size;
        height: root.size;
    }
    if root.kind != "folder": Rectangle {
        width: root.size * 0.82;
        height: root.size * 0.82;
        x: (root.size - self.width) / 2;
        y: (root.size - self.height) / 2;
        border-radius: 3px;
        background: DriveLook.color(root.kind);
        Text {
            text: DriveLook.tag(root.kind);
            color: Fixed.white;
            font-size: root.size * 0.34;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
