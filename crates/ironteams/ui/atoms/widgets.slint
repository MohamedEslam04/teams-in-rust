import { Theme } from "../tokens/theme.slint";
import { ReactionItem, Tokens } from "../tokens/types.slint";
import { Motion } from "../tokens/motion.slint";
import { ReactionHover } from "reaction_hover.slint";

export component Icon inherits Image {
    in property <Tokens> c: Theme.content;
    in property <color> tint: root.c.fg-muted;
    width: 20px;
    height: 20px;
    colorize: tint;
    image-fit: contain;
}

export component IconButton inherits Rectangle {
    in property <Tokens> c: Theme.content;
    in property <image> icon;
    in property <string> tooltip;
    in property <length> size: 32px;
    in property <color> tint: root.c.fg-muted;
    in property <bool> active: false;
    callback clicked();
    width: size;
    height: size;
    border-radius: 4px;
    background: touch.has-hover || active ? root.c.surface-hover : transparent;
    animate background { duration: Motion.quick; }
    accessible-role: button;
    accessible-label: root.tooltip;
    accessible-action-default => { root.clicked(); }
    Icon {
        c: root.c;
        source: root.icon;
        tint: touch.has-hover || root.active ? root.c.accent : root.tint;
        animate tint { duration: Motion.quick; }
        // A press nudges the glyph in.
        transform-scale: touch.pressed ? 0.88 : 1.0;
        animate transform-scale { duration: Motion.quick; }
        width: root.size * 0.6;
        height: root.size * 0.6;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A collapsible section of the chat list (Quick views, Favorites, Groups…), drawn as Teams does:
// a chevron that points down while the section is open and right while it is folded, a quieter
// semibold label, and a hover highlight. The chevron swaps its picture rather than rotating:
// a rotation on the Icon wrapper was not drawn, so an open section kept pointing right.
export component SectionHeader inherits Rectangle {
    in property <Tokens> c: Theme.content;
    in property <string> label;
    in-out property <bool> expanded: true;
    // A "…" on the right while the pointer rests on the header (and on a right click), for a
    // menu the owner draws: `more-clicked` asks it to open.
    in property <bool> more: false;
    in property <string> more-label;
    callback more-clicked();
    height: 32px;
    border-radius: 4px;
    background: touch.has-hover ? root.c.surface-hover : transparent;
    animate background { duration: Motion.quick; }
    accessible-role: button;
    accessible-label: root.label;
    accessible-expandable: true;
    accessible-expanded: root.expanded;
    accessible-action-default => { Motion.toggled = true; root.expanded = !root.expanded; }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 6px;
        Icon {
            c: root.c;
            source: root.expanded ? @image-url("../icons/chevron-down.svg") : @image-url("../icons/chevron-right.svg");
            tint: touch.has-hover ? root.c.fg : root.c.fg-muted;
            width: 12px;
            height: 12px;
            y: (parent.height - 12px) / 2;
        }
        Text {
            text: root.label;
            color: touch.has-hover ? root.c.fg : root.c.fg-muted;
            font-size: 12px * Theme.font-scale;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { Motion.toggled = true; root.expanded = !root.expanded; }
        pointer-event(e) => {
            if root.more && e.button == PointerEventButton.right && e.kind == PointerEventKind.up {
                root.more-clicked();
            }
        }
        if root.more && touch.has-hover: IconButton {
            x: parent.width - 30px;
            y: (parent.height - 22px) / 2;
            size: 22px;
            icon: @image-url("../icons/more.svg");
            tooltip: root.more-label;
            clicked => { root.more-clicked(); }
        }
    }
}

export component ReactionChip inherits Rectangle {
    in property <Tokens> c: Theme.content;
    in property <ReactionItem> r;
    callback clicked();
    height: 24px;
    border-radius: 12px;
    border-width: 1px;
    border-color: r.mine ? root.c.accent : root.c.border;
    background: r.mine ? root.c.accent-subtle : root.c.surface;
    animate background { duration: Motion.quick; }
    // A reaction pops in (fade and grow, 150 ms).
    property <bool> shown: Theme.reduced-motion;
    opacity: root.shown ? 1.0 : 0.0;
    transform-scale: root.shown ? 1.0 : 0.8;
    animate opacity { duration: Motion.fast; easing: ease-out; }
    animate transform-scale { duration: Motion.fast; easing: ease-out; }
    init => { if Motion.scrolling { root.shown = true; } }
    Timer {
        interval: 16ms;
        running: !root.shown;
        triggered => { root.shown = true; }
    }
    accessible-role: button;
    accessible-label: root.r.name + ": " + root.r.names;
    accessible-action-default => { root.clicked(); }
    // Which hover card this chip opened (see `ReactionHover`).
    property <int> token;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 4px;
        Text { text: root.r.emoji; font-size: 13px * Theme.font-scale; vertical-alignment: center; }
        // As in Teams, the count only shows once more than one person reacted.
        if root.r.count > 1: count := Text { text: root.r.count; color: root.c.fg; font-size: 12px * Theme.font-scale; vertical-alignment: center; }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        // Who reacted opens in a card below the chip (reaction_card.slint).
        changed has-hover => {
            if self.has-hover {
                root.token = ReactionHover.enter(root.r.name, root.r.people, root.absolute-position.x, root.absolute-position.y, root.width, root.height);
            } else {
                ReactionHover.leave(root.token);
            }
        }
    }
    Timer {
        interval: 250ms;
        running: touch.has-hover;
        triggered => { ReactionHover.beat(root.token); }
    }
}

// The chip after the reactions: a smiley with a plus, in the chips' pill shape, that opens the
// reaction picker.
export component AddReactionChip inherits Rectangle {
    in property <Tokens> c: Theme.content;
    callback clicked();
    height: 24px;
    width: 32px;
    border-radius: 12px;
    border-width: 1px;
    border-color: root.c.border;
    background: touch.has-hover ? root.c.surface-hover : root.c.surface;
    animate background { duration: Motion.quick; }
    accessible-role: button;
    accessible-label: @tr("Add reaction");
    accessible-action-default => { root.clicked(); }
    Icon {
        c: root.c;
        source: @image-url("../icons/emoji-add.svg");
        tint: touch.has-hover ? root.c.accent : root.c.fg-muted;
        animate tint { duration: Motion.quick; }
        width: 16px;
        height: 16px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}
