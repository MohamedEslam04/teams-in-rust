// One radio choice of a flyout or a panel: a radio dot, the label, a hover highlight. The row is
// as wide as the list it sits in; the owner keeps which one is selected.
import { Theme } from "../tokens/theme.slint";

export component RadioRow inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    // A choice shown but not offered (dimmed, not picked); `tip` says why.
    in property <bool> enabled: true;
    in property <string> tip;
    callback picked();
    height: 32px;
    border-radius: 4px;
    background: touch.has-hover && root.enabled ? Theme.surface-hover : transparent;
    opacity: root.enabled ? 1.0 : 0.45;
    accessible-role: radio-button;
    accessible-label: root.label;
    accessible-checked: root.selected;
    accessible-enabled: root.enabled;
    accessible-description: root.tip;
    accessible-action-default => { if root.enabled { root.picked(); } }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 10px;
        VerticalLayout {
            width: 16px;
            alignment: center;
            Rectangle {
                width: 16px;
                height: 16px;
                border-radius: 8px;
                border-width: 1.5px;
                border-color: root.selected ? Theme.accent : Theme.fg-muted;
                if root.selected: Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: Theme.accent;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
        }
        Text {
            text: root.label;
            color: Theme.fg;
            font-size: 13px * Theme.font-scale;
            overflow: elide;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
    touch := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { if root.enabled { root.picked(); } }
    }
}
