// A slider from 0 to 100 on the theme's colours (the call menu's speaker volume). The owner keeps
// the value: `edited` says where it was dragged to, `released` that the drag ended.
import { Theme } from "../tokens/theme.slint";

export component RangeSlider inherits Rectangle {
    in property <float> value;
    in property <string> label;
    callback edited(float);
    callback released(float);
    height: 20px;
    accessible-role: slider;
    accessible-label: root.label;
    accessible-value: round(root.value);
    accessible-value-minimum: 0;
    accessible-value-maximum: 100;
    accessible-action-increment => { root.nudge(5); }
    accessible-action-decrement => { root.nudge(-5); }
    function nudge(delta: float) {
        root.edited(clamp(root.value + delta, 0, 100));
        root.released(clamp(root.value + delta, 0, 100));
    }
    // Rail, filled part and knob.
    Rectangle {
        y: (root.height - self.height) / 2;
        height: 4px;
        border-radius: 2px;
        background: Theme.border;
        Rectangle {
            width: parent.width * clamp(root.value, 0, 100) / 100;
            border-radius: 2px;
            background: Theme.accent;
        }
    }
    Rectangle {
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: Theme.fg;
        x: (root.width - self.width) * clamp(root.value, 0, 100) / 100;
        y: (root.height - self.height) / 2;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                root.edited(clamp(round(self.mouse-x / root.width * 100), 0, 100));
            }
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.up {
                root.released(root.value);
            }
        }
        moved => {
            if self.pressed {
                root.edited(clamp(round(self.mouse-x / root.width * 100), 0, 100));
            }
        }
    }
}
