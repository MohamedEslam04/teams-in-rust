import { Reactor } from "../tokens/types.slint";

// Which reaction chip is being hovered, for the card that lists who reacted (reaction_card.slint).
// The card is drawn once per window above the message list, so the rows below a chip never cover
// it. A chip fills this in when the pointer comes onto it; the card closes a moment after the
// pointer is on neither the chip nor the card.
export global ReactionHover {
    in-out property <bool> open;
    in-out property <string> name;
    in-out property <[Reactor]> people;
    // The chip, in window coordinates.
    in-out property <length> ax;
    in-out property <length> ay;
    in-out property <length> aw;
    in-out property <length> ah;
    // The pointer is on the chip that opened the card.
    in-out property <bool> chip-hover;
    // Which chip owns the card (each `enter` is a new one), so a chip the pointer just left does
    // not close the card of the chip it moved onto.
    property <int> serial;
    // The owning chip ticks while the pointer is on it: a chip that is rebuilt under the pointer
    // (its message changed) never reports leaving, and the card closes when the ticks stop.
    out property <int> beats;

    public function enter(name: string, people: [Reactor], x: length, y: length, w: length, h: length) -> int {
        root.serial += 1;
        root.name = name;
        root.people = people;
        root.ax = x;
        root.ay = y;
        root.aw = w;
        root.ah = h;
        root.chip-hover = true;
        root.open = people.length > 0;
        return root.serial;
    }
    public function leave(token: int) {
        if token == root.serial {
            root.chip-hover = false;
        }
    }
    public function beat(token: int) {
        if token == root.serial {
            root.beats += 1;
        }
    }
    public function close() {
        root.open = false;
        root.chip-hover = false;
    }
}
