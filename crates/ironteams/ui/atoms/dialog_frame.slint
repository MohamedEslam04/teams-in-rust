// Dialog frames. `DialogFrame` is a titled panel with a close button; `ModalDialog` also dims
// the window behind it, centres the panel and can show an error band under the title.
import { Fixed } from "../tokens/fixed.slint";
import { Tokens } from "../tokens/types.slint";
import { Theme } from "../tokens/theme.slint";
import { IconButton } from "widgets.slint";

// A dialog panel: its title, a close button and the content below.
export component DialogFrame inherits Rectangle {
    in property <Tokens> c: Theme.content;
    in property <string> title;
    in property <length> dialog-width: 480px;
    callback close();
    width: root.dialog-width;
    border-radius: 8px;
    background: root.c.surface;
    border-width: 1px;
    border-color: root.c.border;
    drop-shadow-blur: 16px;
    drop-shadow-color: Fixed.black-a0;
    accessible-role: groupbox;
    accessible-label: root.title;
    TouchArea { }
    VerticalLayout {
        padding: 16px;
        spacing: 10px;
        HorizontalLayout {
            height: 28px;
            Text { text: root.title; color: root.c.fg; font-size: 17px * Theme.font-scale; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
            IconButton { c: root.c; icon: @image-url("../icons/close.svg"); tooltip: "Close"; size: 28px; clicked => { root.close(); } }
        }
        @children
    }
}

// A modal dialog: dimmed backdrop, a titled panel, and its content in `@children`.
export component ModalDialog inherits Rectangle {
    in property <Tokens> c: Theme.content;
    in property <string> title;
    in property <length> panel-width: 520px;
    in property <length> panel-height: 420px;
    in property <string> error;
    callback close();
    background: Fixed.black-a0;
    TouchArea { }
    panel := Rectangle {
        x: (root.width - self.width) / 2;
        y: max(8px, (root.height - self.height) / 2);
        width: min(root.panel-width, root.width - 24px);
        height: min(root.panel-height, root.height - 16px);
        border-radius: 8px;
        background: root.c.panel;
        border-width: 1px;
        border-color: root.c.border;
        clip: true;
        VerticalLayout {
            Rectangle {
                height: 48px;
                HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 10px;
                    Text { text: root.title; color: root.c.fg; font-size: 16px * Theme.font-scale; font-weight: 700; vertical-alignment: center; accessible-role: text; }
                    Rectangle { horizontal-stretch: 1; }
                    IconButton { c: root.c; icon: @image-url("../icons/close.svg"); tooltip: "Close"; size: 28px; y: 10px; clicked => { root.close(); } }
                }
            }
            if root.error != "": Rectangle {
                height: err.preferred-height + 14px;
                background: root.c.danger-soft;
                err := Text {
                    x: 18px;
                    y: 7px;
                    width: parent.width - 36px;
                    text: root.error;
                    color: root.c.fg-strong;
                    font-size: 12px * Theme.font-scale;
                    wrap: word-wrap;
                    accessible-role: text;
                    accessible-label: "Error: " + root.error;
                }
            }
            Rectangle {
                vertical-stretch: 1;
                @children
            }
        }
    }
}
